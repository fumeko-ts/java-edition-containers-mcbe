{
  "namespace": "smelting_common",
  "toggle@global.empty_panel": {
    "size": [25, 25],
    "$toggle_control_name|default": "('control:' + $item_aux)",
    "$toggle_name|default": "furnace_recipe_items",
    "$toggle_binding_value|default": "('#item:' + $item_aux)",
    "grid_position": "$position",
    "$toggle_group_forced_index|default": -1,
    "$item_aux|default": -1,
    "controls": [
      {
        "item_renderer@global.custom_renderer": {
          "$type": "inventory_item_renderer",
          "size": [16, 16],
          "anchor_from": "center",
          "anchor_to": "center",
          "layer": 7,
          "property_bag": { "#item_id_aux": "($item_aux * 65536)" }
        }
      },
      {
        "collection": {
          "type": "collection_panel",
          "size": [25, 25],
          "$collection_path|default": "smelting_common.hover_button",
          "$collection_name": "inventory_items",
          "collection_name": "$collection_name",
          "controls": [
            { "0@$collection_path": { "collection_index": 0 } },
            { "1@$collection_path": { "collection_index": 1 } },
            { "2@$collection_path": { "collection_index": 2 } },
            { "3@$collection_path": { "collection_index": 3 } },
            { "4@$collection_path": { "collection_index": 4 } },
            { "5@$collection_path": { "collection_index": 5 } },
            { "6@$collection_path": { "collection_index": 6 } },
            { "7@$collection_path": { "collection_index": 7 } },
            { "8@$collection_path": { "collection_index": 8 } },
            { "9@$collection_path": { "collection_index": 9 } },
            { "10@$collection_path": { "collection_index": 10 } },
            { "11@$collection_path": { "collection_index": 11 } },
            { "12@$collection_path": { "collection_index": 12 } },
            { "13@$collection_path": { "collection_index": 13 } },
            { "14@$collection_path": { "collection_index": 14 } },
            { "15@$collection_path": { "collection_index": 15 } },
            { "16@$collection_path": { "collection_index": 16 } },
            { "17@$collection_path": { "collection_index": 17 } },
            { "18@$collection_path": { "collection_index": 18 } },
            { "19@$collection_path": { "collection_index": 19 } },
            { "20@$collection_path": { "collection_index": 20 } },
            { "21@$collection_path": { "collection_index": 21 } },
            { "22@$collection_path": { "collection_index": 22 } },
            { "23@$collection_path": { "collection_index": 23 } },
            { "24@$collection_path": { "collection_index": 24 } },
            { "25@$collection_path": { "collection_index": 25 } },
            { "26@$collection_path": { "collection_index": 26 } },
            { "27@$collection_path": { "collection_index": 27 } }
          ]
        }
      },
      {
        "collection": {
          "type": "collection_panel",
          "size": [25, 25],
          "$collection_path|default": "smelting_common.hover_button",
          "$collection_name": "hotbar_items",
          "collection_name": "$collection_name",
          "controls": [
            { "0@$collection_path": { "collection_index": 0 } },
            { "1@$collection_path": { "collection_index": 1 } },
            { "2@$collection_path": { "collection_index": 2 } },
            { "3@$collection_path": { "collection_index": 3 } },
            { "4@$collection_path": { "collection_index": 4 } },
            { "5@$collection_path": { "collection_index": 5 } },
            { "6@$collection_path": { "collection_index": 6 } },
            { "7@$collection_path": { "collection_index": 7 } },
            { "8@$collection_path": { "collection_index": 8 } },
            { "9@$collection_path": { "collection_index": 9 } }
          ]
        }
      },
      {
        "toggle@toggle.radio_toggle": {
          "$size": [25, 25]
        }
      },
      {
        "hover_button": {
          "type": "button",
          "size": [25, 25],
          "layer": 500,
          "default_focus_precedence": 1,
          "hover_control": "hover_text_java",
          "consume_event": false,
          "bindings": [
            {
              "binding_type": "collection_details",
              "binding_collection_name": "inventory_items",
              "binding_condition": "once"
            },
            
            {
              "binding_type": "collection_details",
              "binding_collection_name": "hotbar_items",
              "binding_condition": "once"
            }
          ],
          "button_mappings": [
            { "to_button_id": "button.container_slot_hovered", "mapping_type": "pressed", "consume_event": false },
            {
              "from_button_id": "button.menu_select",
              "to_button_id": "button.container_auto_place",
              "mapping_type": "pressed"
            }
          ],
          "controls": "$controls",
          "$controls": [
            {
              "hover_text_java@global.custom_renderer": {
                "allow_clipping": false,
                "$type": "bundle_tooltip_renderer",
                "layer": 900,
                "controls": [{ "1@java_hover_text.java_tooltip_test": { "$hover|default": true } }]
              }
            }
          ]
        }
      }
    ]
  },

  "hover_button@global.empty_panel": {
    "size": [25, 25],
    "controls": [
      {
        "craft_not_possible@screen_content.image_element": {
          "layer": 5,
          "texture": "assets/sprites/recipe_book/slot_uncraftable",
          "bindings": [
            {
              "binding_type": "collection",
              "binding_collection_name": "$collection_name",
              "binding_name": "#item_id_aux",
              "binding_condition": "always"
            },
            {
              "binding_type": "view",
              "binding_condition": "always",
              "source_property_name": "(not ((#item_id_aux / 65536) = $item_aux))",
              "target_property_name": "#visible"
            }
          ]
        }
      },
      {
        "craft_possible@screen_content.image_element": {
          "layer": 6,
          "texture": "assets/sprites/recipe_book/slot_craftable",
          "bindings": [
            {
              "binding_type": "collection",
              "binding_collection_name": "$collection_name",
              "binding_name": "#item_id_aux",
              "binding_condition": "always"
            },
            {
              "binding_type": "view",
              "binding_condition": "always",
              "source_property_name": "((#item_id_aux / 65536) = $item_aux)",
              "target_property_name": "#visible"
            }
          ]
        }
      }
    ]
  },
  "title_template@screen_content.text_field": {
    "nineslice_size": 1,
    "alpha": 0.8,
    "anchor_from": "center",
    "anchor_to": "center",
    "size": [81, 14],
    "$page_title|default": "Unknown",
    "$trigger_name|default": "",
    "controls": [
      {
        "label@global.empty_label": {
          "text": "$page_title",
          "shadow": true,
          "size": ["default", 10],
          "anchor_from": "left_middle",
          "anchor_to": "left_middle",
          "offset": [4, 1]
        }
      }
    ],
    "bindings": [
      {
        "binding_type": "view",
        "source_control_name": "$trigger_name",
        "source_property_name": "#toggle_state",
        "target_property_name": "#visible"
      }
    ]
  },
  "furnace_filter_on@global.empty_image": {
    "offset": [0, 1],
    "texture": "assets/sprites/recipe_book/furnace_filter_disabled.png",
    "size": ["default", "default"],
    "layer": 5
  },
  "furnace_filter_on_hover@global.empty_image": {
    "offset": [0, 1],
    "texture": "assets/sprites/recipe_book/furnace_filter_disabled_highlighted.png",
    "size": ["default", "default"],
    "layer": 5
  },

  "red_overlay@screen_content.image_element": {
    "texture": "textures/ui/ashur/cell_transparent_image_red",
    "size": [18, 18],
    "$item_aux|default": -1,
    "$trigger_name|default": "",
    "nineslice_size": 1,
    "controls": [
      {
        "clear_item@toggle.radio_toggle": {
          "$size": [18, 18],
          "$toggle_control_name|default": "control:clear",
          "$toggle_name|default": "furnace_recipe_items",
          "$toggle_binding_value|default": "#furnace_clear",
          "$toggle_group_forced_index": 0
        }
      },
      {
        "white@global.empty_image": {
          "texture": "textures/ui/ashur/white",
          "size": [16, 16],
          "anchor_to": "center",
          "anchor_from": "center",
          "alpha": 0.2,
          "layer": 12
        }
      },
      {
        "item_renderer@global.custom_renderer": {
          "$type": "inventory_item_renderer",
          "size": [16, 16],
          "anchor_from": "center",
          "anchor_to": "center",
          "property_bag": { "#item_id_aux": "($item_aux * 65536)" }
        }
      }
    ],
    "bindings": [
      {
        "binding_type": "view",
        "source_control_name": "$trigger_name",
        "source_property_name": "#toggle_state",
        "target_property_name": "#visible"
      }
    ]
  },
  "smoker_selected_items@global.empty_panel": {
    "size": [18, 18],
    "layer": 16,
    "controls": [
      { "1@smelting_common.red_overlay": { "$item_aux": 583, "$trigger_name": "control:583" } },
      { "2@smelting_common.red_overlay": { "$item_aux": 310, "$trigger_name": "control:310" } },
      { "3@smelting_common.red_overlay": { "$item_aux": 302, "$trigger_name": "control:302" } },
      { "4@smelting_common.red_overlay": { "$item_aux": 297, "$trigger_name": "control:297" } },
      { "5@smelting_common.red_overlay": { "$item_aux": 295, "$trigger_name": "control:295" } },
      { "6@smelting_common.red_overlay": { "$item_aux": 287, "$trigger_name": "control:287" } },
      { "7@smelting_common.red_overlay": { "$item_aux": 286, "$trigger_name": "control:286" } },
      { "8@smelting_common.red_overlay": { "$item_aux": 284, "$trigger_name": "control:284" } },
      { "9@smelting_common.red_overlay": { "$item_aux": 408, "$trigger_name": "control:408" } }
    ],
    "bindings": [
      {
        "binding_type": "collection",
        "binding_collection_name": "furnace_ingredient_items",
        "binding_name": "#item_id_aux",
        "binding_condition": "always"
      },
      {
        "binding_type": "view",
        "binding_condition": "always",
        "source_property_name": "(#item_id_aux = -1)",
        "target_property_name": "#visible"
      }
    ]
  }
}
