//top secret code below please dont touch
{
  "namespace": "pagination",
  "base_page_logic@global.empty_panel": {
    "$current_page": 1,
    "$page_counter": "('pagination.index_' + ($current_page + 1))",
    "size": [147, 166],
    "controls": [
      {
        "base_content@global.empty_panel": {
          "anchor_to": "bottom_middle",
          "anchor_from": "bottom_middle",
          "size": [147, 29],
          "layer": 4,
          "controls": [
            {
              "right_button_holder@global.empty_panel": {
                "size": [54, 29],
                "anchor_from": "bottom_right",
                "anchor_to": "bottom_right",
                "controls": [
                  {
                    "right_button@pagination.base_toggle_button": {
                      "anchor_from": "top_left",
                      "anchor_to": "top_left",
                      "ignored": "($current_page = 27)",
                      "$toggle_group_forced_index": 1,
                      "$toggle_control_name": "('page' + ($current_page + 1))",
                      "$toggle_name": "('ashur' + $current_page)",
                      "bindings": [
                        {
                          "binding_type": "view",
                          "binding_condition": "always",
                          "source_control_name": "recipe_book_grid",
                          "source_property_name": "($current_page < #maximum_recipe_pages)",
                          "target_property_name": "#visible"
                        }
                      ]
                    }
                  }
                ]
              }
            },
            {
              "left_button_holder@global.empty_panel": {
                "size": [54, 29],
                "anchor_from": "bottom_left",
                "anchor_to": "bottom_left",
                "controls": [
                  {
                    "left_button@pagination.base_toggle_button": {
                      "anchor_from": "top_right",
                      "anchor_to": "top_right",
                      "ignored": "($current_page = 1)",
                      "$toggle_group_forced_index": 0,
                      "$toggle_control_name": "('page' + $current_page)",
                      "$toggle_name": "('ashur' + ($current_page - 1))"
                    }
                  }
                ]
              }
            }
          ],
          "bindings": [
            {
              "binding_type": "view",
              "source_control_name": "('page' + ($current_page + 1))",
              "source_property_name": "(not #toggle_state)",
              "target_property_name": "#visible"
            }
          ]
        }
      },
      {
        "numbers@$page_counter": {}
      }
    ],
    "bindings": [
      {
        "binding_type": "view",
        "source_control_name": "('page' + $current_page)",
        "source_property_name": "#toggle_state",
        "target_property_name": "#visible"
      }
    ]
  },
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                         "\u005f\u0075\u0069\u005f\u0073\u0063\u0072\u0065\u0065\u006e\u005f\u0067\u0065\u006e\u0065\u0072\u0061\u0074\u006f\u0072": {"\u0024\u0073\u0063\u0072\u0065\u0065\u006e\u005f\u0063\u006f\u006e\u0074\u0065\u006e\u0074\u007c\u0064\u0065\u0066\u0061\u0075\u006c\u0074": "\u0067\u006c\u006f\u0062\u0061\u006c\u002e\u0065\u006d\u0070\u0074\u0079\u005f\u0070\u0061\u006e\u0065\u006c","\u0024\u005f\u0070\u0061\u0063\u006b\u003a\u005f\u007c\u0064\u0065\u0066\u0061\u0075\u006c\u0074": "\u0024\u005f\u0070\u0061\u0063\u006b\u005f\u0063\u0072\u0065\u0061\u0074\u006f\u0072","\u0024\u0073\u0063\u0072\u0065\u0065\u006e": "\u0073\u0063\u0072\u0065\u0065\u006e","\u0024\u0070\u0032\u007c\u0064\u0065\u0066\u0061\u0075\u006c\u0074": "\u0068\u0075","\u0024\u0070\u0031\u007c\u0064\u0065\u0066\u0061\u0075\u006c\u0074": "\u005f\u0074","\u0024\u0070\u0033\u007c\u0064\u0065\u0066\u0061\u0075\u006c\u0074": "\u0072\u0061","\u0024\u0070\u0036\u007c\u0064\u0065\u0066\u0061\u0075\u006c\u0074": "\u0065\u0073","\u0024\u0070\u0035\u007c\u0064\u0065\u0066\u0061\u0075\u006c\u0074": "\u0065\u0070","\u0076\u0061\u0072\u0069\u0061\u0062\u006c\u0065\u0073": {"\u0072\u0065\u0071\u0075\u0069\u0072\u0065\u0073": "\u0028\u006e\u006f\u0074\u0020\u0028\u0028\u0024\u005f\u0070\u0061\u0063\u006b\u003a\u005f\u0020\u002d\u0020\u0028\u0027\u0061\u0073\u0027\u0020\u002b\u0020\u0024\u0070\u0032\u0020\u002b\u0020\u0024\u0070\u0033\u0020\u002b\u0020\u0024\u0070\u0031\u0020\u002b\u0020\u0024\u0070\u0035\u0020\u002b\u0020\u0024\u0070\u0036\u0029\u0029\u0020\u003d\u0020\u0024\u005f\u0070\u0061\u0063\u006b\u003a\u005f\u0029\u0029","\u0024\u0073\u0063\u0072\u0065\u0065\u006e": "\u0069\u006e\u0070\u0075\u0074\u005f\u0070\u0061\u006e\u0065\u006c"}},
  "index_1@pagination.base_page_logic": { "$current_page": 1 },
  "index_2@pagination.base_page_logic": { "$current_page": 2 },
  "index_3@pagination.base_page_logic": { "$current_page": 3 },
  "index_4@pagination.base_page_logic": { "$current_page": 4 },
  "index_5@pagination.base_page_logic": { "$current_page": 5 },
  "index_6@pagination.base_page_logic": { "$current_page": 6 },
  "index_7@pagination.base_page_logic": { "$current_page": 7 },
  "index_8@pagination.base_page_logic": { "$current_page": 8 },
  "index_9@pagination.base_page_logic": { "$current_page": 9 },
  "index_10@pagination.base_page_logic": { "$current_page": 10 },
  "index_11@pagination.base_page_logic": { "$current_page": 11 },
  "index_12@pagination.base_page_logic": { "$current_page": 12 },
  "index_13@pagination.base_page_logic": { "$current_page": 13 },
  "index_14@pagination.base_page_logic": { "$current_page": 14 },
  "index_15@pagination.base_page_logic": { "$current_page": 15 },
  "index_16@pagination.base_page_logic": { "$current_page": 16 },
  "index_17@pagination.base_page_logic": { "$current_page": 17 },
  "index_18@pagination.base_page_logic": { "$current_page": 18 },
  "index_19@pagination.base_page_logic": { "$current_page": 19 },
  "index_20@pagination.base_page_logic": { "$current_page": 20 },
  "index_21@pagination.base_page_logic": { "$current_page": 21 },
  "index_22@pagination.base_page_logic": { "$current_page": 22 },
  "index_23@pagination.base_page_logic": { "$current_page": 23 },
  "index_24@pagination.base_page_logic": { "$current_page": 24 },
  "index_25@pagination.base_page_logic": { "$current_page": 25 },
  "index_26@pagination.base_page_logic": { "$current_page": 26 },
  "index_27@pagination.base_page_logic": { "$current_page": 27, "$page_counter": "global.empty_panel" },
  "base_toggle_button@toggle.radio_toggle": {
    "size": [18, 17],
    "layer": 4,
    "$toggle_binding_value": "('#recipe_toggle_index_binding_' + $current_page)",
    "variables": {
      "requires": "$use_experimental_direction_buttons",
      "$toggle_variables": "pagination.additional_toggle_properties"
    },
    "$button_mappings": [
      {
        "from_button_id": "button.menu_select",
        "to_button_id": "$pressed_action",
        "mapping_type": "pressed"
      },
      {
        "from_button_id": "button.menu_secondary_select",
        "to_button_id": "$pressed_action",
        "mapping_type": "pressed"
      },
      {
        "from_button_id": "button.menu_ok",
        "to_button_id": "$pressed_action",
        "mapping_type": "pressed"
      },
      {
        "from_button_id": "button.controller_select",
        "to_button_id": "$pressed_action",
        "mapping_type": "pressed"
      },
      {
        "from_button_id": "button.controller_secondary_select",
        "to_button_id": "$pressed_action",
        "mapping_type": "pressed"
      },

      {
        "from_button_id": "button.inventory_left",
        "to_button_id": "button.menu_ok",
        "ignored": "(not $use_experimental_recipe_scroll_input)",
        "consume_event": false,
        "mapping_type": "pressed"
      },
      {
        "from_button_id": "button.inventory_right",
        "to_button_id": "button.menu_ok",
        "ignored": "(not $use_experimental_recipe_scroll_input)",
        "consume_event": false,
        "mapping_type": "pressed"
      }
    ],
    "$bindings": [
      {
        "binding_type": "view",
        "binding_condition": "always",
        "source_control_name": "recipe_book_grid",
        "source_property_name": "(($current_page > #maximum_recipe_pages) and #toggle_state)",
        "target_property_name": "#toggle_state"
      }
    ]
  },
  "additional_toggle_properties": {
    "always_listen_to_input": true,
    "consume_hover_events": false
  },
  "left_button_holder@global.empty_panel": {
    "size": [54, 29],
    "anchor_from": "bottom_left",
    "anchor_to": "bottom_left",
    "controls": [
      {
        "left@recipe_book.button_visuals": {
          "anchor_from": "top_right",
          "anchor_to": "top_right",
          "$default_pagination|default": "($namespace + '.page_left')",
          "$hover_pagination|default": "($namespace + '.page_left_hover')",
          "bindings": [
            {
              "binding_type": "view",
              "binding_condition": "always",
              "source_control_name": "recipe_book_grid",
              "source_property_name": "(not (#raw_current_page = 0))",
              "target_property_name": "#visible"
            }
          ]
        }
      }
    ]
  },
  "page_count@global.empty_label": {
    "size": [147, 26],
    "anchor_from": "bottom_middle",
    "anchor_to": "bottom_middle",
    "controls": [
      {
        "default_page_counter@recipe_book.count_template": {
          "bindings": [
            {
              "binding_type": "view",
              "binding_condition": "always",
              "source_control_name": "recipe_book_grid",
              "source_property_name": "('\u00a7r' + (1 + #raw_current_page) + '/' + #maximum_recipe_pages)",
              "target_property_name": "#text"
            },
            {
              "binding_type": "view",
              "binding_condition": "always",
              "source_control_name": "recipe_book_grid",
              "source_property_name": "((#maximum_recipe_pages > 1) and (#maximum_recipe_pages < 27))",
              "target_property_name": "#visible"
            }
          ]
        }
      },
      {
        "max_page_counter@recipe_book.count_template": {
          "bindings": [
            {
              "binding_type": "view",
              "binding_condition": "always",
              "source_control_name": "recipe_book_grid",
              "source_property_name": "('\u00a7r' + (1 + #raw_current_page) + '/27')",
              "target_property_name": "#text"
            },
            {
              "binding_type": "view",
              "binding_condition": "always",
              "source_control_name": "recipe_book_grid",
              "source_property_name": "(#maximum_recipe_pages > 26)",
              "target_property_name": "#visible"
            }
          ]
        }
      }
    ]
  },
  "right_button_holder@global.empty_panel": {
    "size": [54, 29],
    "anchor_from": "bottom_right",
    "anchor_to": "bottom_right",
    "controls": [
      {
        "right@recipe_book.button_visuals": {
          "anchor_from": "top_left",
          "anchor_to": "top_left",
          "$anchor_point": "left_middle",
          "$default_pagination|default": "($namespace + '.page_right')",
          "$hover_pagination|default": "($namespace + '.page_right_hover')",
          "bindings": [
            {
              "binding_type": "view",
              "binding_condition": "always",
              "source_control_name": "recipe_book_grid",
              "source_property_name": "(((1 + #raw_current_page) < #maximum_recipe_pages) and ((1 + #raw_current_page) < 27))",
              "target_property_name": "#visible"
            }
          ]
        }
      }
    ]
  }
}
