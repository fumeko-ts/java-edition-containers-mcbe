{
  "$nature_tab_texture": "pearlescent_froglight",

  // Set container UI transparency (range: 0.0 - 1.0)
  "$container_opacity": 1,

  "$title_text_color": [0.247, 0.247, 0.247, 1.0],
  "$enchant_light_green": [0.475, 0.95, 0.11875],
  "$enchant_light_yellow": [1.0, 1.0, 0.5],
  "$enchant_light_brown": [0.392, 0.357, 0.275, 1.0],
  "$enchant_dark_green": [0.318, 0.475, 0.216],

  "$smoker_search_tab_index": 0,
  "$direction": "right",

  "$creative_recipe_book": false,
  "$loom_screen": false,
  "$anvil_screen": false,
  "$barrel_screen": false,
  "$beacon_screen": false,
  "$blast_furnace_screen": false,
  "$brewing_stand_screen": false,
  "$cartography_screen": false,
  "$crafting_screen": false,
  "$crafter_screen": false,
  "$dispenser_screen": false,
  "$dropper_screen": false,
  "$enchanting_screen": false,
  "$furnace_screen": false,
  "$double_chest_container": false,
  "$grindstone_screen": false,
  "$hopper_screen": false,
  "$horse_screen": false,
  "$inventory_screen": false,
  "$shulker_screen": false,
  "$smithing_screen": false,
  "$smoker_screen": false,
  "$stonecutter_screen": false,
  "$main_trade_screen": false,
  "$recipe_book": false,

  // Internal use – changing content below will break some UI
  "$jc:dev": true,
  "$enchant_selectable_button_mappings": [
    { "from_button_id": "button.menu_select", "to_button_id": "button.menu_ok", "mapping_type": "pressed" },
    { "from_button_id": "button.menu_ok", "to_button_id": "button.menu_ok", "mapping_type": "focused" },
    {
      "from_button_id": "button.controller_back",
      "to_button_id": "button.menu_ok",
      "mapping_type": "focused",
      "ignored": "(not $is_ps4)"
    }
  ],
  "$recipe_book_contents": [
    { "offset_content@$page_contents": { "offset": [0.9, -1.6], "layer": 4 } },
    {
      "holder@global.empty_stack": {
        "orientation": "vertical",
        "anchor_to": "top_middle",
        "anchor_from": "top_middle",
        "size": [111, 30],
        "offset": [8, 0],
        "controls": [
          { "buffer_1@global.empty_panel": { "size": [111, 11] } },
          {
            "search_and_filter@global.empty_stack": {
              "orientation": "horizontal",
              "size": [111, 18],
              "controls": [
                {
                  "text_edit_panel@global.empty_panel": {
                    "size": [81, 18],
                    "controls": [
                      {
                        "text_edit_control@text_edit_box.text_edit_box": {
                          "size": [81, 14],
                          "property_bag": { "#property_field": "#item_name" },
                          "max_length": 300000,
                          "anchor_from": "center",
                          "anchor_to": "center",
                          "$text_clear_button_offset": [3, 0],
                          "$text_edit_box_label_offset": [1, 0.4],
                          "$text_clear_button_enabled": true,

                          "$place_holder_text": "atemp.recipe_book.searchBox",
                          "$extra_contents": "text_edit_box.placeholder_label",

                          "$text_background_locked": "screen_content.text_field",
                          "$text_background_default": "screen_content.text_field",
                          "$text_background_hover": "screen_content.text_field_highlighted",

                          "$text_edit_binding_name": "#text_box_item_name",
                          "$text_edit_box_label_size": ["default", 10]
                        }
                      }
                    ]
                  }
                },
                { "buffer_2@global.empty_panel": { "size": [4, "fill"] } },
                { "filter@crafting_common.filter_toggle": {} }
              ]
            }
          }
        ]
      }
    },
    {
      "stack_holder@global.empty_stack": {
        "orientation": "vertical",
        "anchor_to": "bottom_middle",
        "anchor_from": "bottom_middle",
        "size": [77, 30],
        "controls": [
          {
            "stack@global.empty_stack": {
              "orientation": "horizontal",
              "size": [77, 17],
              "anchor_to": "bottom_middle",
              "anchor_from": "bottom_middle",
              "layer": 20,
              "controls": [
                { "buffer@global.empty_panel": { "size": [18, 0], "ignored": "(not ($current_page = 1))" } },
                { "left@pagination.tepes_left_button": {} },
                {
                  "buffer1@global.empty_panel": {
                    "size": [43, 17],
                    "controls": [
                      { "label@pagination.page_count_label": {} },
                      { "max_page_label@pagination.max_page_label": {} }
                    ]
                  }
                },
                { "right@pagination.tepes_right_button": {} }
              ]
            }
          },
          { "buffer_fill_1@global.empty_panel": { "size": [65, 13] } }
        ]
      }
    }
  ]
}
