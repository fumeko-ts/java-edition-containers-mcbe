{
  //used for compatibility
  "$is_java_containers": true,
  "$_pack_creator": "ashura_temps/ashura_tepes",
  //set UI transparency
  "$container_opacity": 1,
  "$container_color": [],//hex to rgba converter --> https://fumeko-ts.github.io/fumeko-ts/hex_to_rgba.html
  "$background_blur_opacity": 1,//the base png is transparent

  "$show_exit_buttons": true,
  //if true makes so pc users dont need to move their mouse to reselect the page button
  "$use_experimental_direction_buttons": true,
  //if true allows pc users to trigger the page buttons useing the scroll wheel
  "$use_experimental_recipe_scroll_input": false,
  //if true allows the user to hover over a tab to auto select it
  "$use_experimental_tab_toggle_input": false,
  //if true will unlock villager trades
  "$use_unlocked_villager_trades": false,
  //if true allows touch input users to use pc tooltip instead of the mobile one
  "$use_pc_hover_text_with_touch_input": false,
  //title text color 
  "$container_title_color": [0.247, 0.247, 0.247],

  //these item indexes are whats used to render the items in the recipe book tabs
  //you can find the index for a item useing this --> https://www.planetminecraft.com/texture-pack/item-id-visualizer-mcbe-mcpe/
  //item_index = (#item_id_aux / 65536)

  //creative inventory tabs
  "$chest_item_index": 54,
  "$compass_item_index": 394,
  "$redstone_item_index": 376,
  "$iron_sword_item_index": 309,
  "$purple_froglight_item_index": -469,
  "$bricks_item_index": 45,

  //crafting recipe book tabs
  "$apple_item_index": 878,
  "$bucket_lava_item_index": 366,
  "$golden_sword_item_index": 325,
  "$iron_axe_item_index": 300,

  //furnace recipe book tabs
  "$raw_porkchop_item_index": 262,
  "$stone_item_index": 1,
  "$emerald_item_index": 523,

  //blast furnace recipe book tabs
  "$golden_leggings_item_index": 356,
  "$iron_shovel_item_index": 298,

