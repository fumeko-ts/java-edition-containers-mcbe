  "$xp_price_color_enabled_state": [0.4941, 0.9882, 0.1255, 1],
  "$xp_price_shadow_color_enabled_state": [0.1255, 0.2431, 0.0314, 1],

  "$xp_price_color_disabled_state": [0.2471, 0.4941, 0.0627, 1],
