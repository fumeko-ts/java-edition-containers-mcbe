{
  //used for compatibility
  "$is_java_containers": true,
  "$_pack_creator": "ashura_temps/ashura_tepes",

  //set UI transparency
  "$container_opacity": 1,
  "$screen_blur_opacity": 1, 

  //hex to rgba converter --> https://fumeko-ts.github.io/fumeko-ts/hex_to_rgba.html
  "$container_tint_color": [], 
  "$stack_split_overlay_color": [0.188, 0.718, 0.906],
  
  "$show_close_buttons": true,
  "$enable_recipe_page_mouse_scroll": false,
  "$enable_tab_hover_to_select": false,
  "$unlock_villager_trades": false,
  "$show_villager_trades": false,
  "$enable_pc_tooltips_for_touch_input": false,
  "$tile_scroll_boxes": true,
  "$keep_hud_visible_in_containers": false,
  "$clip_entity_renderers": true,
  "$hide_custom_tooltips": false,

  //title text color
  "$container_title_text_color": [0.247, 0.247, 0.247],

  /*
    these item indexes are whats used to render the items in the recipe book tabs
    you can find the index for a item using this --> https://www.planetminecraft.com/texture-pack/item-id-visualizer-mcbe-mcpe/
  */

  "$recipe_tab_chest_item_index": 54,
  "$recipe_tab_purple_froglight_item_index": -469,
  "$recipe_tab_bricks_item_index": 45,
  "$recipe_tab_stone_item_index": 1,

  //enchanting table text colors
  "$enchant_exp_enabled_color": [0.4941, 0.9882, 0.1255, 1],
  "$enchant_exp_enabled_shadow_color": [0.1255, 0.2431, 0.0314, 1],
  "$enchant_exp_disabled_color": [0.2471, 0.4941, 0.0627, 1],
  "$enchant_exp_disabled_shadow_color": [0.0627, 0.1216, 0.0157, 1],
  "$enchant_rune_disabled_color": [0.2, 0.1804, 0.1451, 1],
  "$enchant_rune_enabled_color": [0.4039, 0.3647, 0.2863, 1],
  "$enchant_rune_hover_color": [0.988, 0.988, 0.494],

  /* 
    Compatibility variables (dont modify)
  */
  "$cb_is_thick_menu_buttons": false,         /*https://www.planetminecraft.com/texture-pack/thickly-be-beveled-buttons-bedrock-edition  */ 
  "$is_jei_recipe_book_layout_pack": false,   /*https://www.curseforge.com/minecraft-bedrock/texture-packs/jei-recipe-book-layout        */ 
  "$is_déesse_ui_pack": false,                /*https://www.curseforge.com/minecraft-bedrock/texture-packs/deesse-ui-pack                */ 
  "$is_overcomplicated_brewing_guide": false, /*https://www.curseforge.com/minecraft-bedrock/texture-packs/overcomplicated-brewing-guide */ 
  "$is_container_utilities": false,           /*https://www.curseforge.com/minecraft-bedrock/texture-packs/container-utilities           */ 

  "$pack_scope": "global"
}
