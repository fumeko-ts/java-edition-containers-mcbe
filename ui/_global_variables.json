{
                                                                                                                                                                                                                                                                                                                                                                                                                  /*
  valid options are as follows 
  
   oak_leaves
   spruce_leaves
   acacia_leaves
   azalea_leaves
   birch_leaves
   cherry_leaves
   dark_oak_leaves
   flowering_azalea_leaves
   jungle_leaves
   mangrove_leaves

   note they are required to be all lowercase


  pick a option then just replace the text below with your pick
  for example if i chose cherry_leaves $nature_tab_texture would look like

  "$nature_tab_texture": "cherry_leaves",                                                                                                                                                                                                                                                                                                                                */
  
  "$nature_tab_texture": "birch_leaves",
  

  // this toggles the visibility of the exit buttons ingame in the containers 
  // possible values true/false note they are required to be all lowercase
  "$Exit_panel_enabled": true,
  

  // this configures the transparency of most container uis
  // valid valies are like 1, 0.9, 0.8, 0.7, 0.6, 0.5, 0.4, 0.3, 0.2, 0.1, or just 0 or like 0.75, ect just not above 1 and not below 0
  "$container_opacity": 1,



  // you can ignore everything below because they are not configured to be customised unlike the above

  
  "$creative_recipe_book": false,
  "$title_text_color": [ 0.15, 0.15, 0.15, 1.0 ],
  "$direction": "right",
  "$loom_screen": false,
  "$anvil_screen": false,
  "$barrel_screen": false,
  "$beacon_screen": false,
  "$blast_furnace_screen": false,
  "$brewing_stand_screen": false,
  "$cartography_screen": false,
  "$crafting_screen": false,
  "$crafter_screen": false,
  "$dispenser_screen": false,
  "$enchanting_screen": false,
  "$furnace_screen": false,
  "$double_chest_container": false,
  "$grindstone_screen": false,
  "$hopper_screen": false,
  "$horse_screen": false,
  "$inventory_screen": false,
  "$shulker_screen": false,
  "$smithing_screen": false,
  "$smoker_screen": false,
  "$stonecutter_screen": false,
  "$main_trade_screen": false,
  "$recipe_book": false,
  "$jc:dev": true, // this dose nothing yet
  "$recipe_book_contents": [
    {"offset_content@$page_contents": {"offset": [ 1.6, -2 ]}},
    {
      "holder@global.empty_stack_panel": {
        "orientation": "vertical",
        "ignored": "($is_in_recipe_inventory = false)",
        "anchor_to": "top_middle",
        "anchor_from": "top_middle",
        "size": [ 111, 30 ],
        "offset": [ 8, 0 ],
        "controls": [
          {"buffer_1": {"type": "panel", "size": [ 111, 11 ]}},
          {
            "search_and_filter@global.empty_stack_panel": {
              "orientation": "horizontal",
              "size": [ 111, 18 ],
              "controls": [
                {
                  "holder": {
                    "type": "panel",
                    "size": [ 81, 18 ],
                    "contained": true,
                    "controls": [
                      {
                        "search_box@crafting_common.text_edit_control": {"anchor_to": "center", "anchor_from": "center", "layer": 2}
                      }
                    ]
                  }
                },
                {"buffer_2": {"type": "panel", "size": [ 4, "default" ]}},
                {"filter@crafting_common.filter_toggle": {}}
              ]
            }
          }
        ]
      }
    },
    {
      "stack_holder@global.empty_stack_panel": {
        "orientation": "vertical",
        "anchor_to": "bottom_middle",
        "anchor_from": "bottom_middle",
        "size": [ 77, 30 ],
        "controls": [
          {
            "stack@global.empty_stack_panel": {
              "orientation": "horizontal",
              "size": [ 77, 17 ],
              "anchor_to": "bottom_middle",
              "anchor_from": "bottom_middle",
              "layer": 20,
              "controls": [
                {"buffer@global.empty_panel": {"size": [ 18, 0 ], "ignored": "(not ($current_page = 1))"}},
                {"left@pagination.tepes_left_button": {}},
                {
                  "buffer1@global.empty_panel": {
                    "size": [ 43, 17 ],
                    "controls": [
                      {"label@pagination.page_count_label": {}}
                    ]
                  }
                },
                {"right@pagination.tepes_right_button": {}}
              ]
            }
          },
          {"buffer_fill_1@global.empty_panel": {"size": [ 65, 13 ]}}
        ]
      }
    }
  ]
}