{
  "namespace": "common",
  "slot_selected@screen_content.image_element": {
    "texture": "textures/ui/ashur/touch_ui_selected",
    "nineslice_size": 1,
    "size": [18, 18],
    "$slot_selected_binding_name|default": "#is_selected_slot",
    "visible": true,
    "layer": 6,
    "anchor_from": "center",
    "anchor_to": "center",
    "bindings": [
      {
        "binding_name": "$slot_selected_binding_name",
        "binding_name_override": "#visible",
        "binding_type": "collection",
        "binding_collection_name": "$item_collection"
      }
    ],
    "controls": [{ "progress_bar_release@common.inventory_hold_icon_release": { "layer": 70 } }]
  },
  "cell_image_panel/cell_image_selected": { "ignored": true },
  "scroll_view_control": {
    "scroll_speed": 23
  }
}
