{
  "namespace": "debug_screen",
  "debug_screen@common.base_screen": { "$screen_content": "debug_screen.warning" },
  "warning@common.empty_panel": {
    "controls": [
      {
        "bg_image": {
          "type": "image",
          "texture": "textures/ui/greyBorder",
          "anchor_from": "top_left",
          "anchor_to": "top_left",
          "size": [ "default", 25 ],
          "offset": "@debug_screen.popup_anim_start",
          "controls": [
            {
              "stack@global.empty_stack_panel": {
                "orientation": "horizontal",
                "anchor_to": "left_middle",
                "anchor_from": "left_middle",
                "controls": [
                  {
                    "panel@global.empty_panel": {
                      "type": "panel",
                      "size": [ 27, 27 ],
                      "controls": [
                        {
                          "pack_icon@screen_content.image_element": {
                            "size": [ 20, 19 ],
                            "offset": [ 0, -1 ],
                            "anchor_to": "center",
                            "anchor_from": "center",
                            "texture": "pack_icon.png"
                          }
                        }
                      ]
                    }
                  },
                  {
                    "panel@global.empty_panel": {
                      "type": "panel",
                      "size": [ "default", 25 ],
                      "anchor_to": "bottom_left",
                      "anchor_from": "bottom_left",
                      "controls": [
                        {
                          "text": {
                            "type": "label",
                            "offset": [ 0, 8 ],
                            "text": "\u00a7k.\u00a7r \u00a7lJava Containers \u00a7k.\u00a7r  |  is Enabled",
                            "shadow": true,
                            "anchor_to": "bottom_left",
                            "anchor_from": "bottom_left",
                            "size": [ "default", 25 ],
                            "text_alignment": "left",
                            "layer": 2
                          }
                        }
                      ]
                    }
                  }
                ]
              }
            }
          ]
        }
      }
    ]
  },
  "popup_anim_start": {
    "anim_type": "offset",
    "easing": "linear",
    "from": [ 0, -100 ],
    "to": [ 0, 0 ],
    "duration": 0.35,
    "next": "@debug_screen.popup_anim_wait"
  },
  "popup_anim_wait": {
    "anim_type": "wait",
    "duration": 7,
    "next": "@debug_screen.popup_anim_end"
  },
  "popup_anim_end": {
    "anim_type": "offset",
    "easing": "linear",
    "to": [ 0, -100 ],
    "from": [ 0, 0 ],
    "duration": 0.3,
    "destroy_at_end": "warning"
  }
}