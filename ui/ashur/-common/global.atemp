{
  "namespace": "global",
  "close_button": {
    "type": "button",
    "size": [11, 11],
    "layer": 10,
    "anchor_from": "top_right",
    "anchor_to": "top_right",
    "default_control": "default",
    "hover_control": "hover",
    "pressed_control": "pressed",
    "sound_name": "random.click",
    "$exit_offset": [-2, 2],
    "offset": "$exit_offset",
    "ignored": "$no_close_button",
    "sound_volume": 1.0,
    "sound_pitch": 1.0,
    "button_mappings": [
      {
        "from_button_id": "button.menu_select",
        "to_button_id": "button.menu_exit",
        "mapping_type": "pressed"
      },
      {
        "from_button_id": "button.menu_ok",
        "to_button_id": "button.menu_exit",
        "mapping_type": "focused"
      }
    ],
    "controls": [
      {
        "default@global.empty_image": {
          "alpha": 0.4,
          "texture": "textures/ui/ashur/close_button"
        }
      },
      {
        "hover@global.empty_image": {
          "texture": "textures/ui/ashur/close_button"
        }
      },
      {
        "pressed@global.empty_image": {
          "alpha": 0.4,
          "texture": "textures/ui/ashur/close_button"
        }
      }
    ]
  },
  "stack_count_label": {
    "type": "label",
    "color": "$item_stack_count_color",
    "offset": [0, 1],
    "anchor_to": "bottom_right",
    "anchor_from": "bottom_right",
    "layer": 7,
    "shadow": true,
    "$stack_count_binding_name|default": "#inventory_stack_count",
    "$stack_count_binding_condition|default": "none",
    "text": "$stack_count_binding_name",
    "bindings": [
      {
        "binding_name": "$stack_count_binding_name",
        "binding_type": "collection",
        "binding_collection_name": "$item_collection",
        "binding_condition": "$stack_count_binding_condition"
      }
    ]
  },
  "grid_item@jc_container_item.container_item": { "$grid_item_collection": "hotbar_items" },
  "hotbar": {
    "type": "grid",
    "size": [162, 18],
    "anchor_from": "bottom_middle",
    "anchor_to": "bottom_middle",
    "offset": "$hotbar_offset",
    "$hotbar_offset": [0, -4],
    "grid_dimensions": [9, 1],
    "grid_item_template": "global.grid_item",
    "$item_collection": "hotbar_items",
    "collection_name": "hotbar_items"
  },
  "inventory_bottom_half_with_label@global.empty_stack": {
    "orientation": "vertical",
    "size": [162, 95],
    "offset": "$grid_cell_offset",
    "$grid_cell_offset": [0, 0],
    "$inventory_panel_offset|default": "bottom_middle",
    "anchor_to": "$inventory_panel_offset",
    "anchor_from": "$inventory_panel_offset",
    "$is_creative_survival_tab|default": false,
    "controls": [
      {
        "creative_mode_spacing_top@global.empty_panel": {
          "size": ["default", 10],
          "ignored": "(not ($is_creative_survival_tab = true))"
        }
      },
      {
        "inventory_label_holder@global.empty_panel": {
          "max_size": [162, 10],
          "min_size": [10, 10],
          "ignored": "($is_creative_survival_tab = true)",
          "controls": [
            {
              "inventory_label@global.empty_label": {
                "anchor_from": "bottom_left",
                "anchor_to": "bottom_left",
                "layer": 2,
                "size": ["default", 10],
                "offset": [1, 0],
                "color": "$title_text_color",
                "text": "atemp.container.inventory"
              }
            }
          ]
        }
      },
      { "inventory_label_spacing@global.empty_panel": { "size": ["default", 2] } },
      {
        "inventory_grid": {
          "type": "grid",
          "size": [162, 54],
          "grid_dimensions": [9, 3],
          "$item_collection": "inventory_items",
          "grid_item_template": "global.grid_item",
          "collection_name": "inventory_items"
        }
      },
      { "below_inventory_grid_spacing@global.empty_panel": { "size": ["default", 4] } },
      { "hotbar@global.hotbar": {} },
      { "hotbar_bottom_spacing@global.empty_panel": { "size": ["default", 7] } }
    ]
  },
  "inventory_selected_icon@jc_container_item.item_renderer": {
    "layer": 50,
    "size": [16, 16],
    "offset": [-1, -2],
    "bindings": [
      {
        "binding_name": "#inventory_selected_item",
        "binding_name_override": "#item_id_aux",
        "binding_condition": "always_when_visible"
      },
      {
        "binding_name": "#inventory_selected_item_charged_item",
        "binding_name_override": "#charged_item",
        "binding_condition": "always_when_visible"
      },
      {
        "binding_name": "#inventory_selected_item_color",
        "binding_name_override": "#item_custom_color",
        "binding_condition": "always_when_visible"
      },
      {
        "binding_name": "#inventory_selected_armor_trim_material",
        "binding_name_override": "#armor_trim_material",
        "binding_condition": "always_when_visible"
      },
      {
        "binding_name": "#inventory_selected_banner_patterns",
        "binding_name_override": "#banner_patterns",
        "binding_condition": "always_when_visible"
      },
      {
        "binding_name": "#shield_base_color_hovered",
        "binding_name_override": "#shield_base_color",
        "binding_condition": "always_when_visible"
      },
      {
        "binding_name": "#inventory_selected_banner_colors",
        "binding_name_override": "#banner_colors",
        "binding_condition": "always_when_visible"
      },
      {
        "binding_name": "#inventory_selected_banner_type",
        "binding_name_override": "#banner_type",
        "binding_condition": "always_when_visible"
      },
      {
        "binding_name": "#inventory_selected_decorated_pot_sherds",
        "binding_name_override": "#decorated_pot_sherds",
        "binding_condition": "always_when_visible"
      }
    ]
  },
  "inventory_selected_stack_size_text@global.empty_label": {
    "offset": [0, 1],
    "anchor_to": "bottom_right",
    "anchor_from": "bottom_right",
    "layer": 5000003,
    "shadow": true,
    "color": "$selected_item_stack_count_color",
    "text": "#inventory_selected_item_stack_count",
    "bindings": [{ "binding_name": "#inventory_selected_item_stack_count", "binding_condition": "always_when_visible" }]
  },
  "inventory_icon_panel@global.empty_panel": {
    "controls": [
      { "selected_item_icon@global.inventory_selected_icon": {} },
      { "selected_stack_size_text@global.inventory_selected_stack_size_text": {} },
      {
        "hover_text@global.hover_text": {
          "layer": 59,
          "bindings": [{ "binding_name": "#using_touch", "binding_name_override": "#visible" }]
        }
      }
    ]
  },
  "container_screen": {
    "type": "screen",
    "size": ["70%", "60%"],
    "cache_screen": true,
    "send_telemetry": false,
    "gamepad_cursor": true,
    "close_on_player_hurt": true,
    "$screen_content|default": "global.empty_panel",
    "$extra_screen_controls|default": [],
    "button_mappings": [
      {
        "from_button_id": "button.menu_cancel",
        "to_button_id": "button.menu_exit",
        "mapping_type": "global"
      },
      {
        "from_button_id": "button.menu_inventory_cancel",
        "to_button_id": "button.menu_exit",
        "mapping_type": "global"
      },
      {
        "from_button_id": "button.menu_up",
        "to_button_id": "button.menu_up",
        "mapping_type": "global",
        "scope": "view"
      },
      {
        "from_button_id": "button.menu_down",
        "to_button_id": "button.menu_down",
        "mapping_type": "global",
        "scope": "view"
      },
      {
        "from_button_id": "button.menu_left",
        "to_button_id": "button.menu_left",
        "mapping_type": "global",
        "scope": "view"
      },
      {
        "from_button_id": "button.menu_right",
        "to_button_id": "button.menu_right",
        "mapping_type": "global",
        "scope": "view"
      },
      {
        "from_button_id": "button.menu_select",
        "to_button_id": "button.cursor_drop_all",
        "mapping_type": "pressed"
      },
      {
        "from_button_id": "button.menu_secondary_select",
        "to_button_id": "button.cursor_drop_one",
        "mapping_type": "pressed"
      },
      {
        "from_button_id": "button.menu_ok",
        "to_button_id": "button.cursor_drop_all",
        "mapping_type": "pressed"
      },
      {
        "from_button_id": "button.controller_back",
        "to_button_id": "button.cursor_drop_all",
        "mapping_type": "pressed",
        "ignored": "(not $is_ps4)"
      },
      {
        "from_button_id": "button.controller_select",
        "to_button_id": "button.cursor_drop_one",
        "mapping_type": "pressed"
      },
      {
        "from_button_id": "button.controller_secondary_select",
        "to_button_id": "button.cursor_drop_all",
        "mapping_type": "pressed"
      },
      {
        "from_button_id": "button.controller_secondary_select_left",
        "to_button_id": "button.focus_left",
        "mapping_type": "global"
      },
      {
        "from_button_id": "button.controller_secondary_select_right",
        "to_button_id": "button.focus_right",
        "mapping_type": "global"
      }
    ],
    "controls": [
      {
        "screen_base_input_container": {
          "type": "input_panel",
          "hover_enabled": false,
          "prevent_touch_input": false,
          "ttsSectionContainer": true,
          "button_mappings": [
            {
              "from_button_id": "button.menu_select",
              "to_button_id": "button.container_reset_held",
              "mapping_type": "pressed"
            },
            {
              "from_button_id": "button.menu_secondary_select",
              "to_button_id": "button.container_reset_held",
              "mapping_type": "pressed"
            },
            {
              "from_button_id": "button.menu_ok",
              "to_button_id": "button.container_reset_held",
              "mapping_type": "pressed"
            },
            {
              "from_button_id": "button.arrow_down",
              "to_button_id": "button.arrow_key",
              "mapping_type": "global"
            },
            {
              "from_button_id": "button.arrow_left",
              "to_button_id": "button.arrow_key",
              "mapping_type": "global"
            },
            {
              "from_button_id": "button.arrow_right",
              "to_button_id": "button.arrow_key",
              "mapping_type": "global"
            },
            {
              "from_button_id": "button.controller_back",
              "to_button_id": "button.container_reset_held",
              "mapping_type": "pressed",
              "ignored": "(not $is_ps4)"
            },
            {
              "from_button_id": "button.controller_select",
              "to_button_id": "button.container_reset_held",
              "mapping_type": "pressed"
            },
            {
              "from_button_id": "button.controller_secondary_select",
              "to_button_id": "button.container_reset_held",
              "mapping_type": "pressed"
            },
            {
              "from_button_id": "button.turn_down",
              "to_button_id": "button.scroll_down",
              "mapping_type": "global"
            },
            {
              "from_button_id": "button.turn_left",
              "to_button_id": "button.scroll_left",
              "mapping_type": "global"
            },
            {
              "from_button_id": "button.turn_right",
              "to_button_id": "button.scroll_right",
              "mapping_type": "global"
            },
            {
              "from_button_id": "button.inventory_left",
              "to_button_id": "button.inventory_left",
              "mapping_type": "global"
            },
            {
              "from_button_id": "button.inventory_right",
              "to_button_id": "button.inventory_right",
              "mapping_type": "global"
            },
            { "from_button_id": "button.return", "to_button_id": "button.return", "mapping_type": "global" },
            { "from_button_id": "button.arrow_up", "to_button_id": "button.arrow_key", "mapping_type": "global" },
            { "from_button_id": "button.turn_up", "to_button_id": "button.scroll_up", "mapping_type": "global" },
            { "from_button_id": "button.slot0", "to_button_id": "button.slot_0", "mapping_type": "global" },
            { "from_button_id": "button.slot1", "to_button_id": "button.slot_1", "mapping_type": "global" },
            { "from_button_id": "button.slot2", "to_button_id": "button.slot_2", "mapping_type": "global" },
            { "from_button_id": "button.slot3", "to_button_id": "button.slot_3", "mapping_type": "global" },
            { "from_button_id": "button.slot4", "to_button_id": "button.slot_4", "mapping_type": "global" },
            { "from_button_id": "button.slot5", "to_button_id": "button.slot_5", "mapping_type": "global" },
            { "from_button_id": "button.slot6", "to_button_id": "button.slot_6", "mapping_type": "global" },
            { "from_button_id": "button.slot7", "to_button_id": "button.slot_7", "mapping_type": "global" },
            { "from_button_id": "button.slot8", "to_button_id": "button.slot_8", "mapping_type": "global" },
            { "from_button_id": "button.slot9", "to_button_id": "button.slot_9", "mapping_type": "global" }
          ],
          "controls": [
            { "selected_item_details_factory@selected_item.selected_item_details_factory": {} },
            { "stack_splitting_overlay@stack_splitting_overlay.stack_splitting_overlay": {} },
            { "extra_content@global.empty_panel": { "controls": "$extra_screen_controls" } },
            {
              "screen_background@screen_content.screen_background": {
                "layer": 2
              }
            },
            {
              "safezone_screen_matrix@safezone.screen_holder_safezone": {
                "layer": 2
              }
            }
          ]
        }
      }
    ]
  },
  "inventory_selected_icon_button": {
    "type": "button",
    "anchor_from": "center",
    "anchor_to": "center",
    "locked_control": "",
    "default_control": "default",
    "hover_control": "hover",
    "pressed_control": "pressed",
    "layer": -10,
    "size": [16, 16],
    "follows_cursor": true,
    "sound_name": "random.click",
    "sound_volume": 1.0,
    "sound_pitch": 1.0,
    "always_handle_pointer": true,
    "$durability_bar_required|default": true,
    "$storage_bar_required|default": true,
    "controls": [
      { "default@global.inventory_icon_panel": {} },
      { "pressed@global.inventory_icon_panel": {} },
      { "hover@global.inventory_icon_panel": {} },
      { "durability_bar_grabbed@global.durability_bar_grabbed": {} },
      { "storage_bar_grabbed@global.storage_bar_grabbed": {} }
    ]
  },
  "hover_text": {
    "$hover_text_max_width|default": 0,
    "type": "custom",
    "renderer": "hover_text_renderer",
    "hover_text_max_width": "$hover_text_max_width",
    "layer": 5000,
    "allow_clipping": false,
    "$hover_text|default": "#hover_text",
    "bindings": [
      {
        "binding_type": "global",
        "binding_name": "$hover_text",
        "binding_name_override": "#hover_text",
        "binding_condition": "always"
      }
    ]
  },
  "root_panel": {
    "type": "input_panel",
    "size": "$size",
    "$size": [176, 166],
    "anchor_from": "center",
    "anchor_to": "center",
    "button_mappings": [
      {
        "from_button_id": "button.menu_select",
        "to_button_id": "button.container_reset_held",
        "mapping_type": "pressed"
      },
      {
        "from_button_id": "button.menu_secondary_select",
        "to_button_id": "button.container_reset_held",
        "mapping_type": "pressed"
      },
      {
        "from_button_id": "button.menu_ok",
        "to_button_id": "button.container_reset_held",
        "mapping_type": "pressed"
      },
      { "from_button_id": "button.return", "to_button_id": "button.return", "mapping_type": "global" },
      { "from_button_id": "button.arrow_up", "to_button_id": "button.arrow_key", "mapping_type": "global" },
      {
        "from_button_id": "button.arrow_down",
        "to_button_id": "button.arrow_key",
        "mapping_type": "global"
      },
      {
        "from_button_id": "button.arrow_left",
        "to_button_id": "button.arrow_key",
        "mapping_type": "global"
      },
      {
        "from_button_id": "button.arrow_right",
        "to_button_id": "button.arrow_key",
        "mapping_type": "global"
      },
      {
        "from_button_id": "button.controller_back",
        "to_button_id": "button.container_reset_held",
        "mapping_type": "pressed",
        "ignored": "(not $is_ps4)"
      },
      {
        "from_button_id": "button.controller_select",
        "to_button_id": "button.container_reset_held",
        "mapping_type": "pressed"
      },
      {
        "from_button_id": "button.controller_secondary_select",
        "to_button_id": "button.container_reset_held",
        "mapping_type": "pressed"
      },
      { "from_button_id": "button.turn_up", "to_button_id": "button.scroll_up", "mapping_type": "global" },
      {
        "from_button_id": "button.turn_down",
        "to_button_id": "button.scroll_down",
        "mapping_type": "global"
      },
      {
        "from_button_id": "button.turn_left",
        "to_button_id": "button.scroll_left",
        "mapping_type": "global"
      },
      {
        "from_button_id": "button.turn_right",
        "to_button_id": "button.scroll_right",
        "mapping_type": "global"
      },
      {
        "from_button_id": "button.inventory_left",
        "to_button_id": "button.inventory_left",
        "mapping_type": "global"
      },
      {
        "from_button_id": "button.inventory_right",
        "to_button_id": "button.inventory_right",
        "mapping_type": "global"
      }
    ]
  },
  "empty_panel": { "type": "panel" },
  "empty_label": { "type": "label" },
  "empty_image": { "type": "image" },
  "empty_stack": { "type": "stack_panel" },
  "custom_renderer": { "type": "custom", "renderer": "$type" },
  "container_item@jc_container_item.container_item": {
    "$item_collection": "$item_collection",
    "size": "$cell_size",
    "$cell_size": [18, 18]
  },
  "durability_bar_grabbed@global.custom_renderer": {
    "$type": "progress_bar_renderer",
    "layer": 16,
    "offset": [-3, -4],
    "anchor_from": "bottom_right",
    "anchor_to": "bottom_right",
    "size": [12, 1],
    "property_bag": {
      "drop_shadow": true,
      "is_durability": true,
      "round_value": true
    },
    "bindings": [
      {
        "binding_name": "#selected_item_durability_visible",
        "binding_name_override": "#touch_progress_bar_visible",
        "binding_condition": "always_when_visible"
      },
      {
        "binding_name": "#selected_item_durability_total_amount",
        "binding_name_override": "#progress_bar_total_amount",
        "binding_condition": "always_when_visible"
      },
      {
        "binding_name": "#selected_item_durability_current_amount",
        "binding_name_override": "#progress_bar_current_amount",
        "binding_condition": "always_when_visible"
      }
    ]
  },
  "storage_bar_grabbed@global.custom_renderer": {
    "$type": "progress_bar_renderer",
    "offset": [-3, -4],
    "anchor_from": "bottom_right",
    "anchor_to": "bottom_right",
    "size": [12, 1],
    "layer": 16,
    "primary_color": [0.4, 0.4, 1.0, 1.0],
    "full_storage_color": [1.0, 0.4, 0.4],
    "property_bag": {
      "drop_shadow": true,
      "is_storage_bar": true
    },
    "bindings": [
      {
        "binding_name": "#selected_item_storage_visible",
        "binding_name_override": "#progress_bar_visible",
        "binding_condition": "always_when_visible"
      },
      {
        "binding_name": "#selected_item_storage_total_amount",
        "binding_name_override": "#progress_bar_total_amount",
        "binding_condition": "always_when_visible"
      },
      {
        "binding_name": "#selected_item_storage_current_amount",
        "binding_name_override": "#progress_bar_current_amount",
        "binding_condition": "always_when_visible"
      }
    ]
  }
}
