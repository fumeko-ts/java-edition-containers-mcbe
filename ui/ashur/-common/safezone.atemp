{
  "namespace": "safezone",
  "safezone_buffer@global.empty_panel": {
    "bindings": [
      {
        "binding_name": "$safezone_binding_name",
        "binding_name_override": "#visible"
      }
    ]
  },

  "top_safezone_vertical_buffer@safezone.safezone_buffer": { "size": "$top_vertical_safezone_size" },
  "bottom_safezone_vertical_buffer@safezone.safezone_buffer": { "size": "$bottom_vertical_safezone_size" },
  "left_safezone_horizontal_buffer@safezone.safezone_buffer": { "size": "$left_horizontal_safezone_size" },
  "right_safezone_horizontal_buffer@safezone.safezone_buffer": { "size": "$right_horizontal_safezone_size" },

  "screen_holder_safezone@global.empty_stack": {
    "orientation": "horizontal",
    "size": ["100%", "100%"],
    "controls": [
      { "outer_left@safezone.left_safezone_horizontal_buffer": { "$safezone_binding_name": "#safezone_outer_left" } },
      {
        "inner_left@safezone.left_safezone_horizontal_buffer": {
          "$safezone_binding_name": "#safezone_inner_left",
          "anchor_from": "top_left",
          "anchor_to": "top_left"
        }
      },
      {
        "safezone_inner_matrix@global.empty_stack": {
          "size": ["fill", "100%"],
          "orientation": "vertical",
          "controls": [
            { "outer_top@safezone.top_safezone_vertical_buffer": { "$safezone_binding_name": "#safezone_outer_top" } },
            { "inner_top@safezone.top_safezone_vertical_buffer": { "$safezone_binding_name": "#safezone_inner_top" } },
            {
              "container_content@global.empty_panel": {
                "size": ["100%", "fill"],
                "controls": [
                  {
                    "root_screen_panel@$screen_content": {
                      "$is_crafting_screen|default": "($screen_content = 'crafting_screen.screen_base')",
                      "$is_inventory_screen|default": "($screen_content = 'inventory_screen.screen_base')",
                      "$is_anvil_screen|default": "($screen_content = 'anvil_screen.anvil_panel')",
                      "$is_beacon_screen|default": "($screen_content = 'beacon_screen.beacon_panel')",
                      "$is_blast_furnace_screen|default": "($screen_content = 'blast_furnace_screen.blast_furnace_panel')",
                      "$is_brewing_stand_screen|default": "($screen_content = 'brewing_stand_screen.brewing_panel')",
                      "$is_cartography_screen|default": "($screen_content = 'cartography_screen.cartography_panel')",
                      "$is_small_chest_screen|default": "($screen_content = 'small_chest_screen.small_chest')",
                      "$is_double_chest_screen|default": "($screen_content = 'double_chest_screen.double_chest')",
                      "$is_ender_chest_screen|default": "($screen_content = 'ender_chest_screen.ender_chest')",
                      "$is_shulker_screen|default": "($screen_content = 'shulker_screen.shulker_box')",
                      "$is_barrel_screen|default": "($screen_content = 'barrel_screen.barrel')",
                      "$is_enchanting_screen|default": "($screen_content = 'enchanting_screen.enchanting_panel')",
                      "$is_furnace_screen|default": "($screen_content = 'furnace_screen.furnace_panel')",
                      "$is_grindstone_screen|default": "($screen_content = 'grindstone_screen.grindstone_panel')",
                      "$is_mount_screen|default": "($screen_content = 'horse_screen.horse_panel')",
                      "$is_loom_screen|default": "($screen_content = 'loom_screen.loom_panel')",
                      "$is_crafter_screen|default": "($screen_content = 'crafter_screen.panel_crafter')",
                      "$is_dropper_screen|default": "($screen_content = 'dropper_screen.dropper_panel')",
                      "$is_dispenser_screen|default": "($screen_content = 'dispenser_screen.dispenser_panel')",
                      "$is_hopper_screen|default": "($screen_content = 'hopper_screen.hopper_panel')",
                      "$is_smithing_table_screen|default": "($screen_content = 'smithing_table_screen.smithing_table_panel' )",
                      "$is_smoker_screen|default": "($screen_content = 'smoker_screen.smoker_panel')",
                      "$is_stonecutter_screen|default": "($screen_content = 'stonecutter_screen.stonecutter_panel')",
                      "$is_trading_screen|default": "($screen_content = 'trading_screen.screen_panel')"
                    }
                  },
                  {
                    "bundle_tooltip_wrapper@global.empty_panel": {
                      "size": ["100%", "100%"],
                      "controls": [
                        {
                          "bundle_cursor_tooltip@global.custom_renderer": {
                            "$type": "bundle_tooltip_renderer",
                            "size": ["100%c", "100%c - 26px"],
                            "layer": 20,
                            "controls": [{ "tooltip@bundle.bundle_tooltip": {} }],
                            "bindings": [
                              {
                                "binding_name": "#show_bundle_tooltip_hover",
                                "binding_name_override": "#visible"
                              }
                            ]
                          }
                        },
                        {
                          "bundle_touch_tooltip@bundle.bundle_tooltip": {
                            "offset": [0, "-36px"],
                            "anchor_from": "bottom_middle",
                            "anchor_to": "bottom_middle",
                            "bindings": [
                              {
                                "binding_name": "#show_bundle_tooltip_pocket",
                                "binding_name_override": "#visible"
                              }
                            ]
                          }
                        }
                      ]
                    }
                  }
                ]
              }
            },
            { "inner_bottom@safezone.bottom_safezone_vertical_buffer": {"$safezone_binding_name": "#safezone_inner_bottom"} },
            { "outer_bottom@safezone.bottom_safezone_vertical_buffer": {"$safezone_binding_name": "#safezone_outer_bottom"} }
          ]
        }
      },
      { "inner_right@safezone.right_safezone_horizontal_buffer": { "$safezone_binding_name": "#safezone_inner_right" } },
      { "outer_right@safezone.right_safezone_horizontal_buffer": { "$safezone_binding_name": "#safezone_outer_right" } }
    ]
  }
  /*
  "bundle_pc_factory_collection": {
    "type": "collection_panel",
    "collection_name": "bundle_renderer_collection",
    "size": ["100%", "100%"],
    "factory": {
      "control_ids": {
        "bundle_pc": "safezone.bundle_cursor_tooltip"
      },
      "name": "bundle_renderer_factory_collection",
