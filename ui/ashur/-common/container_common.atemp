{
  "namespace": "container_common",
  "container_details@global.root_panel": {
    "$size": ["100%", "100%"],
    "anchor_to": "center",
    "anchor_from": "center",
    "layer": 5,
    "controls": [
      { "screen@global.empty_panel": { "size": ["100%", "100%"], "controls": "$screen_controls" } },
      {
        "item_flying_selected": {
          "type": "button",
          "anchor_from": "center",
          "anchor_to": "center",
          "layer": -10,
          "size": [16, 16],
          "follows_cursor": true,
          "always_handle_pointer": true,
          "controls": [
            { "1@container_common.held_flying_renderer": {} },
            { "2@global.durability_bar_grabbed": { "layer": 61 } },
            { "3@global.storage_bar_grabbed": { "layer": 61 } }
          ]
        }
      },
      {
        "controller_pointer": {
          "type": "button",
          "visible": false,
          "anchor_from": "center",
          "anchor_to": "center",
          "layer": -10,
          "size": [16, 16],
          "follows_cursor": true,
          "always_handle_pointer": true,
          "controls": [
            {
              "gamepad_cursor_image@global.empty_image": {
                "texture": "textures/ui/pointer",
                "size": [14, 14],
                "layer": 60,
                "follows_cursor": true,

                "bindings": [
                  {
                    "binding_name": "#gamepad_cursor_visible",
                    "binding_name_override": "#visible",
                    "binding_condition": "always"
                  }
                ]
              }
            }
          ]
        }
      }
    ]
  },
  "held_flying_renderer@global.empty_panel": {
    "size": [18, 18],
    "controls": [
      {
        "renderer@global.inventory_selected_icon": {}
      },
      {
        "stack_text@global.empty_label": {
          "anchor_to": "bottom_right",
          "anchor_from": "bottom_right",
          "layer": 53,
          "shadow": true,
          "offset": [-1, -1],
          "color": "$selected_item_stack_count_color",
          "text": "#inventory_selected_item_stack_count",
          "bindings": [
            { "binding_name": "#inventory_selected_item_stack_count", "binding_condition": "always_when_visible" }
          ]
        }
      },
      {
        "hover_text@common.hover_text": {
          "layer": 59,
          "bindings": [{ "binding_name": "#using_touch", "binding_name_override": "#visible" }]
        }
      }
    ]
  }
}
