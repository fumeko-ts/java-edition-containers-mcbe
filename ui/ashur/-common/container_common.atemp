{
  "namespace": "container_common",
  "common_toggle@common_toggles.light_text_toggle": {
    "$button_text": "",
    "$toggle_trigger_name": "+ashur_",
    "$toggle_name": "$toggle_trigger_name",
    "$toggle_view_binding_name": "$toggle_trigger_name",
    "offset": [ 0, -20 ],
    "size": [ 25, 25 ]
  },
  "item_remover@common.button": {
    "size": [ 16, 16 ],
    "sound_volume": 0.0,
    "sound_pitch": 0.0,
    "default_control": "default",
    "hover_control": "hover",
    "pressed_control": "hover",
    "controls": [
      {
        "hover": {
          "type": "panel",
          "size": [ 16, 16 ],
          "layer": 14,
          "controls": [
            {"highlight@common.highlight_slot": {}},
            {"tooltip@common.hover_text": {"layer": 100, "property_bag": {"#hover_text": "destroy item"}}}
          ]
        }
      },
      {"default@global.empty_image": {}}
    ],
    "button_mappings": [
      {
        "from_button_id": "button.menu_select",
        "to_button_id": "button.destroy_selection",
        "mapping_type": "pressed"
      },
      {
        "from_button_id": "button.menu_ok",
        "to_button_id": "button.destroy_selection",
        "mapping_type": "pressed"
      },
      {
        "from_button_id": "button.menu_secondary_select",
        "to_button_id": "button.destroy_selection",
        "mapping_type": "pressed"
      },
      {
        "from_button_id": "button.menu_auto_place",
        "to_button_id": "button.menu_clear",
        "mapping_type": "pressed"
      }
    ]
  }
}