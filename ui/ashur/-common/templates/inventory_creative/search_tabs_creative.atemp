{
  "namespace": "search_tabs_creative",
  "base_panel@global.empty_panel": {
    "$is_creative_survival_tab": true,
    "size": [ 195, 136 ],
    "anchor_to": "center",
    "anchor_from": "center",
    "controls": [
      {"inventory@search_tabs_creative.survival_tab_base": {}}
    ]
  },
  "survival_tab_base@screen_content.creative_inventory_search": {
    "anchor_to": "center",
    "anchor_from": "center",
    "size": [ 195, 136 ],
    "controls": [
      {
        "stack_1@global.empty_stack_panel": {
          "orientation": "horizontal",
          "size": [ 152, 25 ],
          "anchor_to": "bottom_left",
          "anchor_from": "bottom_left",
          "controls": [
            {"buffer_1": {"type": "panel", "size": [ 8, "default" ]}},
            {
              "stack@global.empty_stack_panel": {
                "orientation": "vertical",
                "size": [ 144, 25 ],
                "controls": [
                  {"hotbar@global.hotbar": {}},
                  {"buffer_2": {"type": "panel", "size": [ "default", 9 ]}}
                ]
              }
            }
          ]
        }
      }
    ]
  }
}