{
  "namespace": "cell_template",
  "base": {
    "type": "image",
    "size": [ 25, 25 ],
    "offset": [ 2, 1 ],
    "layer": 4,
    "$is_hover|default": false,
    "controls": [
      {
        "hover_text@global.hover_text": {"property_bag": {"#hover_text": "$label"}, "layer": 9, "ignored": "($is_hover = false)"}
      },
      {
        "hover@common.highlight_slot": {
          "ignored": "($is_hover = false)",
          "layer": 5,
          "anchor_to": "center",
          "anchor_from": "center",
          "$white_highlight_slot_offset": [ -0.4, -0.6 ],
          "$white_highlight_slot_size": [ 20, 20 ],
          "size": [ 20, 20 ]
        }
      },
      {
        "item@screen_content.image_element": {
          "texture": "$item_slot_cell_texture",
          "$item_slot_cell_texture": "('textures/atemp/ui/' + $item)",
          "anchor_to": "center",
          "offset": [ -0.6, 0 ],
          "anchor_from": "center",
          "size": [ 16, 16 ],
          "layer": 6
        }
      }
    ]
  },
  "default@cell_template.base": {
    "$is_hover": false,
    "texture": "assets/minecraft/textures/gui/sprites/recipe_book/slot_craftable.png"
  },
  "hover@cell_template.base": {
    "$is_hover": true,
    "texture": "assets/minecraft/textures/gui/sprites/recipe_book/slot_craftable.png"
  },
  "pressed@cell_template.base": {
    "$is_hover": false,
    "texture": "assets/minecraft/textures/gui/sprites/recipe_book/slot_craftable.png"
  }
}