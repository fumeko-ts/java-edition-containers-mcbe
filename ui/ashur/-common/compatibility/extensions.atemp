  "campatibility": {// this is a example use case
    "type": "panel",
    "size": ["100%", "100%"],
    "controls": [
      {
        "element@global.empty_image": {
          "ignored": true,
          "texture": "textures/ui/white",
          "nineslice_size": 2,
          "size": [24, 24],
          "layer": 50,
          "offset": [5, 0],
          "anchor_to": "bottom_left",
          "anchor_from": "bottom_right"
        }
      }
    ]
  }
}