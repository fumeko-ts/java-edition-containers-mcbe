{
  "namespace": "jc-extensions",

  // screens
  "anvil_screen@jc-extensions.compatability": {},
  "blast_furnace_screen@jc-extensions.compatability": {},
  "brewing_stand_screen@jc-extensions.compatability": {},
  "cartography_screen@jc-extensions.compatability": {},
  "enchanting_screen@jc-extensions.compatability": {},
  "furnace_screen@jc-extensions.compatability": {},
  "grindstone_screen@jc-extensions.compatability": {},
  "loom_screen@jc-extensions.compatability": {},
  "mount_screen@jc-extensions.compatability": {},
  "smithing_table_screen@jc-extensions.compatability": {},
  "smoker_screen@jc-extensions.compatability": {},
  "stonecutter_screen@jc-extensions.compatability": {},
  "trading_screen@jc-extensions.compatability": {},
  "beacon_screen@jc-extensions.compatability": {},

  //inventorys
  "inventory_screen@jc-extensions.compatability_inventory_contents": {},
  "crafting_screen@jc-extensions.compatability_inventory_contents": {},

  "creative_inventory@jc-extensions.compatability_inventory_contents": {},

  // redstone blocks
  "crafter_screen@jc-extensions.compatability": {},
  "dispenser_screen@jc-extensions.compatability": {},
  "dropper_screen@jc-extensions.compatability": {},
  "hopper_screen@jc-extensions.compatability": {},

  // container blocks
  "barrel_screen@jc-extensions.compatability_container_contents": {},
  "double_chest_screen@jc-extensions.compatability_container_contents": {},
  "ender_chest_screen@jc-extensions.compatability_container_contents": {},
  "shulker_screen@jc-extensions.compatability_container_contents": {},
  "small_chest_screen@jc-extensions.compatability_container_contents": {},

  //extended defs
  "compatability": {
    "type": "panel",
    "$compatability_content|default": "global.empty_panel",
    "$is_crafting_screen|default": "($screen_content = 'crafting_screen.screen_base')",
    "$is_inventory_screen|default": "($screen_content = 'inventory_screen.screen_base')",
    "controls": [
      {
        "$compatability_content@$compatability_content": {}
      }
    ]
  },

  "compatability_container_contents@jc-extensions.compatability": {
    // "variables": {
    //   "requires": "$is_déesse_ui_pack",
    //   "$compatability_content|default": "Déesse_UI_Pack.chest_contents"
    // }
  },

  //inventory and crafting screens
  "compatability_inventory_contents@jc-extensions.compatability_container_contents": {
    // "variables": {
    //   "requires": "$is_déesse_ui_pack",
    //   "$compatability_content|default": "Déesse_UI_Pack.inventory_content"
    // }
  }
}
