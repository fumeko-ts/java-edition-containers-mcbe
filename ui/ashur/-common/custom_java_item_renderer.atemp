{
  "namespace": "java_item_renderer",
  "custom_item_renderer@global.empty_panel": {
    "size": [ 16, 16 ],
    "$selected_item|default": false,
    "controls": [
      {
        "glass_panes": {
          "type": "image",
          "size": [ 16, 16 ],
          "ignored": "(not $jc:dev)",
          "allow_debug_missing_texture": false,
          "property_bag": {
            "#item_102": "$glass_pane",
            "#item_160": "$white_pane",
            "#item_-650": "$light_grey_pane",
            "#item_-649": "$grey_pane",
            "#item_-657": "$black_pane",
            "#item_-654": "$brown_pane",
            "#item_-656": "$red_pane",
            "#item_-643": "$orange_pane",
            "#item_-646": "$yellow_pane",
            "#item_-647": "$lime_pane",
            "#item_-655": "$green_pane",
            "#item_-651": "$cyan_pane",
            "#item_-645": "$light_blue_pane",
            "#item_-653": "$blue_pane",
            "#item_-652": "$purple_pane",
            "#item_-644": "$magenta_pane",
            "#item_-648": "$pink_pane"
          },
          "bindings": [
            {
              "binding_type": "collection",
              "ignored": "$selected_item",
              "binding_collection_name": "$item_collection",
              "binding_name": "#item_id_aux"
            },
            {
              "binding_name": "#inventory_selected_item",
              "binding_name_override": "#item_id_aux",
              "ignored": "(not $selected_item)",
              "binding_condition": "always"
            },
            {
              "binding_type": "view",
              "source_property_name": "('textures/java_items/item_' + ('#item_' + (#item_id_aux / 65536)))",
              "target_property_name": "#texture",
              "binding_condition": "always"
            }
          ]
        }
      },
      {
        "item@common.item_renderer": {
          "property_bag": {
            "#item_102": "$glass_pane",
            "#item_160": "$white_pane",
            "#item_-650": "$light_grey_pane",
            "#item_-649": "$grey_pane",
            "#item_-657": "$black_pane",
            "#item_-654": "$brown_pane",
            "#item_-656": "$red_pane",
            "#item_-643": "$orange_pane",
            "#item_-646": "$yellow_pane",
            "#item_-647": "$lime_pane",
            "#item_-655": "$green_pane",
            "#item_-651": "$cyan_pane",
            "#item_-645": "$light_blue_pane",
            "#item_-653": "$blue_pane",
            "#item_-652": "$purple_pane",
            "#item_-644": "$magenta_pane",
            "#item_-648": "$pink_pane"
          },
          "bindings": [
            {
              "binding_name": "#inventory_selected_item_charged_item",
              "binding_name_override": "#charged_item",
              "ignored": "(not $selected_item)",
              "binding_condition": "always_when_visible"
            },
            {
              "binding_name": "#inventory_selected_item_color",
              "binding_name_override": "#item_custom_color",
              "ignored": "(not $selected_item)",
              "binding_condition": "always_when_visible"
            },
            {
              "binding_name": "#inventory_selected_armor_trim_material",
              "binding_name_override": "#armor_trim_material",
              "ignored": "(not $selected_item)",
              "binding_condition": "always_when_visible"
            },
            {
              "binding_name": "#inventory_selected_banner_patterns",
              "binding_name_override": "#banner_patterns",
              "ignored": "(not $selected_item)",
              "binding_condition": "always_when_visible"
            },
            {
              "binding_name": "#shield_base_color_hovered",
              "binding_name_override": "#shield_base_color",
              "ignored": "(not $selected_item)",
              "binding_condition": "always_when_visible"
            },
            {
              "binding_name": "#inventory_selected_banner_colors",
              "binding_name_override": "#banner_colors",
              "ignored": "(not $selected_item)",
              "binding_condition": "always_when_visible"
            },
            {
              "binding_name": "#inventory_selected_banner_type",
              "binding_name_override": "#banner_type",
              "ignored": "(not $selected_item)",
              "binding_condition": "always_when_visible"
            },
            {
              "binding_name": "#inventory_selected_decorated_pot_sherds",
              "binding_name_override": "#decorated_pot_sherds",
              "ignored": "(not $selected_item)",
              "binding_condition": "always_when_visible"
            },
            {
              "binding_name": "#inventory_selected_item",
              "binding_name_override": "#item_id_aux",
              "ignored": "(not $selected_item)",
              "binding_condition": "always"
            },
            {
              "binding_type": "collection",
              "ignored": "$selected_item",
              "binding_collection_name": "$item_collection",
              "binding_name": "#item_id_aux"
            },
            {
              "binding_type": "view",
              "source_property_name": "(#item_id_aux / 65536)",
              "target_property_name": "#item",
              "ignored": "(not $jc:dev)",
              "binding_condition": "visible"
            },
            {
              "binding_type": "view",
              "ignored": "(not $jc:dev)",
              "source_property_name": "(not ((#item = #item_102) or (#item = #item_160) or (#item = #item_-650) or (#item = #item_-649) or (#item = #item_-657) or (#item = #item_-654) or (#item = #item_-656) or (#item = #item_-643) or (#item = #item_-646) or (#item = #item_-647) or (#item = #item_-655) or (#item = #item_-651) or (#item = #item_-645) or (#item = #item_-653) or (#item = #item_-652) or (#item = #item_-644) or (#item = #item_-648)))",
              "target_property_name": "#visible",
              "binding_condition": "visible"
            }
          ]
        }
      }
    ]
  }
}