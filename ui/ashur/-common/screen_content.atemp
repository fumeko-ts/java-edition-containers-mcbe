{
  "namespace": "screen_content",
  "container_base@global.root_panel": {
    "size": "$size",
    "$size": [ 176, 166 ],
    "variables": [
      {"requires": "($anvil_screen = true)", "$container|default": "anvil"},
      {"requires": "($barrel_screen = true)", "$container|default": "barrel"},
      {"requires": "($beacon_screen = true)", "$container|default": "beacon", "$size": [ 230, 219 ]},
      {"requires": "($blast_furnace_screen = true)", "$container|default": "blast_furnace"},
      {"requires": "($brewing_stand_screen = true)", "$container|default": "brewing_stand"},
      {"requires": "($cartography_screen = true)", "$container|default": "cartography"},
      {"requires": "($crafting_screen = true)", "$container|default": "crafting"},
      {"requires": "($crafter_screen = true)", "$container|default": "crafter"},
      {"requires": "($dispenser_screen = true)", "$container|default": "dispenser"},
      {"requires": "($enchanting_screen = true)", "$container|default": "enchanting"},
      {"requires": "($furnace_screen = true)", "$container|default": "furnace"},
      {
        "requires": "($double_chest_container = true)",
        "$container|default": "double_chest",
        "$size": [ 176, 222 ]
      },
      {"requires": "($grindstone_screen = true)", "$container|default": "grindstone"},
      {"requires": "($hopper_screen = true)", "$container|default": "hopper", "$size": [ 176, 133 ]},
      {"requires": "($horse_screen = true)", "$container|default": "horse"},
      {"requires": "($loom_screen = true)", "$container|default": "loom"},
      {"requires": "($shulker_screen = true)", "$container|default": "shulker_box"},
      {"requires": "($smithing_screen = true)", "$container|default": "smithing"},
      {"requires": "($smoker_screen = true)", "$container|default": "smoker"},
      {"requires": "($stonecutter_screen = true)", "$container|default": "stonecutter"},
      {"requires": "($main_trade_screen = true)", "$container|default": "trade", "$size": [ 276, 166 ]},
      {"requires": "($inventory_screen = true)", "$container|default": "inventory"}
    ],
    "controls": [
      {
        "compact_close@common.close_button": {
          "layer": 20,
          "size": [ 15, 7 ],
          "$close_button_panel_size|default": [ 15, 7 ],
          "controls": [
            {
              "default@common.close_button_panel": {"$close_button_texture": "textures/ui/close_button_default_compact"}
            },
            {
              "hover@common.close_button_panel": {"$close_button_texture": "textures/ui/close_button_hover_compact"}
            },
            {
              "pressed@common.close_button_panel": {"$close_button_texture": "textures/ui/close_button_pressed_compact"}
            }
          ],
          "ignored": "($Exit_panel_enabled = false)"
        }
      },
      {"all_misc@$container": {}}
    ]
  },
  "compact_close_button@close_button": {},
  "label": {
    "type": "label",
    "offset": "$text_offset",
    "$text_offset": [ 0, 0 ],
    "anchor_from": "top_left",
    "anchor_to": "top_left",
    "text": "$container_title",
    "size": [ "90%", "default" ],
    "color": "$title_text_color",
    "layer": 20
  },
  "image_element": {"type": "image", "grayscale": true, "alpha": 1},
  "recipe_book@image_element": {
    "texture": "assets/minecraft/textures/gui/recipe_book",
    "size": [ 147, 166 ],
    "uv_size": [ 147, 166 ],
    "uv": [ 1, 1 ],
    "offset": [ 1, 0 ],
    "layer": 9
  },
  "creative_inventory@image_element": {
    "uv_size": [ 195, 136 ],
    "texture": "assets/minecraft/textures/gui/container/creative_inventory/tab_inventory.png"
  },
  "creative_inventory_misc@image_element": {
    "uv_size": [ 195, 136 ],
    "texture": "assets/minecraft/textures/gui/container/creative_inventory/tab_items.png"
  },
  "creative_inventory_search@image_element": {
    "uv_size": [ 195, 136 ],
    "texture": "assets/minecraft/textures/gui/container/creative_inventory/tab_item_search.png"
  },
  "anvil@image_element": {"uv_size": [ 176, 166 ], "texture": "assets/minecraft/textures/gui/container/anvil"},
  "beacon@image_element": {
    "uv_size": [ 230, 219 ],
    "texture": "assets/minecraft/textures/gui/container/beacon",
    "offset": [ -1, 0 ]
  },
  "blast_furnace@image_element": {"uv_size": [ 176, 166 ], "texture": "assets/minecraft/textures/gui/container/blast_furnace"},
  "brewing_stand@image_element": {
    "uv_size": [ 176, 166 ],
    "texture": "assets/minecraft/textures/gui/container/brewing_stand",
    "offset": [ 0, 3 ]
  },
  "cartography@image_element": {
    "uv_size": [ 176, 166 ],
    "texture": "assets/minecraft/textures/gui/container/cartography_table",
    "offset": [ 0, 3 ]
  },
  "crafter@image_element": {
    "uv_size": [ 176, 166 ],
    "texture": "assets/minecraft/textures/gui/container/crafter",
    "offset": [ 0, 4.4 ]
  },
  "dispenser@image_element": {"uv_size": [ 176, 166 ], "texture": "assets/minecraft/textures/gui/container/dispenser"},
  "enchanting@image_element": {
    "uv_size": [ 176, 166 ],
    "texture": "assets/minecraft/textures/gui/container/enchanting_table",
    "offset": [ 0, 3 ]
  },
  "furnace@image_element": {"uv_size": [ 176, 166 ], "texture": "assets/minecraft/textures/gui/container/furnace"},
  "double_chest@image_element": {
    "uv_size": [ 176, 222 ],
    "texture": "assets/minecraft/textures/gui/container/generic_54",
    "offset": [ 0, 1 ]
  },
  "grindstone@image_element": {
    "uv_size": [ 176, 166 ],
    "texture": "assets/minecraft/textures/gui/container/grindstone",
    "offset": [ 0, 3 ]
  },
  "hopper@image_element": {"uv_size": [ 176, 133 ], "texture": "assets/minecraft/textures/gui/container/hopper"},
  "horse@image_element": {"uv_size": [ 176, 166 ], "texture": "assets/minecraft/textures/gui/container/horse"},
  "horse_inventory@image_element": {"uv_size": [ 176, 166 ], "texture": "assets/minecraft/textures/gui/container/horse"},
  "loom@image_element": {
    "uv_size": [ 176, 166 ],
    "texture": "assets/minecraft/textures/gui/container/loom",
    "offset": [ 0, 4.4 ]
  },
  "shulker_box@image_element": {"uv_size": [ 176, 166 ], "texture": "assets/minecraft/textures/gui/container/shulker_box"},
  "smithing@image_element": {"uv_size": [ 176, 166 ], "texture": "assets/minecraft/textures/gui/container/smithing"},
  "smoker@image_element": {"uv_size": [ 176, 166 ], "texture": "assets/minecraft/textures/gui/container/smoker"},
  "stonecutter@image_element": {
    "uv_size": [ 176, 166 ],
    "texture": "assets/minecraft/textures/gui/container/stonecutter",
    "offset": [ 0, 2 ]
  },
  "trade@image_element": {
    "uv_size": [ 276, 166 ],
    "texture": "assets/minecraft/textures/gui/container/villager",
    "offset": [ -70, 0 ]
  },
  "edit_box_indent": {
    "type": "image",
    "texture": "assets/minecraft/textures/gui/sprites/container/anvil/text_field_disabled"
  },
  "edit_box_indent_hover": {"type": "image", "texture": "assets/minecraft/textures/gui/sprites/container/anvil/text_field"},
  "armor_overlay_helmet@crafting.armor_overlay": {"alpha": 0.6, "texture": "textures/ui/empty_armor_slot_helmet"},
  "armor_overlay_chest@crafting.armor_overlay": {"alpha": 0.6, "texture": "textures/ui/empty_armor_slot_chestplate"},
  "armor_overlay_legs@crafting.armor_overlay": {"alpha": 0.6, "texture": "textures/ui/empty_armor_slot_leggings"},
  "armor_image_feet@crafting.armor_overlay": {"alpha": 0.6, "texture": "textures/ui/empty_armor_slot_boots"},
  "armor_overlay_shield@crafting.offhand_overlay": {"alpha": 0.6, "texture": "textures/ui/empty_armor_slot_shield"},
  "scroll_box_image": {
    "type": "panel",
    "size": [ "100% - 2px", "100% - 2px" ],
    "allow_clipping": true,
    "offset": "$misc_scroller_offset",
    "controls": [
      {
        "js": {
          "allow_clipping": true,
          "type": "image",
          "texture": "assets/minecraft/textures/gui/sprites/container/loom/scroller.png",
          "size": [ 12, 15 ],
          "alpha": 1,
          "anchor_from": "top_middle",
          "anchor_to": "top_middle",
          "layer": 5
        }
      }
    ]
  },
  "scroll_box_image_disabled": {
    "anchor_from": "center",
    "anchor_to": "center",
    "type": "panel",
    "size": [ "100% - 2px", "100% - 2px" ],
    "allow_clipping": true,
    "offset": "$misc_scroller_disabled_offset",
    "controls": [
      {
        "js": {
          "allow_clipping": true,
          "type": "image",
          "texture": "assets/minecraft/textures/gui/sprites/container/stonecutter/scroller_disabled.png",
          "size": [ 12, 15 ],
          "alpha": 1,
          "anchor_from": "center",
          "anchor_to": "center",
          "layer": 5
        }
      }
    ]
  },
  "villager_scroller": {
    "type": "panel",
    "size": [ 7, "100%" ],
    "layer": 5,
    "controls": [
      {
        "texture": {
          "type": "image",
          "layer": 5,
          "texture": "assets/minecraft/textures/gui/sprites/container/villager/scroller",
          "size": [ 6, 27 ]
        }
      }
    ]
  },
  "text_field": {
    "type": "panel",
    "size": [ "100%", "100%" ],
    "controls": [
      {
        "texture": {
          "type": "image",
          "nineslice_size": 1,
          "texture": "assets/minecraft/textures/gui/sprites/widget/text_field",
          "size": [ "100%", "100%" ]
        }
      }
    ]
  },
  "text_field_highlighted": {
    "type": "panel",
    "size": [ "100%", "100%" ],
    "controls": [
      {
        "texture": {
          "type": "image",
          "nineslice_size": 1,
          "texture": "assets/minecraft/textures/gui/sprites/widget/text_field_highlighted",
          "size": [ "100%", "100%" ]
        }
      }
    ]
  },
  "barrel@common.empty_panel": {
    "controls": [
      {
        "top_half@image_element": {
          "anchor_from": "top_middle",
          "anchor_to": "top_middle",
          "offset": [ 0, -47.4 ],
          "layer": 4,
          "texture": "assets/minecraft/textures/gui/container/generic_54",
          "uv_size": [ 176, 71 ]
        }
      },
      {
        "bottom_half@image_element": {
          "anchor_from": "top_middle",
          "anchor_to": "top_middle",
          "offset": [ 0, 34.6 ],
          "layer": 2,
          "texture": "assets/minecraft/textures/gui/container/generic_54",
          "uv_size": [ 176, 97 ],
          "uv": [ 0, 125 ]
        }
      }
    ]
  },
  "crafting@image_element": {
    "uv_size": [ 176, 166 ],
    "texture": "assets/minecraft/textures/gui/container/crafting_table",
    "controls": [
      {"exit@close_button": {"$current_panel_offset|default": [ 100.8, -74 ]}}
    ]
  },
  "inventory@image_element": {
    "uv_size": [ 176, 166 ],
    "texture": "assets/minecraft/textures/gui/container/inventory",
    "controls": [
      {"exit@close_button": {"$current_panel_offset|default": [ 100.8, -74 ]}}
    ]
  },
  "tooltip": {
    "type": "panel",
    "size": [ "100%", "100%" ],
    "controls": [
      {
        "tooltip_outline": {
          "type": "image",
          "layer": 2,
          "texture": "textures/ui/purpleBorder.png",
          "size": [ "100%+16px", "100%+16px" ]
        }
      }
    ]
  },
  "trade_arrow": {
    "type": "image",
    "texture": "assets/minecraft/textures/gui/sprites/container/villager/trade_arrow.png",
    "size": [ 10, 11 ],
    "layer": 5
  },
  "trade_cross_out": {
    "type": "image",
    "texture": "assets/minecraft/textures/gui/sprites/container/villager/trade_arrow_out_of_stock.png",
    "size": [ 10, 11 ],
    "layer": 5
  },
  "cross_out": {
    "type": "image",
    "texture": "assets/minecraft/textures/gui/sprites/container/villager/out_of_stock.png",
    "size": [ 28, 21 ],
    "anchor_from": "top_left",
    "anchor_to": "top_left",
    "offset": "$cross_out_offset",
    "ignored": "$cross_out_ignored",
    "layer": "$arrowc_layer"
  },
  "arrow": {
    "type": "image",
    "texture": "textures/atemp/ui/in_stock.png",
    "size": [ 28, 21 ],
    "anchor_from": "top_left",
    "anchor_to": "top_left",
    "offset": "$cross_out_offset",
    "layer": "$arrow_layer"
  },
  "red_cell_image": {"type": "image", "texture": "textures/ui/cell_image_red"}
}