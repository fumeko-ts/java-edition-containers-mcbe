{
  "namespace": "screen_content",
  "image_element": {"type": "image", "grayscale": true, "alpha": "$container_opacity"},
  "container_base@global.root_panel": {
    "size": "$size",
    "$size": [ 176, 166 ],
    "variables": [
      {"requires": "($anvil_screen = true)", "$container|default": "anvil"},
      {"requires": "($barrel_screen = true)", "$container|default": "barrel"},
      {"requires": "($beacon_screen = true)", "$container|default": "beacon", "$size": [ 230, 219 ]},
      {"requires": "($blast_furnace_screen = true)", "$container|default": "blast_furnace"},
      {"requires": "($brewing_stand_screen = true)", "$container|default": "brewing_stand"},
      {"requires": "($cartography_screen = true)", "$container|default": "cartography"},
      {"requires": "($crafting_screen = true)", "$container|default": "crafting"},
      {"requires": "($crafter_screen = true)", "$container|default": "crafter"},
      {"requires": "($dispenser_screen = true)", "$container|default": "dispenser"},
      {"requires": "($enchanting_screen = true)", "$container|default": "enchanting"},
      {"requires": "($furnace_screen = true)", "$container|default": "furnace"},
      {
        "requires": "($double_chest_container = true)",
        "$container|default": "double_chest",
        "$size": [ 176, 222 ]
      },
      {"requires": "($grindstone_screen = true)", "$container|default": "grindstone"},
      {"requires": "($hopper_screen = true)", "$container|default": "hopper", "$size": [ 176, 133 ]},
      {"requires": "($horse_screen = true)", "$container|default": "horse"},
      {"requires": "($loom_screen = true)", "$container|default": "loom"},
      {"requires": "($shulker_screen = true)", "$container|default": "shulker_box"},
      {"requires": "($smithing_screen = true)", "$container|default": "smithing"},
      {"requires": "($smoker_screen = true)", "$container|default": "smoker"},
      {"requires": "($stonecutter_screen = true)", "$container|default": "stonecutter"},
      {"requires": "($main_trade_screen = true)", "$container|default": "trade", "$size": [ 276, 166 ]},
      {"requires": "($inventory_screen = true)", "$container|default": "inventory"}
    ],
    "controls": [
      {
        "compact_close@common.close_button": {
          "layer": 20,
          "size": [ 14, 14 ],
          "anchor_to": "top_right",
          "anchor_from": "top_right",
          "offset": [ -1, 1 ],
          "$close_button_panel_size|default": [ 14, 14 ],
          "controls": [
            {"default@global.close_button_panel": {"$close_button_texture": "textures/atemp/close_button.png"}},
            {
              "hover@global.close_button_panel": {"$close_button_texture": "textures/atemp/close_button_hover.png"}
            },
            {"pressed@global.close_button_panel": {"$close_button_texture": "textures/atemp/close_button.png"}}
          ],
          "ignored": "($Exit_panel_enabled = false)"
        }
      },
      {"all_misc@$container": {}}
    ]
  },
  "close_button_image@screen_content.image_element": {"keep_ratio": true, "texture": "$close_button_texture"},
  "highlight_slot@screen_content.image_element": {
    "texture": "textures/atemp/white_slot",
    "size": "$white_highlight_slot_size",
    "offset": "$white_highlight_slot_offset",
    "$white_highlight_slot_offset|default": [ 0, 0 ],
    "$white_highlight_slot_size|default": [ 16, 16 ],
    "alpha": 0.45
  },
  "label": {
    "type": "label",
    "offset": "$text_offset",
    "$text_offset": [ 0, 0 ],
    "anchor_from": "top_left",
    "anchor_to": "top_left",
    "text": "$container_title",
    "size": [ "90%", "default" ],
    "color": "$title_text_color",
    "layer": 20
  },
  "recipe_book@screen_content.image_element": {
    "texture": "assets/minecraft/textures/gui/recipe_book",
    "size": [ 147, 166 ],
    "uv_size": [ 147, 166 ],
    "uv": [ 1, 1 ],
    "offset": [ 1, 0 ],
    "layer": 9
  },
  "creative_inventory@screen_content.image_element": {
    "uv_size": [ 195, 136 ],
    "texture": "assets/minecraft/textures/gui/container/creative_inventory/tab_inventory.png",
    "layer": 3
  },
  "creative_inventory_misc@screen_content.image_element": {
    "uv_size": [ 195, 136 ],
    "texture": "assets/minecraft/textures/gui/container/creative_inventory/tab_items.png",
    "layer": 3
  },
  "creative_inventory_search@screen_content.image_element": {
    "uv_size": [ 195, 136 ],
    "texture": "assets/minecraft/textures/gui/container/creative_inventory/tab_item_search.png",
    "layer": 3
  },
  "anvil@screen_content.image_element": {"uv_size": [ 176, 166 ], "texture": "assets/minecraft/textures/gui/container/anvil"},
  "beacon@screen_content.image_element": {"uv_size": [ 230, 219 ], "texture": "assets/minecraft/textures/gui/container/beacon"},
  "blast_furnace@screen_content.image_element": {"uv_size": [ 176, 166 ], "texture": "assets/minecraft/textures/gui/container/blast_furnace"},
  "brewing_stand@screen_content.image_element": {"uv_size": [ 176, 166 ], "texture": "assets/minecraft/textures/gui/container/brewing_stand"},
  "cartography@screen_content.image_element": {"uv_size": [ 176, 166 ], "texture": "assets/minecraft/textures/gui/container/cartography_table"},
  "crafter@screen_content.image_element": {"uv_size": [ 176, 166 ], "texture": "assets/minecraft/textures/gui/container/crafter"},
  "dispenser@screen_content.image_element": {"uv_size": [ 176, 166 ], "texture": "assets/minecraft/textures/gui/container/dispenser"},
  "enchanting@screen_content.image_element": {"uv_size": [ 176, 166 ], "texture": "assets/minecraft/textures/gui/container/enchanting_table"},
  "furnace@screen_content.image_element": {"uv_size": [ 176, 166 ], "texture": "assets/minecraft/textures/gui/container/furnace"},
  "double_chest@screen_content.image_element": {"uv_size": [ 176, 222 ], "texture": "assets/minecraft/textures/gui/container/generic_54"},
  "grindstone@screen_content.image_element": {"uv_size": [ 176, 166 ], "texture": "assets/minecraft/textures/gui/container/grindstone"},
  "hopper@screen_content.image_element": {"uv_size": [ 176, 133 ], "texture": "assets/minecraft/textures/gui/container/hopper"},
  "horse@screen_content.image_element": {"uv_size": [ 176, 166 ], "texture": "assets/minecraft/textures/gui/container/horse"},
  "horse_inventory@screen_content.image_element": {"uv_size": [ 176, 166 ], "texture": "assets/minecraft/textures/gui/container/horse"},
  "loom@screen_content.image_element": {"uv_size": [ 176, 166 ], "texture": "assets/minecraft/textures/gui/container/loom"},
  "shulker_box@screen_content.image_element": {"uv_size": [ 176, 166 ], "texture": "assets/minecraft/textures/gui/container/shulker_box"},
  "smithing@screen_content.image_element": {"uv_size": [ 176, 166 ], "texture": "assets/minecraft/textures/gui/container/smithing"},
  "smoker@screen_content.image_element": {"uv_size": [ 176, 166 ], "texture": "assets/minecraft/textures/gui/container/smoker"},
  "stonecutter@screen_content.image_element": {"uv_size": [ 176, 166 ], "texture": "assets/minecraft/textures/gui/container/stonecutter"},
  "trade@screen_content.image_element": {"uv_size": [ 276, 166 ], "texture": "assets/minecraft/textures/gui/container/villager"},
  "edit_box_indent@screen_content.image_element": {"texture": "assets/minecraft/textures/gui/sprites/container/anvil/text_field_disabled"},
  "edit_box_indent_hover@screen_content.image_element": {"texture": "assets/minecraft/textures/gui/sprites/container/anvil/text_field"},
  "armor_overlay_helmet@crafting.armor_overlay": {"alpha": 0.6, "texture": "textures/ui/empty_armor_slot_helmet"},
  "armor_overlay_chest@crafting.armor_overlay": {"alpha": 0.6, "texture": "textures/ui/empty_armor_slot_chestplate"},
  "armor_overlay_legs@crafting.armor_overlay": {"alpha": 0.6, "texture": "textures/ui/empty_armor_slot_leggings"},
  "armor_image_feet@crafting.armor_overlay": {"alpha": 0.6, "texture": "textures/ui/empty_armor_slot_boots"},
  "armor_overlay_shield@crafting.offhand_overlay": {"alpha": 0.6, "texture": "textures/ui/empty_armor_slot_shield"},
  "scroll_box_image@global.empty_panel": {
    "size": [ "100% - 2px", "100% - 2px" ],
    "offset": "$misc_scroller_offset",
    "controls": [
      {
        "js@screen_content.image_element": {
          "allow_clipping": true,
          "texture": "assets/minecraft/textures/gui/sprites/container/loom/scroller.png",
          "size": [ 12, 15 ],
          "alpha": 1,
          "anchor_from": "top_middle",
          "anchor_to": "top_middle",
          "layer": 5
        }
      }
    ]
  },
  "scroll_box_image_disabled": {
    "anchor_from": "center",
    "anchor_to": "center",
    "type": "panel",
    "size": [ "100% - 2px", "100% - 2px" ],
    "offset": "$misc_scroller_disabled_offset",
    "controls": [
      {
        "js@screen_content.image_element": {
          "allow_clipping": true,
          "texture": "assets/minecraft/textures/gui/sprites/container/stonecutter/scroller_disabled.png",
          "size": [ 12, 15 ],
          "alpha": 1,
          "anchor_from": "center",
          "anchor_to": "center",
          "layer": 5
        }
      }
    ]
  },
  "villager_scroller": {
    "type": "panel",
    "size": [ 7, "100%" ],
    "layer": 5,
    "controls": [
      {
        "texture@screen_content.image_element": {
          "layer": 5,
          "texture": "assets/minecraft/textures/gui/sprites/container/villager/scroller",
          "size": [ 6, 27 ]
        }
      }
    ]
  },
  "text_field": {
    "type": "panel",
    "size": [ "100%", "100%" ],
    "controls": [
      {
        "texture@screen_content.image_element": {
          "nineslice_size": 1,
          "texture": "assets/minecraft/textures/gui/sprites/widget/text_field",
          "size": [ "100%", "100%" ]
        }
      }
    ]
  },
  "text_field_highlighted": {
    "type": "panel",
    "size": [ "100%", "100%" ],
    "controls": [
      {
        "texture@screen_content.image_element": {
          "nineslice_size": 1,
          "texture": "assets/minecraft/textures/gui/sprites/widget/text_field_highlighted",
          "size": [ "100%", "100%" ]
        }
      }
    ]
  },
  "barrel@common.empty_panel": {
    "controls": [
      {
        "top_half@screen_content.image_element": {
          "anchor_from": "top_middle",
          "anchor_to": "top_middle",
          "offset": [ 0, -47.4 ],
          "layer": 3,
          "texture": "assets/minecraft/textures/gui/container/generic_54",
          "uv_size": [ 176, 71 ]
        }
      },
      {
        "bottom_half@screen_content.image_element": {
          "anchor_from": "top_middle",
          "anchor_to": "top_middle",
          "offset": [ 0, 34.6 ],
          "layer": 2,
          "texture": "assets/minecraft/textures/gui/container/generic_54",
          "uv_size": [ 176, 97 ],
          "uv": [ 0, 125 ]
        }
      }
    ]
  },
  "crafting@screen_content.image_element": {"uv_size": [ 176, 166 ], "texture": "assets/minecraft/textures/gui/container/crafting_table"},
  "inventory@screen_content.image_element": {"uv_size": [ 176, 166 ], "texture": "assets/minecraft/textures/gui/container/inventory"},
  "trade_arrow@screen_content.image_element": {
    "texture": "assets/minecraft/textures/gui/sprites/container/villager/trade_arrow.png",
    "size": [ 10, 11 ],
    "layer": 5
  },
  "trade_cross_out@screen_content.image_element": {
    "texture": "assets/minecraft/textures/gui/sprites/container/villager/trade_arrow_out_of_stock.png",
    "size": [ 10, 11 ],
    "layer": 5
  },
  "cross_out@screen_content.image_element": {
    "texture": "assets/minecraft/textures/gui/sprites/container/villager/out_of_stock.png",
    "size": [ 28, 21 ],
    "anchor_from": "top_left",
    "anchor_to": "top_left",
    "offset": "$cross_out_offset",
    "ignored": "$cross_out_ignored",
    "layer": "$arrowc_layer"
  },
  "screen_background": {
    "type": "image",
    "texture": "textures/ui/screen_background",
    "layer": -1000,
    "$screen_background_alpha|default": 0.75,
    "alpha": "$screen_background_alpha"
  },
  "arrow@screen_content.image_element": {
    "texture": "textures/atemp/in_stock.png",
    "size": [ 28, 21 ],
    "anchor_from": "top_left",
    "anchor_to": "top_left",
    "offset": "$cross_out_offset",
    "layer": "$arrow_layer"
  },
  "red_cell_image@screen_content.image_element": {"texture": "textures/ui/cell_image_red"}
}