{
  "namespace": "screen_content",
"somali": {
  "type": "panel",
  "size": "$size",
  "offset": [ 0, 0 ],
  "$size": [ 176, 166 ],
  "$current_panel_offset|default": [ 100.8, -74 ],
  "variables"                     : [
    { "requires": "($anvil_screen = true)"             , "$ep": "anvil"           },
    { "requires": "($barrel_screen = true)"            , "$ep": "barrel"          },
    { "requires": "($beacon_screen = true)"            , "$ep": "beacon"           , "$size": [ 230, 219 ]            , "$current_panel_offset|default": [ 126.8, -100 ] },
    { "requires": "($blast_furnace_screen = true)"     , "$ep": "blast_furnace"   },
    { "requires": "($brewing_stand_screen = true)"     , "$ep": "brewing_stand"    , "$current_panel_offset|default": [ 100.8, -71 ]  },
    { "requires": "($cartography_screen = true)"       , "$ep": "cartography"      , "$current_panel_offset|default": [ 100.8, -71 ]  },
    { "requires": "($crafting_screen = true)"          , "$ep": "crafting"        },
    { "requires": "($crafter_screen = true)"           , "$ep": "crafter"          , "$current_panel_offset|default": [ 100.8, -70 ]  },
    { "requires": "($dispenser_screen = true)"         , "$ep": "dispenser"       },
    { "requires": "($enchanting_screen = true)"        , "$ep": "enchanting"       , "$current_panel_offset|default": [ 100.8, -71 ]  },
    { "requires": "($furnace_screen = true)"           , "$ep": "furnace"         },
    { "requires": "($double_chest_container = true)"   , "$ep": "double_chest"     , "$size": [ 176, 222 ]            , "$current_panel_offset|default": [ 100.8, -100 ] },
    { "requires": "($grindstone_screen = true)"        , "$ep": "grindstone"       , "$current_panel_offset|default": [ 100.8, -72 ]  },
    { "requires": "($hopper_screen = true)"            , "$ep": "hopper"           , "$size": [ 176, 133 ]            , "$current_panel_offset|default": [ 100.8, -57 ]  },
    { "requires": "($horse_screen = true)"             , "$ep": "horse"           },
    { "requires": "($loom_screen = true)"              , "$ep": "loom"             , "$current_panel_offset|default": [ 100.8, -70 ]  },
    { "requires": "($shulker_screen = true)"           , "$ep": "shulker_box"     },
    { "requires": "($smithing_screen = true)"          , "$ep": "smithing"        },
    { "requires": "($smoker_screen = true)"            , "$ep": "smoker"          },
    { "requires": "($stonecutter_screen = true)"       , "$ep": "stonecutter"      , "$current_panel_offset|default": [ 100.8, -73 ]  },
    { "requires": "($main_trade_screen = true)"        , "$ep": "trade"            , "$size": [ 276, 166 ]            , "$current_panel_offset|default": [ 80.8, -74 ]   },
    { "requires": "($inventory_screen = true)"         , "$ep": "inventory"       }
  ],
  "controls": [
    { "close_button@close_button": {} },
    { "all_misc@$ep"             : {} }
  ]
}
,
  "label": {
    "type": "label",
    "offset": "$text_offset",
    "$text_offset": [ 0, 0 ],
    "anchor_from": "top_left",
    "anchor_to": "top_left",
    "text": "$container_title",
    "size": [ "90%", "default" ],
    "color": "$title_text_color",
    "layer": 20
  },
  "close_button": {
    "type": "panel",
    "layer": 2,
    "size": [ 18, 18 ],
    "$exit_panel": "common.empty_panel",
    "anchor_from": "center",
    "anchor_to": "center",
    "variables": [
      {
        "requires": "($Exit_panel_enabled = true)",
        "$exit_panel": "exit_button_template.light_close_button_sucrose"
      }
    ],
    "controls": [
      {
        "close_button@$exit_panel": {
          "offset": "$current_panel_offset",
          "anchor_from": "center",
          "anchor_to": "center"
        }
      }
    ]
  },
  "image_element": {
    "type": "image",
    "grayscale": true,
    "alpha": 1
  },
  "recipe_book@image_element": {
    "texture": "assets/minecraft/textures/gui/recipe_book",
    "size": [ 147, 166 ],
    "uv_size": [ 147, 166 ],
    "uv": [ 1, 1 ],
    "offset": [ 1, 0 ],
    "layer": 9
  },
  "creative_inventory@image_element":{
    "uv_size": [195, 136],
    "texture": "assets/minecraft/textures/gui/container/creative_inventory/tab_inventory.png",
    "offset": [ 0, 0 ]
  },
  "creative_inventory_misc@image_element":{
    "uv_size": [195, 136],
    "texture": "assets/minecraft/textures/gui/container/creative_inventory/tab_items.png",
    "offset": [ 0, 0 ]
  },
  "creative_inventory_search@image_element":{
    "uv_size": [195, 136],
    "texture": "assets/minecraft/textures/gui/container/creative_inventory/tab_item_search.png",
    "offset": [ 0, 0 ]
  },
  "anvil@image_element": {
    "uv_size": [ 176, 166 ],
    "texture": "assets/minecraft/textures/gui/container/anvil",
    "offset": [ 0, 0 ]
  },
  "beacon@image_element": {
    "uv_size": [ 230, 219 ],
    "texture": "assets/minecraft/textures/gui/container/beacon",
    "offset": [ -1, 0 ]
  },
  "blast_furnace@image_element": {
    "uv_size": [ 176, 166 ],
    "texture": "assets/minecraft/textures/gui/container/blast_furnace",
    "offset": [ 0, 0 ]
  },
  "brewing_stand@image_element": {
    "uv_size": [ 176, 166 ],
    "texture": "assets/minecraft/textures/gui/container/brewing_stand",
    "offset": [ 0, 3 ]
  },
  "cartography@image_element": {
    "uv_size": [ 176, 166 ],
    "texture": "assets/minecraft/textures/gui/container/cartography_table",
    "offset": [ 0, 3 ]
  },
  "crafter@image_element": {
    "uv_size": [ 176, 166 ],
    "texture": "assets/minecraft/textures/gui/container/crafter",
    "offset": [ 0, 4.4 ]
  },
  "dispenser@image_element": {
    "uv_size": [ 176, 166 ],
    "texture": "assets/minecraft/textures/gui/container/dispenser",
    "offset": [ 0, 0 ]
  },
  "enchanting@image_element": {
    "uv_size": [ 176, 166 ],
    "texture": "assets/minecraft/textures/gui/container/enchanting_table",
    "offset": [ 0, 3 ]
  },
  "furnace@image_element": {
    "uv_size": [ 176, 166 ],
    "texture": "assets/minecraft/textures/gui/container/furnace",
    "offset": [ 0, 0 ]
  },
  "double_chest@image_element": {
    "uv_size": [ 176, 222 ],
    "texture": "assets/minecraft/textures/gui/container/generic_54",
    "offset": [ 0, 1 ]
  },
  "grindstone@image_element": {
    "uv_size": [ 176, 166 ],
    "texture": "assets/minecraft/textures/gui/container/grindstone",
    "offset": [ 0, 3 ]
  },
  "hopper@image_element": {
    "uv_size": [ 176, 133 ],
    "texture": "assets/minecraft/textures/gui/container/hopper",
    "offset": [ 0, 0 ]
  },
  "horse@image_element": {
    "uv_size": [ 176, 166 ],
    "texture": "assets/minecraft/textures/gui/container/horse",
    "offset": [ 0, 0 ]
  },
  "horse_inventory@image_element": {
    "uv_size": [ 176, 166 ],
    "texture": "assets/minecraft/textures/gui/container/horse",
    "offset": [ 0, 0 ]
  },
  "loom@image_element": {
    "uv_size": [ 176, 166 ],
    "texture": "assets/minecraft/textures/gui/container/loom",
    "offset": [ 0, 4.4 ]
  },
  "shulker_box@image_element": {
    "uv_size": [ 176, 166 ],
    "texture": "assets/minecraft/textures/gui/container/shulker_box",
    "offset": [ 0, 0 ]
  },
  "smithing@image_element": {
    "uv_size": [ 176, 166 ],
    "texture": "assets/minecraft/textures/gui/container/smithing",
    "offset": [ 0, 0 ]
  },
  "smoker@image_element": {
    "uv_size": [ 176, 166 ],
    "texture": "assets/minecraft/textures/gui/container/smoker",
    "offset": [ 0, 0 ]
  },
  "stonecutter@image_element": {
    "uv_size": [ 176, 166 ],
    "texture": "assets/minecraft/textures/gui/container/stonecutter",
    "offset": [ 0, 2 ]
  },
  "trade@image_element": {
    "uv_size": [ 276, 166 ],
    "texture": "assets/minecraft/textures/gui/container/villager",
    "offset": [ -70, 0 ]
  },
  "edit_box_indent": {
    "type": "image",
    "texture": "assets/minecraft/textures/gui/sprites/container/anvil/text_field_disabled"
  },
  "edit_box_indent_hover": {
    "type": "image",
    "texture": "assets/minecraft/textures/gui/sprites/container/anvil/text_field"
  },
"armor_overlay_helmet@crafting.armor_overlay": {
    "alpha": 0.6,
    "texture": "textures/ui/empty_armor_slot_helmet"
  },
  "armor_overlay_chest@crafting.armor_overlay": {
    "alpha": 0.6,
    "texture": "textures/ui/empty_armor_slot_chestplate"
  },
  "armor_overlay_legs@crafting.armor_overlay": {
    "alpha": 0.6,
    "texture": "textures/ui/empty_armor_slot_leggings"
  },
  "armor_image_feet@crafting.armor_overlay": {
    "alpha": 0.6,
    "texture": "textures/ui/empty_armor_slot_boots"
  },
  "armor_overlay_shield@crafting.offhand_overlay": {
    "alpha": 0.6,
    "texture": "textures/ui/empty_armor_slot_shield"
  },
  "scroll_box_image": {
    "type": "panel",
    "size": [ "100% - 2px", "100% - 2px" ],
    "allow_clipping": true,
    "offset": "$misc_scroller_offset",
    "controls": [
      {
        "js": {
          "allow_clipping": true,
          "type": "image",
          "texture": "assets/minecraft/textures/gui/sprites/container/loom/scroller.png",
          "size": [ 12, 15 ],
          "alpha": 1,
          "anchor_from": "top_middle",
          "anchor_to": "top_middle",
          "layer": 5
        }
      }
    ]
  },
  "scroll_box_image_disabled": {
    "anchor_from": "center",
    "anchor_to": "center",
    "type": "panel",
    "size": [ "100% - 2px", "100% - 2px" ],
    "allow_clipping": true,
    "offset": "$misc_scroller_disabled_offset",
    "controls": [
      {
        "js": {
          "allow_clipping": true,
          "type": "image",
          "texture": "assets/minecraft/textures/gui/sprites/container/stonecutter/scroller_disabled.png",
          "size": [ 12, 15 ],
          "alpha": 1,
          "anchor_from": "center",
          "anchor_to": "center",
          "layer": 5
        }
      }
    ]
  },
  "villager_scroller": {
    "type": "panel",
    "size": [ 7, "100%" ],
    "layer": 5,
    "controls": [
      {
        "texture": {
          "type": "image",
          "layer": 5,
          "texture": "assets/minecraft/textures/gui/sprites/container/villager/scroller",
          "size": [ 6, 27 ]
        }
      }
    ]
  },
  "text_field": {
    "type": "panel",
    "size": [ "100%", "100%" ],
    "controls": [
      {
        "texture": {
          "type": "image",
          "nineslice_size": 1,
          "texture": "assets/minecraft/textures/gui/sprites/widget/text_field",
          "size": [ "100%", "100%" ]
        }
      }
    ]
  },
  "text_field_highlighted": {
    "type": "panel",
    "size": [ "100%", "100%" ],
    "controls": [
      {
        "texture": {
          "type": "image",
          "nineslice_size": 1,
          "texture": "assets/minecraft/textures/gui/sprites/widget/text_field_highlighted",
          "size": [ "100%", "100%" ]
        }
      }
    ]
  },
  "barrel@common.empty_panel": {
    "controls": [
      {
        "top_half@image_element": {
          "anchor_from": "top_middle",
          "anchor_to": "top_middle",
          "offset": [ 0, -47.4 ],
          "layer": 4,
          "texture": "assets/minecraft/textures/gui/container/generic_54",
          "uv_size": [ 176, 71 ]
        }
      },
      {
        "bottom_half@image_element": {
          "anchor_from": "top_middle",
          "anchor_to": "top_middle",
          "offset": [ 0, 34.6 ],
          "layer": 2,
          "texture": "assets/minecraft/textures/gui/container/generic_54",
          "uv_size": [ 176, 97 ],
          "uv": [ 0, 125 ]
        }
      }
    ]
  },
  "crafting@image_element": {
    "uv_size": [ 176, 166 ],
    "texture": "assets/minecraft/textures/gui/container/crafting_table",
    "controls": [
      {
        "exit@close_button": { "$current_panel_offset|default": [ 100.8, -74 ] }
      }
    ]
  },
  "inventory@image_element": {
    "uv_size": [ 176, 166 ],
    "texture": "assets/minecraft/textures/gui/container/inventory",
    "controls": [
      {
        "exit@close_button": { "$current_panel_offset|default": [ 100.8, -74 ] }
      }
    ]
  },
  "tooltip": {
    "type": "panel",
    "size": [ "100%", "100%" ],
    "controls": [
      {
        "tooltip_outline": {
          "type": "image",
          "layer": 2,
          "texture": "textures/ui/purpleBorder.png",
          "size": [ "100%+16px", "100%+16px" ]
        }
      }
    ]
  },
  "trade_arrow": {
    "type": "image",
    "texture": "assets/minecraft/textures/gui/sprites/container/villager/trade_arrow.png",
    "size": [ 10, 11 ],
    "layer": 5
  },
  "trade_cross_out": {
    "type": "image",
    "texture": "assets/minecraft/textures/gui/sprites/container/villager/trade_arrow_out_of_stock.png",
    "size": [ 10, 11 ],
    "layer": 5
  },
  "cross_out": {
    "type": "image",
    "texture": "assets/minecraft/textures/gui/sprites/container/villager/out_of_stock.png",
    "size": [ 28, 21 ],
    "anchor_from": "top_left",
    "anchor_to": "top_left",
    "offset": "$cross_out_offset",
    "ignored": "$cross_out_ignored",
    "layer": "$arrowc_layer"
  },
  "arrow": {
    "type": "image",
    "texture": "textures/atemp/ui/in_stock.png",
    "size": [ 28, 21 ],
    "anchor_from": "top_left",
    "anchor_to": "top_left",
    "offset": "$cross_out_offset",
    "layer": "$arrow_layer"
  },
  "red_cell_image": { "type": "image", "texture": "textures/ui/cell_image_red" }
}