{
  "namespace": "screen_content",

  // exit button templates
  "container_template@screen_content.image_element": {
    "size": "$size",
    "uv_size": "$size",
    "controls": [
      {
        "close_button@global.close_button": {}
      }
    ]
  },

  //container uis
  "anvil@screen_content.container_template": { "$size": [176, 166], "texture": "assets/container/anvil" },
  "beacon@screen_content.container_template": { "$size": [230, 219], "texture": "assets/container/beacon" },
  "blast_furnace@screen_content.container_template": {
    "$size": [176, 166],
    "texture": "assets/container/blast_furnace"
  },
  "brewing_stand@screen_content.container_template": {
    "$size": [176, 166],
    "texture": "assets/container/brewing_stand"
  },
  "cartography@screen_content.container_template": {
    "$size": [176, 166],
    "texture": "assets/container/cartography_table"
  },
  "crafting@screen_content.container_template": { "$size": [176, 166], "texture": "assets/container/crafting_table" },
  "crafter@screen_content.container_template": { "$size": [176, 166], "texture": "assets/container/crafter" },
  "dispenser@screen_content.container_template": { "$size": [176, 166], "texture": "assets/container/dispenser" },
  "double_chest@screen_content.container_template": { "$size": [176, 222], "texture": "assets/container/generic_54" },
  "dropper@screen_content.container_template": { "$size": [176, 166], "texture": "assets/container/dispenser" },
  "enchanting@screen_content.container_template": {
    "$size": [176, 166],
    "texture": "assets/container/enchanting_table"
  },
  "furnace@screen_content.container_template": { "$size": [176, 166], "texture": "assets/container/furnace" },
  "grindstone@screen_content.container_template": { "$size": [176, 166], "texture": "assets/container/grindstone" },
  "hopper@screen_content.container_template": { "$size": [176, 133], "texture": "assets/container/hopper" },
  "horse@screen_content.container_template": { "$size": [176, 166], "texture": "assets/container/horse" },
  "inventory@screen_content.container_template": { "$size": [176, 166], "texture": "assets/container/inventory" },
  "loom@screen_content.container_template": { "$size": [176, 166], "texture": "assets/container/loom" },
  "shulker_box@screen_content.container_template": { "$size": [176, 166], "texture": "assets/container/shulker_box" },
  "smithing@screen_content.container_template": { "$size": [176, 166], "texture": "assets/container/smithing" },
  "smoker@screen_content.container_template": { "$size": [176, 166], "texture": "assets/container/smoker" },
  "stonecutter@screen_content.container_template": { "$size": [176, 166], "texture": "assets/container/stonecutter" },
  "trade@screen_content.container_template": { "$size": [276, 166], "texture": "assets/container/villager" },

  "small_chest@global.empty_panel": {
    "size": [176, 166],
    "controls": [
      {
        "close_button@global.close_button": {}
      },
      {
        "top_half@screen_content.image_element": {
          "anchor_from": "top_middle",
          "anchor_to": "top_middle",
          "uv": [0, 0],
          "uv_size": [176, 71],
          "size": [176, 71],
          "texture": "assets/container/generic_54"
        }
      },
      {
        "bottom_half@screen_content.image_element": {
          "anchor_from": "bottom_middle",
          "anchor_to": "bottom_middle",
          "uv": [0, 127],
          "uv_size": [176, 95],
          "size": [176, 95],
          "texture": "assets/container/generic_54"
        }
      }
    ]
  },
  "ender_chest@global.empty_panel": {
    "size": [176, 166],
    "controls": [
      {
        "close_button@global.close_button": {}
      },
      {
        "top_half@screen_content.image_element": {
          "anchor_from": "top_middle",
          "anchor_to": "top_middle",
          "uv": [0, 0],
          "uv_size": [176, 71],
          "size": [176, 71],
          "texture": "assets/container/generic_54"
        }
      },
      {
        "bottom_half@screen_content.image_element": {
          "anchor_from": "bottom_middle",
          "anchor_to": "bottom_middle",
          "uv": [0, 127],
          "uv_size": [176, 95],
          "size": [176, 95],
          "texture": "assets/container/generic_54"
        }
      }
    ]
  },
  "barrel@global.empty_panel": {
    "size": [176, 166],
    "controls": [
      {
        "close_button@global.close_button": {}
      },
      {
        "top_half@screen_content.image_element": {
          "anchor_from": "top_middle",
          "anchor_to": "top_middle",
          "uv": [0, 0],
          "uv_size": [176, 71],
          "size": [176, 71],
          "texture": "assets/container/generic_54"
        }
      },
      {
        "bottom_half@screen_content.image_element": {
          "anchor_from": "bottom_middle",
          "anchor_to": "bottom_middle",
          "uv": [0, 127],
          "uv_size": [176, 95],
          "size": [176, 95],
          "texture": "assets/container/generic_54"
        }
      }
    ]
  },
  "recipe_book@screen_content.image_element": {
    "texture": "assets/recipe_book",
    "size": [147, 166],
    "uv_size": [147, 166],
    "uv": [1, 1],
    "offset": [1, 0],
    "layer": 1
  },
  "creative_inventory@screen_content.image_element": {
    "size": [195, 136],
    "uv_size": [195, 136],
    "texture": "assets/container/creative_inventory/tab_inventory",
    "layer": 3
  },
  "creative_inventory_misc@screen_content.image_element": {
    "size": [195, 136],
    "uv_size": [195, 136],
    "texture": "assets/container/creative_inventory/tab_items",
    "layer": 3
  },
  "creative_inventory_search@screen_content.image_element": {
    "size": [195, 136],
    "uv_size": [195, 136],
    "texture": "assets/container/creative_inventory/tab_item_search",
    "layer": 3
  },

  //base ui elements
  "image_element@global.empty_image": { "alpha": "$container_opacity" },
  "screen_background": {
    "type": "image",
    "texture": "textures/ui/screen_background",
    "layer": -1000,
    "$screen_background_alpha|default": 0.78,
    "alpha": "$screen_background_alpha"
  },
  //slot overlays and highlights
  "highlight_slot@screen_content.image_element": {
    "texture": "textures/ui/ashur/white_slot",
    "size": "$white_highlight_slot_size",
    "offset": "$white_highlight_slot_offset",
    "$white_highlight_slot_offset|default": [0, 0],
    "$white_highlight_slot_size|default": [16, 16],
    "alpha": 0.45
  },
  "armor_overlay@screen_content.image_element": {
    "size": [16, 16],
    "bindings": [
      {
        "binding_name": "#empty_armor_image_visible",
        "binding_name_override": "#visible",
        "binding_type": "collection",
        "binding_collection_name": "$item_collection"
      }
    ]
  },
  "offhand_overlay@screen_content.image_element": {
    "size": [16, 16],
    "bindings": [
      {
        "binding_name": "#empty_offhand_image_visible",
        "binding_name_override": "#visible",
        "binding_type": "collection",
        "binding_collection_name": "$item_collection"
      }
    ]
  },
  "armor_overlay_helmet@screen_content.armor_overlay": {
    "size": [16, 16],
    "texture": "assets/sprites/container/slot/helmet"
  },
  "armor_overlay_chest@screen_content.armor_overlay": {
    "size": [16, 16],
    "texture": "assets/sprites/container/slot/chestplate"
  },
  "armor_overlay_legs@screen_content.armor_overlay": {
    "size": [16, 16],
    "texture": "assets/sprites/container/slot/leggings"
  },
  "armor_image_feet@screen_content.armor_overlay": {
    "size": [16, 16],
    "texture": "assets/sprites/container/slot/boots"
  },
  "armor_overlay_shield@screen_content.offhand_overlay": {
    "size": [16, 16],
    "texture": "assets/sprites/container/slot/shield"
  },
  "enchanting_lapis@screen_content.image_element": {
    "size": [16, 16],
    "texture": "assets/sprites/container/slot/lapis_lazuli"
  },
  "crafter_disabled_slot@screen_content.image_element": {
    "size": [18, 18],
    "nineslice_size": 1,
    "offset": [1, 1],
    "texture": "assets/sprites/container/crafter/disabled_slot"
  },

  //buttons and interactive elements
  "enchant_texture_template@screen_content.image_element": { "size": [108, 19], "layer": 5, "offset": [1, 1] },
  "enchanting_button_disabled@screen_content.enchant_texture_template": {
    "texture": "assets/sprites/container/enchanting_table/enchantment_slot_disabled"
  },
  "enchanting_button@screen_content.enchant_texture_template": {
    "texture": "assets/sprites/container/enchanting_table/enchantment_slot"
  },
  "enchanting_button_highlight@screen_content.enchant_texture_template": {
    "texture": "assets/sprites/container/enchanting_table/enchantment_slot_highlighted"
  },
  "redstone_activated_bindings@screen_content.image_element": {
    "size": [16, 16],
    "layer": 12,
    "texture": "$arrow_texture",
    "bindings": [
      {
        "binding_name": "$binding_value",
        "binding_name_override": "#visible"
      }
    ]
  },

  //text fields and edit boxes
  "anvil_text_field@screen_content.image_element": {
    "nineslice_size": 2,
    "texture": "assets/sprites/container/anvil/text_field_disabled",
    "size": [110, 16]
  },
  "anvil_edit_box_hover@screen_content.image_element": {
    "nineslice_size": 2,
    "texture": "assets/sprites/container/anvil/text_field",
    "size": [110, 16]
  },
  "text_field@screen_content.image_element": {
    "nineslice_size": 1,
    "texture": "assets/sprites/recipe_book/text_field",
    "size": ["100%", "100%"]
  },
  "text_field_highlighted@screen_content.image_element": {
    "nineslice_size": 1,
    "texture": "assets/sprites/recipe_book/text_field_highlighted",
    "size": ["100%", "100%"]
  }
}
