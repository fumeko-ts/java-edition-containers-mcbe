  "hover_text_template@global.custom_renderer": {
    "allow_clipping": false,

    "$type": "bundle_tooltip_renderer",
    "layer": 900,
    "controls": [
      {
        "1@java_hover_text.java_tooltip_test": {
          "$hover|default": true,
          "offset": [-3, -20],
          "bindings": [
            {
              "binding_name": "(not #using_touch)",
              "binding_name_override": "#visible"
            }
          ]
        }
      }
    ],
    "bindings": [
      {
        "binding_name": "#banner_patterns",
        "binding_type": "collection",
        "binding_condition": "always",
        "binding_collection_name": "patterns"
      },
      {
        "binding_type": "view",
        "binding_condition": "always",
        "source_property_name": "(#banner_patterns = $pattern_index)",
        "target_property_name": "#visible"
      }
    ]
  }
