{
  "namespace": "crafting_textures",
  "main_cell_panel@global.empty_panel": {
    "size": "$item_renderer_panel_size",
    "$cell_images_binding_condition|default": "visible",
    "$cell_image_size|default": ["default", "default"],
    "controls": [
      {
        "item_render@common.item_renderer": {
          "layer": 16,
          "size": "$item_renderer_size",
          "offset": "$item_renderer_offset",
          "anchor_to": "center",
          "anchor_from": "center"
        }
      },
      { "stack_count@common.stack_count_label": { "layer": 20 } },
      {
        "cell_image_red@screen_content.image_element": {
          "nineslice_size": [1, 1, 1, 1],
          "texture": "textures/ui/ashur/cell_transparent_image_red",
          "size": "$cell_image_size",
          "layer": 10,
          "controls": [
            {
              "remove_item": {
                "type": "collection_panel",
                "size": "$cell_image_size",
                "collection_name": "crafting_input_items",
                "controls": [
                  {"1@crafting_textures.hover_button": { "collection_index": 0 } },
                  {"1@crafting_textures.hover_button": { "collection_index": 1 } },
                  {"1@crafting_textures.hover_button": { "collection_index": 2 } },
                  {"1@crafting_textures.hover_button": { "collection_index": 3 } },
                  {"1@crafting_textures.hover_button": { "collection_index": 4, "ignored": "(not $crafting_screen)" }},
                  {"1@crafting_textures.hover_button": { "collection_index": 5, "ignored": "(not $crafting_screen)" }},
                  {"1@crafting_textures.hover_button": { "collection_index": 6, "ignored": "(not $crafting_screen)" }},
                  {"1@crafting_textures.hover_button": { "collection_index": 7, "ignored": "(not $crafting_screen)" }},
                  {"1@crafting_textures.hover_button": { "collection_index": 8, "ignored": "(not $crafting_screen)" } }
                ]
              }
            },
            {
              "white@global.empty_image": {
                "texture": "textures/ui/ashur/white",
                "size": ["100% - 1px", "100% - 1px"],
                "anchor_to": "center",
                "anchor_from": "center",
                "alpha": 0.2,
                "layer": 12
              }
            }
          ],
          "bindings": [
            {
              "binding_type": "view",
              "source_control_name": "$background_image_control_name",
              "resolve_sibling_scope": true,
              "source_property_name": "((#container_item_background = 3) or (#container_item_background = 7))",
              "target_property_name": "#visible"
            }
          ]
        }
      }
    ],
    "bindings": [
      {
        "binding_name": "#container_item_background",
        "binding_type": "collection",
        "binding_collection_name": "$item_collection_name",
        "binding_condition": "$cell_images_binding_condition"
      }
    ]
  },
  "crafting_input_grid_item@global.inventory_container_item_recipe": {
    "$item_collection_name": "crafting_input_items",
    "$background_images": "crafting_textures.main_cell_panel",
    "$item_renderer_binding_condition": "always",
    "$button_ref": "crafting.inventory_container_slot_button"
  },
  "output_cell_textures@crafting_textures.main_cell_panel": { "$cell_images_binding_condition": "always" },

  "hover_button": {
    "type": "button",
    "size": "$cell_image_size",
    "layer": 500,
    "default_focus_precedence": 1,
    "hover_control": "controls",
    "$item_collection_name|default": "crafting_input_items",
    "consume_event": false,
    "bindings": [
      {
        "binding_type": "collection_details",
        "binding_collection_name": "$item_collection_name",
        "binding_condition": "once"
      }
    ],
    "button_mappings": [
      { "to_button_id": "button.container_slot_hovered", "mapping_type": "pressed", "consume_event": false },
      {
        "from_button_id": "button.menu_select",
        "to_button_id": "button.container_auto_place",
        "mapping_type": "pressed"
      }
    ]
  }
}
