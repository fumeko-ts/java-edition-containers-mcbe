{
  "namespace": "crafting_common",
  "filter_button_template@global.empty_image": {"size": [26, 16]},

  "filter_toggle@toggle.radio_toggle": {
    "$size": [26, 16],
    "$toggle_control_name": "recipe_filter",
    "$toggle_name": "toggle.enableFiltering",
    "$toggle_binding_value": "#filtering_enabled",
    "$is_radio_toggle": false,
    "$controls": [
      { "default@crafting_common.filter_button_template": { "texture": "assets/sprites/recipe_book/filter_disabled" } },
      {
        "default_hover@crafting_common.filter_button_template": {
          "texture": "assets/sprites/recipe_book/filter_disabled_highlighted","controls": [{"hover@global.hover_text":{"layer":20000,"property_bag":{"#hover_text":"Showing All"}}}]
        }
      },
      {
        "checked_hover@crafting_common.filter_button_template": {
          "texture": "assets/sprites/recipe_book/filter_enabled_highlighted","controls": [{"hover@global.hover_text":{"layer":20000,"property_bag":{"#hover_text":"Showing Craftable"}}}]
        }
      },
      { "checked@crafting_common.filter_button_template": { "texture": "assets/sprites/recipe_book/filter_enabled" } }
    ],

    "variables": {
      "requires": "($cb_is_thick_menu_buttons = true)",
      "$controls": [
        { "default@thickly.filter_disabled": {} },
        {"default_hover@thickly.filter_disabled_highlighted": {"controls": [{ "hover@global.hover_text": { "layer": 20000, "property_bag": { "#hover_text": "Showing All" } } }]}},
        {"checked_hover@thickly.filter_enabled_highlighted": {"controls": [{ "hover@global.hover_text": { "layer": 20000, "property_bag": { "#hover_text": "Showing Craftable" } } }]}},
        { "checked@thickly.filter_enabled": {} }
      ]
    },
    "$button_mappings": [
      { "to_button_id": "button.filter_toggle_hovered", "mapping_type": "pressed" },
      {
        "to_button_id": "button.menu_select",
        "mapping_type": "pressed",
        "from_button_id": "button.menu_select"
      },
      { "to_button_id": "button.menu_ok", "mapping_type": "focused", "from_button_id": "button.menu_ok" }
    ]
  },
  "crafting_survival_tabs@global.empty_stack": {
    "orientation": "vertical",
    "size": [35, 135],
    "layer": 2,
    "controls": [
      {
        "search_tab_survival@crafting_common.survival_tab_base": {
          "$toggle_default_state": true,
          "$tab_view_binding_name": "search_tab_toggle",
          "$toggle_group_forced_index": "$search_index",
          "$toggle_state_binding_name": "#is_left_tab_search"
        }
      },
      {
        "equipment_tab_survival@crafting_common.survival_tab_base": {
          "$tab_view_binding_name": "equipment_tab_toggle",
          "$toggle_group_forced_index": "$equipment_index",
          "$toggle_state_binding_name": "#is_left_tab_equipment"
        }
      },
      {
        "construction_tab_survival@crafting_common.survival_tab_base": {
          "$tab_view_binding_name": "construction_tab_toggle",
          "$toggle_group_forced_index": "$construction_index",
          "$toggle_state_binding_name": "#is_left_tab_construct"
        }
      },
      {
        "nature_tab_survival@crafting_common.survival_tab_base": {
          "$tab_view_binding_name": "nature_tab_toggle",
          "$toggle_group_forced_index": "$nature_index",
          "$toggle_state_binding_name": "#is_left_tab_nature"
        }
      },
      {
        "items_tab_survival@crafting_common.survival_tab_base": {
          "$tab_view_binding_name": "items_tab_toggle",
          "$toggle_group_forced_index": "$items_index",
          "$toggle_state_binding_name": "#is_left_tab_items"
        }
      }
    ]
  },
  "tab_item_renderer@global.custom_renderer": {
    "$type": "inventory_item_renderer",
    "size": [16, 16],
    "$item_id|default": -1,
    "property_bag": { "#item_id_aux": "($item_id * 65536)" }
  },
  "survival_tab_icons@global.empty_panel": {
    "offset": [0.4, 0],
    "size": [24, 25],
    "controls": [
      {
        "search@global.empty_panel": {
          "ignored": "(not ($tab_view_binding_name = search_tab_toggle))",
          "controls": [{ "compass@crafting_common.tab_item_renderer": { "$item_id": 416 } }]
        }
      },
      {
        "equipment@global.empty_panel": {
          "ignored": "(not ($tab_view_binding_name = equipment_tab_toggle))",
          "controls": [
            {
              "golden_sword@crafting_common.tab_item_renderer": { "layer": 7, "offset": [4, 0], "$item_id": 347 }
            },
            { "iron_axe@crafting_common.tab_item_renderer": { "layer": 6, "offset": [-7, 0], "$item_id": 322 } }
          ]
        }
      },
      {
        "construction@global.empty_panel": {
          "ignored": "(not ($tab_view_binding_name = construction_tab_toggle))",
          "controls": [{ "bricks@crafting_common.tab_item_renderer": { "$item_id": 45 } }]
        }
      },
      {
        "nature@global.empty_panel": {
          "ignored": "(not ($tab_view_binding_name = nature_tab_toggle))",
          "controls": [
            { "apple@crafting_common.tab_item_renderer": { "layer": 7, "offset": [4, 0], "$item_id": 278 } },
            {
              "lava_bucket@crafting_common.tab_item_renderer": { "layer": 6, "offset": [-7, 0], "$item_id": 388 }
            }
          ]
        }
      },
      {
        "items@global.empty_panel": {
          "ignored": "(not ($tab_view_binding_name = items_tab_toggle))",
          "controls": [{ "redstone_dust@crafting_common.tab_item_renderer": { "$item_id": 398 } }]
        }
      }
    ]
  },
  "survival_tab_base@toggle.toggle": {
    "$toggle_offset": [5, 3],
    "size": [35, 27],
    "$unchecked_offset": [5, 3],
    "$checked_offset": [3, 3],
    "$toggle_base_offset_unchecked": [5, 3],
    "$toggle_base_offset_checked": [3, 3],
    "$toggle_binding_type": "global",
    "$toggle_focus_enabled": false,
    "$is_left_tab": true,
    "$toggle_name": "navigation_tab",
    "$tab_icon": "crafting_common.survival_tab_icon",
    "$toggle_state_binding_name": "#toggle_state",
    "$tab_content": "crafting_common.survival_tab_icons"
  },
  "recipe_toggle_base@toggle.toggle": {
    "type": "panel",
    "size": [20, 18],
    "$unchecked_default_image": "assets/sprites/recipe_book/button",
    "$unchecked_hover_image": "assets/sprites/recipe_book/button_highlighted",
    "$unchecked_locked_image": "assets/sprites/recipe_book/button_highlighted",
    "$unchecked_locked_hover_image": "assets/sprites/recipe_book/button_highlighted",
    "$checked_default_image|default": "assets/sprites/recipe_book/button",
    "$checked_hover_image|default": "assets/sprites/recipe_book/button_highlighted",
    "$checked_locked_image|default": "assets/sprites/recipe_book/button_highlighted",
    "$checked_locked_hover_image|default": "assets/sprites/recipe_book/button_highlighted",
    "variables": {
      "requires": "($cb_is_thick_menu_buttons = true)",
      "$unchecked_default_image": "assets/minecraft/textures/gui/sprites/recipe_book/button",
      "$unchecked_hover_image": "assets/minecraft/textures/gui/sprites/recipe_book/button_highlighted",
      "$unchecked_locked_image": "assets/minecraft/textures/gui/sprites/recipe_book/button_highlighted",
      "$unchecked_locked_hover_image": "assets/minecraft/textures/gui/sprites/recipe_book/button_highlighted",
      "$checked_default_image|default": "assets/minecraft/textures/gui/sprites/recipe_book/button",
      "$checked_hover_image|default": "assets/minecraft/textures/gui/sprites/recipe_book/button_highlighted",
      "$checked_locked_image|default": "assets/minecraft/textures/gui/sprites/recipe_book/button_highlighted",
      "$checked_locked_hover_image|default": "assets/minecraft/textures/gui/sprites/recipe_book/button_highlighted"
    },
    "$is_tab": false,
    "$recipe_inventory": true,
    "$texture_sould_keep_ratio": true,
    "$toggle_binding_type": "global",
    "$toggle_name": "layout_toggle",
    "$tab_view_binding_name": "inventory_layout",
    "$toggle_state_binding_name": "#toggle_state"
  },
  "recipe_layout_toggle@global.empty_panel": {
    "size": [20, 18],
    "layer": 10,
    "controls": [
      {
        "recipe_book_layout_toggle@crafting_common.recipe_toggle_base": {
          "$toggle_group_forced_index": "$recipe_book_layout_index",
          "$toggle_state_binding_name": "#is_recipe_book_layout",
          "bindings": [
            {
              "binding_type": "global",
              "binding_name": "(not #is_recipe_book_layout)",
              "binding_name_override": "#visible"
            }
          ]
        }
      },
      {
        "survival_inventory_toggle@crafting_common.recipe_toggle_base": {
          "$toggle_group_forced_index": "$survival_layout_index",
          "$toggle_state_binding_name": "#is_survival_layout",
          "bindings": [
            {
              "binding_type": "global",
              "binding_name": "#is_recipe_book_layout",
              "binding_name_override": "#visible"
            }
          ]
        }
      }
    ]
  }
}
