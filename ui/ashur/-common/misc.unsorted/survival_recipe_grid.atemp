{
  "namespace": "survival_recipe_grid",
  "recipe_grid@global.empty_panel": {
    "clips_children": true,
    "size": [125, 100],
    "layer": 4,
    "offset": [-11, 31],
    "anchor_to": "top_right",
    "anchor_from": "top_right",
    "$item_collection|default": "recipe_book",
    "controls": [
      {
        "grid_holder@global.empty_panel": {
          "size": [125, "100%c"],
          "anchor_to": "top_left",
          "anchor_from": "top_left",
          "offset": [0, -0.4],
          "controls": [
            {
              "recipe_book_grid": {
                "type": "grid",
                "size": [125, "default"],
                "collection_name": "$item_collection",
                "grid_rescaling_type": "horizontal",
                "grid_item_template": "survival_recipe_grid.item_template",
                "bindings": [
                  {
                    "binding_name": "#recipe_book_total_items",
                    "binding_name_override": "#maximum_grid_items",
                    "binding_condition": "visible",
                    "binding_type": "collection",
                    "binding_collection_name": "recipe_book"
                  },
                  {
                    "binding_type": "view",
                    "binding_condition": "always",
                    "source_property_name": "((#maximum_grid_items + 19) / 20)",
                    "target_property_name": "#maximum_recipe_pages"
                  },
                  {"binding_type":"view","source_control_name":"page1","source_property_name":"#toggle_state","target_property_name":"#current_page_1"},
                  {"binding_type":"view","source_control_name":"page2","source_property_name":"#toggle_state","target_property_name":"#current_page_2"},
                  {"binding_type":"view","source_control_name":"page3","source_property_name":"#toggle_state","target_property_name":"#current_page_3"},
                  {"binding_type":"view","source_control_name":"page4","source_property_name":"#toggle_state","target_property_name":"#current_page_4"},
                  {"binding_type":"view","source_control_name":"page5","source_property_name":"#toggle_state","target_property_name":"#current_page_5"},
                  {"binding_type":"view","source_control_name":"page6","source_property_name":"#toggle_state","target_property_name":"#current_page_6"},
                  {"binding_type":"view","source_control_name":"page7","source_property_name":"#toggle_state","target_property_name":"#current_page_7"},
                  {"binding_type":"view","source_control_name":"page8","source_property_name":"#toggle_state","target_property_name":"#current_page_8"},
                  {"binding_type":"view","source_control_name":"page9","source_property_name":"#toggle_state","target_property_name":"#current_page_9"},
                  {"binding_type":"view","source_control_name":"page10","source_property_name":"#toggle_state","target_property_name":"#current_page_10"},
                  {"binding_type":"view","source_control_name":"page11","source_property_name":"#toggle_state","target_property_name":"#current_page_11"},
                  {"binding_type":"view","source_control_name":"page12","source_property_name":"#toggle_state","target_property_name":"#current_page_12"},
                  {"binding_type":"view","source_control_name":"page13","source_property_name":"#toggle_state","target_property_name":"#current_page_13"},
                  {"binding_type":"view","source_control_name":"page14","source_property_name":"#toggle_state","target_property_name":"#current_page_14"},
                  {"binding_type":"view","source_control_name":"page15","source_property_name":"#toggle_state","target_property_name":"#current_page_15"},
                  {"binding_type":"view","source_control_name":"page16","source_property_name":"#toggle_state","target_property_name":"#current_page_16"},
                  {"binding_type":"view","source_control_name":"page17","source_property_name":"#toggle_state","target_property_name":"#current_page_17"},
                  {"binding_type":"view","source_control_name":"page18","source_property_name":"#toggle_state","target_property_name":"#current_page_18"},
                  {"binding_type":"view","source_control_name":"page19","source_property_name":"#toggle_state","target_property_name":"#current_page_19"},
                  {"binding_type":"view","source_control_name":"page20","source_property_name":"#toggle_state","target_property_name":"#current_page_20"},
                  {"binding_type":"view","source_control_name":"page21","source_property_name":"#toggle_state","target_property_name":"#current_page_21"},
                  {"binding_type":"view","source_control_name":"page22","source_property_name":"#toggle_state","target_property_name":"#current_page_22"},
                  {"binding_type":"view","source_control_name":"page23","source_property_name":"#toggle_state","target_property_name":"#current_page_23"},
                  {"binding_type":"view","source_control_name":"page24","source_property_name":"#toggle_state","target_property_name":"#current_page_24"},
                  {"binding_type":"view","source_control_name":"page25","source_property_name":"#toggle_state","target_property_name":"#current_page_25"},
                  {"binding_type":"view","source_control_name":"page26","source_property_name":"#toggle_state","target_property_name":"#current_page_26"},
                  {"binding_type":"view","source_control_name":"page27","source_property_name":"#toggle_state","target_property_name":"#current_page_27"},
                  {"binding_type":"view","source_control_name":"page28","source_property_name":"#toggle_state","target_property_name":"#current_page_28"},
                  {"binding_type":"view","source_control_name":"page29","source_property_name":"#toggle_state","target_property_name":"#current_page_29"},
                  {"binding_type":"view","source_control_name":"page30","source_property_name":"#toggle_state","target_property_name":"#current_page_30"},
                  {"binding_type":"view","source_control_name":"page31","source_property_name":"#toggle_state","target_property_name":"#current_page_31"},
                  {"binding_type":"view","source_control_name":"page32","source_property_name":"#toggle_state","target_property_name":"#current_page_32"},
                  {"binding_type":"view","source_control_name":"page33","source_property_name":"#toggle_state","target_property_name":"#current_page_33"},
                  {"binding_type":"view","source_control_name":"page34","source_property_name":"#toggle_state","target_property_name":"#current_page_34"},
                  {"binding_type":"view","source_control_name":"page35","source_property_name":"#toggle_state","target_property_name":"#current_page_35"},
                  {"binding_type":"view","source_control_name":"page36","source_property_name":"#toggle_state","target_property_name":"#current_page_36"},
                  {"binding_type":"view","source_control_name":"page37","source_property_name":"#toggle_state","target_property_name":"#current_page_37"},
                  {"binding_type":"view","source_control_name":"page38","source_property_name":"#toggle_state","target_property_name":"#current_page_38"},
                  {"binding_type":"view","source_control_name":"page39","source_property_name":"#toggle_state","target_property_name":"#current_page_39"},
                  {"binding_type":"view","source_control_name":"page40","source_property_name":"#toggle_state","target_property_name":"#current_page_40"},
                  {"binding_type":"view","source_control_name":"page41","source_property_name":"#toggle_state","target_property_name":"#current_page_41"},
                  {"binding_type":"view","source_control_name":"page42","source_property_name":"#toggle_state","target_property_name":"#current_page_42"},
                  {"binding_type":"view","source_control_name":"page43","source_property_name":"#toggle_state","target_property_name":"#current_page_43"},
                  {"binding_type":"view","source_control_name":"page44","source_property_name":"#toggle_state","target_property_name":"#current_page_44"},
                  {"binding_type":"view","source_control_name":"page45","source_property_name":"#toggle_state","target_property_name":"#current_page_45"},
                  {"binding_type":"view","source_control_name":"page46","source_property_name":"#toggle_state","target_property_name":"#current_page_46"},
                  {
                    "binding_type": "view",
                    "binding_condition": "always",
                    "source_property_name": "('#page_' + (1 + (#current_page_1 + #current_page_2 + #current_page_3 + #current_page_4 + #current_page_5 + #current_page_6 + #current_page_7 + #current_page_8 + #current_page_9 + #current_page_10 + #current_page_11 + #current_page_12 + #current_page_13 + #current_page_14 + #current_page_15 + #current_page_16 + #current_page_17 + #current_page_18 + #current_page_19 + #current_page_20 + #current_page_21 + #current_page_22 + #current_page_23 + #current_page_24 + #current_page_25 + #current_page_26 + #current_page_27 + #current_page_28 + #current_page_29 + #current_page_30 + #current_page_31 + #current_page_32 + #current_page_33 + #current_page_34 + #current_page_35 + #current_page_36 + #current_page_37 + #current_page_38 + #current_page_39 + #current_page_40 + #current_page_41 + #current_page_42 + #current_page_43 + #current_page_44 + #current_page_45 + #current_page_46)))",
                    "target_property_name": "#offset"
                  }
                ],
                "offset": "#offset",
                "property_bag": {
                  "#page_1": [0, 0],
                  "#page_2": [0, -100],
                  "#page_3": [0, -200],
                  "#page_4": [0, -300],
                  "#page_5": [0, -400],
                  "#page_6": [0, -500],
                  "#page_7": [0, -600],
                  "#page_8": [0, -700],
                  "#page_9": [0, -800],
                  "#page_10": [0, -900],
                  "#page_11": [0, -1000],
                  "#page_12": [0, -1100],
                  "#page_13": [0, -1200],
                  "#page_14": [0, -1300],
                  "#page_15": [0, -1400],
                  "#page_16": [0, -1500],
                  "#page_17": [0, -1600],
                  "#page_18": [0, -1700],
                  "#page_19": [0, -1800],
                  "#page_20": [0, -1900],
                  "#page_21": [0, -2000],
                  "#page_22": [0, -2100],
                  "#page_23": [0, -2200],
                  "#page_24": [0, -2300],
                  "#page_25": [0, -2400],
                  "#page_26": [0, -2500],
                  "#page_27": [0, -2600],
                  "#page_28": [0, -2700],
                  "#page_29": [0, -2800],
                  "#page_30": [0, -2900],
                  "#page_31": [0, -3000],
                  "#page_32": [0, -3100],
                  "#page_33": [0, -3200],
                  "#page_34": [0, -3300],
                  "#page_35": [0, -3400],
                  "#page_36": [0, -3500],
                  "#page_37": [0, -3600],
                  "#page_38": [0, -3700],
                  "#page_39": [0, -3800],
                  "#page_40": [0, -3900],
                  "#page_41": [0, -4000],
                  "#page_42": [0, -4100],
                  "#page_43": [0, -4200],
                  "#page_44": [0, -4300],
                  "#page_45": [0, -4400],
                  "#page_46": [0, -4500]
                }
              }
            }
          ]
        }
      }
    ]
  },
  "item_template": {
    "type": "input_panel",
    "size": [25, 25],
    "layer": 4,
    "$binding_value|default": "#none",
    "$cell_image_binding|default": "#none",
    "$texture|default": "textures/ui/white",
    "controls": [
      {
        "item_holder@global.empty_panel": {
          "size": [20, 20],
          "anchor_from": "top_left",
          "anchor_to": "top_left",
          "offset": [2, 2],
          "controls": [{ "item_renderer@jc_container_item.item_renderer": { "size": [16, 16] } }]
        }
      },
      {
        "recipe_button@button_mappings.recipe_button_item": {
          "hover_control": "hover",
          "layer": 2,
          "bindings": [
            {
              "binding_type": "collection_details",
              "binding_collection_name": "recipe_book",
              "binding_condition": "once"
            }
          ],
          "controls": [
            {
              "hover@global.hover_text": {
                "offset": [10, -10],
                "layer": 300,
                "ignored": "$touch",
                "$hover_text_binding_name|default": "#hover_text",
                "bindings": [
                  {
                    "binding_name": "$hover_text_binding_name",
                    "binding_name_override": "#hover_remove_text",
                    "binding_condition": "always",
                    "binding_type": "collection",
                    "binding_collection_name": "$item_collection"
                  },
                  {
                    "binding_type": "view",
                    "binding_condition": "always_when_visible",
                    "source_property_name": "(#hover_remove_text - '\n§9§9sr1.atemp§r'')",
                    "target_property_name": "#hover_text"
                  }
                ]
              }
            }
          ]
        }
      },
      {
        "slot_craftable@survival_recipe_grid.cell_image": {
          "$cell_image_binding": "(#container_item_background_texture = 'textures/ui/recipe_book_item_bg')",
          "$texture": "assets/sprites/recipe_book/slot_craftable"
        }
      },
      {
        "slot_uncraftable@survival_recipe_grid.cell_image": {
          "$cell_image_binding": "(#container_item_background_texture = 'textures/ui/recipe_book_red_button')",
          "$texture": "assets/sprites/recipe_book/slot_uncraftable"
        }
      },
      {
        "selected_slot_craftable@survival_recipe_grid.touch_selected": {
          "$binding_value": "(not (#container_item_background = 3))",
          "$texture": "assets/sprites/recipe_book/slot_craftable"
        }
      },
      {
        "selected_slot_uncraftable@survival_recipe_grid.touch_selected": {
          "$binding_value": "(#container_item_background = 3)",
          "$texture": "assets/sprites/recipe_book/slot_uncraftable"
        }
      }
    ]
  },
  "touch_selected@global.empty_panel": {
    "controls": [
      {
        "touch_item@global.empty_image": {
          "size": [25, 25],
          "texture": "$texture",
          "property_bag": { "#collection_name": "crafting_output_items", "#collection_index": 0 },
          "bindings": [
            {
              "binding_name": "$binding_value",
              "binding_name_override": "#visible",
              "binding_type": "collection",
              "binding_collection_name": "crafting_output_items",
              "binding_condition": "always"
            }
          ]
        }
      }
    ],
    "bindings": [
      {
        "binding_name": "(#container_item_background_texture = 'textures/ui/recipe_book_touch_cell_selected')",
        "binding_name_override": "#visible",
        "binding_type": "collection",
        "binding_collection_name": "recipe_book"
      }
    ]
  },
  "cell_image@global.empty_image": {
    "size": [25, 25],
    "texture": "$texture",
    "bindings": [
      {
        "binding_name": "$cell_image_binding",
        "binding_name_override": "#visible",
        "binding_type": "collection",
        "binding_collection_name": "recipe_book"
      }
    ]
  }
}
