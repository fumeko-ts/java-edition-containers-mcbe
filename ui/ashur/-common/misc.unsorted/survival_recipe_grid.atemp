{
  "namespace": "survival_recipe_grid",
  "recipe_grid@global.empty_panel": {
    "clips_children": true,
    "size": [125, 100],
    "layer": 4,
    "offset": [-11, 31],
    "anchor_to": "top_right",
    "anchor_from": "top_right",
    "$item_collection_name|default": "recipe_book",
    "controls": [
      {
        "grid_holder@global.empty_panel": {
          "size": [125, "100%c"],
          "anchor_to": "top_left",
          "anchor_from": "top_left",
          "offset": [0, -0.4],
          "controls": [
            {
              "recipe_grid": {
                "type": "grid",
                "size": [125, "default"],
                "collection_name": "$item_collection_name",
                "grid_rescaling_type": "horizontal",
                "grid_item_template": "survival_recipe_grid.item_template",
                "bindings": "$recipe_book_bindings",
                "offset": "#offset",
                "property_bag": {
                  "#page_1" : [0,     0],"#page_2" : [0,  -100],
                  "#page_3" : [0,  -200],"#page_4" : [0,  -300],
                  "#page_5" : [0,  -400],"#page_6" : [0,  -500],
                  "#page_7" : [0,  -600],"#page_8" : [0,  -700],
                  "#page_9" : [0,  -800],"#page_10": [0,  -900],
                  "#page_11": [0, -1000],"#page_12": [0, -1100],
                  "#page_13": [0, -1200],"#page_14": [0, -1300],
                  "#page_15": [0, -1400],"#page_16": [0, -1500],
                  "#page_17": [0, -1600],"#page_18": [0, -1700],
                  "#page_19": [0, -1800],"#page_20": [0, -1900],
                  "#page_21": [0, -2000],"#page_22": [0, -2100],
                  "#page_23": [0, -2200],"#page_24": [0, -2300],
                  "#page_25": [0, -2400],"#page_26": [0, -2500],
                  "#page_27": [0, -2600]
                }
              }
            }
          ]
        }
      }
    ]
  },
  "item_template": {
    "type": "input_panel",
    "size": [25, 25],
    "layer": 4,
    "$binding_value|default": "#none",
    "$cell_image_binding|default": "#none",
    "$texture|default": "textures/ui/white",
    "controls": [
      {
        "item_holder@global.empty_panel": {
          "size": [20, 20],
          "anchor_from": "top_left",
          "anchor_to": "top_left",
          "offset": [2, 2],
          "controls": [
            { "item_renderer@common.item_renderer": { "size": [16, 16] } }
          ]
        }
      },
      {
        "recipe_button@button_mappings.recipe_button_item": {
          "hover_control": "hover",
          "layer": 2,
          "bindings": [
            {
              "binding_type": "collection_details",
              "binding_collection_name": "recipe_book",
              "binding_condition": "once"
            }
          ],
          "controls": [
            {
              "hover@global.hover_text": {
                "offset": [10, -10],
                "layer": 300,
                "$hover_text_binding_name|default": "#hover_text",
                "bindings": [
                  {
                    "binding_name": "$hover_text_binding_name",
                    "binding_name_override": "#hover_remove_text",
                    "binding_condition": "always",
                    "binding_type": "collection",
                    "binding_collection_name": "$item_collection_name"
                  },
                  {
                    "binding_type": "view",
                    "binding_condition": "always_when_visible",
                    "source_property_name": "(#hover_remove_text - '\n§9§9sr1.atemp§r'')",
                    "target_property_name": "#hover_text"
                  }
                ]
              }
            }
          ]
        }
      },
      {
        "slot_craftable@survival_recipe_grid.cell_image": {
          "$cell_image_binding": "(#container_item_background_texture = 'textures/ui/recipe_book_item_bg')",
          "$texture": "assets/sprites/recipe_book/slot_craftable"
        }
      },
      {
        "slot_uncraftable@survival_recipe_grid.cell_image": {
          "$cell_image_binding": "(#container_item_background_texture = 'textures/ui/recipe_book_red_button')",
          "$texture": "assets/sprites/recipe_book/slot_uncraftable"
        }
      },
      {
        "selected_slot_craftable@survival_recipe_grid.touch_selected": {
          "$binding_value": "(not (#container_item_background = 3))",
          "$texture": "assets/sprites/recipe_book/slot_craftable"
        }
      },
      {
        "selected_slot_uncraftable@survival_recipe_grid.touch_selected": {
          "$binding_value": "(#container_item_background = 3)",
          "$texture": "assets/sprites/recipe_book/slot_uncraftable"
        }
      }
    ]
  },
  "touch_selected@global.empty_panel":{
    "controls": [
      {
        "touch_item@global.empty_image": {
          "size": [25, 25],
          "texture": "$texture",
          "property_bag": { "#collection_name": "crafting_output_items", "#collection_index": 0 },
          "bindings": [
            {
              "binding_name": "$binding_value",
              "binding_name_override": "#visible",
              "binding_type": "collection",
              "binding_collection_name": "crafting_output_items",
              "binding_condition": "always"
            }
          ]
        }
      }
    ],
    "bindings": [
      {
        "binding_name": "(#container_item_background_texture = 'textures/ui/recipe_book_touch_cell_selected')",
        "binding_name_override": "#visible",
        "binding_type": "collection",
        "binding_collection_name": "recipe_book"
      }
    ]
  },
  "cell_image@global.empty_image": {
    "size": [25, 25],
    "texture": "$texture",
    "bindings": [
      {
        "binding_name": "$cell_image_binding",
        "binding_name_override": "#visible",
        "binding_type": "collection",
        "binding_collection_name": "recipe_book"
      }
    ]
  }
}

