{
  "namespace": "trade_global",
  "toggle_content@global.empty_panel": {
    "size": [88, 20],
    "controls": [
      {
        "arrow_holder@global.empty_stack": {
          "orientation": "vertical",
          "size": [10, 20],
          "offset": [-23, 0],
          "anchor_to": "right_middle",
          "anchor_from": "right_middle",
          "controls": [
            { "filler_1@global.empty_panel": { "size": ["fill", 4] } },
            {
              "arrow_holder@global.empty_panel": {
                "size": [10, 9],
                "$alpha|default": 1.0,
                "variables": {
                  "requires": "($locked_toggle = true)",
                  "$alpha|default": 0.25
                },
                "controls": [
                  {
                    "trade_cross_out@screen_content.image_element": {
                      "texture": "assets/sprites/container/villager/trade_arrow_out_of_stock",
                      "size": [10, 9],
                      "anchor_from": "center",
                      "anchor_to": "center",
                      "layer": 5,
                      "alpha": "$alpha",
                      "bindings": [
                        { "binding_type": "collection_details" },
                        { "binding_name": "#trade_cross_out_visible", "binding_name_override": "#visible" }
                      ]
                    }
                  },

                  {
                    "trade_arrow@screen_content.image_element": {
                      "texture": "assets/sprites/container/villager/trade_arrow",
                      "size": [10, 9],
                      "anchor_from": "center",
                      "anchor_to": "center",
                      "layer": 5,
                      "alpha": "$alpha",
                      "bindings": [
                        { "binding_type": "collection_details" },
                        { "binding_name": "(not #trade_cross_out_visible)", "binding_name_override": "#visible" }
                      ]
                    }
                  }
                ]
              }
            },
            { "filler_2@global.empty_panel": { "size": ["fill", 7] } }
          ]
        }
      }
    ]
  },
  "collection": {
    "type": "collection_panel",
    "size": [88, 20],
    "anchor_to": "center",
    "anchor_from": "center",
    "collection_name": "$item_collection"
  },
  "second_trade_item_count@global.empty_label": {
    "color": "white",
    "shadow": true,
    "layer": 5,
    "anchor_from": "bottom_right",
    "anchor_to": "bottom_right",
    "offset": [1, 2],
    "text": "#second_trade_item_count",
    "bindings": [
      { "binding_type": "collection_details" },
      { "binding_name": "#second_trade_item_count" },
      {
        "binding_type": "view",
        "binding_condition": "always",
        "ignored": "$is_second_item",
        "source_property_name": "(not (#second_trade_item_count = '1'))",
        "target_property_name": "#visible"
      }
    ]
  },
  "item_renderer@jc_container_item.item_renderer": {
    "size": [16, 16],
    "anchor_from": "bottom_right",
    "anchor_to": "bottom_right",
    "layer": 4,
    "bindings": [
      { "binding_type": "collection_details" },
      { "binding_name": "#item_id_aux" },
      { "binding_name": "#item_custom_color" },
      { "binding_name": "#item_pickup_time" },
      { "binding_name": "#banner_patterns" },
      { "binding_name": "#banner_colors" },
      { "binding_name": "#banner_type" }
    ]
  },
  "hover_text_button": {
    "type": "button",
    "layer": 500,
    "size": [16, 16],
    "offset": [-1, -1],
    "anchor_from": "bottom_right",
    "anchor_to": "bottom_right",
    "default_focus_precedence": 1,
    "hover_control": "hover_text",
    "consume_event": false,
    "button_mappings": [
      { "to_button_id": "button.container_slot_hovered", "mapping_type": "pressed", "consume_event": false }
    ],
    "controls": [
      {
        "hover_text@common.hover_text": {
          "offset": [10, 0],
          "bindings": [
            { "binding_type": "collection_details" },
            { "binding_name": "#hover_text", "binding_condition": "visible" }
          ]
        }
      }
    ]
  },
  "trade_toggle@common.toggle": {
    "button_mappings": [
      {
        "from_button_id": "button.menu_select",
        "to_button_id": "button.trade_select",
        "mapping_type": "pressed"
      },
      {
        "from_button_id": "button.menu_secondary_select",
        "to_button_id": "button.trade_secondary_select",
        "mapping_type": "pressed"
      },
      {
        "from_button_id": "button.menu_ok",
        "to_button_id": "button.trade_select",
        "mapping_type": "focused"
      },
      {
        "from_button_id": "button.controller_back",
        "to_button_id": "button.trade_select",
        "mapping_type": "focused",
        "ignored": "(not $is_ps4)"
      },
      { "to_button_id": "button.trade_toggle_hovered", "mapping_type": "pressed" }
    ],
    "$unchecked_control": "trade_global.unchecked_control",
    "$checked_control": "trade_global.checked_control",
    "$unchecked_hover_control": "trade_global.unchecked_hover_control",
    "$checked_hover_control": "trade_global.checked_hover_control",
    "variables": {
      "requires": "($cb_is_thick_menu_buttons = true)",
      "$unchecked_control": "thickly.unchecked_control",
      "$checked_control": "thickly.checked_control",
      "$unchecked_hover_control": "thickly.unchecked_hover_control",
      "$checked_hover_control": "thickly.checked_hover_control"
    },
    "$unchecked_locked_control": "trade_global.locked_control",
    "$unchecked_locked_hover_control": "trade_global.locked_control",
    "$checked_locked_control": "trade_global.locked_control",
    "$checked_locked_hover_control": "trade_global.locked_control",
    "controls": [
      {
        "contents@global.empty_panel": {
          "$is_second_item|default": false,
          "size": [88, 20],
          "offset": [1, 1],
          "controls": [
            {
              "item_1@trade_global.collection": {
                "layer": 6,
                "$item_collection": "trade_item_1",
                "controls": [
                  {
                    "item_1@global.empty_panel": {
                      "size": [21, 17],
                      "anchor_from": "top_left",
                      "anchor_to": "top_left",
                      "controls": [
                        {
                          "item_counts@global.empty_panel": {
                            "size": [21, 17],
                            "controls": [
                              {
                                "item_count_default@trade_global.label_template": {
                                  "$item_count_binding_name": "(not #trade_price_different)"
                                }
                              },
                              {
                                "item_count_changed@trade_global.label_template": {
                                  "$item_count_binding_name": "#trade_price_different",
                                  "controls": [
                                    {
                                      "red_slash@trade_global.red_slash": {
                                        "size": [6, 2],
                                        "$slash_binding": "#single_slash_visible"
                                      }
                                    },
                                    {
                                      "red_slash_double@trade_global.red_slash": {
                                        "size": [12, 2],
                                        "$slash_binding": "#double_slash_visible"
                                      }
                                    }
                                  ]
                                }
                              },
                              { "hover_control@trade_global.hover_text_button": {} }
                            ]
                          }
                        },
                        { "item_renderer@trade_global.item_renderer": {} }
                      ]
                    }
                  },
                  {
                    "label_2_holder@global.empty_panel": {
                      "size": [35, 17],
                      "anchor_to": "top_left",
                      "anchor_from": "top_left",
                      "$is_second_item": true,
                      "controls": [{ "second_trade_count@trade_global.second_trade_item_count": {} }],
                      "bindings": [
                        { "binding_type": "collection_details" },
                        { "binding_name": "#double_slash_visible" },
                        { "binding_name": "#single_slash_visible" },
                        {
                          "binding_type": "view",
                          "binding_condition": "always",
                          "source_property_name": "(#double_slash_visible or #single_slash_visible)",
                          "target_property_name": "#visible"
                        }
                      ]
                    }
                  }
                ]
              }
            },
            {
              "item_2@trade_global.collection": {
                "layer": 6,
                "$item_collection": "trade_item_2",
                "controls": [
                  {
                    "item_2@global.empty_panel": {
                      "size": [52, 17],
                      "anchor_from": "top_left",
                      "anchor_to": "top_left",
                      "controls": [
                        {
                          "item_counts@global.empty_panel": {
                            "size": [52, 17],
                            "controls": [{ "hover_control@trade_global.hover_text_button": {} }]
                          }
                        },
                        { "item_renderer@trade_global.item_renderer": {} }
                      ]
                    }
                  },
                  {
                    "label_2_holder@global.empty_panel": {
                      "size": [52, 17],
                      "anchor_to": "top_left",
                      "anchor_from": "top_left",
                      "controls": [{ "second_trade_count@trade_global.second_trade_item_count": {} }]
                    }
                  }
                ]
              }
            },
            {
              "item_3@trade_global.collection": {
                "layer": 6,
                "$item_collection": "sell_item",
                "controls": [
                  {
                    "item_3@global.empty_panel": {
                      "size": [84, 17],
                      "anchor_from": "top_left",
                      "anchor_to": "top_left",
                      "controls": [
                        {
                          "hover_text@global.empty_panel": {
                            "size": [84, 17],
                            "controls": [{ "hover_control@trade_global.hover_text_button": {} }]
                          }
                        },
                        { "item_renderer@trade_global.item_renderer": {} }
                      ]
                    }
                  },
                  {
                    "label_2_holder@global.empty_panel": {
                      "size": [84, 17],
                      "anchor_to": "top_left",
                      "anchor_from": "top_left",
                      "controls": [{ "second_trade_count@trade_global.second_trade_item_count": {} }]
                    }
                  }
                ]
              }
            }
          ]
        }
      },
      { "unchecked@$unchecked_control": {} },
      { "checked@$checked_control": {} },
      { "unchecked_hover@$unchecked_hover_control": {} },
      { "checked_hover@$checked_hover_control": {} },
      { "unchecked_locked@$unchecked_locked_control": {} },
      { "checked_locked@$checked_locked_control": {} },
      { "unchecked_locked_hover@$unchecked_locked_hover_control": {} },
      { "checked_locked_hover@$checked_locked_hover_control": {} }
    ]
  },
  "unchecked_control@trade_global.button_state_common": {
    "$button_sprite": "assets/sprites/container/villager/button.png"
  },
  "checked_control@trade_global.button_state_common": {
    "$button_sprite": "assets/sprites/container/villager/button_highlighted.png"
  },
  "unchecked_hover_control@trade_global.button_state_common": {
    "$button_sprite": "assets/sprites/container/villager/button_highlighted.png"
  },
  "checked_hover_control@trade_global.button_state_common": {
    "$button_sprite": "assets/sprites/container/villager/button_highlighted.png"
  },
  "locked_control@trade_global.button_state_common": {
    "$locked_toggle": true,
    "$button_sprite": "assets/sprites/container/villager/button_disabled.png"
  },
  "button_state_common@global.empty_image": {
    "texture": "$button_sprite",
    "nineslice_size": [2, 2, 2, 2],
    "size": [88, 20],
    "offset": [1, 1],
    "layer": 4,
    "$locked_toggle|default": false,
    "controls": [{ "button_content_panel@trade_global.toggle_content": { "layer": 3 } }]
  },
  "red_slash@screen_content.image_element": {
    "keep_ratio": true,
    "size": ["default", 2],
    "nineslice_size": 1,
    "texture": "assets/sprites/container/villager/discount_strikethrough.png",
    "offset": [0, -3],
    "anchor_to": "bottom_right",
    "anchor_from": "bottom_right",
    "layer": 6,
    "bindings": [
      { "binding_type": "collection_details" },
      { "binding_name": "$slash_binding", "binding_name_override": "#visible" }
    ]
  },
  "label_template@global.empty_label": {
    "color": "white",
    "shadow": true,
    "layer": 5,
    "text": "#trade_item_count",
    "anchor_from": "bottom_right",
    "anchor_to": "bottom_right",
    "offset": [1, 2],
    "bindings": [
      { "binding_type": "collection_details" },
      { "binding_name": "#trade_item_count" },
      { "binding_name": "$item_count_binding_name", "binding_name_override": "#visible" },
      {
        "binding_type": "view",
        "binding_condition": "always",
        "source_property_name": "(not (#second_trade_item_count = '1'))",
        "target_property_name": "#visible"
      }
    ]
  }
}
