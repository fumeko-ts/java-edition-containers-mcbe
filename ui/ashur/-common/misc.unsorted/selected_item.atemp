{
  "namespace": "selected_item",

  "selected_item_tooltip_touch": {
    "type": "factory",
    "control_name": "@selected_item.tooltip"
  },
  "tooltip@global.empty_panel": {
    "anchor_to": "bottom_middle",
    "anchor_from": "bottom_middle",
    "size": ["100%c", "100%c"],
    "layer": 3000,
    "offset": [0, -16],
    "controls": [
      {
        "mobile_tooltip_base@screen_content.image_element": {
          "texture": "textures/ui/purpleBorder.png",
          "size": ["100%c + 8px", "100%c + 8px"],
          "nineslice_size": 2,
          "alpha": "@selected_item.anim_item_details_alpha",
          "controls": [
            {
              "hover_text@global.empty_label": {
                "size": ["default", "default"],
                "text": "#hover_text",
                "alpha": "@selected_item.anim_item_details_alpha",
                "shadow": true,
                "localize": false,
                "bindings": [
                  {
                    "binding_name": "#selected_hover_text"
                  },
                  {
                    "binding_type": "view",
                    "binding_condition": "always_when_visible",
                    "source_property_name": "(#selected_hover_text - '\n§9§9sr1.atemp§r')",
                    "target_property_name": "#hover_text"
                  }
                ]
              }
            }
          ]
        }
      }
    ],
    "bindings": [
      {
        "binding_name": "#selected_hover_text"
      },
      {
        "binding_type": "view",
        "binding_condition": "always",
        "source_property_name": "(not (#selected_hover_text = ''))",
        "target_property_name": "#visible"
      }
    ]
  },
  "anim_item_details_alpha": {
    "anim_type": "alpha",
    "easing": "in_quint",
    "destroy_at_end": "selected_item_details",
    "duration": 2,
    "from": 1.0,
    "to": 0
  }
}
