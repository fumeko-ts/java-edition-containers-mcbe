{
  "namespace": "java_hover_text",
  "java_tooltip_test@global.empty_panel": {
    "size": ["200%c", "200%c"],
    "layer": 50,
    "$hover_text|default": "",
    "controls": [
      {
        "tooltip@screen_content.image_element": {
          "layer": 400,
          "texture": "textures/ui/purpleBorder",
          "nineslice_size": 2,
          "allow_clipping": false,
          "anchor_from": "bottom_right",
          "anchor_to": "bottom_right",
          "offset": [30, 30],
          "size": ["100%c + 10px", "100%c + 8px"],
          "controls": [
            {
              "hover_text@global.empty_label": {
                "localize": true,
                "shadow": true,
                "layer": 401,
                "size": ["default", "default"],
                "text": "$hover_text"
              }
            }
          ],
          "ignored": "(not $hover)"
        }
      }
    ]
  }
}
