// this file has the code for every custom slot in my ui centralized for compatability
// if you are a creator and want to make your pack compatible with this one you can embed this file if you want 
// just make sure its in the same path in ui_defs.json - [ui/ashur/-common/misc.unsorted/button_mappings.json]
{
/*
    - DOCUMENTATION HEADER
     -   custom_mapping_template          - base template, inherited by all buttons below
     -   survival_recipe_cell_button      - paginated recipe grid slots
     -   creative_recipe_cell_button      - creative inventory recipe grid slots
     -   container_item_button            - inventory slots
     -   loom_output_button               - loom output slot
     -   crafting_output_button           - crafting output slot
     -   cartography_output_button        - cartography output slot
     -   stonecutter_output_button        - stonecutter output slot
     -   anvil_output_button              - anvil output slot
     -   smithing_output_button           - smithing output slot
     -   grindstone_output_button         - grindstone output slot
     -   trading_output_button            - trading output slot
     -   armor_input_button               - armor slots
     -   offhand_input_button             - offhand slot
  */

  
  "namespace": "button_mappings",

  "custom_mapping_template": {
    "type": "button",
    "focus_enabled": "$game_pad", // true when a controller is connected ?
    "focus_wrap_enabled": false,
    "focus_magnet_enabled": false,
    "default_focus_precedence": 1,

    "$highlight_control|default": "jc_container_item.slot_highlight",
    "hover_control": "hover",
    "pressed_control": "pressed",
    "bindings": [
      {
        "binding_type": "collection_details",
        "binding_collection_name": "$item_collection",
        "binding_condition": "once"
      }
    ],
    "controls": [
      { "hover@$highlight_control": {} }, 
      { "pressed@$highlight_control": {} }
    ],
    "$primary_button_action|default": "",
    "$secondary_button_action|default": "",
    "$tertiary_button_action|default": "",
    "$coalesce_button_action|default": "",

    "$cancel_button_action|default": "button.try_menu_exit",
    "$drop_one_action|default": "button.drop_one",
    "$drop_all_action|default": "button.drop_all",
    "$shape_drawing_action|default": "button.shape_drawing",
    "$hovered_action|default": "button.container_slot_hovered",

    "$has_cancel_button|default": false,
    "$has_shape_drawing|default": true,
    "$has_coalesce_action|default": false,
    "$hover_action_mapping|default": "pressed",
    "variables": {
      "requires": "$touch",
      "$hover_action_mapping|default": "focused"
    },
    
    "button_mappings": [
      { "from_button_id": "button.menu_cancel"                 , "to_button_id": "$cancel_button_action"     , "mapping_type": "pressed"              , "ignored": "(not $has_cancel_button)" },
      { "from_button_id": "button.menu_select"                 , "to_button_id": "$primary_button_action"    , "mapping_type": "pressed"             },
      { "from_button_id": "button.menu_ok"                     , "to_button_id": "$primary_button_action"    , "mapping_type": "pressed"             },
      { "from_button_id": "button.controller_back"             , "to_button_id": "$primary_button_action"    , "mapping_type": "pressed"              , "ignored": "(not $is_ps4)"             },
      { "from_button_id": "button.menu_secondary_select"       , "to_button_id": "$secondary_button_action"  , "mapping_type": "pressed"             },
      { "from_button_id": "button.controller_select"           , "to_button_id": "$secondary_button_action"  , "mapping_type": "pressed"             },
      { "from_button_id": "button.menu_auto_place"             , "to_button_id": "$tertiary_button_action"   , "mapping_type": "pressed"             },
      { "from_button_id": "button.controller_secondary_select" , "to_button_id": "$tertiary_button_action"   , "mapping_type": "pressed"             },
      { "from_button_id": "button.menu_inventory_drop"         , "to_button_id": "$drop_one_action"          , "mapping_type": "pressed"             },
      { "from_button_id": "button.menu_inventory_drop_all"     , "to_button_id": "$drop_all_action"          , "mapping_type": "pressed"             },
      { "to_button_id"  : "$shape_drawing_action"              , "mapping_type": "pressed"                   , "ignored": "(not $has_shape_drawing)" },
      { "from_button_id": "button.menu_select"                 , "to_button_id": "$coalesce_button_action"   , "mapping_type": "double_pressed"       , "ignored": "(not $has_coalesce_action)" },
      { "from_button_id": "button.menu_ok"                     , "to_button_id": "$coalesce_button_action"   , "mapping_type": "double_pressed"       , "ignored": "(not $has_coalesce_action)" },
      { "to_button_id"  : "$hovered_action"                    , "mapping_type": "$hover_action_mapping" }
    ]
  },

  "survival_recipe_cell_button@button_mappings.custom_mapping_template": {
    "$has_cancel_button": true,
    "$primary_button_action": "button.recipe_select",
    "$secondary_button_action": "button.recipe_secondary",
    "$tertiary_button_action": "button.recipe_tertiary"
  },  
  
  "creative_recipe_cell_button@button_mappings.custom_mapping_template": {
    "$has_cancel_button": true,
    "$primary_button_action": "button.recipe_select",
    "$secondary_button_action": "button.recipe_secondary",
    "$tertiary_button_action": "button.recipe_tertiary"
  },

  //item slots ect inventory hotbar ect...
  "container_item_button@button_mappings.custom_mapping_template": {
    "$primary_button_action": "button.container_take_all_place_all",
    "$secondary_button_action": "button.container_take_half_place_one",
    "$tertiary_button_action": "button.container_auto_place",
    "$has_coalesce_action": true,
    "$coalesce_button_action": "button.coalesce_stack"
  },

  //output and input slots below

  "loom_output_button@button_mappings.custom_mapping_template": {
    "$primary_button_action": "button.loom_result_take_all_place_all",
    "$secondary_button_action": "button.loom_result_take_all_place_all",
    "$tertiary_button_action": "button.container_auto_place",
    "$has_shape_drawing": false
  },

  "crafting_output_button@button_mappings.custom_mapping_template": {
    "$has_cancel_button": true,
    "$primary_button_action": "button.crafting_output_primary",
    "$secondary_button_action": "button.crafting_output_secondary",
    "$tertiary_button_action": "button.crafting_output_tertiary"
  },

  "cartography_output_button@button_mappings.custom_mapping_template": {
    "$primary_button_action": "button.cartography_result_take_all_place_all",
    "$secondary_button_action": "button.cartography_result_take_half_place_one",
    "$tertiary_button_action": "button.container_auto_place",
    "$has_shape_drawing": false
  },

  "stonecutter_output_button@button_mappings.custom_mapping_template": {
    "$primary_button_action": "button.stonecutter_result_take_all_place_all",
    "$secondary_button_action": "button.stonecutter_result_take_half_place_one",
    "$tertiary_button_action": "button.container_auto_place",
    "$has_shape_drawing": false
  },

  "anvil_output_button@button_mappings.custom_mapping_template": {
    "$primary_button_action": "button.anvil_take_all_place_all",
    "$secondary_button_action": "button.anvil_take_half_place_one",
    "$tertiary_button_action": "button.container_auto_place",
    "$has_shape_drawing": false,
    "$has_coalesce_action": true,
    "$coalesce_button_action": "button.anvil_coalesce_stack"
  },

  "smithing_output_button@button_mappings.custom_mapping_template": {
    "$primary_button_action": "button.smithing_table_take_all_place_all",
    "$secondary_button_action": "button.smithing_table_take_half_place_one",
    "$tertiary_button_action": "button.container_auto_place",
    "$has_shape_drawing": false,
    "$has_coalesce_action": true,
    "$coalesce_button_action": "button.smithing_table_coalesce_stack"
  },

  "grindstone_output_button@button_mappings.custom_mapping_template": {
    "$primary_button_action": "button.grindstone_take_all_place_all",
    "$secondary_button_action": "button.grindstone_take_half_place_one",
    "$tertiary_button_action": "button.container_auto_place",
    "$has_shape_drawing": false,
    "$has_coalesce_action": true,
    "$coalesce_button_action": "button.grindstone_coalesce_stack"
  },

  "trading_output_button@button_mappings.custom_mapping_template": {
    "$primary_button_action": "button.trade_take_all_place_all",
    "$secondary_button_action": "button.trade_take_half_place_one",
    "$tertiary_button_action": "button.container_auto_place",
    "$has_shape_drawing": false,
    "$has_coalesce_action": true,
    "$coalesce_button_action": "button.trade_coalesce_stack"
  },

  /* inventory special slot buttons */
  
  "armor_input_button@button_mappings.custom_mapping_template": {
    "$has_cancel_button": true,
    "$primary_button_action": "button.container_take_all_place_all",
    "$secondary_button_action": "button.container_take_half_place_one",
    "$tertiary_button_action": "button.container_auto_place"
  },
  
  "offhand_input_button@button_mappings.custom_mapping_template": {
    "$has_cancel_button": true,
    "$primary_button_action": "button.container_take_all_place_all",
    "$secondary_button_action": "button.container_take_half_place_one",
    "$tertiary_button_action": "button.container_auto_place"
  }
}
