{
  "namespace": "java_item_renderer",// performant
  "custom_item_renderer@global.empty_image":{
    "texture": "textures/jc-items/glass_purple.png",
    "size": [16, 16],
    "layer": 10,
    "anchor_from": "center",
    "anchor_to": "center",
    "bindings": [
      {
        "binding_type": "collection",
        "binding_condition": "always",
        "binding_collection_name": "$item_collection_name",
        "binding_name": "#item_id_aux",
        "binding_name_override": "#item_id"
      },
      {
        "binding_type": "view",
        "binding_condition": "always",
        "source_property_name": "((not (#item_id = -1)) and ((#item_id / 65536) = -652))",
        "target_property_name": "#visible"
      }
    ]
  }
}