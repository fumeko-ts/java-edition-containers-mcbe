{
  "namespace": "java_item_renderer",// performant
  "custom_item_renderer@global.empty_image":{
    "texture": "#item_type",
    "size": [16, 16],
    "layer": 10,
    "anchor_from": "center",
    "anchor_to": "center",
    "keep_ratio": true,
    "property_bag": {
      "#item:-652": "textures/jc-items/glass_purple.png"
    },
    "bindings": [
      {
        "binding_type": "collection",
        "binding_collection_name": "$item_collection_name",
        "binding_name": "#item_id_aux"
      },
      {
        "binding_type": "view",
        "binding_condition": "always",
        "source_property_name": "('#item:' + (#item_id_aux / 65536))",
        "target_property_name": "#item_type"
      },
      {
        "binding_type": "view",
        "binding_condition": "always",
        "source_property_name": "(not (#item_id_aux = -1))",
        "target_property_name": "#visible"
      }
    ]
  }
}