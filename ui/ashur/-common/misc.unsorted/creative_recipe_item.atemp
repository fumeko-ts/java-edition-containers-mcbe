{
  "namespace": "creative_recipe_item",
  "item_template": {
    "type": "input_panel",
    "size": [18, 18],
    "focus_enabled": false,
    "focus_wrap_enabled": false,
    "focus_magnet_enabled": false,
    "$item_collection|default": "recipe_book",
    "layer": 4,
    "controls": [
      {
        "item_cell_button@button_mappings.creative_item_button": {
          "$cell_hover_text_bindings|default": [
            {
              "binding_name": "#recipe_hover_text",
              "binding_name_override": "#hover_text",
              "binding_type": "collection",
              "binding_collection_name": "$item_collection"
            }
          ],
          "$dont_render_hover_text|default": false
        }
      },

      { "item_renderer@jc_container_item.item_renderer": { "layer": 7, "size": [16, 16] } },
      {
        "item_overlay_image@screen_content.image_element": {
          "size": [7, 7],
          "offset": [-1, -1],
          "layer": 9,
          "anchor_from": "bottom_right",
          "anchor_to": "bottom_right",
          "property_bag": {
            "#icon_1": "textures/ui/recipe_book_collapse_icon",
            "#icon_2": "textures/ui/recipe_book_expand_icon"
          },
          "bindings": [
            {
              "binding_name": "('#icon_' + #container_item_modifier)",
              "binding_type": "collection",
              "binding_name_override": "#texture",
              "binding_collection_name": "$item_collection",
              "binding_condition": "visible"
            }
          ]
        }
      },

      {
        "touch_selection@screen_content.image_element": {
          "size": [18, 18],
          "texture": "textures/ui/ashur/touch_ui_selected",
          "nineslice_size": 1,
          "layer": 2,
          "ignored": "(not ($touch or $pocket_screen or $pocket_edition))",
          "bindings": [
            {
              "binding_name": "(#container_item_background_texture = 'textures/ui/recipe_book_touch_cell_selected')",
              "binding_name_override": "#visible",
              "binding_type": "collection",
              "binding_collection_name": "$item_collection"
            }
          ]
        }
      },
      {
        "slot_icon@screen_content.image_element": {
          "nineslice_size": [1, 1, 1, 1],
          "layer": 1,
          "texture": "assets/sprites/container/slot.png",
          "size": [18, 18]
        }
      },
      {
        "group_identifier@screen_content.image_element": {
          "size": [16, 16],
          "offset": [1, 1],
          "anchor_from": "top_left",
          "anchor_to": "top_left",
          "layer": 2,
          "uv_size": [1, 1], // grabs the top left most pixel
          "alpha": 0.5,
          "property_bag": {
            "#icon_3": "assets/sprites/container/slot"
          },
          "allow_debug_missing_texture": false,
          "bindings": [
            {
              "binding_name": "('#icon_' + #container_item_modifier)",
              "binding_type": "collection",
              "binding_name_override": "#texture",
              "binding_collection_name": "$item_collection",
              "binding_condition": "visible"
            }
          ]
        }
      }
    ]
  }
}
