{
  "namespace": "creative_recipe_item",
  "item_template": {
    "type": "input_panel",
    "size": [18, 18],
    "focus_enabled": false,
    "focus_wrap_enabled": false,
    "focus_magnet_enabled": false,
    "$item_collection|default": "recipe_book",
    "layer": 4,
    "controls": [
      {
        "recipe_button_item@toggle.radio_toggle": {
          "$size": [18, 18],
          "$toggle_control_name": "creative_items",
          "$toggle_name": "toggle.creative_items",
          "$toggle_binding_value": "#creative_items",
          "$is_radio_toggle": false,

          "$button_volume": 0.0,
          "$button_mappings": [
            {
              "from_button_id": "button.menu_cancel",
              "to_button_id": "button.try_menu_exit",
              "mapping_type": "pressed"
            },
            {
              "from_button_id": "button.menu_select",
              "to_button_id": "button.recipe_select",
              "mapping_type": "pressed"
            },
            {
              "from_button_id": "button.menu_ok",
              "to_button_id": "button.recipe_select",
              "mapping_type": "pressed"
            },
            {
              "from_button_id": "button.controller_back",
              "to_button_id": "button.recipe_select",
              "mapping_type": "pressed",
              "ignored": "(not $is_ps4)"
            },
            {
              "from_button_id": "button.menu_secondary_select",
              "to_button_id": "button.recipe_secondary",
              "mapping_type": "pressed"
            },
            {
              "from_button_id": "button.controller_select",
              "to_button_id": "button.recipe_secondary",
              "mapping_type": "pressed"
            },
            {
              "from_button_id": "button.menu_auto_place",
              "to_button_id": "button.recipe_tertiary",
              "mapping_type": "pressed"
            },
            {
              "from_button_id": "button.controller_secondary_select",
              "to_button_id": "button.recipe_tertiary",
              "mapping_type": "pressed"
            },
            {
              "from_button_id": "button.menu_inventory_drop",
              "to_button_id": "button.drop_one",
              "mapping_type": "pressed"
            },
            {
              "from_button_id": "button.menu_inventory_drop_all",
              "to_button_id": "button.drop_all",
              "mapping_type": "pressed"
            },
            { "to_button_id": "button.shape_drawing", "mapping_type": "pressed" },
            { "to_button_id": "button.container_slot_hovered", "mapping_type": "pressed" }
          ],

          "$radio_collection_condition|default": "once",
          "$radio_collection_name|default": "recipe_book",
          "$dont_render_hover_text|default": false,
          "$cell_hover_text_bindings|default": [
            {
              "binding_name": "$hover_text_binding_name",
              "binding_name_override": "#hover_remove_text",
              "binding_condition": "always",
              "binding_type": "collection",
              "binding_collection_name": "$item_collection"
            },
            {
              "binding_type": "view",
              "binding_condition": "always_when_visible",
              "source_property_name": "(#hover_remove_text - '\n§9§9sr1.atemp§r')",
              "target_property_name": "#hover_text"
            }
          ],
          "$controls|default": [
            { "default_hover@jc_container_item.slot_highlight": {} },
            { "checked_hover@jc_container_item.slot_highlight": {} }
          ]
        }
      },
      {
        "slot_image@global.empty_image": {
          "nineslice_size": [1, 1, 1, 1],
          "layer": 1,
          "texture": "assets/sprites/container/slot.png",
          "size": [18, 18]
        }
      },

      { "item_renderer@jc_container_item.item_renderer": { "layer": 7, "size": [16, 16] } },
      {
        "group_icons@global.empty_panel": {
          "controls": [
            {
              "item_overlay_contract@creative_recipe_item.item_overlay_image": {
                "texture": "textures/ui/recipe_book_collapse_icon",
                "$group_index": 1
              }
            },

            {
              "item_overlay_expand@creative_recipe_item.item_overlay_image": {
                "texture": "textures/ui/recipe_book_expand_icon",
                "$group_index": 2
              }
            }
          ],
          "bindings": [
            {
              "binding_name": "#container_item_modifier",
              "binding_type": "collection",
              "binding_collection_name": "$item_collection",
              "binding_condition": "visible"
            }
          ]
        }
      },

      {
        "touch_selection@screen_content.image_element": {
          "size": [18, 18],
          "texture": "textures/ui/ashur/touch_ui_selected",
          "nineslice_size": 1,
          "layer": 2,
          "ignored": "(not ($touch or $pocket_screen or $pocket_edition))",
          "bindings": [
            {
              "binding_name": "(#container_item_background_texture = 'textures/ui/recipe_book_touch_cell_selected')",
              "binding_name_override": "#visible",
              "binding_type": "collection",
              "binding_collection_name": "$item_collection"
            }
          ]
        }
      }
    ]
  },

  "item_overlay_image@screen_content.image_element": {
    "size": [7, 7],
    "offset": [-1, -1],
    "layer": 9,
    "anchor_from": "bottom_right",
    "anchor_to": "bottom_right",
    "bindings": [
      {
        "binding_type": "view",
        "source_control_name": "group_icons",
        "resolve_sibling_scope": true,
        "source_property_name": "(#container_item_modifier = $group_index)",
        "target_property_name": "#visible"
      }
    ]
  }
}
