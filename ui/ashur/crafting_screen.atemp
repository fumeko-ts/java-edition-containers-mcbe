{
  "namespace": "crafting_screen",
  "screen_base@container_common.container_details": {
    "min_size": [176, 166],
    "max_size": [359, 166],
    "$screen_controls": [
      {
        "base_horizontal_Stack@global.empty_stack": {
          "orientation": "horizontal",
          "anchor_to": "center",
          "anchor_from": "center",
          "min_size": [176, 166],
          "max_size": [359, 166],
          "layer": 1,
          "controls": [
            { "recipe_book@recipe_book.recipe_book": {} },
            {
              "inventory@global.root_panel": {
                "size": [176, 166],
                "controls": [
                  { "container@screen_content.crafting": {} },
                  { "extensions@jc-extensions.crafting_screen": {} },
                  {
                    "crafting_top_stack@global.empty_panel": {
                      "size": [176, 166],
                      "controls": [
                        {
                          "crafting_stack_wrapper@global.empty_stack": {
                            "orientation": "vertical",
                            "anchor_to": "top_left",
                            "anchor_from": "top_left",
                            "size": [176, 70],
                            "controls": [
                              {
                                "crafting_top_margin@global.empty_panel": {
                                  "size": [176, 16],
                                  "controls": [
                                    {
                                      "crafting_label@global.empty_label": {
                                        "anchor_from": "left_middle",
                                        "anchor_to": "left_middle",
                                        "offset": [29, 2],
                                        "layer": 2,
                                        "size": ["default", 10],
                                        "color": "$container_title_color",
                                        "text": "atemp.container.crafting"
                                      }
                                    }
                                  ]
                                }
                              },
                              {
                                "crafting_body_row@global.empty_stack": {
                                  "orientation": "horizontal",
                                  "size": [176, 54],
                                  "controls": [
                                    {
                                      "left_column_stack@global.empty_stack": {
                                        "orientation": "vertical",
                                        "size": [29, 54],
                                        "controls": [
                                          { "toggle_top_spacing@global.empty_panel": { "size": ["fill", 18] } },
                                          {
                                            "toggle_row@global.empty_stack": {
                                              "orientation": "horizontal",
                                              "size": [29, 18],
                                              "controls": [
                                                { "toggle_left_margin@global.empty_panel": { "size": [5, 18] } },
                                                { "recipe_toggle@crafting_common.recipe_layout_toggle": {} },
                                                { "toggle_right_margin@global.empty_panel": { "size": [4, 18] } }
                                              ]
                                            }
                                          },
                                          { "toggle_bottom_spacing@global.empty_panel": { "size": ["fill", 18] } }
                                        ]
                                      }
                                    },
                                    {
                                      "crafting_3x3_grid@global.empty_grid": {
                                        "size": [54, 54],
                                        "grid_dimensions": [3, 3],
                                        "collection_name": "$item_collection",
                                        "$item_collection": "crafting_input_items",
                                        "$background_control": "crafting_textures.main_cell_panel",
                                        "$item_renderer_binding_condition": "always",
                                        "grid_item_template": "jc_container_item.container_item"
                                      }
                                    },
                                    {
                                      "crafting_output_horizontal_spacer@global.empty_panel": { "size": [36, "fill"] }
                                    },
                                    {
                                      "output_stack@global.empty_stack": {
                                        "orientation": "vertical",
                                        "size": [26, 54],
                                        "controls": [
                                          { "output_top_spacing@global.empty_panel": { "size": ["fill", 14] } },
                                          {
                                            "crafting_output_holder@global.empty_panel": {
                                              "size": [26, 26],
                                              "controls": [
                                                {
                                                  "underlay@crafting_textures.main_cell_panel": {
                                                    "$item_collection|default": "crafting_output_items"
                                                  }
                                                },
                                                {
                                                  "crafting_output_slot@jc_container_item.container_item": {
                                                    "$button_control": "button_mappings.crafting_output_button",
                                                    "$item_renderer_binding_condition": "always",
                                                    "$item_collection": "crafting_output_items",
                                                    "anchor_from": "center",
                                                    "anchor_to": "center"
                                                  }
                                                }
                                              ]
                                            }
                                          },
                                          { "output_bottom_spacing@global.empty_panel": { "size": ["fill", 14] } }
                                        ]
                                      }
                                    },
                                    { "crafting_stack_right_spacer@global.empty_panel": { "size": [31, "fill"] } }
                                  ]
                                }
                              }
                            ]
                          }
                        }
                      ]
                    }
                  },
                  { "bottom@global.inventory_bottom_half_with_label": {} }
                ]
              }
            }
          ]
        }
      }
    ]
  }
}
