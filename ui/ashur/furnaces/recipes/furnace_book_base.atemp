{
  "namespace": "furnace_book_base",
  "recipe_book": {
    "type": "panel",
    "size": [ 147, 166 ],
    "$recipe_book_is_open|default": true,
    "controls": [
      {
        "content": {
          "type": "stack_panel",
          "orientation": "vertical",
          "layer": 2,
          "size": [ 35, 84 ],
          "offset": [ -29, 3 ],
          "anchor_to": "top_left",
          "anchor_from": "top_left",
          "controls": [
            { "search@furnace_guide_tabs.search_tab": {} },
            { "atemp@furnace_guide_tabs.food_tab": {} },
            { "equipment_tab@furnace_guide_tabs.blocks_tab": {} },
            { "nature_tab@furnace_guide_tabs.ores_tab": {} }
          ]
        }
      },
      {
        "root_panel@global.root_panel": { // im ngl i have 0 clue why i set no size to this but it seems to work so im just leaving it as is
          "$is_in_recipe_inventory": false,
          "controls": [
            {"1@furnace_tab_food.base_panel": {
                 "bindings": [ 
                  {
                    "binding_type": "view", 
                    "source_control_name": "furnace_food_tab", 
                    "source_property_name": "#toggle_state", 
                    "target_property_name": "#visible"
                  } 
                ]} 
            },
            {"2@pagination.max_page_is_28": {
                 "$max_ashur_page": 2,
                 "$page_content": "furnace_tab_blocks.base_panel",
                 "$left_button_offset_recipe": [ -107.4, 135.5 ],
                 "$right_button_offset_recipe": [ -52.4, 135.5 ],
                 "bindings": [ 
                  {
                    "binding_type": "view", 
                    "source_control_name": "furnace_blocks_tab", 
                    "source_property_name": "#toggle_state", 
                    "target_property_name": "#visible"
                  } 
                ]} 
            },
            {"3@furnace_tab_ores.base_panel": {
                 "bindings": [ 
                  {
                    "binding_type": "view", 
                    "source_control_name": "furnace_ores_tab", 
                    "source_property_name": "#toggle_state", 
                    "target_property_name": "#visible"
                  } 
                ]} 
            },
            {"3@screen_content.recipe_book": { "layer": 1 } }
          ]
        }
      }
    ]
  }
}