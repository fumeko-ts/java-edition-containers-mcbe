{
  "namespace": "crafting_textures",
  "main_cell_panel": {
    "type": "image",
    "size": "$item_renderer_panel_size",
    "$texture_index|default": 0,
    "$cell_images_binding_condition|default": "visible",
    "controls": [
      {
        "cell_image_classic@global.empty_image": {
          "$cell_image_size|default": [ "default", "default" ],
          "size": "$cell_image_size",
          "controls": [
            {
              "item_render@common.item_renderer": {
                "size": "$item_renderer_size",
                "offset": "$item_renderer_offset",
                "anchor_to": "center",
                "anchor_from": "center",
                "alpha": 1,
                "layer": 12
              }
            }
          ],
          "bindings": [
            {
              "binding_type": "view",
              "source_control_name": "$background_image_control_name",
              "resolve_sibling_scope": true,
              "source_property_name": "(#container_item_background = 0)",
              "target_property_name": "#visible"
            }
          ]
        }
      },
      {
        "cell_image_normal@global.empty_image": {
          "$cell_image_size|default": [ "default", "default" ],
          "size": "$cell_image_size",
          "controls": [
            {
              "item_render@common.item_renderer": {
                "size": "$item_renderer_size",
                "offset": "$item_renderer_offset",
                "anchor_to": "center",
                "anchor_from": "center",
                "alpha": 1,
                "layer": 12
              }
            }
          ],
          "bindings": [
            {
              "binding_type": "view",
              "source_control_name": "$background_image_control_name",
              "resolve_sibling_scope": true,
              "source_property_name": "(#container_item_background = 1)",
              "target_property_name": "#visible"
            }
          ]
        }
      },
      {
        "cell_image_invert@global.empty_image": {
          "$cell_image_size|default": [ "default", "default" ],
          "size": "$cell_image_size",
          "controls": [
            {
              "item_render@common.item_renderer": {
                "size": "$item_renderer_size",
                "offset": "$item_renderer_offset",
                "anchor_to": "center",
                "anchor_from": "center",
                "alpha": 1,
                "layer": 12
              }
            }
          ],
          "bindings": [
            {
              "binding_type": "view",
              "source_control_name": "$background_image_control_name",
              "resolve_sibling_scope": true,
              "source_property_name": "(#container_item_background = 2)",
              "target_property_name": "#visible"
            }
          ]
        }
      },
      {
        "cell_image_red@global.empty_image": {
          "nineslice_size": [ 1, 1, 1, 1 ],
          "texture": "textures/atemp/ui/cell_transparent_image_red.png",
          "$cell_image_size|default": [ "default", "default" ],
          "size": "$cell_image_size",
          "$renderer_alpha_cell_var": 10,
          "layer": 10,
          "controls": [
            {
              "item_render@common.item_renderer": {
                "size": "$item_renderer_size",
                "offset": "$item_renderer_offset",
                "anchor_to": "center",
                "anchor_from": "center",
                "alpha": 0.7,
                "layer": 12
              }
            }
          ],
          "bindings": [
            {
              "binding_type": "view",
              "source_control_name": "$background_image_control_name",
              "resolve_sibling_scope": true,
              "source_property_name": "(#container_item_background = 3)",
              "target_property_name": "#visible"
            }
          ]
        }
      },
      {
        "cell_image_selected@global.empty_image": {
          "$cell_image_size|default": [ "default", "default" ],
          "size": "$cell_image_size",
          "controls": [
            {
              "item_render@common.item_renderer": {
                "size": "$item_renderer_size",
                "offset": "$item_renderer_offset",
                "anchor_to": "center",
                "anchor_from": "center",
                "alpha": 1,
                "layer": 12
              }
            }
          ],
          "bindings": [
            {
              "binding_type": "view",
              "source_control_name": "$background_image_control_name",
              "resolve_sibling_scope": true,
              "source_property_name": "(#container_item_background = 4)",
              "target_property_name": "#visible"
            }
          ]
        }
      },
      {
        "cell_image_darkgrey@global.empty_image": {
          "nineslice_size": [ 1, 1, 1, 1 ],
          "texture": "textures/atemp/ui/cell_transparent_image_red.png",
          "$cell_image_size|default": [ "default", "default" ],
          "size": "$cell_image_size",
          "$renderer_alpha_cell_var": 10,
          "layer": 10,
          "controls": [
            {
              "item_render@common.item_renderer": {
                "size": "$item_renderer_size",
                "offset": "$item_renderer_offset",
                "anchor_to": "center",
                "anchor_from": "center",
                "alpha": 0.7,
                "layer": 12
              }
            }
          ],
          "bindings": [
            {
              "binding_type": "view",
              "source_control_name": "$background_image_control_name",
              "resolve_sibling_scope": true,
              "source_property_name": "(#container_item_background = 7)",
              "target_property_name": "#visible"
            }
          ]
        }
      },
      { "stack_count@common.stack_count_label": { "layer": 20 } }
    ],
    "bindings": [
      {
        "binding_name": "#container_item_background",
        "binding_type": "collection",
        "binding_collection_name": "$item_collection_name",
        "binding_condition": "$cell_images_binding_condition"
      }
    ]
  },
  "crafting_input_grid_item@global.inventory_container_item_recipe": {
    "$item_collection_name": "crafting_input_items",
    "$background_images": "crafting_textures.main_cell_panel",
    "$item_renderer_binding_condition": "always",
    "$button_ref": "crafting.inventory_container_slot_button"
  },
  "output_cell_textures@crafting_textures.main_cell_panel": { "$cell_images_binding_condition": "always" }
}