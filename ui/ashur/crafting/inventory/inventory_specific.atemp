{
  "namespace": "inventory_specific",
  "inventory_crafting_stack": {
    "type": "panel",
    "size": [176, 166],
    "controls": [
      {
        "cell_stack@global.empty_stack_panel": {
          "orientation": "vertical",
          "size": [79, 79],
          "anchor_to": "top_right",
          "anchor_from": "top_right",
          "controls": [
            {"buffer_1": {"type": "panel","size": ["default", 5]}},
            {
              "inventory_label": {
                "type":"label",
                "anchor_from": "left_middle",
                "anchor_to": "left_middle",
                "layer": 2,
                "size": [ "100%", 10 ],
                "color": "$title_text_color", 
                "text": "container.crafting"
              }
            },
            {"buffer_1": {"type": "panel","size": ["default", 2]}},
            {
              "cell_stack@global.empty_stack_panel": {
                "orientation": "horizontal",
                "size": [79, 36],
                "controls": [
                   {"grid@inventory_specific.2x2_crafting_grid":{}},
                   {"buffer_2": {"type": "panel","size": [20, 36]}},
                   {
                     "cell_stack@global.empty_stack_panel": {
                       "orientation": "vertical",
                       "size": [23, 36],
                       "controls": [   
                         {"buffer_3": {"type": "panel","size": ["default", 10]}},
                         {"output_cell_slot@inventory_specific.2x2_crafting_output_grid":{}},
                         {"buffer_4": {"type": "panel","size": ["default", 8]}}
                     ]
                    }
                  }
                ]
              }
            },
            {"buffer_1": {"type": "panel","size": ["default", 7]}},
            {
                "cell_stack@global.empty_stack_panel": {
                  "orientation": "horizontal",
                  "size": [79, 18],
                  "controls": [  
                    {"buffer_1": {"type": "panel","size": [6, "default"]}},
                    {"recipe_toggle@recipe_toggle.recipe_layout_toggle":{}}, 
                    {"buffer_1": {"type": "panel","size": ["fill", "default"]}}
                ]
              }
            },
            {"buffer_1": {"type": "panel","size": ["default", 1]}}
          ]
        }
      }
    ]
  },
  "2x2_crafting_grid": {
    "type": "grid",
    "size": [ 36, 36 ],
    "grid_dimensions": [ 2, 2 ],
    "collection_name": "crafting_input_items",
    "controls": [
      {"crafting_input_item_top_left@crafting_textures.crafting_input_grid_item" : {"grid_position": [ 0, 0 ],"$focus_id_binding_type": "none","$focus_id": "crafting_input_top_left","$focus_override_left_binding_type": "none","$focus_override_left": "armor_item_head"}},
      {"crafting_input_item_top_right@crafting_textures.crafting_input_grid_item": {"grid_position": [ 1, 0 ],"$focus_id_binding_type": "none","$focus_id": "crafting_input_top_right","$focus_override_right_binding_type": "none","$focus_override_right": "crafting_output_item"}},
      {"crafting_input_item_bot_left@crafting_textures.crafting_input_grid_item" : {"grid_position": [ 0, 1 ],"$focus_id_binding_type": "none","$focus_id": "crafting_input_mid_left","$focus_override_left_binding_type": "none","$focus_override_left": "armor_item_legs"}},
      {"crafting_input_item_bot_right@crafting_textures.crafting_input_grid_item": {"grid_position": [ 1, 1 ],"$focus_override_right_binding_type": "none","$focus_override_right": "crafting_output_item"}}
    ]
  },
  "2x2_crafting_output_grid": {
    "type": "grid",
    "grid_dimensions": [ 1, 1 ],
    "collection_name": "crafting_output_items",
    "size": [ 18, 18 ],
    "controls": [
      {
        "work_bench_output@crafting.inventory_container_item": {
          "$item_collection_name": "crafting_output_items",
          "$button_ref": "crafting.output_no_coalesce_container_slot_button",
          "$background_images": "crafting_textures.output_cell_textures",
          "$item_renderer_binding_condition": "always",
          "$stack_count_binding_condition": "always",
          "$focus_id_binding_type": "none",
          "$focus_id": "crafting_output_item",
          "$focus_override_left_binding_type": "none",
          "$focus_override_left": "crafting_input_top_right",
          "$focus_override_up_binding_type": "none",
          "$focus_override_up": "help_button"
        }
      }
    ]
  }
}
