{
  "namespace": "inventory_top_half_creative",
  "inventory_top_half_creative@global.empty_stack_panel": {
    "orientation": "vertical",
    "size": [125, 50],
    "anchor_to": "top_left",
    "anchor_from": "top_left",
    "controls": [
      {"buffer_1": { "type": "panel", "size": ["default", 5] }},
      {
        "stack_1@global.empty_stack_panel": {
          "orientation": "horizontal",
          "size": [125, 45],
          "controls": [
            {"buffer_1": { "type": "panel", "size": [34, "default"] }},
            {
              "stack_2@global.empty_stack_panel": {
                "orientation": "vertical",
                "size": [18, 45],
                "controls": [
                  {"buffer_1": {"type": "panel","size": ["default", 14]}},
                  {"offhand_slot@armor_cells.offhand_slot": {}},//18, 45
                  {"buffer_1": {"type": "panel","size": ["default", 13]}}
                ]
              }
            },
            {"buffer_2": { "type": "panel", "size": [1, "default"] }},
            {"head_and_chest@armor_cells.head_and_chest": {}},//18, 45
            {"buffer_3": { "type": "panel", "size": [1, "default"] }},
            {"player_renderer_panel@crafting_common.player_renderer_panel":{}},//34, 45
            {"buffer_4": { "type": "panel", "size": [1, "default"] }},
            {"legs_and_boots@armor_cells.legs_and_boots":{}}//18, 45
          ]
        }
      }
    ]
  }
}
