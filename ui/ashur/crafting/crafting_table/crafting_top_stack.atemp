{
  "namespace": "crafting_top_stack",
  "crafting_top_stack": {
    "type": "panel",
    "size": [176, 166],
    "controls": [
      {
        "crafting_stack_wrapper@global.empty_stack_panel": {
          "orientation": "vertical",
          "anchor_to": "top_left",
          "anchor_from": "top_left",
          "size": [176, 70],
          "controls": [
            { "label_top_margin@global.empty_panel": { "type": "panel", "size": ["default", 4] }},
            {
              "crafting_label_row@global.empty_stack_panel": {
                "orientation": "horizontal",
                "size": [176, 12],
                "controls": [
                  { "label_left_padding@global.empty_panel": { "type": "panel", "size": [29, "default"] }},
                  {
                    "label_container@global.empty_panel": {
                      "size": [54, "default"],
                      "controls": [
                        {
                          "inventory_label": {
                            "type": "label",
                            "anchor_from": "left_middle",
                            "anchor_to": "left_middle",
                            "layer": 2,
                            "size": [ "100%", 10 ],
                            "color": "$title_text_color",
                            "text": "container.crafting"
                          }
                        }
                      ]
                    }
                  },
                  { "label_right_padding@global.empty_panel": { "type": "panel", "size": [93, "default"] }}
                ]
              }
            },
            {
              "crafting_body_row@global.empty_stack_panel": {
                "orientation": "horizontal",
                "size": [176, 54],
                "controls": [
                  {
                    "left_column_stack@global.empty_stack_panel": {
                      "orientation": "vertical",
                      "size": [29, 54],
                      "controls": [
                        { "toggle_top_spacing@global.empty_panel": { "type": "panel", "size": ["default", 18] }},
                        {
                          "toggle_row@global.empty_stack_panel": {
                            "orientation": "horizontal",
                            "size": [29, 18],
                            "controls": [
                              { "toggle_left_margin@global.empty_panel": { "type": "panel", "size": [5, "default"] }},
                              { "recipe_toggle@recipe_toggle.recipe_layout_toggle": {} },
                              { "toggle_right_margin@global.empty_panel": { "type": "panel", "size": [4, "default"] }}
                            ]
                          }
                        },
                        { "toggle_bottom_spacing@global.empty_panel": { "type": "panel", "size": ["default", 18] }}
                      ]
                    }
                  },
                  { "crafting_grid_panel@crafting_top_stack.crafting_3x3_grid": {} },
                  { "between_grid_output_spacing@global.empty_panel": { "type": "panel", "size": [36, "default"] }},
                  {
                    "output_stack@global.empty_stack_panel": {
                      "orientation": "vertical",
                      "size": [26, 54],
                      "controls": [
                        { "output_top_spacing@global.empty_panel": { "type": "panel", "size": ["default", 14] }},
                        { "output_grid@crafting_top_stack.output_grid_3x3": {} },
                        { "output_bottom_spacing@global.empty_panel": { "type": "panel", "size": ["default", 14] }}
                      ]
                    }
                  },
                  { "final_buffer_spacing@global.empty_panel": { "type": "panel", "size": [31, "default"] }}
                ]
              }
            }
          ]
        }
      }
    ]
  },

  "crafting_3x3_grid": {
    "type": "grid",
    "size": [54, 54],
    "anchor_from": "top_left",
    "anchor_to": "top_left",
    "grid_dimensions": [3, 3],
    "collection_name": "crafting_input_items",
    "controls": [
      { "input_top_left@crafting_textures.crafting_input_grid_item": { "grid_position": [0, 0] }},
      { "input_top_center@crafting_textures.crafting_input_grid_item": { "grid_position": [1, 0] }},
      { "input_top_right@crafting_textures.crafting_input_grid_item": { "grid_position": [2, 0] }},
      { "input_mid_left@crafting_textures.crafting_input_grid_item": { "grid_position": [0, 1] }},
      { "input_center@crafting_textures.crafting_input_grid_item": { "grid_position": [1, 1] }},
      { "input_mid_right@crafting_textures.crafting_input_grid_item": { "grid_position": [2, 1] }},
      { "input_bottom_left@crafting_textures.crafting_input_grid_item": { "grid_position": [0, 2] }},
      { "input_bottom_center@crafting_textures.crafting_input_grid_item": { "grid_position": [1, 2] }},
      { "input_bottom_right@crafting_textures.crafting_input_grid_item": { "grid_position": [2, 2] }}
    ]
  },

  "output_grid_3x3": {
    "type": "grid",
    "grid_dimensions": [1, 1],
    "collection_name": "crafting_output_items",
    "anchor_from": "top_left",
    "anchor_to": "top_left",
    "size": [26, 26],
    "controls": [
      {
        "output_item@crafting.inventory_container_item": {
          "size": [26, 26],
          "$cell_image_size": [26, 26],
          "$item_collection_name": "crafting_output_items",
          "$button_ref": "crafting.output_no_coalesce_container_slot_button",
          "$stack_count_binding_condition": "always",
          "$item_renderer_binding_condition": "always",
          "$background_images": "crafting_textures.output_cell_textures",
          "$focus_id_binding_type": "none",
          "$focus_id": "crafting_output_item",
          "$focus_override_right_binding_type": "none",
          "$focus_override_right": "FOCUS_OVERRIDE_STOP"
        }
      }
    ]
  }
}
