{
  "namespace": "stonecutter_screen",
  "scroll_grid": {
    "type": "grid",
    "size": [ 64, "default" ],
    "layer": 1,
    "anchor_to": "center",
    "anchor_from": "center",
    "$binding_condition|default": "visible",
    "$grid_item_template|default": "stonecutter_screen.recipe_panel",
    "collection_name": "$collection_name",
    "grid_rescaling_type": "horizontal",
    "grid_item_template": "$grid_item_template",
    "bindings": [
      {
        "binding_name": "#stone_selector_total_items",
        "binding_name_override": "#maximum_grid_items",
        "binding_condition": "$binding_condition",
        "binding_type": "collection",
        "binding_collection_name": "$collection_name"
      }
    ]
  },
  "recipe_panel": {
    "type": "input_panel",
    "size": [ 16, 18 ],
    "layer": 2,
    "$item_collection_name": "$collection_name",
    "controls": [
      {
        "item_renderer": {
          "type": "custom",
          "renderer": "inventory_item_renderer",
          "size": [ 16, 16 ],
          "layer": 5,
          "bindings": [
            {
              "binding_name": "#item_id_aux",
              "binding_condition": "visible",
              "binding_type": "collection",
              "binding_collection_name": "$item_collection_name"
            }
          ]
        }
      },
      {
        "slot_button@stonecutter.stone_slot_button": {
          "size": [ 16, 18 ],
          "default_control": "default",
          "hover_control": "hover",
          "pressed_control": "pressed",
          "locked_control": "pressed",
          "controls": [
            {
              "default@screen_content.image_element": {
                "texture": "assets/minecraft/textures/gui/sprites/container/stonecutter/recipe",
                "nineslice_size": [ 2, 2, 2, 2 ]
              }
            },
            {
              "hover@screen_content.image_element": {
                "texture": "assets/minecraft/textures/gui/sprites/container/stonecutter/recipe_highlighted",
                "nineslice_size": [ 2, 2, 2, 2 ]
              }
            },
            {
              "pressed@screen_content.image_element": {
                "texture": "assets/minecraft/textures/gui/sprites/container/stonecutter/recipe_selected",
                "nineslice_size": [ 2, 2, 2, 2 ]
              }
            }
          ]
        }
      }
    ]
  },
  "stonecutter_panel@container_common.container_details": {
    "$screen_controls": [
      {
        "locked_scroll_box@screen_content.scroll_box_image_disabled": {
          "anchor_to": "center",
          "anchor_from": "center",
          "offset": [ 37, -60.2 ],
          "bindings": [
            {
              "binding_name": "(#stone_selector_total_items < 13)",
              "binding_name_override": "#visible",
              "binding_type": "collection",
              "binding_collection_name": "stones"
            }
          ]
        }
      },
      {
        "scroll_panel@scroll_panel.common_container_scrolling_panel": {
          "$collection_name": "stones",
          "anchor_to": "center",
          "anchor_from": "center",
          "$scroll_view_port_size": [ 64, 54 ],
          "$scrolling_pane_size": [ "100%", "100%" ],
          "$scroll_size": [ 14, 54 ],
          "$misc_scroller_offset": [ 0, 0.8 ],
          "offset": [ 4, -42.2 ],
          "size": [ 80, 55 ],
          "layer": 2,
          "$scroll_view_port_offset": [ 0, 2 ],
          "$scroll_box_mouse_image_control": "screen_content.scroll_box_image",
          "$scroll_box_touch_image_control": "screen_content.scroll_box_image",
          "$scrolling_content": "stonecutter_screen.scroll_grid",
          "bindings": [ {"binding_name": "#has_input_item", "binding_name_override": "#visible"} ]
        }
      },
      {
        "screen_stack_panel": {
          "type": "stack_panel",
          "orientation": "horizontal",
          "size": [ "100%c", "100%cm" ],
          "controls": [
            {
              "right_panel@common.empty_panel": {
                "layer": 1,
                "size": [ 176, 166 ],
                "controls": [
                  {"common_panel@screen_content.container_base": {"$stonecutter_screen": true}},
                  {
                    "stonecutter_screen_inventory": {
                      "type": "panel",
                      "layer": 2,
                      "offset": [ 0, -2 ],
                      "controls": [
                        {
                          "top_half_panel": {
                            "type": "panel",
                            "anchor_from": "top_middle",
                            "anchor_to": "top_middle",
                            "size": [ "100% - 14px", "50% - 22px" ],
                            "offset": [ 0, 15 ],
                            "controls": [
                              {
                                "stonecutter_label": {
                                  "type": "label",
                                  "offset": [ 1, -9 ],
                                  "anchor_from": "top_left",
                                  "anchor_to": "top_left",
                                  "text": "$container_title",
                                  "$container_title": "Stonecutter",
                                  "color": "$title_text_color",
                                  "layer": 2
                                }
                              },
                              {
                                "top_half_stack_panel": {
                                  "type": "stack_panel",
                                  "orientation": "horizontal",
                                  "size": [ "100%c", "100%cm" ],
                                  "controls": [
                                    {
                                      "input_slots_holder": {
                                        "type": "panel",
                                        "size": [ "100%c", "100%c" ],
                                        "inherit_max_sibling_height": true,
                                        "controls": [
                                          {
                                            "input_slots_stack_panel": {
                                              "type": "stack_panel",
                                              "orientation": "horizontal",
                                              "size": [ "100%c", "100%cm" ],
                                              "controls": [
                                                {
                                                  "input_item_slot@common.container_item": {"anchor_from": "center", "anchor_to": "center", "$item_collection_name": "stonecutter_input_items"}
                                                }
                                              ]
                                            }
                                          }
                                        ]
                                      }
                                    },
                                    {"padding_1": {"type": "panel", "size": [ 14, 0 ]}}
                                  ],
                                  "offset": [ -53, -2.5 ]
                                }
                              },
                              {
                                "top_half_stack_panel1": {
                                  "type": "stack_panel",
                                  "orientation": "horizontal",
                                  "size": [ "100%c", "100%cm" ],
                                  "controls": [
                                    {"padding_2": {"type": "panel", "size": [ 14, 0 ]}},
                                    {
                                      "result_item_slot_holder": {
                                        "type": "panel",
                                        "size": [ "100%c", "100%c" ],
                                        "inherit_max_sibling_height": true,
                                        "controls": [
                                          {
                                            "result_item_slot@common.container_item": {
                                              "anchor_from": "center",
                                              "anchor_to": "center",
                                              "$item_collection_name": "stonecutter_result_items",
                                              "$button_ref": "stonecutter.result_slot_button",
                                              "$cell_image_size": [ 26, 26 ],
                                              "size": [ 26, 26 ]
                                            }
                                          }
                                        ]
                                      }
                                    }
                                  ],
                                  "offset": [ 56, -2.5 ]
                                }
                              }
                            ]
                          }
                        },
                        {
                          "inventory_panel_bottom_half_with_label@common.inventory_panel_bottom_half_with_label": {"offset": [ 0, -1 ]}
                        },
                        {"hotbar_grid@common.hotbar_grid_template": {}}
                      ]
                    }
                  }
                ]
              }
            }
          ]
        }
      }
    ]
  }
}