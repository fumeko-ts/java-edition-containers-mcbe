{
  "namespace": "creative_inventory",
  "screen_base@global.empty_panel": {
    "size": [195, 136],
    "anchor_from": "center",
    "anchor_to": "center",
    "layer": 3,
    "controls": [
      { "extensions@jc-extensions.creative_inventory": {} },
      {
        "disabled_scroller@screen_content.image_element": {
          "texture": "assets/sprites/container/creative_inventory/scroller_disabled.png",
          "layer": 20,
          "offset": [-8, 18],
          "anchor_from": "top_right",
          "anchor_to": "top_right",
          "size": [12, 15],
          "bindings": [
            {
              "binding_type": "global",
              "binding_name": "#is_left_tab_search",
              "binding_name_override": "#is_search_tab"
            },
            {
              "binding_type": "view",
              "binding_condition": "always",
              "source_control_name": "creative_recipe_grid",
              "source_property_name": "(#maximum_grid_items < 45)",
              "target_property_name": "#less_than_45_items"
            },
            {
              "binding_type": "view",
              "source_property_name": "(#less_than_45_items and #is_search_tab)",
              "target_property_name": "#visible"
            }
          ]
        }
      },
      {
        "inventory_bottom_half_with_label@global.empty_stack": {
          "orientation": "vertical",
          "size": [162, 83],
          "anchor_to": "bottom_left",
          "anchor_from": "bottom_left",
          "offset": [8, 0],
          "controls": [
            {
              "inventory_grid@global.empty_panel": {
                "size": [162, 54],
                "controls": [
                  {
                    "inventory_grid": {
                      "type": "grid",
                      "size": [162, 54],
                      "grid_dimensions": [9, 3],
                      "grid_item_template": "jc_container_item.container_item",
                      "$item_collection": "inventory_items",
                      "collection_name": "$item_collection",
                      "bindings": [
                        {
                          "binding_type": "global",
                          "binding_name": "#is_left_tab_inventory",
                          "binding_name_override": "#visible"
                        }
                      ]
                    }
                  }
                ]
              }
            },
            { "below_inventory_grid_spacing@global.empty_panel": { "size": ["default", 4] } },
            { "hotbar@global.hotbar": {} },
            { "hotbar_bottom_spacing@global.empty_panel": { "size": ["default", 7] } }
          ]
        }
      },
      {
        "scrolling_area@global.empty_panel": {
          "size": [195, 136],
          "controls": [
            {
              "scroll_panel@scroll_panel.scroll_panel": {
                "$scroll_track_offset": [81.2, 0],
                "offset": [0.4, 5],
                "anchor_to": "center",
                "anchor_from": "center",
                "$scroll_size": [12, 112],
                "size": [180, 112],
                "$scroll_view_port_size": [180, 90.2],
                "$scrolling_pane_size": ["100%", "100%"],
                "$scroll_box_image_control": "creative_inventory.scroller",
                "$scrolling_content": "creative_inventory.creative_grid_holder"
              }
            }
          ],
          "bindings": [
            {
              "binding_type": "global",
              "binding_name": "(not #is_left_tab_inventory)",
              "binding_name_override": "#visible"
            }
          ]
        }
      },
      {
        "search_tab@screen_content.creative_inventory_search": {
          "$extra_ui_contents": [
            {
              "search_holder@global.empty_panel": {
                "size": [115, 16],
                "anchor_to": "top_right",
                "anchor_from": "top_right",
                "layer": 7,
                "controls": [
                  {
                    "text_edit_panel@text_edit_area.text_edit_box": {
                      "size": [90, 12],
                      "anchor_from": "bottom_left",
                      "anchor_to": "bottom_left",
                      "$clipping_panel_size": ["100% - 4px", "100%"],
                      "$default_control": "global.empty_panel",
                      "$locked_control": "global.empty_panel",
                      "$edit_label_offset": [0, -2],
                      "$hover_control": "global.empty_panel",
                      "$pressed_control": "global.empty_panel"
                    }
                  }
                ]
              }
            },
            {
              "search_label_stack@global.empty_stack": {
                "orientation": "horizontal",
                "size": ["100%", 17],
                "anchor_from": "top_left",
                "anchor_to": "top_left",
                "controls": [
                  { "search_label_left_filler@global.empty_panel": { "size": [8, 17] } },
                  {
                    "search_label_vertical_stack@global.empty_stack": {
                      "orientation": "vertical",
                      "size": ["fill", 17],
                      "controls": [
                        { "search_label_top_filler@global.empty_panel": { "size": ["fill", 5] } },
                        {
                          "search_label_holder@global.empty_panel": {
                            "size": ["fill", 11],
                            "controls": [
                              {
                                "search_label@global.empty_label": {
                                  "anchor_to": "top_left",
                                  "anchor_from": "top_left",
                                  "size": ["default", 10],
                                  "layer": 6,
                                  "localize": true,
                                  "text": "ashur.tab.search",
                                  "color": "$title_text_color"
                                }
                              }
                            ]
                          }
                        }
                      ]
                    }
                  }
                ]
              }
            }
          ],
          "bindings": [
            {
              "binding_type": "global",
              "binding_name": "#is_left_tab_search",
              "binding_name_override": "#visible"
            }
          ]
        }
      },
      {
        "misc_tabs@screen_content.creative_inventory_misc": {
          "$extra_ui_contents": [
            {
              "label_stack@global.empty_stack": {
                "orientation": "horizontal",
                "size": ["100%", 15],
                "anchor_from": "top_left",
                "anchor_to": "top_left",
                "controls": [
                  { "label_left_filler@global.empty_panel": { "size": [8, 15] } },
                  {
                    "label_panel@global.empty_panel": {
                      "size": ["fill", 15],
                      "controls": [
                        {
                          "equipment@creative_inventory.tab_label_template": {
                            "text": "ashur.tab.equipment",
                            "$label_visibility": "#is_left_tab_equipment"
                          }
                        },
                        {
                          "nature@creative_inventory.tab_label_template": {
                            "text": "ashur.tab.nature",
                            "$label_visibility": "#is_left_tab_nature"
                          }
                        },
                        {
                          "items@creative_inventory.tab_label_template": {
                            "text": "ashur.tab.items",
                            "$label_visibility": "#is_left_tab_items"
                          }
                        },
                        {
                          "construction@creative_inventory.tab_label_template": {
                            "text": "ashur.tab.construction",
                            "$label_visibility": "#is_left_tab_construct"
                          }
                        }
                      ]
                    }
                  }
                ]
              }
            }
          ],
          "bindings": [
            {
              "binding_type": "global",
              "binding_name": "#is_left_tab_search",
              "binding_name_override": "#is_search_section"
            },
            {
              "binding_type": "global",
              "binding_name": "#is_left_tab_inventory",
              "binding_name_override": "#is_inventory_tab"
            },
            {
              "binding_type": "view",
              "binding_condition": "always",
              "source_property_name": "((not #is_search_section) and (not #is_inventory_tab))",
              "target_property_name": "#visible"
            }
          ]
        }
      },
      {
        "inventory_tab@screen_content.creative_inventory": {
          "$extra_ui_contents": [
            {
              "inventory_extra_slots_container@global.empty_stack": {
                "orientation": "horizontal",
                "anchor_to": "top_left",
                "anchor_from": "top_left",
                "size": [125, 50],
                "controls": [
                  // i mainly use @global.empty ect for performance and to make writeing code faster (doing so makes it so i can work more clearly)
                  { "far_left_filler@global.empty_panel": { "size": [34, 50] } },
                  {
                    "offhand_stack@global.empty_stack": {
                      "orientation": "vertical",
                      "size": [18, 50],
                      "controls": [
                        { "top_offhand_filler@global.empty_panel": { "size": [18, 19] } },
                        {
                          "offhand_slot_button@jc_container_item.container_item": {
                            "size": [18, 18],
                            "$item_collection": "offhand_items",
                            "$cell_overlay_ref": "screen_content.armor_overlay_shield"
                          }
                        },
                        { "bottom_offhand_filler@global.empty_panel": { "size": [13, 18] } }
                      ]
                    }
                  },
                  { "offhand_and_items_spacer@global.empty_panel": { "size": [1, 50] } },
                  {
                    "left_armor_slots@global.empty_stack": {
                      "orientation": "vertical",
                      "size": [18, 50],
                      "$item_collection": "armor_items",
                      "collection_name": "$item_collection",
                      "controls": [
                        { "left_slots_top_filler@global.empty_panel": { "size": [18, 5] } },
                        {
                          "hemlet_slot_button@jc_container_item.container_item": {
                            "$cell_overlay_ref": "screen_content.armor_overlay_helmet",
                            "collection_index": 0
                          }
                        },
                        { "left_slots_middle_filler@global.empty_panel": { "size": [18, 9] } },
                        {
                          "chestplate_slot_button@jc_container_item.container_item": {
                            "$cell_overlay_ref": "screen_content.armor_overlay_chest",
                            "collection_index": 1
                          }
                        }
                      ]
                    }
                  },
                  { "armor_slots_center_spacer@global.empty_panel": { "size": [36, 50] } },
                  {
                    "right_armor_slots@global.empty_stack": {
                      "orientation": "vertical",
                      "size": [18, 50],
                      "$item_collection": "armor_items",
                      "collection_name": "$item_collection",
                      "controls": [
                        { "right_slots_top_filler@global.empty_panel": { "size": [18, 5] } },
                        {
                          "leggings_slot_button@jc_container_item.container_item": {
                            "$cell_overlay_ref": "screen_content.armor_overlay_legs",
                            "collection_index": 2
                          }
                        },
                        { "right_slots_middle_filler@global.empty_panel": { "size": [18, 9] } },
                        {
                          "boots_slot_button@jc_container_item.container_item": {
                            "$cell_overlay_ref": "screen_content.armor_image_feet",
                            "collection_index": 3
                          }
                        }
                      ]
                    }
                  }
                ]
              }
            },
            {
              "live_player_panel@global.empty_panel": {
                "anchor_from": "top_middle",
                "anchor_to": "top_middle",
                "size": [34, 20],
                "offset": [-9, 8],
                "controls": [
                  {
                    "player_renderer@global.custom_renderer": {
                      "$type": "live_player_renderer",
                      "layer": 20,
                      "property_bag": { "#look_at_cursor": true }
                    }
                  }
                ]
              }
            },
            {
              "item_remover": {
                "type": "toggle",
                "size": [18, 18],
                "offset": [-5, -7],
                "anchor_to": "bottom_right",
                "anchor_from": "bottom_right",
                "unchecked_hover_control": "default_hover",
                "checked_hover_control": "default_hover",
                "controls": [
                  { "default_hover@screen_content.highlight_slot": { "ignored": "$touch", "size": [16, 16] } }
                ],
                "button_mappings": [
                  {
                    "from_button_id": "button.menu_select",
                    "to_button_id": "button.destroy_selection",
                    "mapping_type": "pressed"
                  },
                  {
                    "from_button_id": "button.menu_ok",
                    "to_button_id": "button.destroy_selection",
                    "mapping_type": "pressed"
                  },
                  {
                    "from_button_id": "button.menu_secondary_select",
                    "to_button_id": "button.destroy_selection",
                    "mapping_type": "pressed"
                  },
                  {
                    "from_button_id": "button.menu_auto_place",
                    "to_button_id": "button.menu_clear",
                    "mapping_type": "pressed"
                  }
                ]
              }
            }
          ],
          "bindings": [
            {
              "binding_type": "global",
              "binding_name": "#is_left_tab_inventory",
              "binding_name_override": "#visible"
            }
          ]
        }
      },
      {
        "top_tabs@global.empty_stack": {
          "size": [195, 32],
          "orientation": "horizontal",
          "anchor_from": "top_middle",
          "anchor_to": "bottom_middle",
          "controls": [
            {
              "nature_tab@creative_inventory.top_tab_template": {
                "$is_top_left_tab": true,
                "$toggle_control_name": "nature_tab_toggle",
                "$toggle_group_forced_index": "$nature_index",
                "$toggle_binding_value": "#is_left_tab_nature"
              }
            },
            { "spacer_1@global.empty_panel": { "size": [1, 32] } },
            {
              "items_tab@creative_inventory.top_tab_template": {
                "$toggle_control_name": "items_tab_toggle",
                "$toggle_group_forced_index": "$items_index",
                "$toggle_binding_value": "#is_left_tab_items"
              }
            },
            { "spacer_2@global.empty_panel": { "size": [1, 32] } },
            {
              "equipment_tab@creative_inventory.top_tab_template": {
                "$toggle_control_name": "equipment_tab_toggle",
                "$toggle_group_forced_index": "$equipment_index",
                "$toggle_binding_value": "#is_left_tab_equipment"
              }
            },
            { "spacer_3@global.empty_panel": { "size": [1, 32] } },
            {
              "construction_tab@creative_inventory.top_tab_template": {
                "$toggle_control_name": "construction_tab_toggle",
                "$toggle_group_forced_index": "$construction_index",
                "$toggle_binding_value": "#is_left_tab_construct"
              }
            },
            { "expanding_spacer@global.empty_panel": { "size": ["fill", 32] } },
            {
              "search_tab@creative_inventory.top_tab_template": {
                "$is_default_active": true,
                "$is_top_right_tab": true,
                "$toggle_control_name": "search_tab_toggle",
                "$toggle_group_forced_index": "$search_index",
                "$toggle_binding_value": "#is_left_tab_search"
              }
            }
          ]
        }
      },
      {
        "inventory_tab@creative_inventory.bottom_tab_template": {
          "$is_bottom_right_tab": true,
          "anchor_from": "bottom_right",
          "anchor_to": "top_right",
          "$toggle_control_name": "survival_tab_toggle",
          "$toggle_group_forced_index": "$survival_index",
          "$toggle_binding_value": "#is_left_tab_inventory"
        }
      }
    ]
  },
  "tab_label_template@global.empty_label": {
    "anchor_to": "bottom_left",
    "anchor_from": "bottom_left",
    "size": ["default", 10],
    "layer": 6,
    "localize": true,
    "color": "$title_text_color",
    "$label_visibility|default": "none",
    "bindings": [
      {
        "binding_type": "global",
        "binding_name": "$label_visibility",
        "binding_name_override": "#visible"
      }
    ]
  },
  "scroller@screen_content.image_element": {
    "tiled": true,
    "nineslice_size": [6, 7, 6, 6],
    "tiled_scale": [1, 1],
    "offset": [2, 0],
    "anchor_to": "center",
    "anchor_from": "center",
    "texture": "assets/sprites/container/creative_inventory/scroller.png",
    "size": [12, "100% - 2px"]
  },
  "creative_grid_holder@global.empty_panel": {
    "size": ["100%c", "100%c"],
    "anchor_to": "center",
    "anchor_from": "center",
    "controls": [
      {
        "creative_recipe_grid": {
          "type": "grid",
          "size": [162, "default"],
          "collection_name": "recipe_book",
          "grid_rescaling_type": "horizontal",
          "grid_fill_direction": "vertical",
          "grid_item_template": "creative_recipe_item.item_template",
          "bindings": [
            {
              "binding_name": "#recipe_book_total_items",
              "binding_name_override": "#maximum_grid_items",
              "binding_condition": "visible",
              "binding_type": "collection",
              "binding_collection_name": "recipe_book"
            }
          ]
        }
      }
    ]
  },
  "top_tab_template@creative_inventory.tab_template": {
    "$tab_texture_unchecked_offset": [0, 4],
    "$tab_texture_checked_offset": [0, 4],
    "$icon_unchecked_offset": [0, 4],
    "$icon_checked_offset": [0, 4]
  },
  "bottom_tab_template@creative_inventory.tab_template": {
    "$tab_texture_unchecked_offset": [0, -4],
    "$tab_texture_checked_offset": [0, -4],
    "$icon_unchecked_offset": [0, -4],
    "$icon_checked_offset": [0, -4]
  },
  "tab_template@toggle.tab_toggle": {
    "$size": [26, 32],
    "$default_selected_index": "$construction_index", //$construction_index=1
    "$toggle_name": "navigation_tab",
    "$extra_contents": "crafting_common.creative_tab_icons",
    "$checked_hover_layer": 4,
    "$checked_layer": 4,
    "$default_hover_layer": 2,
    "$default_layer": 2,
    "$toggle_binding_value": "#toggle_state"
  }
}
