{
  "namespace": "furnace_screen",
  "furnace_panel@global.empty_stack": {
    "orientation": "horizontal",
    "anchor_to": "center",
    "anchor_from": "center",
    "min_size": [176, 166],
    "max_size": [360, 166],
    "controls": [
      {
        "main_furnace_contents@container_common.container_details": {
          "size": [176, 166],
          "$screen_controls": [
            { "common_panel@screen_content.furnace": {} },
            { "extensions@jc-extensions.furnace_screen": {} },
            {
              "furnace_top_half@global.empty_stack": {
                "orientation": "vertical",
                "size": [176, 70],
                "anchor_from": "top_middle",
                "anchor_to": "top_middle",
                "controls": [
                  { "filler_1@global.empty_panel": { "size": ["fill", 6] } },
                  {
                    "label_stack@global.empty_stack": {
                      "orientation": "horizontal",
                      "size": [176, 10],
                      "controls": [
                        { "filler_1@global.empty_panel": { "size": [67, "fill"] } },
                        {
                          "label_holder@global.empty_panel": {
                            "size": [109, 10],
                            "controls": [
                              {
                                "furnace_title_label": {
                                  "type": "label",
                                  "anchor_to": "top_left",
                                  "anchor_from": "top_left",
                                  "offset": [0, -1],
                                  "size": ["default", 10],
                                  "text": "atemp.container.furnace",
                                  "color": "$title_text_color"
                                }
                              }
                            ]
                          }
                        }
                      ]
                    }
                  },
                  {
                    "main_content@global.empty_stack": {
                      "orientation": "horizontal",
                      "size": [176, 54],
                      "controls": [
                        { "filler_1@global.empty_panel": { "size": [55, "fill"] } },
                        {
                          "inputs@global.empty_stack": {
                            "orientation": "vertical",
                            "size": [18, 54],
                            "controls": [
                              {
                                "smelt_input_item@jc_container_item.container_item": {
                                  "$item_collection": "furnace_ingredient_items"
                                }
                              },
                              {
                                "flame_buffer_and_holder@global.empty_panel": {
                                  "size": [18, 18],
                                  "controls": [
                                    {
                                      "flame_progress@furnace_screen.furnace_image_controls": {
                                        "size": [14, 14],
                                        "offset": [-1, 0],
                                        "anchor_to": "center",
                                        "anchor_from": "center",
                                        "$furnace_sprite": "lit_progress",
                                        "$source": "#furnace_flame_ratio",
                                        "$houkou": "down"
                                      }
                                    }
                                  ]
                                }
                              },
                              {
                                "fuel_input_item@jc_container_item.container_item": {
                                  "$item_collection": "furnace_fuel_items"
                                }
                              }
                            ]
                          }
                        },
                        { "filler_2@global.empty_panel": { "size": [6, "fill"] } },
                        {
                          "arrow_holder@global.empty_stack": {
                            "orientation": "vertical",
                            "size": [24, 54],
                            "controls": [
                              { "filler_1@global.empty_panel": { "size": ["fill", 18] } },
                              {
                                "arrow_progress@furnace_screen.furnace_image_controls": {
                                  "size": [24, 16],
                                  "$furnace_sprite": "burn_progress",
                                  "$source": "#furnace_arrow_ratio",
                                  "$houkou": "left"
                                }
                              },
                              { "filler_2@global.empty_panel": { "size": ["fill", 20] } }
                            ]
                          }
                        },
                        { "filler_3@global.empty_panel": { "size": [8, "fill"] } },
                        {
                          "item_output_holder@global.empty_stack": {
                            "orientation": "vertical",
                            "size": [26, 54],
                            "controls": [
                              { "filler_1@global.empty_panel": { "size": ["fill", 14] } },
                              {
                                "cell_holder@global.empty_panel": {
                                  "size": [26, 26],
                                  "controls": [
                                    {
                                      "output_item@jc_container_item.container_item": {
                                        "anchor_to": "center",
                                        "anchor_from": "center",
                                        "$item_collection": "furnace_output_items"
                                      }
                                    }
                                  ]
                                }
                              },
                              { "filler_2@global.empty_panel": { "size": ["fill", 14] } }
                            ]
                          }
                        },
                        { "filler_4@global.empty_panel": { "size": [35, "fill"] } }
                      ]
                    }
                  }
                ]
              }
            },
            {
              "bottom@global.inventory_bottom_half_with_label": {
                "anchor_to": "bottom_middle",
                "anchor_from": "bottom_middle"
              }
            }
          ]
        }
      }
    ]
  },
  "furnace_image_controls@global.empty_image": {
    "layer": 3,
    "texture": "$furnace_sprite_src",
    "$furnace_sprite_src": "('assets/sprites/container/furnace/' + $furnace_sprite)",
    "clip_direction": "$houkou",
    "keep_ratio": true,
    "clip_pixelperfect": true,
    "bindings": [{ "binding_name": "$source", "binding_name_override": "#clip_ratio", "binding_condition": "always" }]
  }
}
