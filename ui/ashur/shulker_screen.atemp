{
  "namespace": "shulker_screen",
  "chest_grid_item@common.container_item": {"$item_collection_name": "container_items"},
  "shulker@container_common.container_details": {
    "type": "panel",
    "size": [ 176, 166 ],
    "layer": 5,
    "$screen_controls": [
      {"common_panel@screen_content.container_base": {"$shulker_screen": true}},
      {
        "shulker_label": {
          "type": "label",
          "offset": [ -50, 5 ],
          "anchor_from": "top_middle",
          "anchor_to": "top_middle",
          "text": "$container_title",
          "$container_title": "Shulker Box",
          "color": "$title_text_color",
          "layer": 2
        }
      },
      {
        "small_chest_panel_top_half": {
          "type": "panel",
          "size": [ "100%", "50%" ],
          "offset": [ 0, 8 ],
          "anchor_to": "top_left",
          "anchor_from": "top_left",
          "controls": [
            {
              "small_chest_grid": {
                "type": "grid",
                "size": [ 162, 54 ],
                "anchor_from": "top_left",
                "anchor_to": "top_left",
                "grid_dimensions": [ 9, 3 ],
                "grid_item_template": "shulker_screen.chest_grid_item",
                "collection_name": "container_items",
                "offset": [ 7, 9 ]
              }
            }
          ]
        }
      },
      {
        "inventory_panel_bottom_half_with_label@common.inventory_panel_bottom_half_with_label": {"offset": [ 0, -3 ]}
      },
      {"hotbar_grid@common.hotbar_grid_template": {"offset": [ 0, -7 ]}}
    ]
  }
}