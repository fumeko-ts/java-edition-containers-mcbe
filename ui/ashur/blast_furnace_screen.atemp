{
  "namespace": "blast_furnace_screen",
  "blast_furnace_panel@global.empty_stack": {
    "orientation": "horizontal",
    "anchor_to": "center",
    "anchor_from": "center",
    "min_size": [176, 166],
    "max_size": [360, 166],
    "controls": [
      {
        "recipe_book@recipe_book.recipe_book": {
          "$recipe_filter_control": "crafting_common.furnace_filter_toggle",
          "$tab_stack_controls": [
            {
              "search_tab@recipe_book.recipe_tab_template": {
                "$is_default_active": true,
                "$extra_contents": "crafting_common.search_tab_icon",
                "$toggle_control_name": "search_tab_toggle",
                "$toggle_group_forced_index": "$search_index",
                "$toggle_binding_value": "#is_left_tab_search"
              }
            },
            {
              "items_tab@recipe_book.recipe_tab_template": {
                "$extra_contents": "crafting_common.blast_furnace_items_tab",
                "$toggle_control_name": "items_tab_toggle",
                "$toggle_group_forced_index": "$items_index",
                "$toggle_binding_value": "#is_left_tab_items"
              }
            }
          ]
        }
      },
      {
        "main_blast_furnace_contents@container_common.container_details": {
          "size": [176, 166],
          "$screen_controls": [
            { "common_panel@screen_content.blast_furnace": {} },
            { "extensions@jc-extensions.blast_furnace_screen": {} },
            {
              "blast_furnace_main_content@global.empty_stack": {
                "orientation": "vertical",
                "size": [176, 70],
                "anchor_from": "top_middle",
                "anchor_to": "top_middle",
                "controls": [
                  { "filler_0@global.empty_panel": { "size": [176, 4] } },
                  {
                    "title_holder@global.empty_panel": {
                      "size": [176, 12],
                      "controls": [
                        {
                          "blast_furnace_title@global.empty_label": {
                            "anchor_to": "top_middle",
                            "anchor_from": "top_middle",
                            "offset": [0, 1],
                            "size": ["default", 10],
                            "text": "atemp.container.blast_furnace",
                            "color": "$container_title_color"
                          }
                        }
                      ]
                    }
                  },
                  {
                    "main_cell_stacks@global.empty_stack": {
                      "orientation": "horizontal",
                      "size": [176, 54],
                      "controls": [
                        { "filler_1@global.empty_panel": { "size": [20, "fill"] } },
                        {
                          "layout_toggle_stack@global.empty_stack": {
                            "orientation": "vertical",
                            "size": [20, "fill"],
                            "controls": [
                              { "filler_2@global.empty_panel": { "size": ["fill", 18] } },
                              { "layout_toggle@crafting_common.recipe_layout_toggle": {} },
                              { "filler_3@global.empty_panel": { "size": ["fill", 18] } }
                            ]
                          }
                        },
                        { "filler_4@global.empty_panel": { "size": [15, "fill"] } },
                        {
                          "fuel_and_ingredient_stack@global.empty_stack": {
                            "orientation": "vertical",
                            "size": [18, "fill"],
                            "controls": [
                              {
                                "blast_furnace_smeltable_item@jc_container_item.container_item": {
                                  "$background_control": "crafting_textures.main_cell_panel",
                                  "$item_collection": "furnace_ingredient_items"
                                }
                              },
                              {
                                "fuel_fire_wrapper@global.empty_panel": {
                                  "size": ["fill", 18],
                                  "controls": [
                                    {
                                      "fuel_fire_progress@blast_furnace_screen.furnace_clipping_image_template": {
                                        "size": [14, 14],
                                        "offset": [1, 3],
                                        "anchor_to": "top_left",
                                        "anchor_from": "top_left",
                                        "texture": "assets/sprites/container/blast_furnace/lit_progress",
                                        "clip_direction": "down",
                                        "$progress_ratio_binding": "#furnace_flame_ratio"
                                      }
                                    }
                                  ]
                                }
                              },
                              {
                                "blast_furnace_burnable_item@jc_container_item.container_item": {
                                  "$item_collection": "furnace_fuel_items"
                                }
                              }
                            ]
                          }
                        },
                        { "filler_5@global.empty_panel": { "size": [6, "fill"] } },
                        {
                          "blast_furnace_arrow_holding_stack@global.empty_stack": {
                            "orientation": "vertical",
                            "size": [24, "fill"],
                            "controls": [
                              { "filler_6@global.empty_panel": { "size": ["fill", 18] } },
                              {
                                "blast_furnace_arrow_progress@blast_furnace_screen.furnace_clipping_image_template": {
                                  "size": [24, 16],
                                  "texture": "assets/sprites/container/blast_furnace/burn_progress",
                                  "clip_direction": "left",
                                  "$progress_ratio_binding": "#furnace_arrow_ratio"
                                }
                              },
                              { "filler_7@global.empty_panel": { "size": ["fill", 20] } }
                            ]
                          }
                        },
                        { "filler_8@global.empty_panel": { "size": [8, "fill"] } },
                        {
                          "output_slot_holding_stack@global.empty_stack": {
                            "orientation": "vertical",
                            "size": [26, "fill"],
                            "controls": [
                              { "filler_9@global.empty_panel": { "size": ["fill", 14] } },
                              {
                                "output_slot_wrapper@global.empty_panel": {
                                  "size": [26, 26],
                                  "controls": [
                                    {
                                      "output_slot_underlay@crafting_textures.main_cell_panel": {
                                        "$item_collection|default": "furnace_output_items"
                                      }
                                    },
                                    {
                                      "output_item_slot@jc_container_item.container_item": {
                                        "anchor_to": "center",
                                        "anchor_from": "center",
                                        "$item_collection": "furnace_output_items"
                                      }
                                    }
                                  ]
                                }
                              },
                              { "filler_10@global.empty_panel": { "size": ["fill", 14] } }
                            ]
                          }
                        },
                        { "filler_11@global.empty_panel": { "size": [39, "fill"] } }
                      ]
                    }
                  }
                ]
              }
            },
            {
              "bottom@global.inventory_bottom_half_with_label": {
                "anchor_to": "bottom_middle",
                "anchor_from": "bottom_middle"
              }
            }
          ]
        }
      }
    ]
  },
  "furnace_clipping_image_template@global.empty_image": {
    "layer": 3,
    "clip_pixelperfect": true,
    "bindings": [
      {
        "binding_name": "$progress_ratio_binding",
        "binding_name_override": "#clip_ratio",
        "binding_condition": "always"
      }
    ]
  }
}
