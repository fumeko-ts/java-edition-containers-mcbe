{
  "namespace": "toggle",
  "tab_texture_template@screen_content.image_element": {
    "size": ["default", "default"],
    "anchor_from": "center",
    "anchor_to": "center",
    "offset": "#offset",
    "property_bag": {
      "#tab_texture_offset_0": "$tab_texture_unchecked_offset",
      "#tab_texture_offset_1": "$tab_texture_checked_offset"
    },
    "bindings": "$tab_texture_bindings"
  },
  "tab_toggle@toggle.radio_toggle": {
    "$is_top_left_tab|default": false,
    "$is_top_right_tab|default": false,
    "$is_bottom_right_tab|default": false,
    "$is_left_tab|default": false,
    //tab sprite templates incase you want to nineslice or uv map seprate the tabs
    "$tab_texture_template_default|default": "toggle.tab_texture_template",
    "$tab_texture_template_default_hover|default": "toggle.tab_texture_template",
    "$tab_texture_template_checked|default": "toggle.tab_texture_template",
    "$tab_texture_template_checked_hover|default": "toggle.tab_texture_template",
    //tab_sprite offsets checked/unchecked no hover
    "$tab_texture_unchecked_offset|default": [0, 0],
    "$tab_texture_checked_offset|default": [0, 0],
    //tab texture layers (for when they need to be ontop and below a element)
    "$checked_hover_layer|default": 5,
    "$checked_layer|default": 5,
    "$default_hover_layer|default": 5,
    "$default_layer|default": 5,
    //icon offsets
    "$icon_unchecked_offset|default": [0, 0],
    "$icon_checked_offset|default": [0, 0],
    //textures
    "$unchecked_default_image|default": "assets/sprites/container/creative_inventory/tab_top_unselected_2.png",
    "$unchecked_hover_image|default"  : "assets/sprites/container/creative_inventory/tab_top_unselected_2.png",
    "$checked_default_image|default"  : "assets/sprites/container/creative_inventory/tab_top_selected_2.png",
    "$checked_hover_image|default"    : "assets/sprites/container/creative_inventory/tab_top_selected_2.png",
    //bindings for tab texture
    "$tab_texture_bindings|default": [
      {
        "binding_type": "view",
        "source_control_name": "$toggle_control_name",
        "source_property_name": "#toggle_state",
        "target_property_name": "#tab_selected"
      },
      {
        "binding_type": "view",
        "source_property_name": "('#tab_texture_offset_' + (#tab_selected * 1))",
        "target_property_name": "#offset"
      }
    ],
    //tab_controls
    "$controls": [
      {"default@$tab_texture_template_default"             : { "layer": "$default_layer"       , "texture": "$unchecked_default_image" }},
      {"default_hover@$tab_texture_template_default_hover" : { "layer": "$default_hover_layer" , "texture": "$unchecked_hover_image"   }},
      {"checked@$tab_texture_template_checked"             : { "layer": "$checked_layer"       , "texture": "$checked_default_image"   }},
      {"checked_hover@$tab_texture_template_checked_hover" : { "layer": "$checked_hover_layer" , "texture": "$checked_hover_image"     }},
      {
        "$extra_contents@$extra_contents": {
          "offset": "#offset",
          "property_bag": {
            "#icon_offset_0": "$icon_unchecked_offset", 
            "#icon_offset_1": "$icon_checked_offset" 
          },
          "bindings": [
            {
              "binding_type": "view",
              "source_control_name": "$toggle_control_name",
              "source_property_name": "#toggle_state",
              "target_property_name": "#tab_selected"
            },
            {
              "binding_type": "view",
              "source_property_name": "('#icon_offset_' + (#tab_selected * 1))",
              "target_property_name": "#offset"
            }
          ]
        }
      }
    ],
    "variables": [
      {
        "requires": "$is_top_left_tab",
        "$unchecked_default_image|default": "assets/sprites/container/creative_inventory/tab_top_unselected_1.png",
        "$unchecked_hover_image|default": "assets/sprites/container/creative_inventory/tab_top_unselected_1.png",
        "$checked_default_image|default": "assets/sprites/container/creative_inventory/tab_top_selected_1.png",
        "$checked_hover_image|default": "assets/sprites/container/creative_inventory/tab_top_selected_1.png"
      },
      {
        "requires": "$is_top_right_tab",
        "$unchecked_default_image|default": "assets/sprites/container/creative_inventory/tab_top_unselected_7.png",
        "$unchecked_hover_image|default": "assets/sprites/container/creative_inventory/tab_top_unselected_7.png",
        "$checked_default_image|default": "assets/sprites/container/creative_inventory/tab_top_selected_7.png",
        "$checked_hover_image|default": "assets/sprites/container/creative_inventory/tab_top_selected_7.png"
      },
      {
        "requires": "$is_bottom_right_tab",
        "$unchecked_default_image|default": "assets/sprites/container/creative_inventory/tab_bottom_unselected_7.png",
        "$unchecked_hover_image|default": "assets/sprites/container/creative_inventory/tab_bottom_unselected_7.png",
        "$checked_default_image|default": "assets/sprites/container/creative_inventory/tab_bottom_selected_7.png",
        "$checked_hover_image|default": "assets/sprites/container/creative_inventory/tab_bottom_selected_7.png"
      },
      {
        "requires": "$is_left_tab",
        "$unchecked_default_image|default": "assets/sprites/recipe_book/tab.png",
        "$unchecked_hover_image|default": "assets/sprites/recipe_book/tab.png",
        "$checked_default_image|default": "assets/sprites/recipe_book/tab_selected.png",
        "$checked_hover_image|default": "assets/sprites/recipe_book/tab_selected.png"
      }
    ]
  },
  "radio_toggle@global.empty_panel": {
    "size": [18, 18],
    "$toggle_control_name|default": "Toggle",
    "$toggle_name|default": "Default_toggle",
    "$toggle_variables|default": "toggle.variables",
    "$default_selected_index|default": 0,
    "$sound_name|default": "random.click",
    "$button_volume|default": 1.0,
    "$toggle_focus_enabled|default": "$game_pad",
    "$is_radio_toggle|default": true,
    "$is_default_active|default": false,
    "$toggle_group_forced_index|default": -1,
    "$toggle_enabled_binding_name|default": "",
    "$toggle_binding_value|default": "#toggle_state",
    "$toggle_binding_condition|default": "always",
    "$pressed_action|default": "button.menu_ok",
    "$hover_action|default": "button.filter_toggle_hovered",
    "$button_mappings|default": [
      { "ignored": "($hover_action = '')", "to_button_id": "$hover_action", "mapping_type": "pressed" },
      {
        "from_button_id": "button.menu_select",
        "to_button_id": "$pressed_action",
        "mapping_type": "pressed"
      },
      { 
        "from_button_id": "button.menu_ok", 
        "to_button_id": "$pressed_action", 
        "mapping_type": "pressed" 
      }
    ],
    "$property_bag|default": { 
      "#enabled": true, 
      "#toggle_state": true 
    },
    "$bindings|default": [
      { "binding_type": "collection_details" },
      {
        "binding_type": "global",
        "binding_condition": "$toggle_binding_condition",
        "binding_name": "$toggle_binding_value",
        "binding_name_override": "#toggle_state"
      },
      {
        "binding_type": "global",
        "binding_condition": "always",
        "ignored": "($toggle_enabled_binding_name = '')",
        "binding_name": "$toggle_enabled_binding_name",
        "binding_name_override": "#enabled"
      }
    ],
    "$unchecked_control_name|default": "default",
    "$unchecked_hover_control_name|default": "default_hover",
    "$checked_control_name|default": "checked",
    "$checked_hover_control_name|default": "checked_hover",
    "$locked_control_name|default": "locked",
    "$extra_contents|default": "global.empty_panel",
    "$unchecked|default": "global.empty_panel",
    "$unchecked_hover|default": "global.empty_panel",
    "$checked|default": "global.empty_panel",
    "$checked_hover|default": "global.empty_panel",
    "$locked|default": "global.empty_panel",
    "$controls|default": [
      { "default@$unchecked": {} },
      { "default_hover@$unchecked_hover": {} },
      { "checked@$checked": {} },
      { "checked_hover@$checked_hover": {} },
      { "locked@$locked": {} },
      { "$extra_contents@$extra_contents": {} }
    ],
    "controls": [
      {
        "$toggle_control_name@$toggle_variables": {
          "type": "toggle",
          "size": ["100%", "100%"],
          "sound_name": "$sound_name",
          "sound_volume": "$button_volume",
          "sound_pitch": 1.0,
          "toggle_name": "$toggle_name",
          "unchecked_control": "$unchecked_control_name",
          "unchecked_hover_control": "$unchecked_hover_control_name",
          "checked_control": "$checked_control_name",
          "checked_hover_control": "$checked_hover_control_name",
          "checked_locked_control": "locked",
          "checked_locked_hover_control": "locked",
          "unchecked_locked_control": "locked",
          "unchecked_locked_hover_control": "locked",
          "radio_toggle_group": "$is_radio_toggle",
          "toggle_group_forced_index": "$toggle_group_forced_index",
          "toggle_group_default_selected": "$default_selected_index",
          "toggle_default_state": "$is_default_active",
          "property_bag": "$property_bag",
          "controls": "$controls",
          "bindings": "$bindings",
          "button_mappings": "$button_mappings",
          "enabled": "#enabled",
          "focus_enabled": "$toggle_focus_enabled",
          "reset_on_focus_lost": true,
          "focus_wrap_enabled": false,
          "focus_magnet_enabled": false,
          "default_focus_precedence": 1
        }
      }
    ]
  },
  "variables": {}
}
