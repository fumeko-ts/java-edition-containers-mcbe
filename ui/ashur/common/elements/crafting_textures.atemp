{
  "namespace": "crafting_textures",
  "main_cell_panel@global.empty_panel": {
    "controls": [
      {
        "default_uncraftable@crafting_textures.cell_state_control": {
          "$slot_underlay_control": "crafting_textures.uncraftable_slot",
          "$underlay_index": 3
        }
      },
      { "console_selected@crafting_textures.cell_state_control": {} }
    ]
  },

  "cell_state_control@global.empty_panel": {
    "$slot_underlay_control|default": "crafting_textures.console_unselected_slot",
    "$underlay_index|default": 7,
    "controls": [
      {
        "white_overlay@global.empty_image": {
          "size": [18, 18],
          "anchor_from": "center",
          "anchor_to": "center",
          "nineslice_size": 2,
          "texture": "textures/ui/ashur/cell_icons/cell_white.png",
          "layer": 12,
          "alpha": 0.1915
        }
      },
      { "slot_underlay@$slot_underlay_control": {} }
    ],
    "bindings": [
      {
        "binding_name": "(#container_item_background = $underlay_index)",
        "binding_name_override": "#visible",
        "binding_condition": "always",
        "binding_type": "collection",
        "binding_collection_name": "$item_collection"
      }
    ]
  },

  "uncraftable_slot@crafting_textures.console_unselected_slot": {
    "color": [0.996, 0.0, 0.008],
    "alpha": 0.19,
    "texture": "textures/ui/ashur/cell_icons/cell_white.png"
  },

  "console_unselected_slot@global.empty_image": {
    "size": ["100%", "100%"],
    "nineslice_size": 2,
    "texture": "textures/ui/ashur/cell_icons/cell_focus_unselect.png",
    "layer": 5
  }
}
