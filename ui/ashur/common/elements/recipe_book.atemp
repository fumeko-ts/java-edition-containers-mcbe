{
  "namespace": "recipe_book",
  "recipe_book@global.empty_panel": {
    "$namespace|default": "screen_content",
    "variables": {
      "requires": "$cb_is_thick_menu_buttons",
      "$namespace|default": "beveled_buttons_bridge"
    },
    "size": ["100%c", 166],
    "ignored": "$is_jei_recipe_book_layout_pack",
    "$recipe_filter_control|default": "crafting_common.filter_toggle",
    "$tab_stack_controls|default": [
      {
        "search_tab@recipe_book.recipe_tab_template": {
          "$is_default_active": true,
          "$extra_contents": "crafting_common.search_tab_icon",
          "$toggle_control_name": "search_tab_toggle",
          "$toggle_group_forced_index": "$search_index",
          "$toggle_binding_value": "#is_left_tab_search"
        }
      },
      {
        "equipment_tab@recipe_book.recipe_tab_template": {
          "$extra_contents": "crafting_common.crafting_equipment_tab_icon",
          "$toggle_control_name": "equipment_tab_toggle",
          "$toggle_group_forced_index": "$equipment_index",
          "$toggle_binding_value": "#is_left_tab_equipment"
        }
      },
      {
        "construction_tab@recipe_book.recipe_tab_template": {
          "$extra_contents": "crafting_common.crafting_construction_tab_icon",
          "$toggle_control_name": "construction_tab_toggle",
          "$toggle_group_forced_index": "$construction_index",
          "$toggle_binding_value": "#is_left_tab_construct"
        }
      },
      {
        "nature_tab@recipe_book.recipe_tab_template": {
          "$extra_contents": "crafting_common.crafting_nature_tab_icon",
          "$toggle_control_name": "nature_tab_toggle",
          "$toggle_group_forced_index": "$nature_index",
          "$toggle_binding_value": "#is_left_tab_nature"
        }
      },
      {
        "items_tab@recipe_book.recipe_tab_template": {
          "$extra_contents": "crafting_common.crafting_items_tab_icon",
          "$toggle_control_name": "items_tab_toggle",
          "$toggle_group_forced_index": "$items_index",
          "$toggle_binding_value": "#is_left_tab_items"
        }
      }
    ],
    "controls": [
      {
        "recipe_book@global.root_panel": {
          "$size": [183, 166],
          "controls": [
            {
              "recipe_book_elements@global.empty_stack": {
                "orientation": "horizontal",
                "size": [183, 166],
                "controls": [
                  {
                    "recipe_book_tab_stack@global.empty_stack": {
                      "orientation": "vertical",
                      "size": [35, 166],
                      "layer": 2,
                      "controls": [
                        { "top_static_filler@global.empty_panel": { "size": [35, 3] } },
                        {
                          "recipe_book_tabs@global.empty_stack": {
                            "orientation": "vertical",
                            "size": [35, "100%c"],
                            "controls": "$tab_stack_controls"
                          }
                        },
                        { "bottom_expanding_filler@global.empty_panel": { "size": [35, "fill"] } }
                      ]
                    }
                  },
                  {
                    "recipe_book_content@screen_content.recipe_book": {
                      "controls": [
                        {
                          "holder@global.empty_stack": {
                            "orientation": "vertical",
                            "anchor_to": "top_right",
                            "anchor_from": "top_right",
                            "size": [122, 28],
                            "controls": [
                              { "buffer_1@global.empty_panel": { "size": [122, 12] } },
                              {
                                "search_and_filter@global.empty_stack": {
                                  "orientation": "horizontal",
                                  "size": [122, 16],
                                  "controls": [
                                    {
                                      "search_holder@global.empty_stack": {
                                        "orientation": "vertical",
                                        "size": [81, 16],
                                        "controls": [
                                          { "buffer_1@global.empty_panel": { "size": [81, 1] } },
                                          {
                                            "text_edit_control@text_edit_area.text_edit_box": {
                                              "size": [81, 14],
                                              "$edit_label_offset": [2, 0],
                                              "$place_holder_text_offset": [3, 0],
                                              "layer": 4,
                                              "$place_holder_text_color": [0.659, 0.659, 0.659],
                                              "$place_holder_text_shadow_color": [0.165, 0.165, 0.165],
                                              "$place_holder_text": "atemp.recipe_book.searchBox",
                                              "$default_control": "screen_content.text_field",
                                              "$locked_control": "screen_content.text_field",
                                              "$hover_control": "screen_content.text_field_highlighted",
                                              "$pressed_control": "screen_content.text_field_highlighted"
                                            }
                                          },
                                          { "buffer_2@global.empty_panel": { "size": [81, 1] } }
                                        ]
                                      }
                                    },
                                    { "buffer_1@global.empty_panel": { "size": [4, 16] } },
                                    { "recipe_filter@$recipe_filter_control": {} },
                                    { "buffer_2@global.empty_panel": { "size": [11, 16] } }
                                  ]
                                }
                              }
                            ]
                          }
                        },
                        { "recipe_items@survival_recipe_grid.recipe_grid": {} },
                        { "page_navigation@pagination.base_page_logic": {} },
                        { "right_button_holder@pagination.right_button_holder": {} },
                        { "page_count@pagination.page_count": {} },
                        { "left_button_holder@pagination.left_button_holder": {} }
                      ]
                    }
                  },
                  { "container_center_spacer@global.empty_panel": { "size": [1, 166] } }
                ]
              }
            }
          ],
          "bindings": [
            {
              "binding_type": "global",
              "binding_name": "(not #is_survival_layout)",
              "binding_name_override": "#visible"
            }
          ]
        }
      }
    ],
    "bindings": [
      {
        "binding_type": "global",
        "binding_name": "(not #is_creative_mode)",
        "binding_name_override": "#visible"
      }
    ]
  },
  "count_template": {
    "type": "label",
    "anchor_from": "top_middle",
    "anchor_to": "top_middle",
    "size": ["default", 10],
    "text": "#text",
    "shadow": true,
    "visible": false
  },
  "recipe_tab_template@toggle.tab_toggle": {
    "size": [35, 27],
    "$is_left_tab": true,
    "$default_selected_index": "$search_index",
    "$toggle_name": "navigation_tab",
    "$tab_texture_unchecked_offset": [5, 0],
    "$tab_texture_checked_offset": [3, 0],
    "$icon_unchecked_offset": [0, 0],
    "$icon_checked_offset": [-2, 0]
  },
  "button_input_variables": { "always_listen_to_input": true, "consume_hover_events": false },
  "button_visuals": {
    "type": "button",
    "size": [18, 17],
    "focus_enabled": "$game_pad",
    "focus_wrap_enabled": false,
    "focus_magnet_enabled": false,
    "default_focus_precedence": 1,
    "default_control": "default",
    "hover_control": "hover",
    "pressed_control": "pressed",
    "layer": 10,
    "button_mappings": [
      {
        "from_button_id": "button.menu_select",
        "to_button_id": "button.menu_select",
        "mapping_type": "pressed"
      },
      { "from_button_id": "button.menu_ok", "to_button_id": "button.menu_ok", "mapping_type": "focused" }
    ],
    "$anchor_point|default": "right_middle",
    "controls": [
      {
        "touch@$default_pagination": {
          "layer": 11,
          "ignored": "(not $touch)",
          "anchor_from": "$anchor_point",
          "anchor_to": "$anchor_point"
        }
      },
      { "default@$default_pagination": { "anchor_from": "$anchor_point", "anchor_to": "$anchor_point" } },
      { "hover@$hover_pagination": { "anchor_from": "$anchor_point", "anchor_to": "$anchor_point" } },
      { "pressed@$hover_pagination": { "anchor_from": "$anchor_point", "anchor_to": "$anchor_point" } }
    ]
  }
}
