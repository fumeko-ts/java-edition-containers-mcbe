{
  "namespace": "trade_global",
  "toggle_contents@global.empty_stack": {
    "size": [88, 20],
    "orientation": "horizontal",
    "layer": 3,
    "controls": [
      {
        "first_item_content@global.empty_collection": {
          "collection_name": "trade_item_1",
          "size": [20, 20],
          "controls": [
            {
              "item_requirement_section_1@trade_global.trade_text_area": {
                "$trade_wrapper_content": [
                  {
                    "primary_item_renderer@trade_global.item_renderer": {
                      "offset": [5, 1],
                      "controls": [
                        {
                          "item_cost_label_1@trade_global.trade_item_count": {
                            "controls": [
                              {
                                "discount_marker@global.empty_image": {
                                  "size": [9, 2],
                                  "texture": "assets/sprites/container/villager/discount_strikethrough",
                                  "anchor_to": "left_middle",
                                  "anchor_from": "right_middle",
                                  "offset": [-10, 0],
                                  "layer": 6,
                                  "bindings": [
                                    {
                                      "binding_type": "view",
                                      "binding_condition": "always",
                                      "resolve_sibling_scope": true,
                                      "source_control_name": "item_cost_label_1",
                                      "source_property_name": "(#double_slash_visible or #single_slash_visible)",
                                      "target_property_name": "#visible"
                                    }
                                  ]
                                }
                              }
                            ]
                          }
                        }
                      ]
                    }
                  }
                ]
              }
            }
          ]
        }
      },
      {
        "spacer@global.empty_collection": {
          "collection_name": "trade_item_1",
          "size": [11, 22],
          "controls": [
            {
              "changed_item_count@trade_global.trade_item_count": {
                "offset": [5, -3],
                "$item_count_binding_name": "#second_trade_item_count"
              }
            }
          ]
        }
      },
      {
        "second_item@global.empty_collection": {
          "size": [19, 20],
          "collection_name": "trade_item_2",
          "controls": [
            {
              "item_requirement_section_2@trade_global.trade_text_area": {
                "$trade_wrapper_content": [
                  {
                    "secondary_item_renderer@trade_global.item_renderer": {
                      "offset": [4, 1],
                      "controls": [
                        {
                          "item_cost_label_2@trade_global.trade_item_count": {
                            "controls": [
                              {
                                "arrow_wrapper@global.empty_panel": {
                                  "size": ["100%cm", "100%cm"],
                                  "anchor_from": "top_right",
                                  "anchor_to": "top_left",
                                  "offset": [3, -5],
                                  "controls": [
                                    {
                                      "out_of_stock_icon@trade_global.trade_arrow": {
                                        "$arrow_visibility_condition": "#trade_cross_out_visible",
                                        "texture": "assets/sprites/container/villager/trade_arrow_out_of_stock"
                                      }
                                    },
                                    { "in_of_stock_icon@trade_global.trade_arrow": {} }
                                  ]
                                }
                              }
                            ]
                          }
                        }
                      ]
                    }
                  }
                ]
              }
            }
          ]
        }
      },
      { "filler_1@global.empty_panel": { "size": [16, 20] } },
      {
        "item_for_sale@global.empty_collection": {
          "size": [22, 20],
          "collection_name": "sell_item",
          "controls": [
            {
              "selling_item_section@trade_global.trade_text_area": {
                "$trade_wrapper_content": [
                  {
                    "tertiary_item_renderer@trade_global.item_renderer": {
                      "offset": [2, 1],
                      "controls": [{ "selling_item_count@trade_global.trade_item_count": {} }]
                    }
                  }
                ]
              }
            }
          ]
        }
      }
    ]
  },
  "trade_arrow@global.empty_image": {
    "size": [10, 9],
    "$arrow_visibility_condition|default": "(not #trade_cross_out_visible)",
    "texture": "assets/sprites/container/villager/trade_arrow",
    "bindings": [
      { "binding_type": "collection_details" },
      {
        "binding_condition": "always",
        "binding_name": "$arrow_visibility_condition",
        "binding_name_override": "#visible"
      }
    ]
  },
  "trade_item_count": {
    "type": "label",
    "shadow": true,
    "layer": 5,
    "$item_count_binding_name|default": "#trade_item_count",
    "text": "$item_count_binding_name",
    "anchor_from": "bottom_right",
    "anchor_to": "bottom_right",
    "offset": [1, 2],
    "property_bag": {
      "#enabled_alpha_true": 1,
      "#enabled_alpha_false": 0.3
    },
    "alpha": "#alpha",
    "propagate_alpha": true,
    "bindings": [
      { "binding_type": "collection_details" },
      { "binding_name": "$item_count_binding_name" },
      { "binding_name": "#double_slash_visible" },
      { "binding_name": "#single_slash_visible" },
      { "binding_name": "#trade_toggle_enabled", "binding_condition": "always_when_visible" },
      {
        "binding_type": "view",
        "binding_condition": "always",
        "source_property_name": "('#enabled_alpha_' + (#trade_toggle_enabled or $use_unlocked_villager_trades))",
        "target_property_name": "#alpha"
      },
      {
        "ignored": "(not ($item_count_binding_name = '#second_trade_item_count'))",
        "binding_condition": "always",
        "binding_name": "#trade_price_different",
        "binding_name_override": "#visible"
      }
    ]
  },
  "item_renderer@jc_container_item.item_renderer": {
    "size": [16, 16],
    "anchor_from": "top_left",
    "anchor_to": "top_left",
    "layer": 5,
    "property_bag": {
      "#disabled_filter_visible": true,
      "#enabled_true": 0.9,
      "#enabled_false": 0.5
    },
    "bindings": [
      { "binding_type": "collection_details" },
      { "binding_name": "#item_custom_color" },
      { "binding_name": "#item_pickup_time" },
      { "binding_name": "#banner_patterns" },
      { "binding_name": "#banner_colors" },
      { "binding_name": "#banner_type" },
      { "binding_name": "#item_id_aux" },
      { "binding_name": "#trade_toggle_enabled", "binding_condition": "always_when_visible" },
      {
        "binding_type": "view",
        "binding_condition": "always",
        "source_property_name": "('#enabled_' + (#trade_toggle_enabled or $use_unlocked_villager_trades))",
        "target_property_name": "#filtered_light_multiplier"
      }
    ]
  },
  "trade_text_area": {
    "type": "button",
    "default_focus_precedence": 1,
    "hover_control": "hover_text",
    "focus_enabled": false,
    "focus_wrap_enabled": false,
    "focus_magnet_enabled": false,
    "consume_event": false,
    "button_mappings": [
      { "to_button_id": "button.container_slot_hovered", "mapping_type": "pressed", "consume_event": false }
    ],
    "$trade_wrapper_content|default": [],
    "controls": [
      { "content_wrapper@global.empty_panel": { "controls": "$trade_wrapper_content" } },
      {
        "hover_text@global.hover_text": {
          "offset": [13, -10], //offset for mobile
          "bindings": [
            { "binding_type": "collection_details" },
            { "binding_name": "#hover_text", "binding_condition": "visible" }
          ]
        }
      }
    ]
  }
}
