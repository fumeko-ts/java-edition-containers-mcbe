{
  "namespace": "scroll_panel",
  "scroll_panel": {
    "type": "input_panel",
    "size": "$scrolling_pane_size",
    "offset": "$scrolling_pane_offset",
    "anchor_to": "top_left",
    "$clip_offset|default": [0, 0],
    "$scrolling_pane_size|default": ["100%", "100%"],
    "$scrolling_pane_offset|default": [0, 0],
    "$scroll_view_control_size|default": ["100%", "100%"],
    "$scroll_view_port_size|default": ["100%", "100%"],
    "$scroll_view_port_offset|default": [0, 0],
    "$view_port_size|default": ["fill", "100%"],
    "$scroll_size|default": [4, "100%"],
    "$scroll_box_size|default": ["100%", "100%"],
    "$scroll_box_visible|default": true,
    "$scroll_track_offset": [0, 0],
    "$scroll_box_image_control": "global.empty_image",
    "anchor_from": "top_left",
    "$scroll_panel_consume_hover_events|default": true,
    "consume_hover_events": "$scroll_panel_consume_hover_events",
    "$scroll_track_icon|default": "global.empty_panel",
    "$scroll_view_name|default": "scroll_view",
    "tts_ignore_count": true,
    "controls": [
      {
        "$scroll_view_name": {
          "type": "scroll_view",
          "size": "$scroll_view_control_size",
          "$scroll_view_control_anchor|default": "center",
          "anchor_to": "$scroll_view_control_anchor",
          "anchor_from": "$scroll_view_control_anchor",
          "scroll_speed": 6,
          "scrollbar_track_button": "button.scrollbar_skip_track",
          "scrollbar_touch_button": "button.scrollbar_touch",
          "always_listen_to_input": true,
          "always_handle_pointer": true,
          "always_handle_scrolling": false,
          "scrollbar_always_visible": false,
          "allow_scroll_even_when_content_fits": false,
          "scrollbar_track": "track",
          "scrollbar_box": "box",
          "scroll_content": "scrolling_content",
          "scroll_view_port": "scrolling_view_port",
          "scroll_box_and_track_panel": "bar_and_track",
          "jump_to_bottom_on_update": false,
          "button_mappings": [
            {
              "from_button_id": "button.menu_select",
              "to_button_id": "button.scrollbar_touch",
              "mapping_type": "pressed",
              "button_up_right_of_first_refusal": true
            }
          ],
          "bindings": [{ "binding_name": "#gesture_control_enabled" }],
          "controls": [
            {
              "panel@global.empty_panel": {
                "anchor_to": "top_left",
                "anchor_from": "top_left",
                "$view_port_size|default": ["100%", "100%"],
                "clips_children": true,
                "controls": [
                  {
                    "viewport@global.empty_panel": {
                      "size": "$view_port_size",
                      "anchor_from": "top_left",
                      "anchor_to": "top_left",
                      "clips_children": true,
                      "$scrolling_content_anchor_from|default": "top_left",
                      "$scrolling_content_anchor_to|default": "top_left",
                      "controls": [
                        {
                          "scrolling_view_port@global.empty_panel": {
                            "layer": 1,
                            "anchor_from": "top_left",
                            "anchor_to": "top_left",
                            "clips_children": true,
                            "clip_offset": "$clip_offset",
                            "offset": "$scroll_view_port_offset",
                            "size": "$scroll_view_port_size",
                            "controls": [
                              {
                                "scrolling_content@$scrolling_content": {
                                  "layer": 2,
                                  "anchor_from": "$scrolling_content_anchor_from",
                                  "anchor_to": "$scrolling_content_anchor_to"
                                }
                              }
                            ]
                          }
                        }
                      ]
                    }
                  },
                  {
                    "bar_and_track@global.empty_panel": {
                      "clips_children": true,
                      "size": "$scrolling_pane_size",
                      "anchor_from": "center",
                      "anchor_to": "center",
                      "controls": [
                        {
                          "centered_panel@global.empty_panel": {
                            "size": "$scroll_size",
                            "anchor_to": "center",
                            "anchor_from": "center",
                            "allow_clipping": false,
                            "offset": "$scroll_track_offset",
                            "controls": [
                              {
                                "track": {
                                  "type": "scroll_track",
                                  "size": "$scroll_track_sise",
                                  "$scroll_track_sise|default": ["default", "default"],
                                  "layer": 4,
                                  "anchor_from": "center",
                                  "anchor_to": "center",
                                  "controls": [{ "bar_indent@$scroll_track_icon": {} }],
                                  "button_mappings": [
                                    {
                                      "from_button_id": "button.menu_select",
                                      "to_button_id": "button.scrollbar_skip_track",
                                      "mapping_type": "pressed"
                                    }
                                  ]
                                }
                              },
                              {
                                "scroll_box@global.empty_panel": {
                                  "layer": 5,
                                  "anchor_from": "center",
                                  "anchor_to": "center",
                                  "controls": [
                                    {
                                      "box": {
                                        "type": "scrollbar_box",
                                        "anchor_to": "top_left",
                                        "anchor_from": "top_left",
                                        "layer": 1,
                                        "visible": "$scroll_box_visible",
                                        "contained": true,
                                        "draggable": "vertical",
                                        "button_mappings": [
                                          {
                                            "from_button_id": "button.menu_select",
                                            "to_button_id": "button.menu_select",
                                            "mapping_type": "pressed",
                                            "button_up_right_of_first_refusal": true
                                          }
                                        ],
                                        "controls": [{ "mouse_box@$scroll_box_image_control": {} }]
                                      }
                                    }
                                  ]
                                }
                              }
                            ]
                          }
                        }
                      ]
                    }
                  }
                ]
              }
            }
          ]
        }
      }
    ]
  },

  "new_scroll_panel": {
    "type": "scroll_view",
    "size": "$scroll_viewport_and_bar_combined_size",
    "scroll_speed": 6,
    "scrollbar_track_button": "button.scrollbar_skip_track",
    "scrollbar_touch_button": "button.scrollbar_touch",
    "always_listen_to_input": true,
    "always_handle_pointer": true,
    "always_handle_scrolling": false,
    "scrollbar_always_visible": false,
    "allow_scroll_even_when_content_fits": false,
    "jump_to_bottom_on_update": false,
    "button_mappings": [
      {
        "from_button_id": "button.menu_select",
        "to_button_id": "button.scrollbar_touch",
        "mapping_type": "pressed",
        "button_up_right_of_first_refusal": true
      }
    ],
    "bindings": [{ "binding_name": "#gesture_control_enabled", "binding_condition": "always" }],
    "scrollbar_track": "scroll_track",
    "scrollbar_box": "scroll_box",
    "scroll_content": "scrolling_content",
    "scroll_view_port": "scrolling_view_port",
    "scroll_box_and_track_panel": "scroll_box_and_track",

    //variables

    "$scroll_viewport_and_bar_combined_size|default": [66, 54],

    "$scroll_viewport_size|default": [54, 54],
    "$scroll_viewport_anchor|default": "top_left",

    "$scroll_track_anchor|default": "right_middle",
    "$scroll_track_size|default": [12, "100%"],
    "$scroll_track_offset|default": [2, 0],
    "$scroll_track_should_clip_children|default": false,

    "$scroll_box_visible|default": true,

    "$scroll_box_icon|default": "global.empty_panel",
    "$scroll_track_icon|default": "global.empty_panel",

    "$scrolling_content|default": "global.empty_panel",

    "controls": [
      {
        "scrolling_view_port@global.empty_panel": {
          "size": "$scroll_viewport_size",
          "anchor_from": "$scroll_viewport_anchor",
          "anchor_to": "$scroll_viewport_anchor",
          "layer": 2,
          "clips_children": true,
          "controls": [
            {
              "scrolling_content@$scrolling_content": {
                "anchor_from": "top_middle",
                "anchor_to": "top_middle"
              }
            }
          ]
        }
      },
      {
        "scroll_box_and_track@global.root_panel": {
          "size": "$scroll_track_size",
          "anchor_to": "$scroll_track_anchor",
          "anchor_from": "$scroll_track_anchor",
          "offset": "$scroll_track_offset",
          "layer": 3,
          "allow_clipping": false,
          "clips_children": "$scroll_track_should_clip_children",
          "controls": [
            {
              "scroll_track": {
                "type": "scroll_track",
                "size": ["100%", "100%"],
                "layer": 1,
                "controls": [{ "$scroll_track_icon@$scroll_track_icon": {} }],
                "button_mappings": [
                  {
                    "from_button_id": "button.menu_select",
                    "to_button_id": "button.scrollbar_skip_track",
                    "mapping_type": "pressed",
                    "button_up_right_of_first_refusal": true
                  }
                ]
              }
            },
            {
              "scroll_box": {
                "type": "scrollbar_box",
                "anchor_to": "top_middle",
                "anchor_from": "top_middle",
                "visible": "$scroll_box_visible",
                "contained": true,
                "draggable": "vertical",
                "layer": 2,
                "button_mappings": [
                  {
                    "from_button_id": "button.menu_select",
                    "to_button_id": "button.menu_select",
                    "mapping_type": "pressed",
                    "button_up_right_of_first_refusal": true
                  }
                ],
                "controls": [{ "$scroll_box_icon@$scroll_box_icon": {} }]
              }
            }
          ]
        }
      }
    ]
  },
  "test_scrolling_pane@scroll_panel.new_scroll_panel": {
    "layer": 99,

    "$scroll_viewport_size": [162, 54],

    "$scroll_box_icon": "scroll_panel.box",
    "$scroll_track_icon": "scroll_panel.track",

    "$scrolling_content": "scroll_panel.scrolling_content"
  },

  "icon@global.empty_image": {
    "texture": "assets/sprites/container/slot.png",
    "nineslice_size": 1,
    "color": "purple",
    "size": [18, 18]
  },

  "box@global.empty_image": {
    "texture": "assets/sprites/container/slot.png",
    "nineslice_size": 1,
    "color": "cyan",
    "size": ["100%", "100%"]
  },

  "track@global.empty_image": {
    "texture": "assets/sprites/container/slot.png",
    "nineslice_size": 1,
    "color": "red",
    "size": ["100%", "100%"]
  },
  "scrolling_content@global.empty_grid": {
    "size": [54, 360],
    "grid_dimensions": [3, 20],
    "grid_item_template": "scroll_panel.icon"
  }
}
