{
  "namespace": "custom_debug_content",
  "item_id_getter@global.empty_panel": {
    "anchor_from": "left_middle",
    "anchor_to": "left_middle",
    "offset": [5, 0],
    "size": ["60% - 176px", "100% - 20px"],
    "controls": [
      {"data@custom_debug_content.id_collection_binding_data": {}},
      {"edit_content@custom_debug_content.edit_area": {}}
    ]
  },
  /*
    outputs the raw json needed to update the tab ids
  */
  "edit_area@text_edit_area.text_edit_box": {
    "size": ["100%", "100%"],
    "anchor_from": "top_left",
    "anchor_to": "top_left",
    "$text_edit_label_size": ["100%", "100%"],
    "$text_edit_text_control": "debug_text_input",
    "$text_box_input_label_bindings": [
      {"binding_type": "view","source_control_name": "binding_data_index_0"  ,"source_property_name": "('  \/*slot_1*\/  \"$chest_item_index\": ' + #item_id + ',\n')"            ,"target_property_name": "#p0"},
      {"binding_type": "view","source_control_name": "binding_data_index_1"  ,"source_property_name": "('  \/*slot_2*\/  \"$compass_item_index\": ' + #item_id + ',\n')"          ,"target_property_name": "#p1"},
      {"binding_type": "view","source_control_name": "binding_data_index_2"  ,"source_property_name": "('  \/*slot_3*\/  \"$redstone_item_index\": ' + #item_id + ',\n')"         ,"target_property_name": "#p2"},
      {"binding_type": "view","source_control_name": "binding_data_index_3"  ,"source_property_name": "('  \/*slot_4*\/  \"$iron_sword_item_index\": ' + #item_id + ',\n')"       ,"target_property_name": "#p3"},
      {"binding_type": "view","source_control_name": "binding_data_index_4"  ,"source_property_name": "('  \/*slot_5*\/  \"$purple_froglight_item_index\": ' + #item_id + ',\n')" ,"target_property_name": "#p4"},
      {"binding_type": "view","source_control_name": "binding_data_index_5"  ,"source_property_name": "('  \/*slot_6*\/  \"$bricks_item_index\": ' + #item_id + ',\n\n')"           ,"target_property_name": "#p5"},
      {"binding_type": "view","source_control_name": "binding_data_index_6"  ,"source_property_name": "('  \/*slot_7*\/  \"$apple_item_index\": ' + #item_id + ',\n')"            ,"target_property_name": "#p6"},
      {"binding_type": "view","source_control_name": "binding_data_index_7"  ,"source_property_name": "('  \/*slot_8*\/  \"$bucket_lava_item_index\": ' + #item_id + ',\n')"      ,"target_property_name": "#p7"},
      {"binding_type": "view","source_control_name": "binding_data_index_8"  ,"source_property_name": "('  \/*slot_9*\/  \"$golden_sword_item_index\": ' + #item_id + ',\n')"     ,"target_property_name": "#p8"},
      {"binding_type": "view","source_control_name": "binding_data_index_9"  ,"source_property_name": "('  \/*slot_10*\/  \"$iron_axe_item_index\": ' + #item_id + ',\n\n')"         ,"target_property_name": "#p9"},
      {"binding_type": "view","source_control_name": "binding_data_index_10" ,"source_property_name": "('  \/*slot_11*\/  \"$raw_porkchop_item_index\": ' + #item_id + ',\n')"     ,"target_property_name": "#p10"},
      {"binding_type": "view","source_control_name": "binding_data_index_11" ,"source_property_name": "('  \/*slot_12*\/  \"$stone_item_index\": ' + #item_id + ',\n')"            ,"target_property_name": "#p11"},
      {"binding_type": "view","source_control_name": "binding_data_index_12" ,"source_property_name": "('  \/*slot_13*\/  \"$emerald_item_index\": ' + #item_id + ',\n\n')"          ,"target_property_name": "#p12"},
      {"binding_type": "view","source_control_name": "binding_data_index_13" ,"source_property_name": "('  \/*slot_14*\/  \"$golden_leggings_item_index\": ' + #item_id + ',\n')"  ,"target_property_name": "#p13"},
      {"binding_type": "view","source_control_name": "binding_data_index_14" ,"source_property_name": "('  \/*slot_15*\/  \"$iron_shovel_item_index\": ' + #item_id + ',\n')"      ,"target_property_name": "#p14"},

      {
        "binding_type": "view",
        "source_property_name": "(#p0 + #p1 + #p2 + #p3 + #p4 + #p5 + #p6 + #p7 + #p8 + #p9 + #p10 + #p11 + #p12 + #p13 + #p14)",
        "target_property_name": "#item_name"
      }
    ]
  },
  "id_collection_binding_data@global.empty_collection": {
    "size":[0, 0],
    "collection_name": "container_items",
    "controls": [
      {"binding_data_index_0@custom_debug_content.data_control": {"collection_index": 0}},
      {"binding_data_index_1@custom_debug_content.data_control": {"collection_index": 1}},
      {"binding_data_index_2@custom_debug_content.data_control": {"collection_index": 2}},
      {"binding_data_index_3@custom_debug_content.data_control": {"collection_index": 3}},
      {"binding_data_index_4@custom_debug_content.data_control": {"collection_index": 4}},
      {"binding_data_index_5@custom_debug_content.data_control": {"collection_index": 5}},
      
      {"binding_data_index_6@custom_debug_content.data_control": {"collection_index": 6}},
      {"binding_data_index_7@custom_debug_content.data_control": {"collection_index": 7}},
      {"binding_data_index_8@custom_debug_content.data_control": {"collection_index": 8}},
      {"binding_data_index_9@custom_debug_content.data_control": {"collection_index": 9}},

      {"binding_data_index_10@custom_debug_content.data_control": {"collection_index": 10}},
      {"binding_data_index_11@custom_debug_content.data_control": {"collection_index": 11}},
      {"binding_data_index_12@custom_debug_content.data_control": {"collection_index": 12}},

      {"binding_data_index_13@custom_debug_content.data_control": {"collection_index": 13}},
      {"binding_data_index_14@custom_debug_content.data_control": {"collection_index": 14}}
    ]
  },
  "data_control@global.empty_panel": {
    "bindings": [
      {
        "binding_type": "collection",
        "binding_collection_name": "container_items",
        "binding_name": "#item_id_aux"
      },
      {
        "binding_type": "view",
        "source_property_name": "(#item_id_aux / 65536)",
        "target_property_name": "#item_id"
      }
    ]
  }
}
