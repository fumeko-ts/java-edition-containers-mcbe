{
  "namespace": "survival_recipe_grid",
  "recipe_grid@global.empty_panel": {
    "clips_children": true,
    "size": [ 125, 100 ],
    "layer": 4,
    "offset": [ -11, 31 ],
    "anchor_to": "top_right",
    "anchor_from": "top_right",
    "$item_collection|default": "recipe_book",
    "controls": [
      {
        "grid_holder@global.empty_panel": {
          "size": [ 125, "100%c" ],
          "anchor_to": "top_left",
          "anchor_from": "top_left",
          "offset": [ 0, -0.4 ],
          "controls": [
            {
              "recipe_book_grid@global.empty_grid": {
                "size": [ 125, "default" ],
                "collection_name": "$item_collection",
                "grid_rescaling_type": "horizontal",
                "grid_item_template": "survival_recipe_grid.item_template",
                "bindings": [
                  {
                    "binding_name": "#recipe_book_total_items",
                    "binding_name_override": "#maximum_grid_items",
                    "binding_condition": "visible",
                    "binding_type": "collection",
                    "binding_collection_name": "recipe_book"
                  },
                  //do not steal how i did this it took me so long to make please respect my license
                  {
                    "binding_type": "view",
                    "binding_condition": "always",
                    "source_property_name": "((#maximum_grid_items + 19) / 20)",
                    "target_property_name": "#maximum_recipe_pages"
                  },
                  {"binding_type": "view","source_control_name": "page1", "source_property_name": "#toggle_state","target_property_name": "#p1"},
                  {"binding_type": "view","source_control_name": "page2", "source_property_name": "#toggle_state","target_property_name": "#p2"},
                  {"binding_type": "view","source_control_name": "page3", "source_property_name": "#toggle_state","target_property_name": "#p3"},
                  {"binding_type": "view","source_control_name": "page4", "source_property_name": "#toggle_state","target_property_name": "#p4"},
                  {"binding_type": "view","source_control_name": "page5", "source_property_name": "#toggle_state","target_property_name": "#p5"},
                  {"binding_type": "view","source_control_name": "page6", "source_property_name": "#toggle_state","target_property_name": "#p6"},
                  {"binding_type": "view","source_control_name": "page7", "source_property_name": "#toggle_state","target_property_name": "#p7"},
                  {"binding_type": "view","source_control_name": "page8", "source_property_name": "#toggle_state","target_property_name": "#p8"},
                  {"binding_type": "view","source_control_name": "page9", "source_property_name": "#toggle_state","target_property_name": "#p9"},
                  {"binding_type": "view","source_control_name": "page10","source_property_name": "#toggle_state","target_property_name": "#p10"},
                  {"binding_type": "view","source_control_name": "page11","source_property_name": "#toggle_state","target_property_name": "#p11"},
                  {"binding_type": "view","source_control_name": "page12","source_property_name": "#toggle_state","target_property_name": "#p12"},
                  {"binding_type": "view","source_control_name": "page13","source_property_name": "#toggle_state","target_property_name": "#p13"},
                  {"binding_type": "view","source_control_name": "page14","source_property_name": "#toggle_state","target_property_name": "#p14"},
                  {"binding_type": "view","source_control_name": "page15","source_property_name": "#toggle_state","target_property_name": "#p15"},
                  {"binding_type": "view","source_control_name": "page16","source_property_name": "#toggle_state","target_property_name": "#p16"},
                  {"binding_type": "view","source_control_name": "page17","source_property_name": "#toggle_state","target_property_name": "#p17"},
                  {"binding_type": "view","source_control_name": "page18","source_property_name": "#toggle_state","target_property_name": "#p18"},
                  {"binding_type": "view","source_control_name": "page19","source_property_name": "#toggle_state","target_property_name": "#p19"},
                  {"binding_type": "view","source_control_name": "page20","source_property_name": "#toggle_state","target_property_name": "#p20"},
                  {"binding_type": "view","source_control_name": "page21","source_property_name": "#toggle_state","target_property_name": "#p21"},
                  {"binding_type": "view","source_control_name": "page22","source_property_name": "#toggle_state","target_property_name": "#p22"},
                  {"binding_type": "view","source_control_name": "page23","source_property_name": "#toggle_state","target_property_name": "#p23"},
                  {"binding_type": "view","source_control_name": "page24","source_property_name": "#toggle_state","target_property_name": "#p24"},
                  {"binding_type": "view","source_control_name": "page25","source_property_name": "#toggle_state","target_property_name": "#p25"},
                  {"binding_type": "view","source_control_name": "page26","source_property_name": "#toggle_state","target_property_name": "#p26"},
                  {"binding_type": "view","source_control_name": "page27","source_property_name": "#toggle_state","target_property_name": "#p27"},
                  {
                    "binding_type": "view",
                    "binding_condition": "always",
                    "source_property_name": "(#p1 + #p2 + #p3 + #p4 + #p5 + #p6 + #p7 + #p8 + #p9 + #p10 + #p11 + #p12 + #p13 + #p14 + #p15 + #p16 + #p17 + #p18 + #p19 + #p20 + #p21 + #p22 + #p23 + #p24 + #p25 + #p26 + #p27)",
                    "target_property_name": "#raw_current_page"
                  },
                  {
                    "binding_type": "view",
                    "binding_condition": "always",
                    "source_property_name": "('#page_' + (1 + #raw_current_page))",
                    "target_property_name": "#offset"
                  }
                ],
                "offset": "#offset",
                "property_bag": {
                  "#page_1":  [ 0, 0    ],
                  "#page_2":  [ 0, -100 ],
                  "#page_3":  [ 0, -200 ],
                  "#page_4":  [ 0, -300 ],
                  "#page_5":  [ 0, -400 ],
                  "#page_6":  [ 0, -500 ],
                  "#page_7":  [ 0, -600 ],
                  "#page_8":  [ 0, -700 ],
                  "#page_9":  [ 0, -800 ],
                  "#page_10": [ 0, -900 ],
                  "#page_11": [ 0, -1000 ],
                  "#page_12": [ 0, -1100 ],
                  "#page_13": [ 0, -1200 ],
                  "#page_14": [ 0, -1300 ],
                  "#page_15": [ 0, -1400 ],
                  "#page_16": [ 0, -1500 ],
                  "#page_17": [ 0, -1600 ],
                  "#page_18": [ 0, -1700 ],
                  "#page_19": [ 0, -1800 ],
                  "#page_20": [ 0, -1900 ],
                  "#page_21": [ 0, -2000 ],
                  "#page_22": [ 0, -2100 ],
                  "#page_23": [ 0, -2200 ],
                  "#page_24": [ 0, -2300 ],
                  "#page_25": [ 0, -2400 ],
                  "#page_26": [ 0, -2500 ],
                  "#page_27": [ 0, -2600 ]
                }
              }
            }
          ]
        }
      }
    ]
  },
  "item_template@button_mappings.survival_recipe_cell_button": {
    "size": [ 25, 25 ],
    "layer": 4,
    "sound_volume": 1.0,
    "sound_pitch": 1.0,
    "$output_item_collection|default": "crafting_output_items",
    "variables": {
      "requires": "($is_smoker_screen or $is_furnace_screen or $is_blast_furnace_screen)",
      "$output_item_collection|default": "furnace_output_items"
    },
    "controls": [
      {
        "hover@global.empty_panel": {
          "controls": [
            {
              "hover_text@global.hover_text": {
                "offset": [ 15, -10 ],
                "bindings": [
                  {
                    "binding_name": "#hover_text",
                    "binding_name_override": "#hover_text",
                    "binding_type": "collection",
                    "binding_collection_name": "$item_collection"
                  },
                  {
                    "ignored": "$use_pc_hover_text_with_touch_input",
                    "binding_name": "(not #using_touch)",
                    "binding_name_override": "#visible"
                  }
                ]
              }
            }
          ]
        }
      },
      {
        "item_holder@global.empty_panel": {
          "size": [ 20, 20 ],
          "anchor_from": "top_left",
          "anchor_to": "top_left",
          "offset": [ 2, 2 ],
          "controls": [
            {"item_renderer@jc_container_item.item_renderer": {"size": [ 16, 16 ]}}
          ]
        }
      },
      {
        "recipe_slot@screen_content.image_element": {
          "size": [ 25, 25 ],
          "texture": "#texture",
          "property_bag": {
            "#collection_name": "$output_item_collection",
            "#collection_index": 0,
            "#texture_1": "assets/sprites/recipe_book/slot_craftable",
            "#texture_2": "assets/sprites/recipe_book/slot_uncraftable"
          },
          "bindings": [
            {
              "binding_name": "#container_item_background",
              "binding_name_override": "#item_index",
              "binding_condition": "always",
              "binding_type": "collection",
              "binding_collection_name": "$output_item_collection"
            },
            {
              "binding_name": "#container_item_background_texture",
              "binding_name_override": "#item_bg",
              "binding_condition": "visible",
              "binding_type": "collection",
              "binding_collection_name": "recipe_book"
            },
            {
              "binding_type": "view",
              "source_property_name": "((#item_bg = 'textures/ui/recipe_book_item_bg') or ((#item_bg = 'textures/ui/recipe_book_touch_cell_selected') and (#item_index = 0)))",
              "target_property_name": "#craftable"
            },
            {
              "binding_type": "view",
              "source_property_name": "((#item_bg = 'textures/ui/recipe_book_red_button') or ((#item_bg = 'textures/ui/recipe_book_touch_cell_selected') and (#item_index = 3)))",
              "target_property_name": "#uncraftable"
            },
            {
              "binding_type": "view",
              "source_property_name": "('#texture_' + ((#craftable * 1) + (#uncraftable * 2)))",
              "target_property_name": "#texture"
            }
          ]
        }
      }
    ]
  }
}