{
  "namespace": "jei_layout_bridge",
  "jei_inventory_layout@d\u00e9esse_JEIlayout.inventory_jei_layout": {
    "controls": [
      { "left_half@jei_layout_bridge.template": { "$recipe_direction": "$controls_left" } },
      { "center_content@jei_layout_bridge.container_element": {} },
      { "right_half@jei_layout_bridge.template": {} }
    ]
  },
  "jei_smelting_layout@d\u00e9esse_JEIlayout.furnace_jei_layout": {
    "controls": [
      { "left_half@jei_layout_bridge.template": { "$recipe_direction": "$controls_left" } },
      { "center_content@jei_layout_bridge.container_element": {} },
      { "right_half@jei_layout_bridge.template": {} }
    ]
  },
  "template@global.empty_panel": {
    "size": ["fill", "100% - 2px"],
    "$recipe_direction|default": "$controls_right",
    "controls": [{ "recipe_book@$recipe_direction": {} }]
  },
  "container_element@global.empty_panel": {
    "size": [180, "100%"],
    "controls": [
      {
        "player_inventory@$recipe_container_type": {
          "anchor_to": "center",
          "anchor_from": "center"
        }
      }
    ]
  }
}
