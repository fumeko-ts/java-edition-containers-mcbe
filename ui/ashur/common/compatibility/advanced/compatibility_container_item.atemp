{
  "namespace": "compatibility_container_item",

  "container_item_bridge@global.empty_panel": {
    //vanilla mappings (don't change)
    "$button_ref|default": "$button_control",
    "$item_collection_name|default": "$item_collection",
    
    //custom things (can change)
    "variables": [
      /*
      Possible variables to override and their default values: 
        - "$dont_render_hover_text": false,
        - "$dont_render_item": false,
        - "$dont_render_item_count": false,
        - "$stack_count_offset": [0, 1],
        - "$progress_bar_offset": [-3, -3],
        - "$progress_bar_anchor": "bottom_right",
        - "$background_control": "global.empty_panel",
        - "$item_renderer_control": "jc_container_item.item_renderer",
        - "$button_control": "button_mappings.container_item_button",
        - "$button_control_name": "$button_control",
        - "$bundle_cycled_item_renderer": "jc_container_item.bundle_item_template",
        - "$storage_bar_control": "jc_container_item.storage_bar",
        - "$durability_bar_control": "jc_container_item.durability_bar",
        - "$stack_count_control": "jc_container_item.stack_count_label",
        - "$touch_slot_selected_control": "jc_container_item.touch_slot_selected",
        - "$item_collection": "Minecraft",
        - "$button_binding": "#none",

        - "$cell_hover_text_bindings": [
            {
              "binding_type": "collection",
              "binding_collection_name": "$item_collection",
              "binding_name": "#hover_text",
              "binding_name_override": "#hover_text"
            },
            {
              "binding_name": "(not #show_bundle_tooltip_hover)",
              "binding_name_override": "#visible"
            }
          ],

        - "$custom_slot_content": "global.empty_panel",
    
      How to override: 
        {
          "requires": "(...)",// for info on this refer to 'ui/ashur/common/compatibility/extensions.atemp'
          "$item_renderer_control": "global.empty_panel" //doing this removes the item renderer
        }

      You can use $item_collection_name to override per item cell here’s the possible values for $item_collection_name:
        - anvil_result_items
        - anvil_material_items
        - anvil_input_items
        - beacon_payment_items

        - brewing_input_item
        - brewing_fuel_item

        - cartography_result_items
        - cartography_additional_items
        - cartography_input_items

        - enchanting_lapis_items
        - enchanting_input_items

        - grindstone_result_items
        - grindstone_input_items
        - grindstone_additional_items

        - loom_material_items
        - loom_dye_items
        - loom_input_items

        - smithing_table_result_items
        - smithing_table_material_items
        - smithing_table_input_items
        - smithing_table_template_items

        - stonecutter_result_items
        - stonecutter_input_items

        - trade2_ingredient2_item
        - trade2_ingredient1_item
        - trade2_result_item

      All mount UI's share this 1:
        - horse_equip_items

      Inventory and Creative inventory share these 2:
        - offhand_items
        - armor_items

      Inventory and Crafting UI's share these 2:
        - crafting_output_items
        - crafting_input_items

      All smelting UI's share these 3:
        - furnace_output_items
        - furnace_fuel_items
        - furnace_ingredient_items

      There’s also 3 other variables: 
        - container_items
        - hotbar_items
        - inventory_items

      How to use:
        {
          "requires": "($item_collection_name = 'enchanting_lapis_items')"//this will overwrite the var you want for only the enchanting lapis slot.
        }
      */

      //the base pack's existing overrides
      {
        "requires": "$is_container_utilities",
        "$item_renderer_control": "container_utilities_bridge.custom_item_renderer",
        "$button_control_name": "container_utilities_bridge.input_manager"
      },
      {
        "requires": "$is_déesse_ui_pack",
        "$custom_slot_content": "deesse_ui_bridge.buttons"
      }
    ]
  },
  "floating_item_compatibility@global.empty_panel": {
    "variables": [
      /*
      this allows the user to do things with the floating item renderer here’s the possible variables to override and an example of how to do so.

      Possible variables to override and their default values: 
       - "$floating_item_renderer_control": "container_common.floating_item_renderer_control",
       - "$floating_stack_count_label_control": "container_common.floating_stack_count_label",
       - "$floating_durability_bar_control": "container_common.floating_durability_bar",
       - "$floating_storage_bar_control": "container_common.floating_storage_bar"
      How to override: 
        {
          "requires": "(...)",// for info on this refer to 'ui/ashur/common/compatibility/extensions.atemp'
          "$floating_item_renderer_control": "global.empty_panel" //when (...) is true this will override the floating item renderer
        }

      If you don't know if your override will work you can do "requires": true, inplace to test
      
      */
    ]
  }
}
