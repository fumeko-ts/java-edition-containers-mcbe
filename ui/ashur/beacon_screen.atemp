{
  "namespace": "beacon_screen",
  "beacon_panel@container_common.container_details": {
    "size": [ 230, 219 ],
    "anchor_from": "center",
    "anchor_to": "center",
    "$screen_controls": [
      {
        "beacon_inner_panel@global.empty_panel": {
          "size": [ 216, 97 ],
          "anchor_from": "top_middle",
          "anchor_to": "top_middle",
          "controls": [
            {
              "primary_power_label@beacon_screen.beacon_label": {"text": "tile.beacon.primary", "offset": [ -54, 8 ]}
            },
            {
              "secondary_power_label@beacon_screen.beacon_label": {"text": "tile.beacon.secondary", "offset": [ 52, 8 ]}
            }
          ]
        }
      },
      {"base@screen_content.container_base": {"$beacon_screen": true}},
      {
        "beacon_top_half@global.empty_stack": {
          "orientation": "vertical",
          "size": [ 230, 129 ],
          "anchor_from": "top_middle",
          "anchor_to": "top_middle",
          "controls": [
            {"filler_1@global.empty_panel": {"size": [ "fill", 21 ]}},
            {
              "top_panel_buttons@global.empty_stack": {
                "orientation": "horizontal",
                "size": [ 230, 72 ],
                "controls": [
                  {"filler_1@global.empty_panel": {"size": [ 52, "fill" ]}},
                  {
                    "main_buttons@global.empty_stack": {
                      "orientation": "vertical",
                      "size": [ 46, 72 ],
                      "controls": [
                        {
                          "row_1@global.empty_stack": {
                            "orientation": "horizontal",
                            "size": [ 46, 22 ],
                            "controls": [
                              {"speed@primary_button.primary_button": {"$button_name": "speed"}},
                              {"filler_1@global.empty_panel": {"size": [ 2, "fill" ]}},
                              {"haste@primary_button.primary_button": {"$button_name": "haste"}}
                            ]
                          }
                        },
                        {"filler_1@global.empty_panel": {"size": [ "fill", 3 ]}},
                        {
                          "row_2@global.empty_stack": {
                            "orientation": "horizontal",
                            "size": [ 46, 22 ],
                            "controls": [
                              {"1@primary_button.primary_button": {"$button_name": "resist"}},
                              {"filler_1@global.empty_panel": {"size": [ 2, "fill" ]}},
                              {"2@primary_button.primary_button": {"$button_name": "jump"}}
                            ]
                          }
                        },
                        {"filler_2@global.empty_panel": {"size": [ "fill", 3 ]}},
                        {
                          "row_2@global.empty_stack": {
                            "orientation": "horizontal",
                            "size": [ 46, 22 ],
                            "controls": [
                              {"filler_1@global.empty_panel": {"size": [ 12, "fill" ]}},
                              {"1@primary_button.primary_button": {"$button_name": "strength"}},
                              {"filler_2@global.empty_panel": {"size": [ 12, "fill" ]}}
                            ]
                          }
                        }
                      ]
                    }
                  },
                  {"filler_2@global.empty_panel": {"size": [ 45, "fill" ]}},
                  {
                    "secondary_buttons@global.empty_stack": {
                      "orientation": "vertical",
                      "size": [ 46, 72 ],
                      "controls": [
                        {"filler_1@global.empty_panel": {"size": [ "fill", 25 ]}},
                        {
                          "secondary_buttons_holder@global.empty_stack": {
                            "orientation": "horizontal",
                            "size": [ 46, 22 ],
                            "controls": [
                              {"1@secondary_button.secondary_button": {"$button_name": "regen"}},
                              {"filler_1@global.empty_panel": {"size": [ 2, "fill" ]}},
                              {"2@secondary_button.secondary_button": {"$button_name": "extra"}}
                            ]
                          }
                        },
                        {"filler_2@global.empty_panel": {"size": [ "fill", 23 ]}}
                      ]
                    }
                  },
                  {"filler_3@global.empty_panel": {"size": [ 41, "fill" ]}}
                ]
              }
            }
          ]
        }
      },
      {
        "input_slot_holder@global.empty_stack": {
          "orientation": "vertical",
          "anchor_from": "top_left",
          "anchor_to": "top_left",
          "size": [ 153, 27 ],
          "controls": [
            {"input_top_filler@global.empty_panel": {"size": [ "fill", 109 ]}},
            {
              "slot_push@global.empty_stack": {
                "orientation": "horizontal",
                "size": [ 153, 18 ],
                "controls": [
                  {"filler_1@global.empty_panel": {"size": [ 135, "fill" ]}},
                  {"input@global.container_item": {"$item_collection": "beacon_payment_items"}}
                ]
              }
            }
          ]
        }
      },
      {
        "beacon_inventory@global.empty_stack": {
          "orientation": "horizontal",
          "size": [ 230, 83 ],
          "anchor_to": "bottom_middle",
          "anchor_from": "bottom_middle",
          "controls": [
            {"filler_1@global.empty_panel": {"size": [ 35, "fill" ]}},
            {
              "inventory_bottom_half_with_label@global.empty_stack": {
                "orientation": "vertical",
                "size": [ 162, 83 ],
                "controls": [
                  {
                    "inventory_grid": {
                      "type": "grid",
                      "size": [ 162, 54 ],
                      "grid_dimensions": [ 9, 3 ],
                      "$item_collection_name": "inventory_items",
                      "grid_item_template": "global.grid_item",
                      "collection_name": "inventory_items"
                    }
                  },
                  {"below_inventory_grid_spacing@global.empty_panel": {"size": [ "fill", 4 ]}},
                  {"hotbar@global.hotbar": {}},
                  {"hotbar_bottom_spacing@global.empty_panel": {"size": [ "fill", 7 ]}}
                ]
              }
            },
            {"filler_2@global.empty_panel": {"size": [ 33, "fill" ]}}
          ]
        }
      },
      {
        "confirm_and_exit_buttons@global.empty_stack": {
          "orientation": "vertical",
          "anchor_to": "bottom_right",
          "anchor_from": "bottom_right",
          "size": [ 67, 114 ],
          "controls": [
            {
              "buttons_stack@global.empty_stack": {
                "orientation": "horizontal",
                "size": [ 67, 22 ],
                "controls": [
                  {"confirm_panel@beacon_screen.advanced_buttons_template": {"$button_name": "confirm"}},
                  {"filler_1@global.empty_panel": {"size": [ 4, "fill" ]}},
                  {"cancel_panel@beacon_screen.advanced_buttons_template": {"$button_name": "cancel"}},
                  {"filler_2@global.empty_panel": {"size": [ 19, "fill" ]}}
                ]
              }
            },
            {"filler_1@global.empty_panel": {"size": [ "fill", "fill" ]}}
          ]
        }
      },
      {
        "label_holder@global.empty_stack": {
          "orientation": "vertical",
          "size": [ 230, 21 ],
          "anchor_to": "top_middle",
          "anchor_from": "top_middle",
          "controls": [
            {"filler_1@global.empty_panel": {"size": [ "fill", 9 ]}},
            {
              "labels@global.empty_stack": {
                "orientation": "horizontal",
                "size": [ 230, 11 ],
                "controls": [
                  {"filler_1@global.empty_panel": {"size": [ 26, "fill" ]}},
                  {"primary_label@global.empty_panel": {"size": [ 99, "fill" ]}},
                  {"secondary_label@global.empty_panel": {"size": [ 105, "fill" ]}}
                ]
              }
            },
            {"filler_2@global.empty_panel": {"size": [ "fill", 1 ]}}
          ]
        }
      },
      {
        "usable_items_panel@global.empty_panel": {
          "size": [ 104, 18 ],
          "anchor_to": "top_left",
          "anchor_from": "top_left",
          "controls": [
            {
              "netherite@beacon_screen.item_renderer": {
                "offset": [ 20, 109 ],
                "$item_property": {"#item_id_aux": 48627712},
                "bindings": [ {"binding_name": "#supports_netherite", "binding_name_override": "#visible"} ]
              }
            },
            {
              "emerald@beacon_screen.item_renderer": {"offset": [ 41, 109 ], "$item_property": {"#item_id_aux": 25427968}}
            },
            {
              "diamond@beacon_screen.item_renderer": {"offset": [ 63, 109 ], "$item_property": {"#item_id_aux": 17301504}}
            },
            {
              "gold@beacon_screen.item_renderer": {"offset": [ 86, 109 ], "$item_property": {"#item_id_aux": 17432576}}
            },
            {
              "iron@beacon_screen.item_renderer": {"offset": [ 108, 109 ], "$item_property": {"#item_id_aux": 17367040}}
            }
          ]
        }
      }
    ]
  },
  "beacon_label@common.section_heading_label": {
    "anchor_from": "top_middle",
    "anchor_to": "top_middle",
    "color": "$beacon_power_title_text_color",
    "shadow": true
  },
  "item_renderer@global.empty_panel": {
    "size": [ 16, 16 ],
    "anchor_to": "top_left",
    "anchor_from": "top_left",
    "$item_property|default": {},
    "controls": [
      {
        "item_renderer@global.custom_renderer": {"$type": "inventory_item_renderer", "size": [ 16, 16 ], "property_bag": "$item_property"}
      }
    ]
  },
  "advanced_buttons_template@common.toggle": {
    "size": [ 22, 22 ],
    "layer": 4,
    "focus_wrap_enabled": false,
    "$toggle_name": "$button_name",
    "checked_control": "checked",
    "unchecked_control": "unchecked",
    "checked_hover_control": "checked_hover",
    "unchecked_hover_control": "unchecked_hover",
    "checked_locked_control": "locked_default",
    "unchecked_locked_control": "locked_default",
    "checked_locked_hover_control": "locked_default",
    "unchecked_locked_hover_control": "locked_default",
    "bindings": [
      {"binding_collection_name": "$button_name", "binding_type": "collection_details"},
      {
        "binding_type": "collection",
        "binding_name": "#active",
        "binding_collection_name": "$button_name",
        "binding_name_override": "#enabled"
      },
      {
        "binding_name": "#button_visible",
        "binding_name_override": "#visible",
        "binding_collection_name": "$button_name",
        "binding_type": "collection"
      },
      {
        "binding_type": "collection",
        "binding_name": "#selected",
        "binding_collection_name": "$button_name",
        "binding_name_override": "#toggle_state"
      }
    ],
    "button_mappings": [
      {
        "from_button_id": "button.menu_select",
        "to_button_id": "button.menu_ok",
        "mapping_type": "pressed"
      },
      {"from_button_id": "button.menu_ok", "to_button_id": "button.menu_ok", "mapping_type": "pressed"}
    ],
    "controls": [
      {
        "unchecked@beacon_screen.advanced_icons": {
          "$advanced_button_icon": "('assets/beacon_button_sprites/' + $button_name)",
          "$button_texture": "assets/beacon_button_sprites/default"
        }
      },
      {
        "checked@beacon_screen.advanced_icons": {
          "$advanced_button_icon": "('assets/beacon_button_sprites/' + $button_name)",
          "$button_texture": "assets/beacon_button_sprites/selected"
        }
      },
      {
        "locked_default@beacon_screen.advanced_icons": {
          "$advanced_button_icon": "('assets/beacon_button_sprites/' + $button_name + '_locked')",
          "$button_texture": "assets/beacon_button_sprites/locked"
        }
      },
      {
        "unchecked_hover@beacon_screen.advanced_icons": {
          "$advanced_button_icon": "('assets/beacon_button_sprites/' + $button_name)",
          "$button_texture": "assets/beacon_button_sprites/hover"
        }
      },
      {
        "checked_hover@beacon_screen.advanced_icons": {
          "$advanced_button_icon": "('assets/beacon_button_sprites/' + $button_name)",
          "$button_texture": "assets/beacon_button_sprites/selected"
        }
      }
    ]
  },
  "advanced_icons@screen_content.image_element": {
    "size": [ 22, 22 ],
    "layer": 4,
    "$advanced_button_icon|default": "",
    "texture": "$button_texture",
    "controls": [
      {
        "advanced_icons@screen_content.image_element": {
          "texture": "$advanced_button_icon",
          "layer": 6,
          "anchor_from": "center",
          "anchor_to": "center",
          "size": [ 18, 18 ]
        }
      }
    ]
  }
}