{
  "namespace": "beacon_screen",
  "beacon_panel@container_common.container_details": {
    "size": [230, 219],
    "$screen_controls": [
      { "common_panel@screen_content.beacon": {} },
      { "extensions@jc-extensions.beacon_screen": {} },
      {
        "primary_toggles_holder@global.empty_panel": {
          "anchor_from": "top_left",
          "anchor_to": "top_left",
          "size": [99, 94],
          "controls": [
            {
              "primary_stacks@global.empty_stack": {
                "orientation": "vertical",
                "anchor_from": "bottom_right",
                "anchor_to": "bottom_right",
                "size": [46, 72],
                "controls": [
                  {
                    "speed_and_haste@global.empty_stack": {
                      "orientation": "horizontal",
                      "size": [46, 22],
                      "controls": [
                        { "primary_speed_effect@beacon_screen.primary_toggle": { "$button_name": "speed" } },//22x22
                        { "filler_1@global.empty_panel": { "size": [2, 22] } },
                        { "primary_haste_effect@beacon_screen.primary_toggle": { "$button_name": "haste" } }//22x22
                      ]
                    }
                  },
                  { "filler_2@global.empty_panel": { "size": [46, 3] } },
                  {
                    "resist_and_jump@global.empty_stack": {
                      "orientation": "horizontal",
                      "size": [46, 22],
                      "controls": [
                        { "primary_resist_effect@beacon_screen.primary_toggle": { "$button_name": "resist" } },//22x22
                        { "filler_3@global.empty_panel": { "size": [2, 22] } },
                        { "primary_jump_effect@beacon_screen.primary_toggle": { "$button_name": "jump" } }//22x22
                      ]
                    }
                  },
                  { "filler_4@global.empty_panel": { "size": [46, 3] } },
                  {
                    "strength@global.empty_stack": {
                      "orientation": "horizontal",
                      "size": [46, 22],
                      "controls": [
                        { "filler_5@global.empty_panel": { "size": [12, 22] } },
                        { "primary_strength_effect@beacon_screen.primary_toggle": { "$button_name": "strength" } },//22x22
                        { "filler_6@global.empty_panel": { "size": [12, 22] } }
                      ]
                    }
                  }
                ]
              }
            }
          ]
        }
      },
      {
        "secondary_toggles_holder@global.empty_panel": {
          "size": [86, 69],
          "anchor_to": "top_right",
          "anchor_from": "top_right",
          "controls": [
            {
              "regen_and_extra@global.empty_stack": {
                "orientation": "horizontal",
                "size": [46, 22],
                "anchor_from": "bottom_left",
                "anchor_to": "bottom_left",
                "controls": [
                  { "regen@beacon_screen.secondary_left_toggle": {} },//22x22
                  { "filler_7@global.empty_panel": { "size": [2, 22] } },
                  { "extra@beacon_screen.secondary_right_toggle": {} }//22x22
                ]
              }
            }
          ]
        }
      },
      {
        "ores_holder@global.empty_panel": {
          "size": [124, 125],
          "anchor_from": "top_left",
          "anchor_to": "top_left",
          "layer": 3,
          "controls": [
            {
              "ores@global.empty_stack": {
                "orientation": "horizontal",
                "size": [104, 16],
                "anchor_from": "bottom_right",
                "anchor_to": "bottom_right",
                "controls": [
                  {"netherite@beacon_screen.beacon_ore_texture_template" : {"$ore_path": "textures/items/netherite_ingot" }},//16x16
                  {"filler_8@global.empty_panel": {"size": [5, 16]}},
                  {"emerald@beacon_screen.beacon_ore_texture_template"   : {"$ore_path": "textures/items/emerald"         }},//16x16
                  {"filler_9@global.empty_panel": {"size": [6, 16]}},
                  {"diamond@beacon_screen.beacon_ore_texture_template"   : {"$ore_path": "textures/items/diamond"         }},//16x16
                  {"filler_10@global.empty_panel": {"size": [7, 16]}},
                  {"gold@beacon_screen.beacon_ore_texture_template"      : {"$ore_path": "textures/items/gold_ingot"      }},//16x16
                  {"filler_11@global.empty_panel": {"size": [6, 16]}},
                  {"iron@beacon_screen.beacon_ore_texture_template"      : {"$ore_path": "textures/items/iron_ingot"      }}//16x16
                ]
              }
            }
          ]
        }
      },
      {
        "input_and_actions_holder@global.empty_panel": {
          "anchor_from": "top_right",
          "anchor_to": "top_right",
          "size": [95, 129],
          "controls": [
            {
              "input_and_actions@global.empty_stack": {
                "orientation": "horizontal",
                "size": [77, 22],
                "anchor_from": "bottom_left",
                "anchor_to": "bottom_left",
                "controls": [
                  {
                    "payment_input@global.empty_stack": {
                      "orientation": "vertical",
                      "size": [18, 22],
                      "controls": [
                        {"filler_12@global.empty_panel": {"size": [18, 2]}},
                        {"payment_slot@jc_container_item.container_item": { "$item_collection": "beacon_payment_items" }},//18x18
                        {"filler_13@global.empty_panel": {"size": [18, 2]}}
                      ]
                    }
                  },
                  {"filler_14@global.empty_panel": {"size": [11, 22]}},
                  {"confirm_action@beacon_screen.primary_toggle": {"$button_name": "confirm" }},//22x22
                  {"filler_15@global.empty_panel": {"size": [4, 22]}},
                  {"cancel_action@beacon_screen.primary_toggle": {"$button_name": "cancel" }}//22x22
                ]
              }
            }
          ]
        }
      },
      {
        "inventory_section@global.empty_stack": {
          "orientation": "horizontal",
          "size": [230, 83],
          "anchor_to": "bottom_middle",
          "anchor_from": "bottom_middle",
          "controls": [
            {"filler_16@global.empty_panel": {"size": [35, 83]} },
            {
              "inventory_grid_holder@global.empty_panel": {
                "size": [162, 83],
                "controls": [{"inventory_and_hotbar@container_common.container_bottom_section": {}}]
              }
            },
            {"filler_17@global.empty_panel": {"size": [33, 83]} }
          ]
        }
      },
      {
        "labels_holder@global.empty_stack": {
          "orientation": "vertical",
          "size": [230, 22],
          "anchor_from": "top_middle",
          "anchor_to": "top_middle",
          "controls": [
            {"filler_18@global.empty_panel": {"size": [230, 7]}},
            {
              "labels@global.empty_stack": {
                "orientation": "horizontal",
                "size": [230, 15],
                "controls": [
                  {"filler_19@global.empty_panel": {"size": [10, 15]}},
                  {
                    "primary_label_holder@global.empty_panel": {
                      "size": [105, 15],
                      "controls": [{"primary@beacon_screen.beacon_labels": {"text": "tile.beacon.primary"}}]
                    }
                  },
                  {"filler_20@global.empty_panel": {"size": [2, 15]}},
                  {
                    "secondary_label_holder@global.empty_panel": {
                      "size": [103, 15],
                      "controls": [{"secondary@beacon_screen.beacon_labels": {"text": "tile.beacon.secondary"}}]
                    }
                  },
                  {"filler_21@global.empty_panel": {"size": [10, 15]}}
                ]
              }
            }
          ]
        }
      }
    ]
  },
  "beacon_ore_texture_template@screen_content.image_element": {"size": [16, 16],"texture": "$ore_path"},

  "beacon_labels@global.empty_label": {
    "size": ["default", "default"],
    "layer": 4,
    "anchor_from": "center",
    "anchor_to": "center",
    "color": [0.867, 0.867, 0.867],
    "localize": true,
    "shadow": true
  },
  //toggles and toggle assets
   "secondary_left_toggle@global.empty_panel": {
    "size": [22, 22],
    "controls": [{"secondary_regen@beacon_screen.primary_toggle": {"$button_name": "regen"}}]
  },
  "secondary_right_toggle@global.empty_panel": {
    "size": [22, 22],
    "controls": [
      { "secondary_speed@beacon_screen.secondary_toggle_bridge"    : { "$effect_name": "speed"    } },
      { "secondary_haste@beacon_screen.secondary_toggle_bridge"    : { "$effect_name": "haste"    } },
      { "secondary_resist@beacon_screen.secondary_toggle_bridge"   : { "$effect_name": "resist"   } },
      { "secondary_jump@beacon_screen.secondary_toggle_bridge"     : { "$effect_name": "jump"     } },
      { "secondary_strength@beacon_screen.secondary_toggle_bridge" : { "$effect_name": "strength" } }
    ]
  },
  "secondary_toggle_bridge@beacon_screen.primary_toggle": {
    "$button_name": "extra",
    "$icon_path": "('assets/beacon_button_sprites/' + $effect_name)",
    "bindings": [
      {
        "binding_name": "#extra_image_selection",
        "binding_name_override": "#visible",
        "binding_collection_name": "$effect_name",
        "binding_type": "collection"
      }
    ]
  },
  
  "primary_toggle@global.empty_panel": {
    "size": [22, 22],
    "$button_name|default": "none",
    "$icon_path|default": "('assets/beacon_button_sprites/' + $button_name)",
    "controls": [
      {
        "toggle_static_hover": {
          "type": "button",
          "layer": 7,
          "size": [22, 22],
          "default_focus_precedence": 1,
          "hover_control": "hover_text",
          "consume_event": false,
          "button_mappings": [
            {
              "to_button_id": "button.container_slot_hovered",
              "mapping_type": "pressed",
              "consume_event": false
            }
          ],
          "controls": [
            {
              "hover_text@global.hover_text": {
                "bindings": [
                  {
                    "binding_name": "#button_hover",
                    "binding_name_override": "#hover_text",
                    "binding_collection_name": "$button_name",
                    "binding_type": "collection"
                  }
                ]
              }
            }
          ]
        }
      },
      {
        "toggle_control@toggle.radio_toggle": {
          "size": [22, 22],
          "$is_radio_toggle": false,
          "$toggle_control_name": "('beacon_screen_' + $button_name)",
          "$toggle_name": "$button_name",
          "$button_mappings": [
            {
              "from_button_id": "button.menu_select",
              "to_button_id": "button.menu_ok",
              "mapping_type": "pressed"
            },
            {
              "from_button_id": "button.menu_ok",
              "to_button_id": "button.menu_ok",
              "mapping_type": "pressed"
            }
          ],
          "$bindings": [
            {
              "binding_collection_name": "$button_name",
              "binding_type": "collection_details"
            },
            {
              "binding_name": "#button_visible",
              "binding_name_override": "#visible",
              "binding_collection_name": "$button_name",
              "binding_type": "collection"
            },
            {
              "binding_type": "collection",
              "binding_collection_name": "$button_name",
              "binding_name": "#active",
              "binding_name_override": "#enabled"
            },
            {
              "binding_type": "collection",
              "binding_name": "#selected",
              "binding_collection_name": "$button_name",
              "binding_name_override": "#toggle_state"
            }
          ],
          "$unchecked": "beacon_screen.toggle_unchecked_visual",
          "$unchecked_hover": "beacon_screen.toggle_hover_visual",
          "$checked": "beacon_screen.toggle_checked_visual",
          "$checked_hover": "beacon_screen.toggle_checked_visual",
          "$locked": "beacon_screen.toggle_locked_visual",
          "$extra_contents": "beacon_screen.toggle_icon",    
          "variables": {
            "requires": "($cb_is_thick_menu_buttons = true)",
          
            "$unchecked": "Thickly_Be-Beveled_Buttons.toggle_unchecked_visual",
            "$unchecked_hover": "Thickly_Be-Beveled_Buttons.toggle_hover_visual",
            "$checked": "Thickly_Be-Beveled_Buttons.toggle_checked_visual",
            "$checked_hover": "Thickly_Be-Beveled_Buttons.toggle_checked_visual",
            "$locked": "Thickly_Be-Beveled_Buttons.toggle_locked_visual"
          }
        }
      }
    ]
  },
  "beacon_toggle_texture_template@screen_content.image_element": {
    "size": [22, 22],
    "layer": 4,
    "nineslice_size": 2
  },
  "toggle_unchecked_visual@beacon_screen.beacon_toggle_texture_template" : {"texture": "assets/beacon_button_sprites/default"  },
  "toggle_hover_visual@beacon_screen.beacon_toggle_texture_template"     : {"texture": "assets/beacon_button_sprites/hover"    },
  "toggle_checked_visual@beacon_screen.beacon_toggle_texture_template"   : {"texture": "assets/beacon_button_sprites/selected" },
  "toggle_locked_visual@beacon_screen.beacon_toggle_texture_template": {"texture": "assets/beacon_button_sprites/locked"},
  "toggle_icon@screen_content.image_element": {
    "size": [18, 18],
    "layer": 5,
    "anchor_from": "center",
    "anchor_to": "center",
    "texture": "$icon_path"
  }
}