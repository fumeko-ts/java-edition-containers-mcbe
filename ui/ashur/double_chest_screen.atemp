{
  "namespace": "double_chest_screen",
  "chest_grid_item@common.container_item": {"$item_collection_name": "container_items"},
  "double_chest@container_common.container_details": {
    "type": "panel",
    "size": [ 176, 220 ],
    "layer": 5,
    "$screen_controls": [
      {
        "double_chest_label": {
          "type": "label",
          "offset": [ -49.2, 4.6 ],
          "anchor_from": "top_middle",
          "anchor_to": "top_middle",
          "text": "$container_title",
          "$container_title": "Large Chest",
          "color": "$title_text_color",
          "layer": 12
        }
      },
      {"common_panel@screen_content.container_base": {"$double_chest_container": true}},
      {
        "double_chest_screen_panel_top_half": {
          "type": "panel",
          "size": [ "100%", 132 ],
          "offset": [ 0, 7 ],
          "anchor_to": "top_left",
          "anchor_from": "top_left",
          "controls": [
            {
              "double_chest_screen_grid": {
                "type": "grid",
                "size": [ 162, 108 ],
                "offset": [ 7, 10 ],
                "anchor_from": "top_left",
                "anchor_to": "top_left",
                "grid_dimensions": [ 9, 6 ],
                "grid_item_template": "double_chest_screen.chest_grid_item",
                "collection_name": "container_items"
              }
            }
          ]
        }
      },
      {
        "inventory_panel_bottom_half_with_label@common.inventory_panel_bottom_half_with_label": {"offset": [ 0, -1 ]}
      },
      {"hotbar_grid@common.hotbar_grid_template": {}}
    ]
  }
}