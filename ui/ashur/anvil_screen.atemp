{
  "namespace": "anvil_screen",
  "anvil_panel@container_common.container_details": {
    "size": [176, 166],
    "$screen_controls": [
      { "common_panel@screen_content.anvil": {} },
      {
        "anvil_top_half@global.empty_stack": {
          "orientation": "vertical",
          "size": [176, 66],
          "anchor_to": "top_middle",
          "anchor_from": "top_middle",
          "controls": [
            { "filler_1@global.empty_panel": { "size": ["fill", 6] } },
            {
              "anvil_label_dynamic?@global.empty_stack": {
                "orientation": "horizontal",
                "size": [176, 14],
                "controls": [
                  { "filler_1@global.empty_panel": { "size": [60, "fill"] } },
                  {
                    "anvil_label_holder@global.empty_panel": {
                      "size": [116, 14],
                      "controls": [
                        {
                          "barrel_label@global.empty_label": {
                            "anchor_to": "top_left",
                            "anchor_from": "top_left",
                            "size": ["default", 10],
                            "offset": [0, -1],
                            "layer": 5,
                            "text": "atemp.container.repair",
                            "color": "$title_text_color"
                          }
                        }
                      ]
                    }
                  }
                ]
              }
            },
            {
              "anvil_text_edit@global.empty_stack": {
                "orientation": "horizontal",
                "size": [176, 16],
                "controls": [
                  { "filler_1@global.empty_panel": { "size": [59, "fill"] } },
                  {
                    "text_edit_panel@global.empty_panel": {
                      "size": [110, 16],
                      "controls": [
                        {
                          "anvil_text_control@text_edit_box.text_edit_box": {
                            "property_bag": { "#property_field": "#item_name" },
                            "max_length": 60,
                            "$text_edit_text_control": "anvil_text_input",
                            "$text_box_text_color": [0.231, 0.231, 0.231, 1],
                            "$text_background_locked": "screen_content.anvil_text_field",
                            "$text_background_default": "screen_content.anvil_edit_box_hover",
                            "$text_background_hover": "screen_content.anvil_edit_box_hover",
                            "$text_edit_binding_name": "#text_box_item_name",
                            "$text_edit_box_label_size": ["default", 10]
                          }
                        }
                      ]
                    }
                  },
                  { "filler_2@global.empty_panel": { "size": [7, "fill"] } }
                ]
              }
            },
            { "filler_2@global.empty_panel": { "size": ["fill", 9] } },
            {
              "anvil_cells@global.empty_stack": {
                "orientation": "horizontal",
                "size": [176, 21],
                "controls": [
                  { "filler_1@global.empty_panel": { "size": [26, "fill"] } },
                  {
                    "stack_1@global.empty_stack": {
                      "orientation": "vertical",
                      "size": [18, 21],
                      "controls": [
                        { "filler_1@global.empty_panel": { "size": ["fill", 1] } },
                        { "input_item_slot@global.container_item": { "$item_collection": "anvil_input_items" } },
                        { "filler_2@global.empty_panel": { "size": ["fill", 2] } }
                      ]
                    }
                  },
                  { "filler_2@global.empty_panel": { "size": [31, "fill"] } },
                  {
                    "stack_2@global.empty_stack": {
                      "orientation": "vertical",
                      "size": [18, 21],
                      "controls": [
                        { "filler_1@global.empty_panel": { "size": ["fill", 1] } },
                        { "material_item_slot@global.container_item": { "$item_collection": "anvil_material_items" } },
                        { "filler_2@global.empty_panel": { "size": ["fill", 2] } }
                      ]
                    }
                  },
                  { "filler_3@global.empty_panel": { "size": [6, "fill"] } },
                  {
                    "anvil_ex_holder@global.empty_panel": {
                      "size": [28, 21],
                      "controls": [
                        {
                          "cross_out_icon@screen_content.image_element": {
                            "texture": "assets/sprites/container/anvil/error",
                            "size": [28, 21],
                            "bindings": [{ "binding_name": "#cross_out_icon", "binding_name_override": "#visible" }]
                          }
                        }
                      ]
                    }
                  },
                  { "filler_4@global.empty_panel": { "size": [6, "fill"] } },
                  {
                    "stack_3@global.empty_stack": {
                      "orientation": "vertical",
                      "size": [18, 21],
                      "controls": [
                        { "filler_1@global.empty_panel": { "size": ["fill", 1] } },
                        {
                          "result_item_slot@global.container_item": {
                            "$item_collection": "anvil_result_items",
                            "$button_ref": "button_mappings.anvil_output_slot_button"
                          }
                        },
                        { "filler_2@global.empty_panel": { "size": ["fill", 2] } }
                      ]
                    }
                  },
                  { "filler_5@global.empty_panel": { "size": [25, "fill"] } }
                ]
              }
            }
          ]
        }
      },
      {
        "cost@global.empty_panel": {
          "size": [167, 79],
          "anchor_to": "top_left",
          "anchor_from": "top_left",
          "controls": [
            {
              "cost_labels@global.empty_panel": {
                "size": ["100%c", "100%c"],
                "anchor_to": "bottom_right",
                "anchor_from": "bottom_right",
                "controls": [
                  {
                    "anvil_info@screen_content.image_element": {
                      "texture": "textures/ui/Gray",
                      "layer": 4,
                      "size": ["100%c + 6px", "100%c + 4px"],
                      "alpha": 0.3,
                      "controls": [
                        {
                          "cost_label_0@anvil_screen.cost_label": {
                            "color": "$anvil_cost_fail_text_color",
                            "$cost_bindings": "#cost_text_red"
                          }
                        },
                        {
                          "cost_label_1@anvil_screen.cost_label": {
                            "color": [0.494, 0.988, 0.125, 1.0],
                            "$cost_bindings": "#cost_text_green"
                          }
                        }
                      ],
                      "bindings": [
                        { "binding_name": "#cost_text_red" },
                        { "binding_name": "#cost_text_green" },
                        {
                          "binding_type": "view",
                          "binding_condition": "always",
                          "source_property_name": "(#cost_text_red or #cost_text_green)",
                          "target_property_name": "#visible"
                        }
                      ]
                    }
                  }
                ]
              }
            }
          ]
        }
      },
      {
        "bottom@global.inventory_bottom_half_with_label": {
          "anchor_to": "bottom_middle",
          "anchor_from": "bottom_middle"
        }
      },
      {
        "anvil_highlight@screen_content.image_element": {
          "texture": "textures/anvil_highlight.png",
          "alpha": "@anvil_screen.anvil_highlight_alpha_1",
          "size": [68, 33],
          "anchor_from": "top_left",
          "anchor_to": "top_left",
          "layer": 18,
          "bindings": [
            {
              "binding_type": "collection",
              "binding_collection_name": "anvil_input_items",
              "binding_name": "#item_id_aux",
              "binding_name_override": "#anvil_input_items"
            },
            {
              "binding_type": "view",
              "binding_condition": "always",
              "source_control_name": "anvil_text_input",
              "source_property_name": "(#item_name = '')",
              "target_property_name": "#no_text"
            },
            {
              "binding_type": "view",
              "binding_condition": "always",
              "source_property_name": "(#no_text and (#anvil_input_items = -1))",
              "target_property_name": "#visible"
            }
          ]
        }
      }
    ]
  },
  "cost_label@global.empty_label": {
    "shadow": true,
    "layer": 10,
    "text": "#text",
    "bindings": [
      { "binding_name": "#cost_text", "binding_name_override": "#text" },
      { "binding_name": "$cost_bindings", "binding_name_override": "#visible" }
    ]
  },
  "blitsprite_alpha_template": {
    "anim_type": "alpha",
    "duration": "$frame_time",
    "from": "$frame",
    "to": "$frame",
    "next": "('@anvil_screen.' + $next)"
  },
  "anvil_highlight_alpha_1@anvil_screen.blitsprite_alpha_template": {"$frame_time": 0.5,"$frame": 0,"$next": "anvil_highlight_alpha_2"},
  "anvil_highlight_alpha_2@anvil_screen.blitsprite_alpha_template": {"$frame_time": 0.5,"$frame": 1,"$next": "anvil_highlight_alpha_1"}
}
