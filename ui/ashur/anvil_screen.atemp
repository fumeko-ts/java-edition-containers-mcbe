{
  "namespace": "anvil_screen",
  "anvil_panel@container_common.container_details": {
    "size": [176, 166],
    "$screen_controls": [
      { "common_panel@screen_content.anvil": {} },
      { "extensions@jc-extensions.anvil_screen": {} },
      {
        "anvil_top_half@global.empty_stack": {
          "orientation": "vertical",
          "size": [176, 66],
          "anchor_to": "top_middle",
          "anchor_from": "top_middle",
          "controls": [
            { "filler_1@global.empty_panel": { "size": ["fill", 6] } },
            {
              "anvil_label_dynamic?@global.empty_stack": {
                "orientation": "horizontal",
                "size": [176, 14],
                "controls": [
                  { "filler_1@global.empty_panel": { "size": [60, "fill"] } },
                  {
                    "anvil_label_holder@global.empty_panel": {
                      "size": [116, 14],
                      "controls": [
                        {
                          "anvil_label@global.empty_label": {
                            "anchor_to": "top_left",
                            "anchor_from": "top_left",
                            "size": ["default", 10],
                            "offset": [0, -1],
                            "layer": 5,
                            "text": "atemp.container.repair",
                            "color": "$container_title_color"
                          }
                        }
                      ]
                    }
                  }
                ]
              }
            },
            {
              "anvil_text_edit@global.empty_stack": {
                "orientation": "horizontal",
                "size": [176, 16],
                "controls": [
                  { "filler_1@global.empty_panel": { "size": [59, "fill"] } },
                  {
                    "anvil_text_control@text_edit_area.text_edit_box": {
                      "size": [110, 16],
                      "$edit_label_offset": [1, 0],
                      "$default_control": "global.empty_panel",
                      "$locked_control": "global.empty_panel",
                      "$hover_control": "global.empty_panel",
                      "$pressed_control": "global.empty_panel",
                      "$extra_contents": "anvil_screen.edit_area_background",
                      "$text_edit_text_control": "anvil_text_input",
                      "bindings": [
                        {
                          "binding_type": "collection",
                          "binding_collection_name": "anvil_input_items",
                          "binding_name": "#item_id_aux",
                          "binding_name_override": "#anvil_input_items"
                        },
                        {
                          "binding_type": "view",
                          "binding_condition": "always",
                          "source_property_name": "(not (#anvil_input_items = -1))",
                          "target_property_name": "#enabled"
                        }
                      ]
                    }
                  },
                  { "filler_2@global.empty_panel": { "size": [7, "fill"] } }
                ]
              }
            },
            { "filler_2@global.empty_panel": { "size": ["fill", 9] } },
            {
              "anvil_cells@global.empty_stack": {
                "orientation": "horizontal",
                "size": [176, 21],
                "controls": [
                  { "filler_1@global.empty_panel": { "size": [26, "fill"] } },
                  {
                    "stack_1@global.empty_stack": {
                      "orientation": "vertical",
                      "size": [18, 21],
                      "controls": [
                        { "filler_1@global.empty_panel": { "size": ["fill", 1] } },
                        {
                          "input_item_slot@jc_container_item.container_item": {
                            "$item_collection": "anvil_input_items"
                          }
                        },
                        { "filler_2@global.empty_panel": { "size": ["fill", 2] } }
                      ]
                    }
                  },
                  { "filler_2@global.empty_panel": { "size": [31, "fill"] } },
                  {
                    "stack_2@global.empty_stack": {
                      "orientation": "vertical",
                      "size": [18, 21],
                      "controls": [
                        { "filler_1@global.empty_panel": { "size": ["fill", 1] } },
                        {
                          "material_item_slot@jc_container_item.container_item": {
                            "$item_collection": "anvil_material_items"
                          }
                        },
                        { "filler_2@global.empty_panel": { "size": ["fill", 2] } }
                      ]
                    }
                  },
                  { "filler_3@global.empty_panel": { "size": [6, "fill"] } },
                  {
                    "error_holder@global.empty_panel": {
                      "size": [28, 21],
                      "controls": [
                        {
                          "cross_out_icon@screen_content.image_element": {
                            "texture": "assets/sprites/container/anvil/error",
                            "size": [28, 21],
                            "bindings": [{ "binding_name": "#cross_out_icon", "binding_name_override": "#visible" }]
                          }
                        }
                      ]
                    }
                  },
                  { "filler_4@global.empty_panel": { "size": [6, "fill"] } },
                  {
                    "stack_3@global.empty_stack": {
                      "orientation": "vertical",
                      "size": [18, 21],
                      "controls": [
                        { "filler_1@global.empty_panel": { "size": ["fill", 1] } },
                        {
                          "result_item_slot@jc_container_item.container_item": {
                            "$item_collection": "anvil_result_items",
                            "$button_control": "button_mappings.anvil_output_button"
                          }
                        },
                        { "filler_2@global.empty_panel": { "size": ["fill", 2] } }
                      ]
                    }
                  },
                  { "filler_5@global.empty_panel": { "size": [25, "fill"] } }
                ]
              }
            }
          ]
        }
      },
      {
        "status_holder@global.empty_panel": {
          "size": [167, 79],
          "anchor_to": "top_left",
          "anchor_from": "top_left",
          "controls": [
            {
              "status@global.empty_panel": {
                "size": ["100%c", "100%c"],
                "anchor_to": "bottom_right",
                "anchor_from": "bottom_right",
                "controls": [
                  {
                    "anvil_status_label@screen_content.image_element": {
                      "texture": "textures/ui/Gray",
                      "layer": 4,
                      "size": ["100%c + 6px", "100%c + 4px"],
                      "alpha": 0.3,
                      "controls": [
                        {
                          "cost_text_red@anvil_screen.cost_label": {
                            "color": [1.0, 0.35, 0.35],
                            "$cost_bindings": "#cost_text_red"
                          }
                        },
                        {
                          "cost_text_green@anvil_screen.cost_label": {
                            "color": [0.494, 0.988, 0.125, 1.0],
                            "$cost_bindings": "#cost_text_green"
                          }
                        }
                      ],
                      "bindings": [
                        { "binding_name": "#cost_text_red" },
                        { "binding_name": "#cost_text_green" },
                        {
                          "binding_type": "view",
                          "binding_condition": "always",
                          "source_property_name": "(#cost_text_red or #cost_text_green)",
                          "target_property_name": "#visible"
                        }
                      ]
                    }
                  }
                ]
              }
            }
          ]
        }
      },
      {
        "anvil_highlight@global.empty_image": {
          "texture": "textures/anvil_highlight.png",
          "alpha": "@anvil_screen.anvil_highlight_alpha_1",
          "size": [68, 33],
          "anchor_from": "top_left",
          "anchor_to": "top_left",
          "layer": 18,
          "bindings": [
            {
              "binding_type": "view",
              "binding_condition": "always",
              "source_control_name": "anvil_text_input",
              "source_property_name": "(#item_name = '')",
              "target_property_name": "#no_text"
            },
            {
              "binding_type": "collection",
              "binding_collection_name": "anvil_input_items",
              "binding_name": "#item_id_aux",
              "binding_name_override": "#anvil_input_items"
            },
            {
              "binding_type": "view",
              "binding_condition": "always",
              "source_property_name": "(#no_text and (#anvil_input_items = -1))",
              "target_property_name": "#visible"
            }
          ]
        }
      },
      {
        "bottom@global.inventory_bottom_half_with_label": {
          "anchor_to": "bottom_middle",
          "anchor_from": "bottom_middle"
        }
      }
    ]
  },
  "edit_area_background@global.empty_panel": {
    "size": [110, 16],
    "controls": [
      {
        "anvil_text_field@screen_content.anvil_text_field": {
          "bindings": [
            {
              "binding_type": "view",
              "binding_condition": "always",
              "source_control_name": "anvil_highlight",
              "source_property_name": "(#anvil_input_items = -1)",
              "target_property_name": "#visible"
            }
          ]
        }
      },
      {
        "anvil_edit_box_focused@screen_content.anvil_edit_box_focused": {
          "bindings": [
            {
              "binding_type": "view",
              "binding_condition": "always",
              "source_control_name": "anvil_highlight",
              "source_property_name": "(not (#anvil_input_items = -1))",
              "target_property_name": "#visible"
            }
          ]
        }
      }
    ]
  },
  "cost_label@global.empty_label": {
    "shadow": true,
    "layer": 10,
    "text": "#text",
    "bindings": [
      { "binding_name": "#cost_text", "binding_name_override": "#text" },
      { "binding_name": "$cost_bindings", "binding_name_override": "#visible" }
    ]
  },
  "blitsprite_alpha_template": {
    "anim_type": "alpha",
    "duration": 0.4,
    "from": "$frame",
    "to": "$frame",
    "next": "('@anvil_screen.' + $next)"
  },
  "anvil_highlight_alpha_1@anvil_screen.blitsprite_alpha_template": { "$frame": 0, "$next": "anvil_highlight_alpha_2" },
  "anvil_highlight_alpha_2@anvil_screen.blitsprite_alpha_template": { "$frame": 1, "$next": "anvil_highlight_alpha_1" }
}
