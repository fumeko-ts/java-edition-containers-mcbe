{
  "namespace": "hopper_screen",
  "hopper_panel@container_common.container_details": {
    "type": "panel",
    "layer": 5,
    "size": [ 176, 133 ],
    "$screen_controls": [
      {"common_panel@screen_content.container_base": {"$hopper_screen": true}},
      {
        "item_hopper_label": {
          "type": "label",
          "offset": [ 8, 5 ],
          "anchor_from": "top_left",
          "anchor_to": "top_left",
          "text": "$container_title",
          "$container_title": "Item Hopper",
          "color": "$title_text_color",
          "layer": 2
        }
      },
      {
        "red_panel": {
          "type": "panel",
          "size": [ "100%", "50% - 12px" ],
          "offset": [ 0, 0.6 ],
          "anchor_to": "top_left",
          "anchor_from": "top_left",
          "controls": [
            {
              "redstone_input_grid": {
                "type": "grid",
                "anchor_from": "center",
                "anchor_to": "center",
                "offset": [ 0, 0 ],
                "grid_dimensions": [ 5, 1 ],
                "collection_name": "container_items",
                "grid_item_template": "common.container_item",
                "$item_collection_name": "container_items"
              }
            }
          ]
        }
      },
      {"red_bottom_half@common.inventory_panel_bottom_half_with_label": {"offset": [ 0, -3 ]}},
      {"hotbar_grid@common.hotbar_grid_template": {"offset": [ 0, -7 ]}}
    ]
  }
}