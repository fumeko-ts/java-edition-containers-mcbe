{
  "namespace": "crafting_common",
  "text_edit_control@text_edit_box.text_field": {
    "size": [81, 14],
    "$text_panel_size": [81, 14],
    "$text_background_default": "screen_content.text_field",
    "$text_background_hover": "screen_content.text_field_highlighted",
    "$text_edit_box_label_offset": [3, 0],
    "property_bag": {"#property_field": "#item_name"},
    "$shadow": true,
    "$text_clear_button_enabled" : true,
    "focus_wrap_enabled": false,
    "max_length": 30,
    "$text_edit_binding_name": "#text_box_item_name",
    "$text_edit_box_label_size": ["default", 8],
    "$place_holder_text": "\u00a7o\u00a78\u00a77Search..."
  },
  "filter_disabled@global.empty_image"            : {"texture": "assets/minecraft/textures/gui/sprites/recipe_book/filter_disabled.png"},
  "filter_disabled_highlighted@global.empty_image": {"texture": "assets/minecraft/textures/gui/sprites/recipe_book/filter_disabled_highlighted.png","controls": [{"hover@global.hover_text": { "layer":20000,"property_bag":{"#hover_text": "Showing All"} }}]},
  "filter_enabled@global.empty_image"             : {"texture": "assets/minecraft/textures/gui/sprites/recipe_book/filter_enabled.png"},
  "filter_enabled_highlighted@global.empty_image" : {"texture": "assets/minecraft/textures/gui/sprites/recipe_book/filter_enabled_highlighted.png" ,"controls": [{"hover@global.hover_text": { "layer":20000, "property_bag":{"#hover_text": "Showing Craftable"} }}]},
  "filter_toggle@common_toggles.switch_toggle"    : {
    "size": [ 26, 18 ],
    "$unchecked_control": "crafting_common.filter_disabled",
    "$unchecked_hover_control": "crafting_common.filter_disabled_highlighted",
    "$checked_control": "crafting_common.filter_enabled",
    "$checked_hover_control": "crafting_common.filter_enabled_highlighted",
    "$toggle_name": "toggle.enableFiltering",
    "$toggle_binding_type": "global",
    "$toggle_state_binding_name": "#filtering_enabled",
    "$button_mappings": [
      {
        "to_button_id": "button.filter_toggle_hovered",
        "mapping_type": "pressed"
      },
      {
        "to_button_id": "button.menu_select",
        "mapping_type": "pressed",
        "from_button_id": "button.menu_select"
      },
      {
        "to_button_id": "button.menu_ok",
        "mapping_type": "focused",
        "from_button_id": "button.menu_ok"
      },
      {
        "to_button_id": "button.controller_back",
        "mapping_type": "focused",
        "from_button_id": "button.controller_back",
        "ignored": "(not $is_ps4)"
      },
      {
        "to_button_id": "$toggle_off_button",
        "mapping_type": "pressed",
        "from_button_id": "button.menu_left",
        "ignored": "(not $enable_directional_toggling)",
        "input_mode_condition": "gamepad_and_not_gaze"
      },
      {
        "to_button_id": "$toggle_on_button",
        "mapping_type": "pressed",
        "from_button_id": "button.menu_right",
        "ignored": "(not $enable_directional_toggling)",
        "input_mode_condition": "gamepad_and_not_gaze"
      }
    ]
  }
}
