{
  "namespace": "crafting_tab_stack",
  "tab_stack@global.empty_stack_panel": {
    "orientation": "vertical",
    "layer": 2,
    "size": [35, 135],
    "offset": [ -29, 3 ],
    "anchor_to": "top_left",
    "anchor_from": "top_left",
    "controls": [
      {"search@crafting_tab_stack.search_tab": {}},
      {"equipment@crafting_tab_stack.equipment_tab": {}},
      {"nature@crafting_tab_stack.nature_tab": {}},
      {"items@crafting_tab_stack.items_tab": {}},
      {"construction@crafting_tab_stack.construction_tab": {}}
    ]
  },
  "icon_control@screen_content.image_element": {
    "texture": "$icon_for_tab",
    "$icon_for_tab": "",
    "size": "$tab_icon_size",
    "$tab_icon_size": [17, 17],
    "variables": [
      {
        "requires": "($tab_view_binding_name = search_tab_toggle)",
        "$tab_icon_size": [25, 16],
        "$icon_for_tab": "textures/atemp/ui/item/compass_28.png"
      },
      {
        "requires": "($tab_view_binding_name = equipment_tab_toggle)",
        "$tab_icon_size": [28, 19],
        "$icon_for_tab": "textures/atemp/ui/item/porkchop.png"
      },
      {
        "requires": "($tab_view_binding_name = nature_tab_toggle)",
        "$tab_icon_size": [25, 16],
        "$icon_for_tab": "textures/atemp/ui/block/stone.png"
      },
      {
        "requires": "($tab_view_binding_name = items_tab_toggle)",
        "$tab_icon_size": [22, 14],
        "$icon_for_tab": "textures/atemp/ui/fuel.png"
      },
      {
        "requires": "($tab_view_binding_name = construction_tab_toggle)",
        "$tab_icon_size": [22, 14],
        "$icon_for_tab": "textures/atemp/ui/fuel.png"
      }
    ]
  },
  "icon_holder": {
    "type": "panel",
    "size": [24, 25],
    "controls": [ {"img@$tab_icon": {}} ]
  },
  "top_tab@recipe_tabs.tab_left": {
    "type": "panel",
    "size": [35, 27],
    "$toggle_binding_type": "global",
    "$toggle_focus_enabled": false,
    "$toggle_name": "navigation_tab",
    "$tab_icon": "crafting_tab_stack.icon_control",
    "$toggle_state_binding_name": "#toggle_state",
    "$tab_content": "crafting_tab_stack.icon_holder"
  },
  "search_tab@crafting_tab_stack.top_tab": {
    "$tab_view_binding_name"    : "search_tab_toggle",
    "$toggle_group_forced_index": "$search_index",
    "$toggle_state_binding_name": "#is_left_tab_search"
  },
  "equipment_tab@crafting_tab_stack.top_tab": {
    "$tab_view_binding_name"    : "equipment_tab_toggle",
    "$toggle_group_forced_index": "$equipment_index",
    "$toggle_state_binding_name": "#is_left_tab_equipment"
  },
  "nature_tab@crafting_tab_stack.top_tab": {
    "$tab_view_binding_name"    : "nature_tab_toggle",
    "$toggle_group_forced_index": "$nature_index",
    "$toggle_state_binding_name": "#is_left_tab_nature"
  },
  "items_tab@crafting_tab_stack.top_tab": {
    "$tab_view_binding_name"    : "items_tab_toggle",
    "$toggle_group_forced_index": "$items_index",
    "$toggle_state_binding_name": "#is_left_tab_items"
  },
  "construction_tab@crafting_tab_stack.top_tab": {
    "$tab_view_binding_name"    : "construction_tab_toggle",
    "$toggle_group_forced_index": "$construction_index",
    "$toggle_state_binding_name": "#is_left_tab_construct"
  }
}
