{
  "namespace": "inventory_screen",
  "screen_base@global.root_panel": {
    "controls": [
      {
        "base_horizontal_Stack@global.empty_stack_panel": {
          "orientation": "horizontal",
          "anchor_to": "center",
          "anchor_from": "center",
          "min_size": [176, 166],
          "max_size": [325, 166],
          "layer": 1,
          "controls": [
            {"recipe_book@inventory_screen.recipe_book":{"bindings":[{"binding_type":"global","binding_name":"(not #is_survival_layout)","binding_name_override":"#visible"}]}},
            {"buffer_1":{"type":"panel","size":[2,"default"],"bindings":[{"binding_type":"global","binding_name":"(not #is_survival_layout)","binding_name_override":"#visible"}]}},
            {"inventory@inventory_screen.inventory":{}}
          ],
          "bindings":[
            {
              "binding_type": "global",
              "binding_name": "(not #is_creative_mode)",
              "binding_name_override": "#visible"
            }
          ]
        }
      },
      { 
        "creative_mode@creative_inventory.screen_base":{
          "bindings":[
            {
              "binding_type": "global",
              "binding_name": "#is_creative_mode",
              "binding_name_override": "#visible"
            }
          ]
        }
      },
      { "flying_item_renderer@common.flying_item_renderer": { "layer": 21 } },
      { "red_hold_icon@common.inventory_take_progress_icon_button": {} },
      { "red_icon@global.inventory_selected_icon_button": {} },
      { "gamepad_cursor@common.gamepad_cursor_button": {} }
    ]
  },
  "inventory@global.root_panel": {
    "size": [176, 166],
    "controls": [
      {
        "container@screen_content.somali": {
          "$inventory_screen": true,
          "contained"        : true// im sure this is not needed but im keeping it eanyway cause it looks like a cool property and i want to use it
        }
      },
      {"inventory_crafting_stack@inventory_specific.inventory_crafting_stack":{}},
      {"equipment_panel@inventory_top_half.player_equipment_panel":{}},
      {"container_grid@inventory_compressed_stack.inventory_grid_stack":{}}
    ]
  },
  "recipe_book": {
    "type": "panel",
    "size": [147, 166],
    "controls": [
      {"tab_stack@crafting_tab_stack.tab_stack": {}},
      {
        "root_panel@global.root_panel": {
          "controls": [
            { "recipe_base@screen_content.recipe_book": {"layer": 1} },
            {
              "base_page_control@pagination.max_page_is_28": {
                "$is_in_recipe_inventory": true,
                "$max_ashur_page": 28,
                "$page_content": "recipe_grid.recipe_grid"
              }
            }
          ]
        }
      }
    ]
  }
}
