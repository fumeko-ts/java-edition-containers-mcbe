{
  "namespace": "crafting_top_stack",
  "crafting_top_stack": {
    "type": "panel",
    "size": [176, 166],
    "controls": [
      {
        "stack_top_buffer_stack@global.empty_stack_panel": {
          "orientation": "vertical",
          "anchor_to": "top_left",
          "anchor_from": "top_left",
          "size": [176, 70],
          "controls": [
            {"buffer_1": { "type": "panel", "size": ["default", 4] }},
            {
              "cell_stack@global.empty_stack_panel": {
                "orientation": "horizontal",
                "size": [176, 12],
                "controls": [
                   {"buffer_3": { "type": "panel", "size": [29, "default"] }},
                   {
                    "label_holder@global.empty_panel":{
                        "size": [54, "default"],
                        "controls":[
                            {
                              "inventory_label": {
                                 "type":"label",
                                 "anchor_from": "left_middle",
                                 "anchor_to": "left_middle",
                                 "layer": 2,
                                 "size": [ "100%", 10 ],
                                 "color": "$title_text_color", 
                                 "text": "container.crafting"
                               }
                            }
                         ]
                      }
                   },
                   {"buffer_3": { "type": "panel", "size": [93, "default"] }}
                ]
              }
            },
            {
              "cell_stack@global.empty_stack_panel": {
                "orientation": "horizontal",
                "size": [176, 54],
                "controls": [
                   {"buffer_2": { "type": "panel", "size": [29, "default"] }},
                   {"crafting_3x3@crafting_top_stack.crafting_3x3_grid":{}},
                   {"buffer_3": { "type": "panel", "size": [36, "default"] }},
                   {
                    "cell_stack@global.empty_stack_panel": {
                      "orientation": "vertical",
                      "size": [26, 54],
                      "controls": [
                         {"buffer_4": { "type": "panel", "size": ["default", 14] }},
                         {"crafting_3x3@crafting_top_stack.output_grid_3x3":{}},
                         {"buffer_5": { "type": "panel", "size": ["default", 14] }}
                      ]
                    }
                  },
                  {"buffer_6": { "type": "panel", "size": [31, "default"] }}
                ]
              }
            }
          ]
        }
      }
    ]
  },
  "crafting_3x3_grid": {
    "type": "grid",
    "size": [54, 54],
    "anchor_from": "top_left",
    "anchor_to": "top_left",
    "grid_dimensions": [3, 3],
    "collection_name": "crafting_input_items",
    "controls": [
      {"crafting_input_item_top_left@crafting_textures.crafting_input_grid_item": {"grid_position": [0, 0]}},
      {"crafting_input_item_top_mid@crafting_textures.crafting_input_grid_item": {"grid_position": [1, 0]}},
      {"crafting_input_item_top_right@crafting_textures.crafting_input_grid_item": {"grid_position": [2, 0]}},
      {"crafting_input_item_mid_left@crafting_textures.crafting_input_grid_item": {"grid_position": [0, 1]}},
      {"crafting_input_item_middle@crafting_textures.crafting_input_grid_item": {"grid_position": [1, 1]}},
      {"crafting_input_item_mid_right@crafting_textures.crafting_input_grid_item": {"grid_position": [2, 1]}},
      {"crafting_input_item_bot_left@crafting_textures.crafting_input_grid_item": {"grid_position": [0, 2]}},
      {"crafting_input_item_bot_mid@crafting_textures.crafting_input_grid_item": {"grid_position": [1, 2]}},
      {"crafting_input_item_bot_right@crafting_textures.crafting_input_grid_item": {"grid_position": [2, 2]}}
    ]
  },
  "output_grid_3x3": {
    "type": "grid",
    "grid_dimensions": [ 1, 1 ],
    "collection_name": "crafting_output_items",
    "anchor_from": "top_left",
    "anchor_to": "top_left",
    "size": [ 26, 26 ],
    "controls": [
      {
        "work_bench_output@crafting.inventory_container_item": {
          "size": [ 26, 26 ],
          "$cell_image_size": [ 26, 26 ],
          "$item_collection_name": "crafting_output_items",
          "$button_ref": "crafting.output_no_coalesce_container_slot_button",
          "$stack_count_binding_condition": "always",
          "$item_renderer_binding_condition": "always",
          "$background_images": "crafting_textures.output_cell_textures",
          "$focus_id_binding_type": "none",
          "$focus_id": "crafting_output_item",
          "$focus_override_right_binding_type": "none",
          "$focus_override_right": "FOCUS_OVERRIDE_STOP"
        }
      }
    ]
  }
}