{
  "namespace": "crafter_screen",
  "crafter_panel@container_common.container_details": {
    "size": [176, 166],
    "$screen_controls": [
      { "common_panel@screen_content.crafter": {} },
      { "extensions@jc-extensions.crafter_screen": {} },
      {
        "main_vertical_stack@global.empty_stack": {
          "orientation": "vertical",
          "size": [176, 70],
          "anchor_to": "top_middle",
          "anchor_from": "top_middle",
          "controls": [
            { "vertical_filler_top@global.empty_panel": { "size": ["fill", 3] } },
            {
              "title_label_wrapper@global.empty_panel": {
                "size": [176, 10],
                "controls": [
                  {
                    "crafter_label@global.empty_label": {
                      "offset": [68, 2],
                      "anchor_to": "left_middle",
                      "anchor_from": "left_middle",
                      "size": ["default", 10],
                      "layer": 5,
                      "text": "atemp.container.crafter",
                      "color": "$container_title_color"
                    }
                  }
                ]
              }
            },
            { "vertical_filler_between@global.empty_panel": { "size": ["fill", 3] } },
            {
              "input_and_output_row@global.empty_stack": {
                "orientation": "horizontal",
                "size": [176, 54],
                "controls": [
                  { "input_left_filler@global.empty_panel": { "size": [25, "fill"] } },
                  {
                    "crafter_items@global.empty_grid": {
                      "size": [54, 54],
                      "grid_dimensions": [3, 3],
                      "$item_collection": "container_items",
                      "collection_name": "$item_collection",
                      "controls": [
                        { "slot_button_0@crafter_screen.slot_template": {"grid_position": [0, 0],"$crafter_button_index": 0}},
                        { "slot_button_1@crafter_screen.slot_template": {"grid_position": [1, 0],"$crafter_button_index": 1}},
                        { "slot_button_2@crafter_screen.slot_template": {"grid_position": [2, 0],"$crafter_button_index": 2}},
                        { "slot_button_3@crafter_screen.slot_template": {"grid_position": [0, 1],"$crafter_button_index": 3}},
                        { "slot_button_4@crafter_screen.slot_template": {"grid_position": [1, 1],"$crafter_button_index": 4}},
                        { "slot_button_5@crafter_screen.slot_template": {"grid_position": [2, 1],"$crafter_button_index": 5}},
                        { "slot_button_6@crafter_screen.slot_template": {"grid_position": [0, 2],"$crafter_button_index": 6}},
                        { "slot_button_7@crafter_screen.slot_template": {"grid_position": [1, 2],"$crafter_button_index": 7}},
                        { "slot_button_8@crafter_screen.slot_template": {"grid_position": [2, 2],"$crafter_button_index": 8}}
                      ]
                    }
                  },
                  { "redstone_filler@global.empty_panel": { "size": [18, "fill"] } },
                  {
                    "redstone_arrow_stack@global.empty_stack": {
                      "orientation": "vertical",
                      "size": [16, 54],
                      "controls": [
                        { "top_filler@global.empty_panel": { "size": ["fill", 19] } },
                        {
                          "redstone_detector@global.empty_panel": {
                            "size": [16, 16],
                            "layer": 2,
                            "controls": [
                              {
                                "redstone_activated@screen_content.redstone_activated_bindings": {
                                  "$arrow_texture": "assets/sprites/container/crafter/powered_redstone",
                                  "$binding_value": "(#redstone_arrow_texture = 'textures/ui/redstone_arrow_powered')",
                                  "variables": {
                                    "requires": "$pocket_screen",
                                    "$binding_value": "(#redstone_arrow_texture = 'textures/ui/redstone_arrow_vertical_powered')"
                                  }
                                }
                              },
                              {
                                "redstone_deactivated@screen_content.redstone_activated_bindings": {
                                  "$arrow_texture": "assets/sprites/container/crafter/unpowered_redstone",
                                  "$binding_value": "(#redstone_arrow_texture = 'textures/ui/redstone_arrow_unpowered')",
                                  "variables": {
                                    "requires": "$pocket_screen",
                                    "$binding_value": "(#redstone_arrow_texture = 'textures/ui/redstone_arrow_vertical_unpowered')"
                                  }
                                }
                              }
                            ]
                          }
                        },
                        { "bottom_filler@global.empty_panel": { "size": ["fill", 19] } }
                      ]
                    }
                  },
                  {
                    "output_stack@global.empty_stack": {
                      "orientation": "horizontal",
                      "size": [63, 54],
                      "controls": [
                        { "output_right_filler@global.empty_panel": { "size": [20, "fill"] } },
                        {
                          "output_vertical_stack@global.empty_stack": {
                            "orientation": "vertical",
                            "size": [18, 54],
                            "controls": [
                              { "output_top_filler@global.empty_panel": { "size": ["fill", 18] } },
                              {
                                "crafter_output_button": {
                                  "type": "button",
                                  "hover_control": "hover",
                                  "size": [18, 18],
                                  "controls": [
                                    {
                                      "hover@global.hover_text": {
                                        "$hover_text": "#crafting_preview_info"
                                      }
                                    },
                                    {
                                      "output_item_renderer@jc_container_item.item_renderer": {
                                        "size": [16, 16],
                                        "$item_collection|default": "crafter_output_item",
                                        "bindings": [
                                          {"binding_name": "#crafter_output_item"                               ,"binding_name_override": "#item_id_aux"            },
                                          {"binding_name": "#crafter_output_item_color"                         ,"binding_name_override": "#item_custom_color"      },
                                          {"binding_name": "#crafter_output_item_shield_base_color_hovered"     ,"binding_name_override": "#shield_base_color"      },
                                          {"binding_name": "#crafter_output_item_banner_patterns"               ,"binding_name_override": "#banner_patterns"        },
                                          {"binding_name": "#crafter_output_item_selected_banner_colors"        ,"binding_name_override": "#banner_colors"          },
                                          {"binding_name": "#crafter_output_item_selected_banner_type"          ,"binding_name_override": "#banner_type"            },
                                          {"binding_name": "#crafter_output_item_selected_decorated_pot_sherds" ,"binding_name_override": "#decorated_pot_sherds"   }
                                        ]
                                      }
                                    },
                                    {
                                      "output_stack_count_label": {
                                        "type": "label",
                                        "layer": 20,
                                        "offset": [0, 1],
                                        "anchor_to": "bottom_right",
                                        "anchor_from": "bottom_right",
                                        "shadow": true,
                                        "text": "#inventory_stack_count",
                                        "bindings": [
                                          {
                                            "binding_name": "#output_stack_count",
                                            "binding_name_override": "#inventory_stack_count"
                                          }
                                        ]
                                      }
                                    }
                                  ]
                                }
                              },
                              { "output_bottom_filler@global.empty_panel": { "size": ["fill", 18] } }
                            ]
                          }
                        },
                        { "output_right_filler@global.empty_panel": { "size": [25, "fill"] } }
                      ]
                    }
                  }
                ]
              }
            }
          ]
        }
      },
      {
        "bottom@global.inventory_bottom_half_with_label": {
          "anchor_to": "bottom_middle",
          "anchor_from": "bottom_middle"
        }
      }
    ]
  },
  "slot_template@global.empty_panel": {
    "size": [18, 18],
    "controls": [
      {
        "disabled_button": {
          "type": "button",
          "size": [18, 18],
          "anchor_from": "center",
          "anchor_to": "center",
          "layer": 3,
          "sound_volume": 1.0,
          "sound_pitch": 1.0,
          "sound_name": "random.click",
          "always_listen_to_input": true,
          "consume_hover_events": false,
          "$pressed_action": "('disabled_button' + $crafter_button_index)",
          "bindings": [
            { "binding_name": "('#button_visible' + $crafter_button_index)", "binding_name_override": "#visible" }
          ],
          "controls": [{ "button_texture@screen_content.crafter_disabled_slot": {} }],
          "button_mappings": [
            {
              "from_button_id": "button.menu_select",
              "to_button_id": "$pressed_action",
              "mapping_type": "pressed"
            },
            {
              "from_button_id": "button.menu_secondary_select",
              "to_button_id": "$pressed_action",
              "mapping_type": "pressed"
            },
            { "from_button_id": "button.menu_ok", "to_button_id": "$pressed_action", "mapping_type": "pressed" },
            {
              "from_button_id": "button.controller_select",
              "to_button_id": "$pressed_action",
              "mapping_type": "pressed"
            },
            {
              "from_button_id": "button.controller_secondary_select",
              "to_button_id": "$pressed_action",
              "mapping_type": "pressed"
            }
          ]
        }
      },
      {
        "item_cell@jc_container_item.container_item": {
          "layer": 2,
          "$highlight_control|default": "global.empty_panel",
          "$button_binding|default": "('#button_visible' + $crafter_button_index)",
          "$cell_hover_text_bindings": [
            {"binding_name": "$button_binding"},
            {"binding_name": "#show_bundle_tooltip_hover"},
            {
              "binding_name": "#hover_text",
              "binding_name_override": "#hover_text",
              "binding_type": "collection",
              "binding_collection_name": "$item_collection"
            },
            {
              "binding_type": "view",
              "binding_condition": "always",
              "source_property_name": "(not ($button_binding or #show_bundle_tooltip_hover))",
              "target_property_name": "#visible"
            }
          ]
        }
      },
      {
        "button_visuals": {
          "type": "button",
          "size": [18, 18],
          "layer": 4,
          "hover_control": "highlight_slot_overlay",
          "consume_event": false,
          "focus_enabled": "$game_pad",
          "focus_wrap_enabled": false,
          "focus_magnet_enabled": false,
          "default_focus_precedence": 1,
          "button_mappings": [
            { "to_button_id": "button.container_slot_hovered", "mapping_type": "pressed", "consume_event": false }
          ],
          "controls": [
            { 
              "highlight_slot_overlay@global.empty_image": {
                "texture": "assets/sprites/container/slot_highlight_front.png",
                "size": [18, 18],
                "layer": 7
              }
            }
          ]
        }
      }
    ]
  }
}
