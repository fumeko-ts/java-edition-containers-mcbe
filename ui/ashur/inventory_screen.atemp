{
  "namespace": "inventory_screen",
  "screen_base@global.root_panel": {
    "controls": [
      {
        "base_horizontal_Stack@global.empty_stack": {
          "orientation": "horizontal",
          "anchor_to": "center",
          "anchor_from": "center",
          "min_size": [176, 166],
          "max_size": [359, 166],
          "layer": 1,
          "controls": [
            {
              "3@global.empty_stack": {
                "size": [183, 166],
                "orientation": "horizontal",
                "controls": [
                  { "tab_stack@crafting_common.crafting_survival_tabs": {} },
                  {
                    "recipe_base@screen_content.recipe_book": {
                      "controls": [
                        {
                          "holder@global.empty_stack": {
                            "orientation": "vertical",
                            "anchor_to": "top_right",
                            "anchor_from": "top_right",
                            "size": [122, 28],
                            "controls": [
                              { "buffer_1@global.empty_panel": { "size": [122, 12] } },
                              {
                                "search_and_filter@global.empty_stack": {
                                  "orientation": "horizontal",
                                  "size": [122, 16],
                                  "controls": [
                                    {
                                      "search_holder@global.empty_stack": {
                                        "orientation": "vertical",
                                        "size": [81, 16],
                                        "controls": [
                                          { "buffer_1@global.empty_panel": { "size": [81, 1] } },
                                          {
                                            "text_edit_control@text_edit_box.text_edit_box": {
                                              "size": [81, 14],
                                              "property_bag": { "#property_field": "#item_name" },
                                              "max_length": 300000,
                                              "$text_clear_button_offset": [3, 0],
                                              "$text_edit_box_label_offset": [1, 0.4],
                                              "$text_clear_button_enabled": true,

                                              "$place_holder_text": "atemp.recipe_book.searchBox",
                                              "$extra_contents": "text_edit_box.placeholder_label",

                                              "$text_background_locked": "screen_content.text_field",
                                              "$text_background_default": "screen_content.text_field",
                                              "$text_background_hover": "screen_content.text_field_highlighted",

                                              "$text_edit_binding_name": "#text_box_item_name",
                                              "$text_edit_box_label_size": ["default", 10]
                                            }
                                          },
                                          { "buffer_2@global.empty_panel": { "size": [81, 1] } }
                                        ]
                                      }
                                    },
                                    { "buffer_1@global.empty_panel": { "size": [4, 16] } },

                                    { "filter@crafting_common.filter_toggle": {} }, //[26, 16],
                                    { "buffer_2@global.empty_panel": { "size": [11, 16] } }
                                  ]
                                }
                              }
                            ]
                          }
                        },
                        { "recipe_items@survival_recipe_grid.recipe_grid": {} },
                        { "page_navigation@pagination.base_page_logic": {} }
                      ]
                    }
                  },
                  { "4@global.empty_panel": { "size": [1, "fill"] } }
                ],
                "bindings": [
                  {
                    "binding_type": "global",
                    "binding_name": "(not #is_survival_layout)",
                    "binding_name_override": "#visible"
                  }
                ]
              }
            },
            {
              "inventory@global.root_panel": {
                "size": [176, 166],
                "controls": [
                  { "container@screen_content.container_base": { "$inventory_screen": true } },
                  {
                    "inventory_crafting_stack@global.empty_panel": {
                      "size": [176, 166],
                      "controls": [
                        {
                          "cell_stack@global.empty_stack": {
                            "orientation": "vertical",
                            "size": [79, 79],
                            "anchor_to": "top_right",
                            "anchor_from": "top_right",
                            "controls": [
                              { "buffer_1@global.empty_panel": { "size": ["default", 5] } },
                              {
                                "inventory_label@global.empty_label": {
                                  "anchor_from": "left_middle",
                                  "anchor_to": "left_middle",
                                  "layer": 2,
                                  "size": ["100%", 10],
                                  "color": "$title_text_color",
                                  "text": "atemp.container.crafting"
                                }
                              },
                              { "buffer_1@global.empty_panel": { "size": ["default", 2] } },
                              {
                                "cell_stack@global.empty_stack": {
                                  "orientation": "horizontal",
                                  "size": [79, 36],
                                  "controls": [
                                    {
                                      "2x2_crafting_grid": {
                                        "type": "grid",
                                        "size": [36, 36],
                                        "grid_dimensions": [2, 2],
                                        "collection_name": "crafting_input_items",
                                        "grid_item_template": "crafting_textures.crafting_input_grid_item"
                                      }
                                    },
                                    { "buffer_2@global.empty_panel": { "size": [20, 36] } },
                                    {
                                      "cell_stack@global.empty_stack": {
                                        "orientation": "vertical",
                                        "size": [23, 36],
                                        "controls": [
                                          { "buffer_3@global.empty_panel": { "size": ["default", 10] } },
                                          {
                                            "2x2_crafting_output_grid": {
                                              "type": "grid",
                                              "grid_dimensions": [1, 1],
                                              "collection_name": "crafting_output_items",
                                              "size": [18, 18],
                                              "controls": [
                                                {
                                                  "work_bench_output@crafting.inventory_container_item": {
                                                    "$item_collection_name": "crafting_output_items",
                                                    "$button_ref": "crafting.output_no_coalesce_container_slot_button",
                                                    "$background_images": "crafting_textures.output_cell_textures",
                                                    "$item_renderer_binding_condition": "always",
                                                    "$stack_count_binding_condition": "always"
                                                  }
                                                }
                                              ]
                                            }
                                          },
                                          { "buffer_4@global.empty_panel": { "size": ["default", 8] } }
                                        ]
                                      }
                                    }
                                  ]
                                }
                              },
                              { "buffer_1@global.empty_panel": { "size": ["default", 7] } },
                              {
                                "cell_stack@global.empty_stack": {
                                  "orientation": "horizontal",
                                  "size": [79, 18],
                                  "controls": [
                                    { "buffer_1@global.empty_panel": { "size": [6, "default"] } },
                                    { "recipe_toggle@crafting_common.recipe_layout_toggle": {} },
                                    { "buffer_1@global.empty_panel": { "size": ["fill", "default"] } }
                                  ]
                                }
                              },
                              { "buffer_1@global.empty_panel": { "size": ["default", 1] } }
                            ]
                          }
                        }
                      ]
                    }
                  },
                  {
                    "player_equipment_panel@global.empty_panel": {
                      "size": [176, 166],
                      "controls": [
                        {
                          "stack_top_buffer_stack@global.empty_stack": {
                            "orientation": "vertical",
                            "anchor_to": "top_left",
                            "anchor_from": "top_left",
                            "size": [94, 86],
                            "controls": [
                              { "buffer_1@global.empty_panel": { "size": ["default", 7] } },
                              {
                                "cell_stack@global.empty_stack": {
                                  "orientation": "horizontal",
                                  "size": [94, 79],
                                  "controls": [
                                    { "buffer_1@global.empty_panel": { "size": [7, "default"] } },
                                    {
                                      "armor_grid": {
                                        "type": "grid",
                                        "size": [18, 72],
                                        "grid_dimensions": [1, 4],
                                        "$item_collection_name": "armor_items",
                                        "collection_name": "$item_collection_name",
                                        "controls": [
                                          {
                                            "head_grid_item@common.container_item": {
                                              "grid_position": [0, 0],
                                              "$cell_overlay_ref": "screen_content.armor_overlay_helmet",
                                              "$button_ref": "crafting.no_coalesce_container_slot_button"
                                            }
                                          },
                                          {
                                            "chest_grid_item@common.container_item": {
                                              "grid_position": [0, 1],
                                              "$cell_overlay_ref": "screen_content.armor_overlay_chest",
                                              "$button_ref": "crafting.no_coalesce_container_slot_button"
                                            }
                                          },
                                          {
                                            "legs_grid_item@common.container_item": {
                                              "grid_position": [0, 2],
                                              "$cell_overlay_ref": "screen_content.armor_overlay_legs",
                                              "$button_ref": "crafting.no_coalesce_container_slot_button"
                                            }
                                          },
                                          {
                                            "feet_grid_item@common.container_item": {
                                              "grid_position": [0, 3],
                                              "$cell_overlay_ref": "screen_content.armor_image_feet",
                                              "$button_ref": "crafting.no_coalesce_container_slot_button"
                                            }
                                          }
                                        ]
                                      }
                                    },
                                    {
                                      "player_render_float@global.empty_panel": {
                                        "size": [51, 72],
                                        "controls": [
                                          {
                                            "player_float@global.empty_panel": {
                                              "size": [30, 80],
                                              "controls": [
                                                {
                                                  "player_renderer": {
                                                    "type": "custom",
                                                    "size": [30, 80],
                                                    "offset": [0, -14],
                                                    "renderer": "live_player_renderer",
                                                    "anchor_from": "center",
                                                    "anchor_to": "center",
                                                    "property_bag": { "#look_at_cursor": true },
                                                    "animation_reset_name": "screen_animation_reset",
                                                    "anims": [
                                                      "@common.screen_exit_size_animation_push",
                                                      "@common.screen_exit_size_animation_pop",
                                                      "@common.screen_entrance_size_animation_push",
                                                      "@common.screen_entrance_size_animation_pop"
                                                    ]
                                                  }
                                                }
                                              ]
                                            }
                                          }
                                        ]
                                      }
                                    },
                                    {
                                      "offhand_stack@global.empty_stack": {
                                        "orientation": "vertical",
                                        "size": [18, 72],
                                        "controls": [
                                          { "filler_panel@global.empty_panel": { "size": [18, 54] } },
                                          {
                                            "offhand_1x1": {
                                              "type": "grid",
                                              "size": [18, 18],
                                              "grid_dimensions": [1, 1],
                                              "$item_collection_name": "offhand_items",
                                              "collection_name": "$item_collection_name",
                                              "controls": [
                                                {
                                                  "offhand_grid_item@common.container_item": {
                                                    "grid_position": [0, 0],
                                                    "$cell_overlay_ref": "screen_content.armor_overlay_shield",
                                                    "$button_ref": "crafting.no_coalesce_container_slot_button"
                                                  }
                                                }
                                              ]
                                            }
                                          }
                                        ]
                                      }
                                    }
                                  ]
                                }
                              }
                            ]
                          }
                        }
                      ]
                    }
                  },
                  {
                    "inventory_grid_stack@global.empty_panel": {
                      "size": [176, 166],
                      "controls": [
                        {
                          "cell_stack@global.empty_stack": {
                            "orientation": "vertical",
                            "size": [162, 83],
                            "anchor_to": "bottom_middle",
                            "anchor_from": "bottom_middle",
                            "controls": [
                              {
                                "inventory_grid": {
                                  "type": "grid",
                                  "size": [162, 54],
                                  "grid_dimensions": [9, 3],
                                  "$item_collection_name": "inventory_items",
                                  "grid_item_template": "global.grid_item",
                                  "collection_name": "inventory_items"
                                }
                              },
                              { "buffer_2@global.empty_panel": { "size": ["default", 4] } },
                              { "hotbar@global.hotbar": {} },
                              { "buffer_3@global.empty_panel": { "size": ["default", 7] } }
                            ]
                          }
                        }
                      ]
                    }
                  }
                ]
              }
            }
          ],
          "bindings": [
            {
              "binding_type": "global",
              "binding_name": "(not #is_creative_mode)",
              "binding_name_override": "#visible"
            }
          ]
        }
      },
      {
        "creative_mode@creative_inventory.screen_base": {
          "anchor_to": "center",
          "anchor_from": "center",
          "bindings": [
            { "binding_type": "global", "binding_name": "#is_creative_mode", "binding_name_override": "#visible" }
          ]
        }
      }
    ]
  }
}
