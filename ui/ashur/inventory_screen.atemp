{
  "namespace": "inventory_screen",
  "screen_base@container_common.container_details": {
    "size": ["100%cm", "100%cm"],
    "$screen_controls": [
      {
        "survival_inventory@global.empty_stack": {
          "orientation": "horizontal",
          "size": ["100%c", 166],
          "controls": [
            { "recipe_book@recipe_book.recipe_book": {} },
            {
              "inventory@global.root_panel": {
                "size": [176, 166],
                "controls": [
                  { "common_panel@screen_content.inventory": {} },
                  { "extensions@jc-extensions.inventory_screen": {} },
                  {
                    "inventory_top_section@global.empty_stack": {
                      "orientation": "vertical",
                      "size": [176, 79],
                      "layer": 2,
                      "anchor_to": "top_middle",
                      "anchor_from": "top_middle",
                      "controls": [
                        { "filler_0@global.empty_panel": { "size": ["fill", 7] } },
                        {
                          "inventory_stack@global.empty_stack": {
                            "orientation": "horizontal",
                            "size": [176, 72],
                            "controls": [
                              { "filler_1@global.empty_panel": { "size": [7, "fill"] } },
                              {
                                "armor_grid@global.empty_grid": {
                                  "size": [18, 72],
                                  "grid_dimensions": [1, 4],
                                  "$item_collection": "armor_items",
                                  "collection_name": "$item_collection",
                                  "$button_control": "button_mappings.armor_input_button",
                                  "controls": [
                                    {
                                      "helmet_armor_slot@jc_container_item.container_item": {
                                        "grid_position": [0, 0],
                                        "$background_control": "screen_content.armor_helmet_icon"
                                      }
                                    },
                                    {
                                      "chestplate_armor_slot@jc_container_item.container_item": {
                                        "grid_position": [0, 1],
                                        "$background_control": "screen_content.armor_chestplate_icon"
                                      }
                                    },
                                    {
                                      "leggings_armor_slot@jc_container_item.container_item": {
                                        "grid_position": [0, 2],
                                        "$background_control": "screen_content.armor_leggings_icon"
                                      }
                                    },
                                    {
                                      "boots_armor_slot@jc_container_item.container_item": {
                                        "grid_position": [0, 3],
                                        "$background_control": "screen_content.armor_boots_icon"
                                      }
                                    }
                                  ]
                                }
                              },
                              {
                                "renderer_vertical_holding_stack@global.empty_stack": {
                                  "orientation": "vertical",
                                  "size": [51, 72],
                                  "controls": [
                                    { "filler_2@global.empty_panel": { "size": ["fill", 1] } },
                                    {
                                      "renderer_horizontal_holding_stack@global.empty_stack": {
                                        "orientation": "horizontal",
                                        "size": [51, 70],
                                        "controls": [
                                          { "filler_3@global.empty_panel": { "size": [1, "fill"] } },
                                          {
                                            "player_renderer_clipping_panel@global.empty_panel": {
                                              "size": [49, 70],
                                              "clips_children": "$should_clip_entity_renderers",
                                              "controls": [
                                                {
                                                  "player_renderer@global.custom_renderer": {
                                                    "$type": "live_player_renderer",
                                                    "size": [30, 80],
                                                    "offset": [0, -14],
                                                    "anchor_from": "center",
                                                    "anchor_to": "center",
                                                    "property_bag": {
                                                      "#look_at_cursor": true
                                                    }
                                                  }
                                                }
                                              ]
                                            }
                                          },
                                          { "filler_4@global.empty_panel": { "size": [1, "fill"] } }
                                        ]
                                      }
                                    },
                                    { "filler_5@global.empty_panel": { "size": ["fill", 1] } }
                                  ]
                                }
                              },
                              {
                                "offhand_stack@global.empty_stack": {
                                  "orientation": "vertical",
                                  "size": [18, 72],
                                  "controls": [
                                    { "filler_6@global.empty_panel": { "size": ["fill", 54] } },
                                    {
                                      "offhand_slot@jc_container_item.container_item": {
                                        "$item_collection": "offhand_items",
                                        "$background_control": "screen_content.offhand_icon",
                                        "$button_control": "button_mappings.offhand_input_button"
                                      }
                                    }
                                  ]
                                }
                              },
                              { "filler_7@global.empty_panel": { "size": [3, "fill"] } },
                              {
                                "crafting_area_stack@global.empty_stack": {
                                  "orientation": "vertical",
                                  "size": [79, 72],
                                  "controls": [
                                    {
                                      "container_title_stack@global.empty_stack": {
                                        "orientation": "horizontal",
                                        "size": ["fill", 8],
                                        "controls": [
                                          {
                                            "container_title_wrapper@global.empty_panel": {
                                              "size": [74, 8],
                                              "controls": [
                                                {
                                                  "crafting_title_text@global.empty_label": {
                                                    "size": [74, 10],
                                                    "anchor_from": "bottom_left",
                                                    "anchor_to": "bottom_left",
                                                    "color": "$container_title_color",
                                                    "text": "atemp.container.crafting"
                                                  }
                                                }
                                              ]
                                            }
                                          },
                                          { "filler_8@global.empty_panel": { "size": [5, "fill"] } }
                                        ]
                                      }
                                    },
                                    { "filler_9@global.empty_panel": { "size": ["fill", 2] } },
                                    {
                                      "crafting_grid_stack@global.empty_stack": {
                                        "orientation": "horizontal",
                                        "size": [79, 36],
                                        "controls": [
                                          {
                                            "crafting_input_grid@global.empty_grid": {
                                              "size": [36, 36],
                                              "grid_dimensions": [2, 2],
                                              "collection_name": "$item_collection",
                                              "$item_collection": "crafting_input_items",
                                              "$item_renderer_binding_condition": "always",
                                              "$background_control": "crafting_textures.main_cell_panel",
                                              "grid_item_template": "jc_container_item.container_item"
                                            }
                                          },
                                          { "filler_10@global.empty_panel": { "size": [20, "fill"] } },
                                          {
                                            "crafting_output_stack@global.empty_stack": {
                                              "orientation": "vertical",
                                              "size": [18, 36],
                                              "controls": [
                                                { "filler_11@global.empty_panel": { "size": ["fill", 10] } },
                                                {
                                                  "crafting_output_slot@jc_container_item.container_item": {
                                                    "$button_control": "button_mappings.crafting_output_button",
                                                    "$item_collection": "crafting_output_items",
                                                    "$item_renderer_binding_condition": "always",
                                                    "$background_control": "crafting_textures.main_cell_panel"
                                                  }
                                                },
                                                { "filler_12@global.empty_panel": { "size": ["fill", 8] } }
                                              ]
                                            }
                                          },
                                          { "filler_13@global.empty_panel": { "size": [5, "fill"] } }
                                        ]
                                      }
                                    },
                                    {
                                      "layout_toggle_vertical_stack@global.empty_stack": {
                                        "orientation": "vertical",
                                        "size": [79, 26],
                                        "controls": [
                                          { "filler_14@global.empty_panel": { "size": ["fill", 8] } },
                                          {
                                            "layout_toggle_horizontal_stack@global.empty_stack": {
                                              "orientation": "horizontal",
                                              "size": [79, 18],
                                              "controls": [
                                                { "filler_15@global.empty_panel": { "size": [7, "fill"] } },
                                                { "recipe_toggle@crafting_common.recipe_layout_toggle": {} },
                                                { "filler_16@global.empty_panel": { "size": [52, "fill"] } }
                                              ]
                                            }
                                          }
                                        ]
                                      }
                                    }
                                  ]
                                }
                              }
                            ]
                          }
                        }
                      ]
                    }
                  },
                  {
                    "inventory_section@container_common.inventory_section_without_label": {
                      "anchor_from": "bottom_middle",
                      "anchor_to": "bottom_middle"
                    }
                  }
                ]
              }
            }
          ],
          "bindings": [
            {
              "binding_type": "global",
              "binding_condition": "always",
              "binding_name": "(not #is_creative_mode)",
              "binding_name_override": "#visible"
            }
          ]
        }
      },
      {
        "creative_inventory@creative_inventory.screen_base": {
          "bindings": [
            {
              "binding_type": "global",
              "binding_condition": "always",
              "binding_name": "#is_creative_mode",
              "binding_name_override": "#visible"
            }
          ]
        }
      }
    ]
  }
}
