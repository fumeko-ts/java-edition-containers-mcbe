{
  "namespace": "loom_screen",
  "loom_panel@container_common.container_details": {
    "size": [176, 166],
    "$screen_controls": [
      { "common_panel@screen_content.loom": {} },
      { "extensions@jc-extensions.loom_screen": {} },
      {
        "slot_buttons_holder@global.empty_stack": {
          "orientation": "vertical",
          "size": [50, 62],
          "anchor_from": "top_left",
          "anchor_to": "top_left",
          "controls": [
            { "slot_buttons_top_filler@global.empty_panel": { "size": [50, 25] } },
            {
              "main_slot_button_stack@global.empty_stack": {
                "orientation": "horizontal",
                "size": [50, 37],
                "controls": [
                  { "left_buttons_filler@global.empty_panel": { "size": [12, 37] } },
                  {
                    "slot_button_stack@global.empty_stack": {
                      "orientation": "vertical",
                      "size": [38, 37],
                      "controls": [
                        {
                          "top_slot_buttons@global.empty_stack": {
                            "orientation": "horizontal",
                            "size": [38, 18],
                            "controls": [
                              {
                                "banner_slot@jc_container_item.container_item": {
                                  "$item_collection": "loom_input_items",
                                  "$background_control": "loom_screen.banner_empty_image"
                                }
                              },
                              { "slot_center_filler@global.empty_panel": { "size": [2, 18] } },
                              {
                                "dye_slot@jc_container_item.container_item": {
                                  "$item_collection": "loom_dye_items",
                                  "$background_control": "loom_screen.dye_empty_image"
                                }
                              }
                            ]
                          }
                        },
                        { "slot_center_spacer@global.empty_panel": { "size": [38, 1] } },
                        {
                          "bottom_slot_button@global.empty_stack": {
                            "orientation": "horizontal",
                            "size": [38, 18],
                            "controls": [
                              { "bottom_slot_left_filler@global.empty_panel": { "size": [10, 18] } },
                              {
                                "pattern_panel@global.empty_panel": {
                                  "size": [18, 18],
                                  "controls": [
                                    {
                                      "pattern_slot@jc_container_item.container_item": {
                                        "$item_collection": "loom_material_items",
                                        "bindings": [
                                          {
                                            "binding_name": "(not #empty_image_visible)",
                                            "binding_name_override": "#visible",
                                            "binding_type": "collection",
                                            "binding_collection_name": "$item_collection"
                                          }
                                        ]
                                      }
                                    },
                                    {
                                      "pattern_slot_visual_fix@jc_container_item.container_item": {
                                        "$item_collection": "loom_material_items",
                                        "$background_control": "loom_screen.pattern_empty_image",
                                        "$dont_render_item": true,
                                        "$dont_render_hover_text": true,
                                        "$dont_render_item_count": true,
                                        "bindings": [
                                          {
                                            "binding_name": "#empty_image_visible",
                                            "binding_name_override": "#visible",
                                            "binding_type": "collection",
                                            "binding_collection_name": "$item_collection"
                                          }
                                        ]
                                      }
                                    }
                                  ]
                                }
                              },
                              { "bottom_slot_right_filler@global.empty_panel": { "size": [10, 18] } }
                            ]
                          }
                        }
                      ]
                    }
                  }
                ]
              }
            }
          ]
        }
      },
      {
        "title_holder@global.empty_panel": {
          "size": [50, 13],
          "anchor_to": "top_left",
          "anchor_from": "top_left",
          "controls": [
            {
              "loom_label@global.empty_label": {
                "offset": [8, 0],
                "anchor_to": "bottom_left",
                "anchor_from": "bottom_left",
                "size": ["default", 10],
                "layer": 5,
                "text": "atemp.container.loom",
                "color": "$container_title_color"
              }
            }
          ]
        }
      },
      {
        "output_holder@global.empty_panel": {
          "size": [34, 74],
          "anchor_to": "top_right",
          "anchor_from": "top_right",
          "controls": [
            {
              "result_item_slot@jc_container_item.container_item": {
                "anchor_to": "bottom_left",
                "anchor_from": "bottom_left",
                "$item_collection": "loom_result_items",
                "$button_control": "button_mappings.loom_output_button"
              }
            }
          ]
        }
      },
      {
        "scroll_panel@global.empty_panel": {
          "size": [131, 69],
          "anchor_to": "top_left",
          "anchor_from": "top_left",
          "controls": [
            {
              "loom_scrolling_panel@scroll_panel.scroll_panel": {
                "$scroll_size": [12, 56.2],
                "size": [73, 56.2],
                "offset": [2, 0.4],
                "$scroll_view_port_size": [71, 56.2],
                "$scrolling_pane_size": ["100%", "100%"],
                "$scroll_track_offset": [28.6, -1],
                "anchor_to": "bottom_right",
                "anchor_from": "bottom_right",
                "$scroll_box_image_control": "loom_screen.scroller",
                "$collection_name": "patterns",
                "$scrolling_content": "loom_screen.loom_selection_grid",
                "bindings": [
                  {
                    "binding_type": "collection",
                    "binding_collection_name": "loom_dye_items",
                    "binding_name": "#item_id_aux",
                    "binding_name_override": "#slot_has_banner"
                  },
                  {
                    "binding_type": "collection",
                    "binding_collection_name": "loom_input_items",
                    "binding_name": "#item_id_aux",
                    "binding_name_override": "#slot_has_dye"
                  },
                  {
                    "binding_type": "view",
                    "binding_condition": "always",
                    "source_property_name": "((not (#slot_has_banner = -1)) and (not (#slot_has_dye = -1)))",
                    "target_property_name": "#visible"
                  }
                ]
              }
            }
          ]
        }
      },
      {
        "disabled_scroll_box@global.empty_panel": {
          "size": [57, 28],
          "anchor_to": "top_right",
          "anchor_from": "top_right",
          "controls": [
            {
              "disabled_box_binding@screen_content.image_element": {
                "texture": "assets/sprites/container/loom/scroller_disabled",
                "size": [12, 15],
                "anchor_from": "bottom_left",
                "anchor_to": "bottom_left"
              }
            }
          ],
          "bindings": [
            {
              "binding_type": "view",
              "source_control_name": "loom_scrolling_panel",
              "binding_condition": "always",
              "source_property_name": "((#slot_has_dye = -1) or (#slot_has_banner = -1))",
              "target_property_name": "#visible"
            }
          ]
        }
      },
      {
        "banner_preview_holder@global.empty_panel": {
          "size": [35, 48],
          "anchor_to": "top_right",
          "anchor_from": "top_right",
          "controls": [
            {
              "result_banner_renderer@global.custom_renderer": {
                "$type": "banner_pattern_renderer",
                "size": [20, 40],
                "anchor_from": "bottom_left",
                "anchor_to": "bottom_left",
                "bindings": [
                  {
                    "binding_name": "#result_patterns",
                    "binding_name_override": "#banner_patterns",
                    "binding_condition": "always"
                  },
                  {
                    "binding_name": "#result_colors",
                    "binding_name_override": "#banner_colors",
                    "binding_condition": "always"
                  }
                ]
              }
            }
          ]
        }
      },
      {
        "bottom@global.inventory_bottom_half_with_label": {
          "anchor_to": "bottom_middle",
          "anchor_from": "bottom_middle"
        }
      }
    ]
  },
  "item_empty_image@screen_content.image_element": {
    "size": [16, 16],
    "layer": 5,
    "anchor_from": "center",
    "anchor_to": "center",
    "bindings": [
      {
        "binding_name": "#empty_image_visible",
        "binding_name_override": "#visible",
        "binding_type": "collection",
        "binding_collection_name": "$item_collection"
      }
    ]
  },
  "banner_empty_image@loom_screen.item_empty_image": { "texture": "assets/sprites/container/loom/banner_slot" },
  "dye_empty_image@loom_screen.item_empty_image": { "texture": "assets/sprites/container/loom/dye_slot" },
  "pattern_empty_image@loom_screen.item_empty_image": { "texture": "assets/sprites/container/loom/pattern_slot" },
  "scroller@screen_content.image_element": {
    "tiled": true,
    "nineslice_size": [6, 7, 6, 6],
    "tiled_scale": [1, 1],
    "offset": [0, 0.8],
    "anchor_to": "center",
    "anchor_from": "center",
    "texture": "assets/sprites/container/loom/scroller",
    "size": [12, "100%"]
  },
  "loom_selection_grid@global.empty_grid": {
    "size": [56, "default"],
    "collection_name": "$collection_name",
    "anchor_to": "center",
    "anchor_from": "center",
    "grid_rescaling_type": "horizontal",
    "grid_fill_direction": "vertical",
    "grid_item_template": "loom_screen.pattern_button",
    "bindings": [
      {
        "binding_name": "#pattern_selector_total_items",
        "binding_name_override": "#maximum_grid_items",
        "binding_condition": "visible",
        "binding_type": "collection",
        "binding_collection_name": "$collection_name"
      }
    ]
  },
  "pattern_button": {
    "type": "input_panel",
    "size": [14, 14],
    "controls": [
      {
        "default@screen_content.image_element": {
          "size": [14, 14],
          "layer": 1,
          "nineslice_size": 1,
          "texture": "assets/sprites/container/loom/pattern",
          "bindings": [
            {
              "binding_type": "collection",
              "binding_condition": "always",
              "binding_collection_name": "$collection_name",
              "binding_name": "(#pattern_cell_background_texture = 'textures/ui/cell_image_normal')",
              "binding_name_override": "#visible"
            }
          ]
        }
      },
      {
        "selected@screen_content.image_element": {
          "size": [14, 14],
          "layer": 1,
          "nineslice_size": 1,
          "texture": "assets/sprites/container/loom/pattern_selected",
          "bindings": [
            {
              "binding_type": "collection",
              "binding_condition": "always",
              "binding_collection_name": "$collection_name",
              "binding_name": "(#pattern_cell_background_texture = 'textures/ui/cell_image_invert')",
              "binding_name_override": "#visible"
            }
          ]
        }
      },
      {
        "banner_template@global.empty_image": {
          "anchor_to": "top_left",
          "anchor_from": "top_left",
          "layer": 10,
          "keep_ratio": false,
          "texture": "#texture",
          "offset": [4, 2],
          "size": [5, 10],
          "bindings": [
            {
              "binding_name": "#banner_patterns",
              "binding_type": "collection",
              "binding_collection_name": "patterns"
            },
            {
              "binding_type": "view",
              "binding_condition": "always",
              "source_property_name": "('textures/ui/ashur/banner_patterns/' + #banner_patterns)",
              "target_property_name": "#texture"
            }
          ]
        }
      },
      {
        "banner_bg@global.empty_image": {
          "anchor_to": "top_left",
          "anchor_from": "top_left",
          "offset": [4, 2],
          "keep_ratio": false,
          "texture": "textures/ui/ashur/banner_patterns/banner_bg",
          "size": [5, 10],
          "layer": 6
        }
      },
      {
        "pattern_slot_button": {
          "type": "button",
          "size": [14, 14],
          "sound_name": "ui.loom.select_pattern",
          "sound_volume": 1.0,
          "sound_pitch": 1.0,
          "default_focus_precedence": 1,
          "layer": 1,
          "bindings": [
            {
              "binding_type": "collection_details",
              "binding_collection_name": "$collection_name",
              "binding_condition": "once"
            }
          ],
          "button_mappings": [
            {
              "from_button_id": "button.menu_select",
              "to_button_id": "button.pattern_select",
              "mapping_type": "pressed"
            },
            {
              "from_button_id": "button.menu_ok",
              "to_button_id": "button.pattern_select",
              "mapping_type": "pressed"
            },
            {
              "from_button_id": "button.controller_back",
              "to_button_id": "button.pattern_select",
              "mapping_type": "pressed",
              "ignored": "(not $is_ps4)"
            },
            {
              "from_button_id": "button.menu_secondary_select",
              "to_button_id": "button.pattern_select",
              "mapping_type": "pressed"
            },
            {
              "from_button_id": "button.controller_select",
              "to_button_id": "button.pattern_select",
              "mapping_type": "pressed"
            },
            {
              "from_button_id": "button.menu_auto_place",
              "to_button_id": "button.pattern_select",
              "mapping_type": "pressed"
            },
            {
              "from_button_id": "button.controller_secondary_select",
              "to_button_id": "button.pattern_select",
              "mapping_type": "pressed"
            },
            {
              "from_button_id": "button.menu_inventory_drop",
              "to_button_id": "button.pattern_select",
              "mapping_type": "pressed"
            },
            {
              "from_button_id": "button.menu_inventory_drop_all",
              "to_button_id": "button.pattern_select",
              "mapping_type": "pressed"
            },
            { "to_button_id": "button.container_slot_hovered", "mapping_type": "pressed" }
          ],
          "hover_control": "hover",
          "controls": [
            {
              "hover@global.empty_panel": {
                "size": [14, 14],
                "controls": [
                  // {
                  //   "hover_text@global.hover_text": {
                  //     "property_bag": {
                  //       "#0_1_": "§a0_1_",//
                  //       "#0_2_": "§c0_2_",
                  //       "#0_3_": "§e0_3_",
                  //       "#0_4_": "§b0_4_",
                  //       "#0_5_": "§d0_5_",
                  //       "#0_6_": "§60_6_",
                  //       "#0_7_": "§90_7_",
                  //       "#0_8_": "§f0_8_",
                  //       "#0_9_": "§40_9_",
                  //       "#0_10_": "§50_10_",
                  //       "#0_11_": "§10_11_",
                  //       "#0_12_": "§30_12_",
                  //       "#0_13_": "§70_13_",
                  //       "#0_14_": "§20_14_",
                  //       "#0_15_": "§80_15_",
                  //       "#0_16_": "§a0_16_",
                  //       "#0_17_": "§c0_17_",
                  //       "#0_18_": "§e0_18_",
                  //       "#0_20_": "§b0_20_",
                  //       "#0_21_": "§d0_21_",
                  //       "#0_22_": "§60_22_",
                  //       "#0_23_": "§90_23_",
                  //       "#0_24_": "§f0_24_",
                  //       "#0_25_": "§40_25_",
                  //       "#0_26_": "§50_26_",
                  //       "#0_27_": "§10_27_",
                  //       "#0_28_": "§30_28_",
                  //       "#0_29_": "§70_29_",
                  //       "#0_30_": "§20_30_",
                  //       "#0_31_": "§80_31_",
                  //       "#0_32_": "§a0_32_",
                  //       "#0_33_": "§c0_33_",
                  //       "#0_34_": "§e0_34_",
                  //       "#0_35_": "§b0_35_",
                  //       "#0_36_": "§d0_36_",
                  //       "#0_37_": "§60_37_",
                  //       "#0_38_": "§90_38_",
                  //       "#0_39_": "§f0_39_",
                  //       "#0_40_": "§40_40_",
                  //       "#0_41_": "§50_41_",
                  //       "#0_42_": "§10_42_",
                  //       "#0_43_": "§30_43_"
                  //     },
                  //     "bindings": [
                  //       {
                  //         "binding_name": "#banner_patterns",
                  //         "binding_type": "collection",
                  //         "binding_collection_name": "patterns"
                  //       },
                  //       {
                  //         "binding_type": "view",
                  //         "source_property_name": "('#' + #banner_patterns)",
                  //         "target_property_name": "#hover_text"
                  //       }
                  //     ]
                  //   }
                  // },
                  {
                    "hover@screen_content.image_element": {
                      "size": [14, 14],
                      "nineslice_size": 1,
                      "texture": "assets/sprites/container/loom/pattern_highlighted",
                      "bindings": [
                        {
                          "binding_type": "collection",
                          "binding_condition": "always",
                          "binding_collection_name": "$collection_name",
                          "binding_name": "(not (#pattern_cell_background_texture = 'textures/ui/cell_image_invert'))",
                          "binding_name_override": "#visible"
                        }
                      ]
                    }
                  }
                ]
              }
            }
          ]
        }
      }
    ]
  }
}
