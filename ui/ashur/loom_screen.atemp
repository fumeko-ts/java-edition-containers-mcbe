{
  "namespace": "loom_screen",
  "loom_panel@container_common.container_details": {
    "size": [176, 166],
    "$screen_controls": [
      { "common_panel@screen_content.loom": {} },
      { "extensions@jc-extensions.loom_screen": {} },
      {
        "slot_buttons_holder@global.empty_stack": {
          "orientation": "vertical",
          "size": [50, 62],
          "anchor_from": "top_left",
          "anchor_to": "top_left",
          "controls": [
            { "slot_buttons_top_filler@global.empty_panel": { "size": [50, 25] } },
            {
              "main_slot_button_stack@global.empty_stack": {
                "orientation": "horizontal",
                "size": [50, 37],
                "controls": [
                  { "left_buttons_filler@global.empty_panel": { "size": [12, 37] } },
                  {
                    "slot_button_stack@global.empty_stack": {
                      "orientation": "vertical",
                      "size": [38, 37],
                      "controls": [
                        {
                          "top_slot_buttons@global.empty_stack": {
                            "orientation": "horizontal",
                            "size": [38, 18],
                            "controls": [
                              {
                                "banner_slot@jc_container_item.container_item": {
                                  "$item_collection": "loom_input_items",
                                  "$background_control": "screen_content.banner_empty_image"
                                }
                              },
                              { "slot_center_filler@global.empty_panel": { "size": [2, 18] } },
                              {
                                "dye_slot@jc_container_item.container_item": {
                                  "$item_collection": "loom_dye_items",
                                  "$background_control": "screen_content.dye_empty_image"
                                }
                              }
                            ]
                          }
                        },
                        { "slot_center_spacer@global.empty_panel": { "size": [38, 1] } },
                        {
                          "bottom_slot_button@global.empty_stack": {
                            "orientation": "horizontal",
                            "size": [38, 18],
                            "controls": [
                              { "bottom_slot_left_filler@global.empty_panel": { "size": [10, 18] } },
                              {
                                "pattern_panel@global.empty_panel": {
                                  "size": [18, 18],
                                  "controls": [
                                    {
                                      "pattern_slot@jc_container_item.container_item": {
                                        "$item_collection": "loom_material_items",
                                        "bindings": [
                                          {
                                            "binding_name": "(not #empty_image_visible)",
                                            "binding_name_override": "#visible",
                                            "binding_type": "collection",
                                            "binding_collection_name": "$item_collection"
                                          }
                                        ]
                                      }
                                    },
                                    {
                                      "pattern_slot_visual_fix@jc_container_item.container_item": {
                                        "$item_collection": "loom_material_items",
                                        "$background_control": "screen_content.pattern_empty_image",
                                        "$dont_render_item": true,
                                        "$dont_render_hover_text": true,
                                        "$dont_render_item_count": true,
                                        "bindings": [
                                          {
                                            "binding_name": "#empty_image_visible",
                                            "binding_name_override": "#visible",
                                            "binding_type": "collection",
                                            "binding_collection_name": "$item_collection"
                                          }
                                        ]
                                      }
                                    }
                                  ]
                                }
                              },
                              { "bottom_slot_right_filler@global.empty_panel": { "size": [10, 18] } }
                            ]
                          }
                        }
                      ]
                    }
                  }
                ]
              }
            }
          ]
        }
      },
      {
        "title_holder@global.empty_panel": {
          "size": [50, 13],
          "anchor_to": "top_left",
          "anchor_from": "top_left",
          "controls": [
            {
              "loom_label@global.empty_label": {
                "offset": [8, 0],
                "anchor_to": "bottom_left",
                "anchor_from": "bottom_left",
                "size": ["default", 10],
                "layer": 5,
                "text": "atemp.container.loom",
                "color": "$container_title_color"
              }
            }
          ]
        }
      },
      {
        "output_holder@global.empty_panel": {
          "size": [34, 74],
          "anchor_to": "top_right",
          "anchor_from": "top_right",
          "controls": [
            {
              "result_item_slot@jc_container_item.container_item": {
                "anchor_to": "bottom_left",
                "anchor_from": "bottom_left",
                "$item_collection": "loom_result_items",
                "$button_control": "button_mappings.loom_output_button"
              }
            }
          ]
        }
      },
      {
        "scrolling_panel_wrapper@global.empty_panel": {
          "size": [131, 69],
          "anchor_to": "top_left",
          "anchor_from": "top_left",
          "controls": [
            {
              "loom_scrolling_pane@scroll_panel.scroll_panel": {
                "size": [73, 56.2],
                "offset": [2, 0.4],
                "$scroll_size": [12, 56.2],
                "$scroll_track_offset": [28.6, -1],
                "$scroll_view_port_size": [71, 56.2],
                "$scrolling_pane_size": ["100%", "100%"],
                
                "anchor_to": "bottom_right",
                "anchor_from": "bottom_right",
                "$scroll_box_image_control": "loom_screen.scroller",
                "$scrolling_content": "loom_screen.loom_selection_grid"
              }
            }
          ],
          "bindings": [
            {
              "binding_type": "collection",
              "binding_collection_name": "loom_dye_items",
              "binding_name": "#item_id_aux",
              "binding_name_override": "#slot_has_banner"
            },
            {
              "binding_type": "collection",
              "binding_collection_name": "loom_input_items",
              "binding_name": "#item_id_aux",
              "binding_name_override": "#slot_has_dye"
            },
            {
              "binding_type": "view",
              "binding_condition": "always",
              "source_property_name": "((not (#slot_has_banner = -1)) and (not (#slot_has_dye = -1)))",
              "target_property_name": "#visible"
            }
          ]
        }
      },
      {
        "disabled_scroll_box@global.empty_panel": {
          "size": [57, 28],
          "anchor_to": "top_right",
          "anchor_from": "top_right",
          "controls": [
            {
              "disabled_box_binding@screen_content.image_element": {
                "texture": "assets/sprites/container/loom/scroller_disabled",
                "size": [12, 15],
                "anchor_from": "bottom_left",
                "anchor_to": "bottom_left"
              }
            }
          ],
          "bindings": [
            {
              "binding_type": "view",
              "source_control_name": "scrolling_panel_wrapper",
              "binding_condition": "always",
              "source_property_name": "((#slot_has_dye = -1) or (#slot_has_banner = -1))",
              "target_property_name": "#visible"
            }
          ]
        }
      },
      {
        "banner_preview_holder@global.empty_panel": {
          "size": [35, 48],
          "anchor_to": "top_right",
          "anchor_from": "top_right",
          "controls": [
            {
              "result_banner_renderer@global.custom_renderer": {
                "$type": "banner_pattern_renderer",
                "size": [20, 40],
                "anchor_from": "bottom_left",
                "anchor_to": "bottom_left",
                "bindings": [
                  {
                    "binding_name": "#result_patterns",
                    "binding_name_override": "#banner_patterns",
                    "binding_condition": "always"
                  },
                  {
                    "binding_name": "#result_colors",
                    "binding_name_override": "#banner_colors",
                    "binding_condition": "always"
                  }
                ]
              }
            }
          ]
        }
      },
      {
        "bottom@global.inventory_bottom_half_with_label": {
          "anchor_to": "bottom_middle",
          "anchor_from": "bottom_middle"
        }
      }
    ]
  },
  "item_empty_image@screen_content.image_element": {
    "size": [16, 16],
    "layer": 5,
    "anchor_from": "center",
    "anchor_to": "center",
    "bindings": [
      {
        "binding_name": "#empty_image_visible",
        "binding_name_override": "#visible",
        "binding_type": "collection",
        "binding_collection_name": "$item_collection"
      }
    ]
  },
  "scroller@screen_content.image_element": {
    "tiled": true,
    "nineslice_size": [6, 7, 6, 6],
    "tiled_scale": [1, 1],
    "offset": [0, 0.8],
    "texture": "assets/sprites/container/loom/scroller",
    "size": [12, "100%"]
  },
  "loom_selection_grid@global.empty_grid": {
    "size": [56, "default"],
    "$item_collection": "patterns",
    "collection_name": "$item_collection",
    "grid_rescaling_type": "horizontal",
    "grid_fill_direction": "vertical",
    "grid_item_template": "loom_screen.pattern_item_button",
    "bindings": [
      {
        "binding_name": "#pattern_selector_total_items",
        "binding_name_override": "#maximum_grid_items",
        "binding_condition": "visible",
        "binding_type": "collection",
        "binding_collection_name": "$item_collection"
      }
    ]
  },
  "pattern_item_button@button_mappings.pattern_item_button": {
    "size": [14, 14],
    "$hover_control": "loom_screen.highlight_texture",
    "$extra_controls": [
      {
        "default@loom_screen.highlight_texture": {
          "texture": "#texture",
          "layer": 2,
          "allow_debug_missing_texture": false,
          "property_bag": {
            "#textures/ui/cell_image_normal": "assets/sprites/container/loom/pattern",
            "#textures/ui/cell_image_invert": "assets/sprites/container/loom/pattern_selected"
          },
          "controls": [
            {
              "banner_template@global.empty_image": {
                "anchor_to": "top_left",
                "anchor_from": "top_left",
                "layer": 3,
                "texture": "#texture",
                "keep_ratio": false,
                "offset": [4, 2],
                "size": [5, 10],
                "controls": [
                  {
                    "banner_bg@global.empty_image": {
                      "keep_ratio": false,
                      "texture": "textures/ui/ashur/banner_patterns/banner_bg",
                      "size": [5, 10],
                      "color": "black",
                      "layer": -1
                    }
                  }
                ],
                "bindings": [
                  {
                    "binding_name": "#banner_patterns",
                    "binding_type": "collection",
                    "binding_collection_name": "$item_collection"
                  },
                  {
                    "binding_type": "view",
                    "binding_condition": "always",
                    "source_property_name": "('textures/ui/ashur/banner_patterns/' + #banner_patterns)",
                    "target_property_name": "#texture"
                  }
                ]
              }
            }
          ],
          "bindings": [
            {
              "binding_type": "collection",
              "binding_condition": "always",
              "binding_collection_name": "$item_collection",
              "binding_name": "('#' + #pattern_cell_background_texture)",
              "binding_name_override": "#texture"
            }
          ]
        }
      }
    ]
  },

  "highlight_texture@screen_content.image_element": {
    "size": [14, 14],
    "layer": 3,
    "texture": "assets/sprites/container/loom/pattern_highlighted",
    "bindings": [
      {
        "binding_type": "collection",
        "binding_condition": "always",
        "binding_collection_name": "$item_collection",
        "binding_name": "(not (#pattern_cell_background_texture = 'textures/ui/cell_image_invert'))",
        "binding_name_override": "#visible"
      }
    ]
  }
}
