{
  "namespace": "horse_screen",
  "horse_panel@container_common.container_details": {
    "size": [176, 166],
    "$screen_controls": [
      {
        "horse_inventory_sprite@screen_content.image_element": {
          "uv_size": [176, 166],
          "texture": "assets/container/horse"
        }
      },

      {
        "cell_main@global.empty_panel": {
          "size": [18, 36],
          "anchor_from": "top_left",
          "anchor_to": "top_left",
          "offset": [7, 17],
          "controls": [
            {
              "slot_overlays@global.empty_stack": {
                "orientation": "vertical",
                "size": [18, "default"],
                "anchor_from": "top_middle",
                "anchor_to": "top_middle",
                "$bindings|default": [
                  { "binding_name": "$slot_visible_value_one" },
                  { "binding_name": "$slot_visible_value_two" },
                  {
                    "binding_type": "view",
                    "binding_condition": "always",
                    "source_property_name": "($slot_visible_value_one or $slot_visible_value_two)",
                    "target_property_name": "#visible"
                  }
                ],
                "controls": [
                  {
                    "saddle_slot@horse_screen.slot_collection": {
                      "$slot_icon": "assets/sprites/container/slot/saddle",
                      "$slot_visible_value_one": "#has_saddle_slot"
                    }
                  },
                  {
                    "horse_armor_slot@horse_screen.slot_collection": {
                      "$slot_icon": "assets/sprites/container/slot/horse_armor",
                      "$slot_visible_value_one": "#has_only_horse_armor_slot",
                      "$slot_visible_value_two": "#has_horse_armor_and_saddle_slot"
                    }
                  },
                  {
                    "llama_armor_slot@horse_screen.slot_collection": {
                      "$slot_icon": "assets/sprites/container/slot/llama_armor",
                      "$slot_visible_value_one": "#has_only_carpet_slot"
                    }
                  },

                  {
                    "nautilus_armor_slot@horse_screen.slot_collection": {
                      "$slot_icon": "assets/sprites/container/slot/nautilus_armor",
                      "$slot_visible_value_one": "#has_only_nautilus_armor_slot",
                      "$slot_visible_value_two": "#has_nautilus_armor_and_saddle_slot"
                    }
                  }
                ]
              }
            },
            {
              "equip_grid": {
                "type": "grid",
                "anchor_from": "top_middle",
                "anchor_to": "top_middle",
                "layer": 9,
                "collection_name": "horse_equip_items",
                "grid_item_template": "global.container_item",
                "grid_dimension_binding": "#equip_grid_dimensions",
                "$item_collection": "horse_equip_items",
                "bindings": [
                  {
                    "binding_name": "#equip_grid_dimensions"
                  }
                ]
              }
            }
          ]
        }
      },
      {
        "horse_renderer@global.empty_panel": {
          "offset": [25, 14],
          "size": [54, 54],
          "anchor_from": "top_left",
          "anchor_to": "top_left",
          "controls": [
            {
              "horse_float@global.empty_panel": {
                "size": ["30%", "30%"],
                "offset": [0, "30%"],
                "controls": [
                  {
                    "horse@global.custom_renderer": {
                      "$type": "live_horse_renderer",
                      "anchor_from": "center",
                      "anchor_to": "center",
                      "bindings": [
                        {
                          "binding_name": "#entity_id"
                        }
                      ]
                    }
                  }
                ]
              }
            }
          ]
        }
      },
      {
        "inventory@global.empty_panel": {
          "size": [97, 71],
          "anchor_to": "top_right",
          "anchor_from": "top_right",

          "$bindings|default": [],
          "$item_collection|default": "container_items",
          "controls": [
            {
              "inventory_grid": {
                "type": "grid",
                "anchor_to": "bottom_left",
                "anchor_from": "bottom_left",
                "collection_name": "$item_collection",
                "grid_item_template": "global.container_item",
                "grid_dimension_binding": "#inv_grid_dimensions",
                "$background_images": "horse_screen.slot_collection",
                "bindings": [{ "binding_name": "#inv_grid_dimensions" }]
              }
            }
          ],
          "bindings": [
            {
              "binding_name": "#is_chested",
              "binding_name_override": "#visible"
            }
          ]
        }
      },
      {
        "label_holding_stack@global.empty_stack": {
          "orientation": "vertical",
          "size": [176, 17],
          "anchor_to": "top_middle",
          "anchor_from": "top_middle",
          "controls": [
            { "filler_1@global.empty_panel": { "size": ["fill", 6] } },
            {
              "smithing_label@global.empty_panel": {
                "size": [176, 11],
                "controls": [
                  {
                    "sithing_label@global.empty_label": {
                      "anchor_to": "top_left",
                      "anchor_from": "top_left",
                      "layer": 5,
                      "offset": [7, -1],
                      "text": "$container_title",
                      "color": "$title_text_color"
                    }
                  }
                ]
              }
            }
          ]
        }
      },
      {
        "bottom@global.inventory_bottom_half_with_label": {
          "anchor_to": "bottom_middle",
          "anchor_from": "bottom_middle"
        }
      }
    ]
  },
  "slot_collection@screen_content.image_element": {
    "nineslice_size": 1,
    "texture": "assets/sprites/container/slot.png",
    "layer": 7,
    "size": [18, 18],
    "$slot_icon|default": "textures/ui",
    "$item_collection|default": "none",
    "$slot_visible_value_one|default": "#none",
    "$slot_visible_value_two|default": "#none",
    "controls": [
      {
        "saddle_slot@screen_content.image_element": {
          "texture": "$slot_icon",
          "allow_debug_missing_texture": false,
          "layer": 5,
          "size": [16, 16]
        }
      }
    ],
    "property_bag": {
      "#none": false
    },
    "bindings": "$bindings"
  }
}
