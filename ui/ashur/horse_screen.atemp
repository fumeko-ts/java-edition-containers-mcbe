{
  "namespace": "horse_screen",

  "horse_panel@container_common.container_details": {
    "size": [176, 166],
    "$screen_controls": [
      { "common_panel@screen_content.horse": {} },
      { "extensions@jc-extensions.mount_screen": {} },
      {
        "horse_renderer@global.empty_panel": {
          "offset": [25, 14],
          "size": [54, 54],
          "anchor_from": "top_left",
          "anchor_to": "top_left",
          "controls": [
            {
              "horse_float@global.empty_panel": {
                "size": ["30%", "30%"],
                "offset": [-1, "30%"],
                "controls": [
                  {
                    "horse@global.custom_renderer": {
                      "$type": "live_horse_renderer",
                      "anchor_from": "center",
                      "anchor_to": "center",
                      "layer": 7,
                      "bindings": [
                        {
                          "binding_name": "#entity_id"
                        }
                      ]
                    }
                  }
                ]
              }
            }
          ]
        }
      },
      {
        "inventory@global.empty_panel": {
          "size": [97, 71],
          "anchor_to": "top_right",
          "anchor_from": "top_right",
          "controls": [
            {
              "inventory_grid@global.empty_grid": {
                "anchor_to": "bottom_left",
                "anchor_from": "bottom_left",
                "$item_collection": "container_items",
                "collection_name": "$item_collection",
                "grid_item_template": "jc_container_item.container_item",
                "grid_dimension_binding": "#inv_grid_dimensions",
                "$background_images": "horse_screen.slot_collection",
                "bindings": [{ "binding_name": "#inv_grid_dimensions" }]
              }
            }
          ],
          "bindings": [
            {
              "binding_name": "#is_chested",
              "binding_name_override": "#visible"
            }
          ]
        }
      },
      {
        "input_contents_stack@global.empty_stack": {
          "size": [25, 71],
          "orientation": "vertical",
          "anchor_to": "top_left",
          "anchor_from": "top_left",
          "controls": [
            { "top_filler@global.empty_panel": { "size": [25, 17] } },
            {
              "input_and_underlay_container@global.empty_stack": {
                "orientation": "horizontal",
                "size": [25, 54],
                "controls": [
                  { "left_filler@global.empty_panel": { "size": [7, 54] } },
                  {
                    "input_grids_holder@global.empty_stack": {
                      "size": [18, 54],
                      "orientation": "vertical", // dynamic sizeing because its beter this way   probaly :)
                      "controls": [
                        {
                          "top_filler@global.empty_panel": {
                            "size": [18, "fill"],
                            "bindings": [
                              { "binding_name": "#has_only_carpet_slot", "binding_name_override": "#visible" }
                            ]
                          }
                        },
                        {
                          "equip_grid@global.empty_grid": {
                            "max_size": [18, 36],
                            "min_size": [18, 18],
                            "collection_name": "horse_equip_items",
                            "grid_item_template": "horse_screen.container_item",
                            "grid_dimension_binding": "#equip_grid_dimensions",
                            "bindings": [
                              {
                                "binding_name": "#equip_grid_dimensions"
                              }
                            ]
                          }
                        },
                        {
                          "bottom_expanding_filler@global.empty_panel": {
                            "size": [18, "fill"],
                            "bindings": [
                              { "binding_name": "#has_only_carpet_slot", "binding_name_override": "#visible" }
                            ]
                          }
                        },
                        {
                          "bottom_filler@global.empty_panel": {
                            "size": [18, 18],
                            "bindings": [
                              {
                                "binding_name": "(not #has_only_carpet_slot)",
                                "binding_name_override": "#visible"
                              }
                            ]
                          }
                        }
                      ]
                    }
                  }
                ]
              }
            }
          ]
        }
      },
      {
        "label_holding_stack@global.empty_stack": {
          "orientation": "vertical",
          "size": [176, 17],
          "anchor_to": "top_middle",
          "anchor_from": "top_middle",
          "controls": [
            { "filler_1@global.empty_panel": { "size": ["fill", 6] } },
            {
              "mount_title@global.empty_panel": {
                "size": [176, 11],
                "controls": [
                  {
                    "mount_label@global.empty_label": {
                      "anchor_to": "top_left",
                      "anchor_from": "top_left",
                      "layer": 5,
                      "offset": [7, -1],
                      "text": "$container_title",
                      "color": "$title_text_color"
                    }
                  }
                ]
              }
            }
          ]
        }
      },
      {
        "bottom@global.inventory_bottom_half_with_label": {
          "anchor_to": "bottom_middle",
          "anchor_from": "bottom_middle"
        }
      }
    ]
  },
  "container_item@global.empty_panel": {
    "size": [18, 18],
    "controls": [
      {
        "slot@jc_container_item.container_item": {
          "$item_collection": "horse_equip_items"
        }
      },
      {
        "slot_underlays@global.empty_panel": {
          "size": [18, 18],
          "controls": [
            {
              "saddle_slot@horse_screen.slot_icon_template": {
                "$slot_icon": "assets/sprites/container/slot/saddle",
                "$binding_name": "#has_saddle_slot",
                "$index": 0
              }
            },
            {
              "carpet_slot@horse_screen.slot_icon_template": {
                "$slot_icon": "assets/sprites/container/slot/llama_armor",
                "$binding_name": "#has_only_carpet_slot",
                "$index": 0
              }
            },
            {
              "horse_armor_slot@horse_screen.slot_icon_template": {
                "$slot_icon": "assets/sprites/container/slot/horse_armor",
                "$binding_name": "#has_horse_armor_and_saddle_slot",
                "$index": 1
              }
            },
            {
              "nautilus_armor_slot@horse_screen.slot_icon_template": {
                "$slot_icon": "assets/sprites/container/slot/nautilus_armor",
                "$binding_name": "#has_nautilus_armor_and_saddle_slot",
                "$index": 1
              }
            }
          ]
        }
      }
    ]
  },
  "slot_icon_template@screen_content.image_element": {
    "size": [18, 18],
    "$binding_name|default": "#has_saddle_slot",
    "$index|default": 0,
    "$slot_icon": "",
    "texture": "assets/sprites/container/slot.png",
    "layer": 3,
    "controls": [
      {
        "overlay@screen_content.image_element": {
          "layer": 4,
          "texture": "$slot_icon",
          "size": [16, 16],
          "anchor_from": "center",
          "anchor_to": "center",
          "bindings": [
            { "binding_name": "$binding_name" },
            {
              "binding_name": "#collection_index",
              "binding_type": "collection_details",
              "binding_collection_name": "horse_equip_items"
            },
            {
              "binding_name": "#item_id_aux",
              "binding_type": "collection",
              "binding_collection_name": "horse_equip_items"
            },
            {
              "binding_type": "view",
              "binding_condition": "always",
              "source_property_name": "(((#collection_index = $index) and $binding_name) and (#item_id_aux = -1))",
              "target_property_name": "#visible"
            }
          ]
        }
      }
    ]
  },
  "slot_collection@screen_content.image_element": {
    "texture": "assets/sprites/container/slot.png",
    "layer": 2,
    "size": [18, 18]
  }
}
