// https://github.com/fumeko-ts/java-edition-containers-mcbe#java-containers-license
// ------------------------------------------------------------------------- 
{
  "namespace": "tab_menu_desktop",
  "player_count_label": {
    "type": "panel",
    "size": [ "100%", 12 ],
    "layer": 200,
    "controls": [
      {
        "single_player_label": {
          "type": "label",
          "size": [ "100% - 9px", 10 ],
          "text": "\u00a7aonly me online",
          "anchor_from": "right_middle",
          "anchor_to": "right_middle",
          "layer": 200,
          "bindings": [
            {
              "binding_type": "collection_details",
              "binding_collection_name": "players_collection"
            },
            {
              "binding_type": "collection",
              "binding_collection_name": "players_collection",
              "binding_name": "#collection_index"
            },
            {
              "binding_type": "view",
              "source_property_name": "(#collection_index = 0)",
              "target_property_name": "#visible"
            }
          ]
        }
      },
      {
        "multi_player_label": {
          "type": "label",
          "size": [ "100% - 9px", 10 ],
          "text": "#output_base_text",
          "anchor_from": "right_middle",
          "anchor_to": "right_middle",
          "layer": 200,
          "bindings": [
            {
              "binding_type": "collection_details",
              "binding_collection_name": "players_collection"
            },
            {
              "binding_type": "collection",
              "binding_collection_name": "players_collection",
              "binding_name": "#collection_index"
            },
            {
              "binding_type": "view",
              "source_property_name": "(#collection_index + 1)",
              "target_property_name": "#count"
            },
            {
              "binding_type": "view",
              "source_property_name": "('\u00a7a' + #count + '\u00a77 Users online')",
              "target_property_name": "#output_base_text"
            },
            {
              "binding_type": "view",
              "source_property_name": "(#collection_index > 0)",
              "target_property_name": "#visible"
            }
          ]
        }
      }
    ]
  },
  "background": {
    "type": "image",
    "texture": "textures/ui/Black",
    "alpha": 0.4,
    "layer": 1
  },
  "tab_list": {
    "type": "button",
    "pressed_control": "tab_list_content",
    "button_mappings": [
      {
        "from_button_id": "button.scoreboard",
        "to_button_id": "button.scoreboard",
        "mapping_type": "global",
        "consume_event": false
      }
    ],
    "controls": [
      {
        "tab_list_content": {
          "type": "image",
          "anchor_from": "top_middle",
          "anchor_to": "top_middle",
          "offset": [ 0, 10 ],
          "size": [ 440, 700 ],
          "contained": true,
          "clips_children": true,
          "controls": [
            {
              "buffer@$ep": {
                "offset": [ 0, 10 ],
                "anchor_from": "top_middle",
                "anchor_to": "top_middle",
                "size": [ "100%", "100%c" ],
                "controls": [ { "tab_list_grid@tab_menu_desktop.tab_list_grid": {  } } ]
              }
            }
          ]
        }
      }
    ]
  },
  "tab_list_grid": {
    "type": "grid",
    "size": [ "25%", "default" ],
    "anchor_from": "top_left",
    "anchor_to": "top_left",
    "grid_item_template": "tab_menu_desktop.tab_list_grid_item",
    "collection_name": "players_collection",
    "grid_dimension_binding": "#players_grid_dimension",
    "bindings": [ { "binding_name": "#players_grid_dimension" } ]
  },
  "tab_list_grid_item": {
    "type": "panel",
    "size": [ "25%", 14 ],
    "layer": 200,
    "controls": [
      {
        "background": {
          "type": "image",
          "anchor_from": "left_middle",
          "anchor_to": "left_middle",
          "offset": [ 0.5, 0 ],
          "size": [ "400% + 16px", "100% - 1px" ],
          "layer": 2,
          "nineslice_size": [ 1, 1, 1, 1 ],
          "texture": "textures/atemp/ui/player_list_bg.png",
          "alpha": 0.4
        }
      },
      {
        "main": {
          "type": "stack_panel",
          "orientation": "horizontal",
          "anchor_from": "left_middle",
          "anchor_to": "left_middle",
          "size": [ "25%", "100% - 2px" ],
          "layer": 3,
          "bindings": [
            {
              "binding_name": "#collection_index",
              "binding_type": "collection",
              "binding_collection_name": "players_collection"
            }
          ],
          "controls": [
            { "padding": { "type": "panel", "size": [ 2, 0 ] } },
            {
              "player_picture": {
                "type": "panel",
                "layer": 11,
                "size": [ 12, 12 ],
                "controls": [
                  {
                    "player_gamer_pic@pause.player_gamer_pic": { "size": [ 10, 10 ], "controls": [  ] }
                  },
                  {
                    "player_local_icon@pause.player_local_icon": { "size": [ 10, 10 ] }
                  }
                ]
              }
            },
            {
              "player_gamertag": {
                "type": "panel",
                "size": [ "fill", 10 ],
                "controls": [
                  {
                    "gamertag_text": {
                      "type": "label",
                      "text": "#gamertag",
                      "anchor_from": "left_middle",
                      "anchor_to": "left_middle",
                      "size": [ "default", "default" ],
                      "font_type": "default",
                      "layer": 11,
                      "bindings": [
                        {
                          "binding_name": "#gamertag",
                          "binding_type": "collection",
                          "binding_collection_name": "players_collection"
                        }
                      ]
                    }
                  }
                ]
              }
            }
          ]
        }
      }
    ]
  }
}