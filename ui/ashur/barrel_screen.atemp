{
  "namespace": "barrel_screen",
  "chest_grid_item@common.container_item": {"$item_collection_name": "container_items"},
  "barrel@container_common.container_details": {
    "type": "panel",
    "size": [176, 166],
    "anchor_to": "center",
    "anchor_from": "center",
    "$screen_controls": [
      {
        "barrel_label": {
          "type": "label",
          "offset": [-63.4, 5],
          "anchor_from": "top_middle",
          "anchor_to": "top_middle",
          "text": "$container_title",
          "$container_title": "Barrel",
          "color": "$title_text_color",
          "layer": 12
        }
      },
      {
        "barrel_chest_panel_top_half": {
          "type": "panel",
          "size": ["100%", "50%"],
          "offset": [0, 8],
          "anchor_to": "top_left",
          "anchor_from": "top_left",
          "controls": [
            {
              "barrel_chest_grid": {
                "type": "grid",
                "size": [162, 54],
                "offset": [7, 9],
                "anchor_from": "top_left",
                "anchor_to": "top_left",
                "grid_dimensions": [9, 3],
                "grid_item_template": "barrel_screen.chest_grid_item",
                "collection_name": "container_items"
              }
            }
          ]
        }
      },
      {"0@screen_content.somali": {"$barrel_screen": true} },
      {"1@common.inventory_panel_bottom_half_with_label": { "offset": [0, -3] }},
      {"2@common.hotbar_grid_template": { "offset": [0, -7] }}
    ]
  }
}
