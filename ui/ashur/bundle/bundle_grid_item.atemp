{
  "namespace": "bundle_grid_item",
  "bundle_slot_item@global.empty_panel": {
    "size": [24, 24],
    "layer": 12,
    "controls": [
      {
        "bundle_item_slot@bundle_grid_item.bundle_tooltip_slot_button": {
          "size": [24, 24],
          "bindings": [
            {
              "binding_name": "#show_bundle_item_slot",
              "binding_name_override": "#visible",
              "binding_type": "collection",
              "binding_collection_name": "$item_collection_name"
            }
          ],
          "controls": [
            {
              "item_renderer_holder@global.empty_panel": {
                "size": [16, 16],
                "anchor_from": "center",
                "anchor_to": "center",
                "layer": 8,
                "controls": [
                  {
                    "item_renderer@common.item_renderer": {}
                  }
                ]
              }
            },
            {
              "slot_bg": {
                "type": "image",
                "texture": "assets/sprites/container/bundle/slot_background.png",
                "size": [24, 24],
                "layer": 1
              }
            },
            {
              "bundle_cell_image@global.empty_panel": {
                "controls": [
                  {
                    "highlight_slot": {
                      "type": "image",
                      "texture": "assets/sprites/container/bundle/slot_highlight_back.png",
                      "size": [24, 24],
                      "layer": 3
                    }
                  },

                  {
                    "highlight_slot_overlay": {
                      "type": "image",
                      "texture": "assets/sprites/container/bundle/slot_highlight_front.png",
                      "size": [24, 24],
                      "layer": 14
                    }
                  },
                  {
                    "hover_text@common.hover_text": {
                      "layer": 90,
                      "bindings": [
                        {
                          "binding_name": "#hover_text",
                          "binding_name_override": "#hover_remove_text",
                          "binding_condition": "always",
                          "binding_type": "collection",
                          "binding_collection_name": "$item_collection_name"
                        },
                        {
                          "binding_type": "view",
                          "binding_condition": "always_when_visible",
                          "source_property_name": "(#hover_remove_text - '\n§9§9sr1.atemp§r'')",
                          "target_property_name": "#hover_text"
                        }
                      ]
                    }
                  }
                ],
                "bindings": [
                  {
                    "binding_name": "#using_touch"
                  },
                  {
                    "binding_name": "#is_selected_bundle_item_slot",
                    "binding_type": "collection",
                    "binding_collection_name": "$item_collection_name"
                  },
                  {
                    "binding_type": "view",
                    "binding_condition": "always",
                    "source_property_name": "((not #using_touch) and #is_selected_bundle_item_slot)",
                    "target_property_name": "#visible"
                  }
                ]
              }
            }
          ]
        }
      },
      {
        "bundle_overflow_text@global.empty_label": {
          "size": ["default", 10],
          "layer": 2,
          "text": "#more_hidden_items_text",
          "shadow": true,
          "bindings": [
            {
              "binding_name": "#is_hidden_items_label",
              "binding_name_override": "#visible",
              "binding_type": "collection",
              "binding_collection_name": "$item_collection_name"
            },
            {
              "binding_name": "#more_hidden_items_text",
              "binding_condition": "visible"
            }
          ]
        }
      }
    ]
  },
  "bundle_tooltip_slot_button@common.container_slot_button_prototype": {
    "$pressed_button_name": "button.tapped_bundle_item_icon",
    "size": ["100%", "100%"],
    "sound_name": "random.click",
    "sound_volume": 1.0,
    "sound_pitch": 1.0,
    "button_mappings": [
      {
        "from_button_id": "button.menu_cancel",
        "to_button_id": "button.hide_bundle_tooltip",
        "mapping_type": "pressed"
      },
      {
        "from_button_id": "button.menu_select",
        "to_button_id": "$pressed_button_name",
        "mapping_type": "pressed"
      },
      {
        "from_button_id": "button.menu_ok",
        "to_button_id": "$pressed_button_name",
        "mapping_type": "pressed"
      },
      {
        "from_button_id": "button.controller_back",
        "to_button_id": "$pressed_button_name",
        "mapping_type": "pressed",
        "ignored": "(not $is_ps4)"
      },
      {
        "from_button_id": "button.menu_secondary_select",
        "to_button_id": "$pressed_button_name",
        "mapping_type": "pressed"
      },
      {
        "from_button_id": "button.controller_select",
        "to_button_id": "$pressed_button_name",
        "mapping_type": "pressed"
      },
      {
        "from_button_id": "button.menu_auto_place",
        "to_button_id": "$pressed_button_name",
        "mapping_type": "pressed"
      },
      {
        "from_button_id": "button.controller_secondary_select",
        "to_button_id": "$pressed_button_name",
        "mapping_type": "pressed"
      },
      {
        "from_button_id": "button.menu_inventory_drop",
        "to_button_id": "$pressed_button_name",
        "mapping_type": "pressed"
      },
      {
        "from_button_id": "button.menu_inventory_drop_all",
        "to_button_id": "$pressed_button_name",
        "mapping_type": "pressed"
      }
    ]
  }
}
