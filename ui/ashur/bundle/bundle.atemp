{
  "namespace": "bundle",
  "bundle_tooltip@global.empty_stack": {
    "size": ["100%cm", "100%cm"],
    "min_size": [86, 58],
    "$item_collection_name|default": "bundle_items",
    "layer": 50,
    "offset": [0, -10],
    "orientation": "horizontal",
    "controls": [
      {
        "background@global.empty_image": {
          "texture": "textures/ui/purpleBorder",
          "nineslice_size": 2,
          "layer": 1,
          "size": ["100%c + 24px", "100%c"],
          "controls": [
            {
              "bundle_stack@global.empty_stack": {
                "size": ["100%cm", "100%c"],
                "anchor_from": "center",
                "anchor_to": "center",
                "orientation": "vertical",
                "controls": [
                  {
                    "filler2@global.empty_panel": {
                      "size": [1, 6]
                    }
                  },
                  {
                    "label@global.empty_panel": {
                      "size": ["100%c", "100%c"],
                      "controls": [
                        {
                          "bundle_label@global.empty_label": {
                            "layer": 4,
                            "anchor_from": "top_left",
                            "anchor_to": "top_left",
                            "shadow": true,
                            "offset": [-6, -1],
                            "text": "#bundle_name",
                            "min_size": ["default", "default"],
                            "bindings": [
                              {
                                "binding_name": "#bundle_name",
                                "binding_condition": "always"
                              }
                            ]
                          }
                        }
                      ]
                    }
                  },
                  {
                    "filler4@global.empty_panel": {
                      "size": [1, 2]
                    }
                  },
                  {
                    "grid_holder@global.empty_panel": {
                      "size": [96, "100%c"],
                      "controls": [
                        {
                          "spacer@global.empty_panel": {
                            "size": [96, "100%c + 4px"],
                            "controls": [
                              {
                                "empty_bundle_label@global.empty_label": {
                                  "layer": 3,
                                  "color": [0.659, 0.659, 0.659],
                                  "text": "item.bundle.empty.description",
                                  "anchor_from": "top_left",
                                  "anchor_to": "top_left",
                                  "shadow": true,
                                  "size": [96, "default"]
                                }
                              }
                            ],
                            "bindings": [
                              {
                                "binding_name": "#is_selected_bundle_empty",
                                "binding_name_override": "#visible"
                              }
                            ]
                          }
                        },
                        {
                          "item_grid": {
                            "type": "grid",
                            "layer": 3,
                            "anchor_from": "top_left",
                            "anchor_to": "top_left",
                            "grid_dimension_binding": "#bundle_tooltip_grid_dimensions",
                            "collection_name": "$item_collection_name",
                            "grid_item_template": "bundle_grid_item.bundle_slot_item",
                            "bindings": [
                              {
                                "binding_name": "#bundle_tooltip_grid_dimensions",
                                "binding_condition": "always_when_visible"
                              }
                            ]
                          }
                        }
                      ]
                    }
                  },
                  {
                    "filler@global.empty_panel": {
                      "size": [1, 4]
                    }
                  },
                  {
                    "weight_bar@global.empty_panel": {
                      "layer": 4,
                      "size": [96, 13],
                      "controls": [
                        {
                          "empty_message@global.empty_label": {
                            "color": "$sub_header_text_color",
                            "layer": 5,
                            "text": "item.bundle.empty",
                            "offset": [0, 1],
                            "shadow": true,
                            "bindings": [
                              {
                                "binding_name": "#is_selected_bundle_empty",
                                "binding_name_override": "#visible"
                              }
                            ]
                          }
                        },
                        {
                          "weight_bar_fill@global.empty_image": {
                            "layer": 5,
                            "nineslice_size": 2,
                            "anchor_from": "center",
                            "anchor_to": "center",
                            "texture": "assets/sprites/container/bundle/bundle_progress",
                            "clip_direction": "left",
                            "clip_pixelperfect": false,
                            "bindings": [
                              {
                                "binding_name": "#bundle_weight_bar_ratio",
                                "binding_name_override": "#clip_ratio",
                                "binding_condition": "always_when_visible"
                              },
                              {
                                "binding_name": "(not #is_selected_bundle_full)",
                                "binding_name_override": "#visible"
                              }
                            ]
                          }
                        },
                        {
                          "weight_bar_full@global.empty_image": {
                            "layer": 5,
                            "nineslice_size": 2,
                            "anchor_from": "center",
                            "anchor_to": "center",
                            "texture": "assets/sprites/container/bundle/bundle_full_progress",
                            "controls": [
                              {
                                "full_label@global.empty_label": {
                                  "color": "$sub_header_text_color",
                                  "layer": 2,
                                  "offset": [0, 1],
                                  "text": "item.bundle.full",
                                  "shadow": true
                                }
                              }
                            ],
                            "bindings": [
                              {
                                "binding_name": "#is_selected_bundle_full",
                                "binding_name_override": "#visible"
                              }
                            ]
                          }
                        },
                        {
                          "weight_bar_border@global.empty_image": {
                            "texture": "assets/sprites/container/bundle/bundle_progressbar_border.png",
                            "nineslice_size": 2,
                            "size": [96, 13],
                            "layer": 5
                          }
                        }
                      ]
                    }
                  },
                  {
                    "filler1@global.empty_panel": {
                      "size": [1, 12]
                    }
                  }
                ]
              }
            }
          ]
        }
      },

      {
        "exit@global.empty_panel": {
          "size": [24, 24],
          "controls": [
            {
              "close_button@common.close_button": {
                "$pressed_button_name": "button.hide_bundle_tooltip",
                "size": [18, 18],
                "anchor_from": "top_right",
                "anchor_to": "top_right",
                "layer": 2,
                "button_mappings": [
                  {
                    "to_button_id": "$pressed_button_name",
                    "mapping_type": "pressed"
                  },
                  {
                    "from_button_id": "button.menu_ok",
                    "to_button_id": "$pressed_button_name",
                    "mapping_type": "focused"
                  },
                  {
                    "from_button_id": "button.menu_select",
                    "to_button_id": "$pressed_button_name",
                    "mapping_type": "pressed"
                  },
                  {
                    "from_button_id": "button.menu_up",
                    "to_button_id": "$pressed_button_name",
                    "mapping_type": "global"
                  }
                ],
                "controls": [
                  {
                    "bg@global.empty_image": {
                      "size": [18, 18],
                      "texture": "textures/ui/white",
                      "alpha": 0.6,
                      "color": "black",
                      "nineslice_size": 2
                    }
                  },
                  {
                    "default@common.close_button_panel": {
                      "$close_button_texture": "textures/ui/close_button_default_light"
                    }
                  },
                  {
                    "hover@common.close_button_panel": {
                      "$close_button_texture": "textures/ui/close_button_hover_light"
                    }
                  },
                  {
                    "pressed@common.close_button_panel": {
                      "$close_button_texture": "textures/ui/close_button_pressed_light"
                    }
                  }
                ]
              }
            }
          ],
          "bindings": [
            {
              "binding_name": "#show_bundle_tooltip_pocket",
              "binding_name_override": "#visible"
            }
          ]
        }
      }
    ]
  }
}
