{
  "namespace": "small_chest_screen",
  "small_chest@container_common.container_details": {
    "size": [176, 167],
    "$screen_controls": [
      { "common_panel@screen_content.small_chest": {} },
      { "extensions@jc-extensions.small_chest_screen": {} },
      {
        "small_chest_top_section@global.empty_stack": {
          "orientation": "vertical",
          "size": [176, 71],
          "anchor_from": "top_middle",
          "anchor_to": "top_middle",
          "controls": [
            { "filler_0@global.empty_panel": { "size": ["fill", 5] } },
            {
              "container_title_stack@global.empty_stack": {
                "orientation": "horizontal",
                "size": [176, 10],
                "controls": [
                  { "filler_1@global.empty_panel": { "size": [8, "fill"] } },
                  {
                    "small_chest_label@global.empty_label": {
                      "size": [154, 10],
                      "localize": true,
                      "text_alignment": "left",
                      "text": "$container_title",
                      "color": "$container_title_color",
                      "enable_profanity_filter": true
                    }
                  },
                  { "filler_2@global.empty_panel": { "size": [14, "fill"] } }
                ]
              }
            },
            { "filler_3@global.empty_panel": { "size": ["fill", 2] } },
            {
              "container_grid_stack@global.empty_stack": {
                "orientation": "horizontal",
                "size": [176, 54],
                "controls": [
                  { "filler_4@global.empty_panel": { "size": [7, "fill"] } },
                  {
                    "small_chest_grid@global.empty_grid": {
                      "size": [162, 54],
                      "grid_dimensions": [9, 3],
                      "grid_item_template": "jc_container_item.container_item",
                      "$item_collection": "container_items",
                      "collection_name": "$item_collection"
                    }
                  },
                  { "filler_5@global.empty_panel": { "size": [7, "fill"] } }
                ]
              }
            }
          ]
        }
      },
      {
        "inventory_section@container_common.inventory_section_with_label": {
          "$inventory_label_control_offset": [1, 0]
        }
      }
    ]
  }
}
