{
  "namespace": "small_chest_screen",
  "chest_grid_item@common.container_item": {"$item_collection_name": "container_items"},
  "small_chest@container_common.container_details": {
    "type": "panel",
    "layer": 5,
    "size": [ 176, 166 ],
    "$screen_controls": [
      {
        "small_chest_label": {
          "type": "label",
          "offset": [ -65.8, 5 ],
          "anchor_from": "top_middle",
          "anchor_to": "top_middle",
          "text": "$container_title",
          "$container_title": "Chest",
          "color": "$title_text_color",
          "layer": 12
        }
      },
      {"common_panel@screen_content.container_base": {"$barrel_screen": true}},
      {
        "small_chest_panel_top_half": {
          "type": "panel",
          "size": [ "100%", "50%" ],
          "offset": [ 0, 8 ],
          "anchor_to": "top_left",
          "anchor_from": "top_left",
          "controls": [
            {
              "small_chest_grid": {
                "type": "grid",
                "size": [ 162, 54 ],
                "offset": [ 7, 9 ],
                "anchor_from": "top_left",
                "anchor_to": "top_left",
                "grid_dimensions": [ 9, 3 ],
                "grid_item_template": "small_chest_screen.chest_grid_item",
                "collection_name": "container_items"
              }
            }
          ]
        }
      },
      {
        "bottom@crafting_screen.inventory_bottom_half_with_label": {"anchor_to": "bottom_middle", "anchor_from": "bottom_middle"}
      }
    ]
  }
}