{
  "namespace": "smithing_table_screen",
  "smithing_table_panel@container_common.container_details": {
    "size": [176, 166],
    "$screen_controls": [
      { "common_panel@screen_content.smithing": {} },
      { "extensions@jc-extensions.smithing_table_screen": {} },
      {
        "result_item_preview_inner@global.empty_panel": {
          "size": [30, 24],
          "anchor_to": "right_middle",
          "anchor_from": "right_middle",
          "offset": [-17, -40],
          "controls": [
            {
              "smithing_preview_renderer@global.custom_renderer": {
                "$type": "equipment_preview_renderer",
                "layer": 8,
                "rotation_x": 30,
                "rotation_y": -30,
                "bindings": [
                  {
                    "binding_name": "#item_id_aux",
                    "binding_type": "collection",
                    "binding_collection_name": "smithing_table_result_items"
                  },
                  {
                    "binding_name": "#item_custom_color",
                    "binding_type": "collection",
                    "binding_collection_name": "smithing_table_result_items"
                  },
                  {
                    "binding_name": "#armor_trim_pattern",
                    "binding_type": "collection",
                    "binding_collection_name": "smithing_table_result_items"
                  },
                  {
                    "binding_name": "#armor_trim_material",
                    "binding_type": "collection",
                    "binding_collection_name": "smithing_table_result_items"
                  }
                ]
              }
            }
          ]
        }
      },
      {
        "smithing_content@global.empty_stack": {
          "size": [176, 65],
          "orientation": "vertical",
          "anchor_to": "top_left",
          "anchor_from": "top_left",
          "controls": [
            { "filler_1@global.empty_panel": { "size": ["fill", 15] } },
            {
              "label_holding_stack@global.empty_stack": {
                "orientation": "horizontal",
                "size": [176, 12],
                "controls": [
                  { "filler_1@global.empty_panel": { "size": [44, "fill"] } },
                  {
                    "smithing_label@global.empty_panel": {
                      "size": [132, "fill"],
                      "controls": [
                        {
                          "smithing_label@global.empty_label": {
                            "anchor_to": "top_left",
                            "anchor_from": "top_left",
                            "size": ["default", 10],
                            "offset": [0, -1],
                            "layer": 5,
                            "text": "atemp.container.upgrade",
                            "color": "$title_text_color"
                          }
                        }
                      ]
                    }
                  }
                ]
              }
            },
            { "filler_2@global.empty_panel": { "size": ["fill", 20] } },
            {
              "cell_inputs_holding_stack@global.empty_stack": {
                "orientation": "horizontal",
                "size": [176, 18],
                "controls": [
                  { "cell_filler_1@global.empty_panel": { "size": [7, 18] } },
                  {
                    "template_slot@jc_container_item.container_item": {
                      "$cell_overlay_ref": "smithing_table_screen.slot_overlay",
                      "$item_collection": "smithing_table_template_items"
                    }
                  },
                  {
                    "upgrade_slot@jc_container_item.container_item": {
                      "$cell_overlay_ref": "smithing_table_screen.slot_overlay",
                      "$item_collection": "smithing_table_input_items"
                    }
                  },
                  {
                    "material_slot@jc_container_item.container_item": {
                      "$cell_overlay_ref": "smithing_table_screen.slot_overlay",
                      "$item_collection": "smithing_table_material_items"
                    }
                  },
                  { "cell_filler_2@global.empty_panel": { "size": [36, 18] } },
                  {
                    "result_item_slot@jc_container_item.container_item": {
                      "$item_collection": "smithing_table_result_items",
                      "$button_ref": "button_mappings.smithing_table_output_slot_button"
                    }
                  }
                ]
              }
            }
          ]
        }
      },
      {
        "bottom@global.inventory_bottom_half_with_label": {
          "anchor_to": "bottom_middle",
          "anchor_from": "bottom_middle"
        }
      },
      {
        "craft_not_possible@global.empty_panel": {
          "size": [93, 67],
          "anchor_from": "top_left",
          "anchor_to": "top_left",
          "controls": [
            {
              "arrow_holder@global.empty_panel": {
                "size": [28, 21],
                "anchor_to": "bottom_right",
                "anchor_from": "bottom_right",
                "controls": [
                  {
                    "cross_out_icon_image@screen_content.image_element": {
                      "texture": "assets/sprites/container/smithing/error",
                      "size": [28, 21],
                      "layer": 5,
                      "bindings": [{ "binding_name": "#cross_out_icon", "binding_name_override": "#visible" }]
                    }
                  }
                ]
              }
            }
          ]
        }
      }
    ]
  },

  "slot_overlay@global.empty_panel": {
    "layer": 1,
    "size": [16, 16],
    "controls": [
      {
        "template_slot@global.empty_panel": {
          "ignored": "(not ($item_collection = smithing_table_template_items))",
          "controls": [
            {
              "1@smithing_table_screen.slot_sprite_renderer": {
                "$slot_spritesheet": "textures/ui/ashur/smithing_icons/smithing_template_slot",
                "bindings": [{ "binding_name": "#show_input_overlay_templates", "binding_name_override": "#visible" }]
              }
            }
          ]
        }
      },
      {
        "equipment_slot@global.empty_panel": {
          "ignored": "(not ($item_collection = smithing_table_input_items))",
          "controls": [
            {
              "1@smithing_table_screen.slot_sprite_renderer": {
                "$slot_spritesheet": "textures/ui/ashur/smithing_icons/only_armor",
                "bindings": [{ "binding_name": "#show_input_overlay_armors", "binding_name_override": "#visible" }]
              }
            },
            {
              "2@smithing_table_screen.slot_sprite_renderer": {
                "$slot_spritesheet": "textures/ui/ashur/smithing_icons/smithing_equipment_slot",
                "bindings": [
                  { "binding_name": "#show_input_overlay_armors_and_tools", "binding_name_override": "#visible" }
                ]
              }
            }
          ]
        }
      },
      {
        "material_slot@global.empty_panel": {
          "ignored": "(not ($item_collection = smithing_table_material_items))",
          "controls": [
            {
              "1@smithing_table_screen.slot_sprite_renderer": {
                "$slot_spritesheet": "textures/ui/ashur/smithing_icons/smithing_material_slot",
                "bindings": [{ "binding_name": "#show_material_overlay_all", "binding_name_override": "#visible" }]
              }
            },
            {
              "2@smithing_table_screen.slot_sprite_renderer": {
                "$slot_spritesheet": "textures/ui/ashur/smithing_icons/netherite",
                "bindings": [{ "binding_name": "#show_material_overlay_ingot", "binding_name_override": "#visible" }]
              }
            }
          ]
        }
      }
    ]
  },
  "slot_sprite_renderer@global.empty_image": {
    "layer": 1,
    "size": [16, 16],
    "texture": "$slot_spritesheet",
    "disable_anim_fast_forward": true,
    "uv": { "anim_type": "aseprite_flip_book", "initial_uv": [0, 0] },
    "uv_size": [16, 16]
  }
}
