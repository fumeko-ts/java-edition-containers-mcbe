{
  "namespace": "enchanting_screen",
  "enchanting_panel@container_common.container_details": {
    "size": [176, 166],
    "$screen_controls": [
      { "common_panel@screen_content.enchanting": {} },
      { "extensions@jc-extensions.enchanting_screen": {} },
      {
        "top_half@global.empty_stack": {
          "orientation": "vertical",
          "size": [117, 71],
          "layer": 2,
          "anchor_to": "top_right",
          "anchor_from": "top_right",
          "controls": [
            { "top_filler@global.empty_panel": { "size": ["fill", 14] } },
            {
              "buttons_row@global.empty_stack": {
                "orientation": "horizontal",
                "size": [117, 57],
                "controls": [
                  { "left_filler@global.empty_panel": { "size": [1, "fill"] } },
                  {
                    "enchantments_button_grid": {
                      "type": "grid",
                      "layer": 6,
                      "size": [108, 57],
                      "collection_name": "#enchant_buttons",
                      "$collection_index|default": 0,
                      "grid_dimensions": [1, 3],
                      "controls": [
                        {
                          "button1@enchant_button.button": {
                            "grid_position": [0, 0],
                            "$collection_index": 1
                          }
                        },
                        {
                          "button2@enchant_button.button": {
                            "grid_position": [0, 1],
                            "$collection_index": 2
                          }
                        },
                        {
                          "button3@enchant_button.button": {
                            "grid_position": [0, 2],
                            "$collection_index": 3
                          }
                        }
                      ]
                    }
                  },
                  { "right_filler@global.empty_panel": { "size": [8, "fill"] } }
                ]
              }
            }
          ]
        }
      },
      {
        "lapis_and_book_stack@global.empty_stack": {
          "orientation": "vertical",
          "size": [90, 64],
          "anchor_to": "top_left",
          "anchor_from": "top_left",
          "controls": [
            { "filler_1@global.empty_panel": { "size": ["fill", 6] } },
            {
              "label_holder@global.empty_panel": {
                "size": ["fill", 10],
                "controls": [
                  {
                    "enchant_label@global.empty_label": {
                      "offset": [8, -1],
                      "anchor_to": "top_left",
                      "anchor_from": "top_left",
                      "layer": 5,
                      "text": "atemp.container.enchant",
                      "color": "$title_text_color"
                    }
                  }
                ]
              }
            },
            { "filler_1@global.empty_panel": { "size": ["fill", 30] } },
            {
              "enchanting_input_grids@global.empty_stack": {
                "orientation": "horizontal",
                "size": [52, 18],
                "controls": [
                  { "filler_1@global.empty_panel": { "size": [14, "fill"] } },
                  { "item_input@jc_container_item.container_item": { "$item_collection": "enchanting_input_items" } },
                  { "filler_2@global.empty_panel": { "size": [2, "fill"] } },
                  {
                    "lapis_input@jc_container_item.container_item": {
                      "$item_collection": "enchanting_lapis_items",
                      "$cell_overlay_ref": "screen_content.enchanting_lapis"
                    }
                  }
                ]
              }
            }
          ]
        }
      },
      {
        "enchanting_book@global.empty_stack": {
          "orientation": "vertical",
          "size": [53, 46],
          "anchor_to": "top_left",
          "anchor_from": "top_left",
          "controls": [
            { "filler_1@global.empty_panel": { "size": ["fill", 6] } },
            {
              "second_stack@global.empty_stack": {
                "orientation": "horizontal",
                "size": [53, 40],
                "controls": [
                  { "filler_2@global.empty_panel": { "size": [13, "fill"] } },
                  {
                    "enchanting_book_holder@global.empty_panel": {
                      "size": [40, 40],
                      "controls": [
                        {
                          "enchanting_book@global.custom_renderer": {
                            "$type": "enchanting_book_renderer",
                            "layer": 13,
                            "offset": [0, 5],
                            "anchor_to": "center",
                            "anchor_from": "center",
                            "bindings": [{ "binding_name": "#open", "binding_type": "global" }]
                          }
                        }
                      ]
                    }
                  }
                ]
              }
            }
          ]
        }
      },
      {
        "bottom@global.inventory_bottom_half_with_label": {
          "anchor_to": "bottom_middle",
          "anchor_from": "bottom_middle"
        }
      }
    ]
  }
}
