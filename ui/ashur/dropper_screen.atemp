{
  "namespace": "dropper_screen",
  "dropper_panel@container_common.container_details": {
    "type": "panel",
    "size": [ 176, 166 ],
    "$screen_controls": [
      {"common_panel@screen_content.container_base": {"$dropper_screen": true}},
      {
        "dropper_top_half@global.empty_stack": {
          "orientation": "vertical",
          "size": [ 176, 70 ],
          "anchor_to": "top_middle",
          "anchor_from": "top_middle",
          "controls": [
            {"filler_1@global.empty_panel": {"size": [ "fill", 6 ]}},
            {
              "dropper_main_content@global.empty_stack": {
                "orientation": "horizontal",
                "size": [ 176, 64 ],
                "controls": [
                  {"filler_2@global.empty_panel": {"size": [ 61, "fill" ]}},
                  {
                    "label_and_grid_holder@global.empty_stack": {
                      "orientation": "vertical",
                      "size": [ 54, 64 ],
                      "controls": [
                        {
                          "dropper_label_holder": {
                            "type": "input_panel",
                            "contained": true,
                            "size": [ 54, 10 ],
                            "controls": [
                              {
                                "dropper_label@global.empty_label": {
                                  "anchor_to": "top_left",
                                  "anchor_from": "top_left",
                                  "offset": [ 2, 0 ],
                                  "text": "atemp.container.dropper",
                                  "color": "$title_text_color"
                                }
                              }
                            ]
                          }
                        },
                        {
                          "dropper_item_input": {
                            "type": "grid",
                            "size": [ 54, 54 ],
                            "grid_dimensions": [ 3, 3 ],
                            "collection_name": "container_items",
                            "grid_item_template": "common.container_item",
                            "$item_collection_name": "container_items"
                          }
                        }
                      ]
                    }
                  },
                  {"filler_3@global.empty_panel": {"size": [ 61, "fill" ]}}
                ]
              }
            }
          ]
        }
      },
      {
        "bottom@crafting_screen.inventory_bottom_half_with_label": {"anchor_to": "bottom_middle", "anchor_from": "bottom_middle"}
      }
    ]
  }
}