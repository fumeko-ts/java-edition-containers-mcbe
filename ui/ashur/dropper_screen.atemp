{
  "namespace": "dropper_screen",
  "dropper_panel@container_common.container_details": {
    "type": "panel",
    "size": [ 176, 166 ],
    "$screen_controls": [
      {"common_panel@screen_content.container_base": {"$dispenser_screen": true}},
      {
        "dropper_label": {
          "type": "label",
          "offset": [ 0, 5 ],
          "anchor_from": "top_middle",
          "anchor_to": "top_middle",
          "text": "$container_title",
          "$container_title": "Dropper",
          "color": "$title_text_color",
          "layer": 2
        }
      },
      {
        "redstone_panel_top_half": {
          "type": "panel",
          "size": [ "100%", "50% - 12px" ],
          "offset": [ 0, 7.6 ],
          "anchor_to": "top_left",
          "anchor_from": "top_left",
          "controls": [
            {
              "redstone_input_grid": {
                "type": "grid",
                "anchor_from": "center",
                "anchor_to": "center",
                "offset": [ 0, 0 ],
                "grid_dimensions": [ 3, 3 ],
                "collection_name": "container_items",
                "grid_item_template": "common.container_item",
                "$item_collection_name": "container_items"
              }
            }
          ]
        }
      },
      {
        "bottom@crafting_screen.inventory_bottom_half_with_label": {"anchor_to": "bottom_middle", "anchor_from": "bottom_middle"}
      }
    ]
  }
}