{
   "namespace": "furnace_recipe",
   "burn_base_panel": {
     "$misc_blocks_offset|default": [150, 25],
     "$misc_raw_offset|default": [150, 50],
     "$misc_terracotta_offset|default": [25, 0],
     "$misc_stone_offset|default": [0, 0],
     "$misc_deepslate_offset|default": [-25, 0],
     "$misc_ores_offset|default": [-50, 0],
     "type": "panel",
     "anchor_from": "center",
     "anchor_to": "center",
     "$is_burn_tab|default": false,
     "$is_smelt_tab|default": false,
     "$is_misc_tab|default": false,
     "variables": [
       { "requires": "($is_misc_tab|default = true)", "$misc_blocks_offset|default": [150, 175], "$misc_raw_offset|default": [150, 200], "$misc_terracotta_offset|default": [25, 150], "$misc_stone_offset|default": [0, 150], "$misc_deepslate_offset|default": [-25, 150], "$misc_ores_offset|default": [-50, 150], "$is_burn_tab|default": true, "$is_smelt_tab|default": true }
     ],
     "controls": [
       { "ores@ores_panel": {"ignored": "(not ($is_smelt_tab = true)"} }                                   ,
       { "deepslate@deepslate_panel": {"ignored": "(not ($is_smelt_tab = true))"} }                        ,
       { "stone@stone_panel": {"ignored": "(not ($is_smelt_tab = true))"} }                                ,
       { "terracotta@terracotta_panel": {"ignored": "(not ($is_smelt_tab = true))"} }                      ,
       { "raw_materials@raw_materials_panel": {"ignored": "(not ($is_smelt_tab = true))"} }                ,
       { "misc_blocks@misc_blocks_panel": {"ignored": "(not ($is_smelt_tab = true))"} }                    ,
       { "logs@logs_panel": {"ignored": "(not ($is_burn_tab = true))"} }                                   ,
       { "stripped_logs@stripped_logs_panel": {"ignored": "(not ($is_burn_tab = true))"} }                 ,
       { "wood@wood_panel": {"ignored": "(not ($is_burn_tab = true))"} }                                   ,
       { "planks@planks_panel": {"ignored": "(not ($is_burn_tab = true))"} }                               ,
       { "stairs@stairs_panel": {"ignored": "(not ($is_burn_tab = true))"} }                               ,
       { "doors@doors_panel": {"ignored": "(not ($is_burn_tab = true))"} }                                 ,
       { "trapdoors@trapdoors_panel": {"ignored": "(not ($is_burn_tab = true))"} }                         ,
       { "fences@fences_panel": {"ignored": "(not ($is_burn_tab = true))"} }                               ,
       { "fence_gates@fence_gates_panel": {"ignored": "(not ($is_burn_tab = true))"} }                     ,
       { "signs@signs_panel": {"ignored": "(not ($is_burn_tab = true))"} }                                 ,
       { "hanging_signs@hanging_signs_panel": {"ignored": "(not ($is_burn_tab = true))"} }                 ,
       { "pressure_plates@pressure_plates_panel": {"ignored": "(not ($is_burn_tab = true))"} }             ,
       { "boats@boats_panel": {"ignored": "(not ($is_burn_tab = true))"} }                                 ,
       { "chest_boats@chest_boats_panel": {"ignored": "(not ($is_burn_tab = true))"} }                     ,
       { "slabs@slabs_panel": {"ignored": "(not ($is_burn_tab = true))"} }                                 ,
       { "cartography_table@misc_cartography_table_def": {"ignored": "(not ($is_burn_tab = true))"} }      ,
       { "fletching_table@misc_fletching_table_def": {"ignored": "(not ($is_burn_tab = true))"} }          ,
       { "crafting_table@misc_crafting_table_def": {"ignored": "(not ($is_burn_tab = true))"} }            ,
       { "loom@misc_loom_def": {"ignored": "(not ($is_burn_tab = true))"} }                                ,
       { "chest@misc_chest_def": {"ignored": "(not ($is_burn_tab = true))"} }                              ,
       { "barrel@misc_barrel_def": {"ignored": "(not ($is_burn_tab = true))"} }                            ,
       { "bookshelf@misc_bookshelf_def": {"ignored": "(not ($is_burn_tab = true))"} }                      ,
       { "chiseled_bookshelf@misc_chiseled_bookshelf_def": {"ignored": "(not ($is_burn_tab = true))"} }    ,
       { "lectern@misc_lectern_def": {"ignored": "(not ($is_burn_tab = true))"} }                          ,
       { "stick@misc_stick_def": {"ignored": "(not ($is_burn_tab = true))"} }                              ,
       { "bowl@misc_bowl_def": {"ignored": "(not ($is_burn_tab = true))"} }                                ,
       { "composter@misc_composter_def": {"ignored": "(not ($is_burn_tab = true))"} }                      ,
       { "bamboo_mosaic@misc_bamboo_mosaic_def": {"ignored": "(not ($is_burn_tab = true))"} }              ,
       { "coal_block@misc_coal_block_def": {"ignored": "(not ($is_burn_tab = true))"} }                    ,
       { "coal@misc_coal_def": {"ignored": "(not ($is_burn_tab = true))"} }                                ,
       { "bamboo_mosaic_stairs@misc_bamboo_mosaic_stairs_def": {"ignored": "(not ($is_burn_tab = true))"} }
     ]
   },
