{
  "namespace": "cell_toggle",
  "template@common_toggles.light_template_toggle": {
    "$unchecked_control|default": "cell_template.default",
    "$checked_control|default": "cell_template.pressed",
    "$unchecked_hover_control|default": "cell_template.hover",
    "$checked_hover_control|default": "cell_template.hover",
    "$unchecked_locked_control|default": "cell_template.default",
    "$unchecked_locked_hover_control|default": "cell_template.hover",
    "$checked_locked_control|default": "cell_template.pressed",
    "$checked_locked_hover_control|default": "cell_template.hover",
    "$toggle_binding_type|default": "none"
  },
  "base@common_toggles.light_text_toggle": {
    "size": [ 25, 25 ],
    "$template_toggle": "cell_toggle.template",
    "$index|default": 10,
    "$label|default": "",
    "$item|default": "",
    "$toggle_name": "('toggle_name_' + $index)",
    "$toggle_view_binding_name": "('trigger_' + $index)"
  }
}