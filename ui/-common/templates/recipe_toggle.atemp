{
  "namespace": "recipe_toggle",
  "layout_toggle@common_toggles.light_image_toggle": {
    "$hover_border_visible": false,
    "$default_border_visible": false,
    "$toggle_binding_type": "global",
    "$icon_control": "global.empty_image",
    "$button_content": "crafting.layout_toggle_content",
    "$toggle_name": "layout_toggle",
    "$template_toggle": "survival_inventory.layout_template_toggle"
  },
  "layout_template_toggle@recipe_toggle.light_template_toggle": {
    "$focus_override_up": "FOCUS_OVERRIDE_STOP",
    "$default_texture": "assets/minecraft/textures/gui/sprites/recipe_book/button",
    "$hover_texture": "assets/minecraft/textures/gui/sprites/recipe_book/button_highlighted",
    "$pressed_texture": "assets/minecraft/textures/gui/sprites/recipe_book/button_highlighted",
    "$pressed_no_hover_texture": "assets/minecraft/textures/gui/sprites/recipe_book/button"
  },
  "recipe_layout_toggle": {
    "type": "panel",
    "size": [ 20, 18 ],
    "layer": 10,
    "controls": [
      {
        "recipe_book_layout_toggle@recipe_toggle.layout_toggle": {
          "size": [ 20, 18 ],
          "$toggle_group_forced_index": "$recipe_book_layout_index",
          "$toggle_state_binding_name": "#is_recipe_book_layout",
          "bindings": [
            {
              "binding_type": "global",
              "binding_name": "(not #is_recipe_book_layout)",
              "binding_name_override": "#visible"
            }
          ]
        }
      },
      {
        "survival_inventory_toggle@recipe_toggle.layout_toggle": {
          "size": [ 20, 18 ],
          "$toggle_group_forced_index": "$survival_layout_index",
          "$toggle_state_binding_name": "#is_survival_layout",
          "bindings": [
            {
              "binding_type": "global",
              "binding_name": "#is_recipe_book_layout",
              "binding_name_override": "#visible"
            }
          ]
        }
      }
    ]
  }
}