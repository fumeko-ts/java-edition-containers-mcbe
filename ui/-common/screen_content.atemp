{
  "namespace": "screen_content",
  "somali": {
    "type": "panel",
    "size": "$size",
    "offset": [ 0, 0 ],
    "$current_panel_offset|default": [ 20, -20 ],
    "variables": [
      {
        "requires": "($anvil_screen = true)",
        "$size": [ 176, 166 ],
        "$current_panel_offset|default": [ 100.8, -74 ],
        "$ep": "anvil"
      },
      {
        "requires": "($barrel_screen = true)",
        "$size": [ 176, 166 ],
        "$current_panel_offset|default": [ 100.8, -74 ],
        "$ep": "barrel"
      },
      {
        "requires": "($beacon_screen = true)",
        "$size": [ 230, 219 ],
        "$current_panel_offset|default": [ 126.8, -100 ],
        "$ep": "beacon"
      },
      {
        "requires": "($blast_furnace_screen = true)",
        "$size": [ 176, 166 ],
        "$current_panel_offset|default": [ 100.8, -74 ],
        "$ep": "blast_furnace"
      },
      {
        "requires": "($brewing_stand_screen = true)",
        "$size": [ 176, 166 ],
        "$current_panel_offset|default": [ 100.8, -71 ],
        "$ep": "brewing_stand"
      },
      {
        "requires": "($cartography_screen = true)",
        "$size": [ 176, 166 ],
        "$current_panel_offset|default": [ 100.8, -71 ],
        "$ep": "cartography"
      },
      {
        "requires": "($crafting_screen = true)",
        "$size": [ 176, 166 ],
        "$current_panel_offset|default": [ 100.8, -74 ],
        "$ep": "crafting"
      },
      {
        "requires": "($crafter_screen = true)",
        "$size": [ 176, 166 ],
        "$current_panel_offset|default": [ 100.8, -70 ],
        "$ep": "crafter"
      },
      {
        "requires": "($dispenser_screen = true)",
        "$size": [ 176, 166 ],
        "$current_panel_offset|default": [ 100.8, -74 ],
        "$ep": "dispenser"
      },
      {
        "requires": "($enchanting_screen = true)",
        "$size": [ 176, 166 ],
        "$current_panel_offset|default": [ 100.8, -71 ],
        "$ep": "enchanting"
      },
      {
        "requires": "($furnace_screen = true)",
        "$size": [ 176, 166 ],
        "$current_panel_offset|default": [ 100.8, -74 ],
        "$ep": "furnace"
      },
      {
        "requires": "($double_chest_container = true)",
        "$size": [ 176, 222 ],
        "$current_panel_offset|default": [ 100.8, -100 ],
        "$ep": "double_chest"
      },
      {
        "requires": "($grindstone_screen = true)",
        "$size": [ 176, 166 ],
        "$current_panel_offset|default": [ 100.8, -72 ],
        "$ep": "grindstone"
      },
      {
        "requires": "($hopper_screen = true)",
        "$size": [ 176, 133 ],
        "$current_panel_offset|default": [ 100.8, -57 ],
        "$ep": "hopper"
      },
      {
        "requires": "($horse_screen = true)",
        "$size": [ 176, 166 ],
        "$current_panel_offset|default": [ 100.8, -74 ],
        "$ep": "horse"
      },
      {
        "requires": "($loom_screen = true)",
        "$size": [ 176, 166 ],
        "$current_panel_offset|default": [ 100.8, -70 ],
        "$ep": "loom"
      },
      {
        "requires": "($shulker_screen = true)",
        "$size": [ 176, 166 ],
        "$current_panel_offset|default": [ 100.8, -74 ],
        "$ep": "shulker_box"
      },
      {
        "requires": "($smithing_screen = true)",
        "$size": [ 176, 166 ],
        "$current_panel_offset|default": [ 100.8, -74 ],
        "$ep": "smithing"
      },
      {
        "requires": "($smoker_screen = true)",
        "$size": [ 176, 166 ],
        "$current_panel_offset|default": [ 100.8, -74 ],
        "$ep": "smoker"
      },
      {
        "requires": "($stonecutter_screen = true)",
        "$size": [ 176, 166 ],
        "$current_panel_offset|default": [ 100.8, -73 ],
        "$ep": "stonecutter"
      },
      {
        "requires": "($main_trade_screen = true)",
        "$size": [ 276, 166 ],
        "$current_panel_offset|default": [ 80.8, -74 ],
        "$ep": "trade"
      },
      {
        "requires": "($inventory_screen = true)",
        "$size": [ 176, 166 ],
        "$current_panel_offset|default": [ 100.8, -74 ],
        "$ep": "inventory"
      }
    ],
    "$text_offset": [ 0, 0 ],
    "controls": [
      { "close_button@close_button": {  } },
      { "all_misc@$ep": {  } }
    ]
  },
  "label": {
    "type": "label",
    "offset": "$text_offset",
    "$text_offset": [ 0, 0 ],
    "anchor_from": "top_left",
    "anchor_to": "top_left",
    "text": "$container_title",
    "size": [ "90%", "default" ],
    "color": "$title_text_color",
    "layer": 20
  },
  "close_button": {
    "type": "panel",
    "layer": 2,
    "size": [ 18, 18 ],
    "$exit_panel": "common.empty_panel",
    "anchor_from": "center",
    "anchor_to": "center",
    "bindings": [
      {
        "binding_name": "#close_button_visible",
        "binding_name_override": "#visible"
      }
    ],
    "variables": [
      {
        "requires": "($Exit_panel_enabled = true)",
        "$exit_panel": "common.light_close_button_sucrose"
      }
    ],
    "controls": [
      {
        "close_button@$exit_panel": {
          "offset": "$current_panel_offset",
          "anchor_from": "center",
          "anchor_to": "center"
        }
      }
    ]
  },
  "image_element": { "type": "image", "grayscale": true, "alpha": 1 },
  "recipe_book@image_element": {
    "texture": "assets/minecraft/textures/gui/recipe_book",
    "size": [ 147, 166 ],
    "uv_size": [ 147, 166 ],
    "uv": [ 1, 1 ],
    "offset": [ 1, 0 ],
    "layer": 9
  },
  "anvil@image_element": {
    "uv_size": [ 176, 166 ],
    "texture": "assets/minecraft/textures/gui/container/anvil",
    "offset": [ 0, 0 ]
  },
  "beacon@image_element": {
    "uv_size": [ 230, 219 ],
    "texture": "assets/minecraft/textures/gui/container/beacon",
    "offset": [ -1, 0 ]
  },
  "blast_furnace@image_element": {
