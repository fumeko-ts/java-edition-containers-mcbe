  "shulker_box@image_element": {
    "uv_size": [ 176, 166 ],
    "texture": "assets/minecraft/textures/gui/container/shulker_box",
    "offset": [ 0, 0 ]
  },
  "smithing@image_element": {
    "uv_size": [ 176, 166 ],
    "texture": "assets/minecraft/textures/gui/container/smithing",
