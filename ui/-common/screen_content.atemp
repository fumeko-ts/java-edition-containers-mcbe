  "edit_box_indent": {
    "type": "image",
    "texture": "assets/minecraft/textures/gui/sprites/container/anvil/text_field_disabled"
  },
  "edit_box_indent_hover": {
    "type": "image",
    "texture": "assets/minecraft/textures/gui/sprites/container/anvil/text_field"
  },
  "scroll_box_image": {
    "type": "panel",
    "size": [ "100% - 2px", "100% - 2px" ],
    "allow_clipping": true,
    "offset": "$misc_scroller_offset",
    "controls": [
      {
        "js": {
          "allow_clipping": true,
          "type": "image",
          "texture": "assets/minecraft/textures/gui/sprites/container/loom/scroller.png",
          "size": [ 12, 15 ],
          "alpha": 1,
          "anchor_from": "top_middle",
          "anchor_to": "top_middle",
          "layer": 5
        }
      }
    ]
  },
  "scroll_box_image_disabled": {
    "anchor_from": "center",
    "anchor_to": "center",
    "type": "panel",
    "size": [ "100% - 2px", "100% - 2px" ],
    "allow_clipping": true,
    "offset": "$misc_scroller_disabled_offset",
    "controls": [
      {
        "js": {
          "allow_clipping": true,
          "type": "image",
          "texture": "assets/minecraft/textures/gui/sprites/container/stonecutter/scroller_disabled.png",
          "size": [ 12, 15 ],
          "alpha": 1,
          "anchor_from": "center",
          "anchor_to": "center",
          "layer": 5
        }
      }
    ]
  },
  "villager_scroller": {
    "type": "panel",
    "size": [ 7, "100%" ],
    "layer": 5,
    "controls": [
      {
        "texture": {
          "type": "image",
          "layer": 5,
          "texture": "assets/minecraft/textures/gui/sprites/container/villager/scroller",
          "size": [ 6, 27 ]
        }
      }
    ]
  },
  "text_field": {
    "type": "panel",
    "size": [ "100%", "100%" ],
    "controls": [
      {
        "texture": {
          "type": "image",
          "nineslice_size": 1,
          "texture": "assets/minecraft/textures/gui/sprites/widget/text_field",
          "size": [ "100%", "100%" ]
        }
      }
    ]
  },
  "text_field_highlighted": {
    "type": "panel",
    "size": [ "100%", "100%" ],
    "controls": [
      {
        "texture": {
          "type": "image",
          "nineslice_size": 1,
          "texture": "assets/minecraft/textures/gui/sprites/widget/text_field_highlighted",
          "size": [ "100%", "100%" ]
        }
      }
    ]
  },
  "barrel@common.empty_panel": {
    "controls": [
      {
        "top_half@image_element": {
          "anchor_from": "top_middle",
          "anchor_to": "top_middle",
          "offset": [ 0, -47.4 ],
          "layer": 4,
          "texture": "assets/minecraft/textures/gui/container/generic_54",
          "uv_size": [ 176, 71 ]
        }
      },
      {
        "bottom_half@image_element": {
          "anchor_from": "top_middle",
          "anchor_to": "top_middle",
          "offset": [ 0, 34.6 ],
          "layer": 2,
          "texture": "assets/minecraft/textures/gui/container/generic_54",
          "uv_size": [ 176, 97 ],
          "uv": [ 0, 125 ]
        }
      }
    ]
  },
  "crafting@image_element": {
    "uv_size": [ 176, 166 ],
    "texture": "assets/minecraft/textures/gui/container/crafting_table",
    "offset": [ 307, 84 ],
    "controls": [
      {
        "exit@close_button": { "$current_panel_offset|default": [ 100.8, -74 ] }
      }
    ]
  },
  "inventory@image_element": {
    "uv_size": [ 176, 166 ],
    "texture": "assets/minecraft/textures/gui/container/inventory",
    "offset": [ 0, 0 ],
    "controls": [
      {
        "exit@close_button": { "$current_panel_offset|default": [ 100.8, -74 ] }
      }
    ]
  },
  "tooltip": {
    "type": "panel",
    "size": [ "100%", "100%" ],
    "controls": [
      {
        "tooltip_outline": {
          "type": "image",
          "layer": 2,
          "texture": "textures/ui/purpleBorder.png",
          "size": [ "100%+16px", "100%+16px" ]
        }
      }
    ]
  },
  "trade_arrow": {
    "type": "image",
    "texture": "assets/minecraft/textures/gui/sprites/container/villager/trade_arrow.png",
    "size": [ 10, 11 ],
    "layer": 5
  },
  "trade_cross_out": {
    "type": "image",
    "texture": "assets/minecraft/textures/gui/sprites/container/villager/trade_arrow_out_of_stock.png",
    "size": [ 10, 11 ],
    "layer": 5
  },
  "cross_out": {
    "type": "image",
    "texture": "assets/minecraft/textures/gui/sprites/container/villager/out_of_stock.png",
    "size": [ 28, 21 ],
    "anchor_from": "top_left",
    "anchor_to": "top_left",
    "offset": "$cross_out_offset",
    "ignored": "$cross_out_ignored",
    "layer": "$arrowc_layer"
  },
  "arrow": {
    "type": "image",
    "texture": "textures/atemp/ui/in_stock.png",
    "size": [ 28, 21 ],
    "anchor_from": "top_left",
    "anchor_to": "top_left",
    "offset": "$cross_out_offset",
    "layer": "$arrow_layer"
  },
  "red_cell_image": { "type": "image", "texture": "textures/ui/cell_image_red" }
}