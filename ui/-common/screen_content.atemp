  "hopper@image_element": {
    "uv_size": [ 176, 133 ],
    "texture": "assets/minecraft/textures/gui/container/hopper",
    "offset": [ 0, 0 ]
  },
  "horse@image_element": {
    "uv_size": [ 176, 166 ],
    "texture": "assets/minecraft/textures/gui/container/horse",
    "offset": [ 0, 0 ]
  },
  "horse_inventory@image_element": {
    "uv_size": [ 176, 166 ],
    "texture": "assets/minecraft/textures/gui/container/horse",
    "offset": [ 0, 0 ]
  },
  "loom@image_element": {
    "uv_size": [ 176, 166 ],
