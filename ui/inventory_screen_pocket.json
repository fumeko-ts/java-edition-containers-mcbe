{
  "namespace": "crafting_pocket",
  "crafting_screen_pocket@crafting_pocket.inventory_screen_pocket_base": {
    "$inventory_gui": false,
    "send_telemetry": false,
    "load_screen_immediately": true,
    "$use_loading_bars": false,
    "low_frequency_rendering": true,
    "render_game_behind": true,
    "force_render_below": true,
    "absorbs_input": false,
    "is_showing_menu": true,
    "$uses_bundle_tooltip": true,
    "$screen_content": "crafting.crafting_screen_content",
    "$screen_bg_content": "common.screen_background",
    "$top_half_variant": "survival_inventory.crafting_panel_top_half",
    "$close_on_player_hurt|default": true,
    "close_on_player_hurt": "$close_on_player_hurt"
  },
  "inventory_screen_pocket@crafting_pocket.inventory_screen_pocket_base": {
    "$inventory_gui": true,
    "send_telemetry": false,
    "load_screen_immediately": true,
    "$use_loading_bars": false,
    "low_frequency_rendering": true,
    "render_game_behind": true,
    "force_render_below": true,
    "absorbs_input": true,
    "is_showing_menu": true,
    "$uses_bundle_tooltip": true,
    "$screen_content": "crafting.survival_screen_content",
    "$screen_bg_content": "common.screen_background",
    "$screen_background_alpha": 0.4,
    "$top_half_variant": "survival_inventory.survival_panel_top_half"
  }
}