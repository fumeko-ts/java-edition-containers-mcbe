{
  "highlight_slot_panel/highlight": {
    "variables": [
      {
        "requires": "($recipe_book = true or $creative_recipe_book = true)",
        "$recipe_var": [
          {
            "hover_text@common.hover_text": {
              "laagsdgdser": 29,
              "$hover_text_binding_name|default": "#hover_text",
              "bindings": [
                {
                  "binding_name": "#item_id_aux",
                  "binding_type": "collection",
                  "binding_collection_name": "$item_collection_name"
                },
                {
                  "binding_type": "view",
                  "source_property_name": "#item_id_aux",
                  "target_property_name": "#aux_id",
                  "binding_condition": "always"
                },
                {
                  "binding_type": "view",
                  "source_property_name": "(#hover_text_binding + ('\u00a78\nAux Id: ' + #aux_id))",
                  "target_property_name": "#hover_text"
                },
                {
                  "binding_name": "$hover_text_binding_name",
                  "binding_name_override": "#hover_text_binding",
                  "binding_type": "collection",
                  "binding_collection_name": "$item_collection_name"
                },
                {
                  "binding_type": "view",
                  "source_property_name": "(not #hover_text_binding = '')",
                  "target_property_name": "#visible"
                }
              ]
            }
          }
        ]
      }
    ],
    "$recipe_var": [
      {
        "hover_text@common.hover_text": {
          "laagsdgdser": 29,
          "$hover_text_binding_name|default": "#hover_text",
          "propertagsdgds_bag": {"force_update": true, "#color": "\u00a7e", "#start": 0, "#slash": "/", "#result": 0},
          "bindings": [
            {
              "binding_name": "$hover_text_binding_name",
              "binding_name_override": "#hover_text_binding",
              "binding_type": "collection",
              "binding_collection_name": "$item_collection_name"
            },
            {
              "binding_type": "collection",
              "binding_name": "#item_durability_total_amount",
              "binding_collection_name": "$item_collection_name"
            },
            {
              "binding_type": "collection",
              "binding_name": "#item_durability_current_amount",
              "binding_collection_name": "$item_collection_name"
            },
            {
              "binding_type": "collection",
              "binding_name": "#item_id_aux",
              "binding_name_override": "#aux_id",
              "binding_collection_name": "$item_collection_name"
            },
            {
              "binding_type": "view",
              "source_property_name": "(#result + ((#item_durability_total_amount > #result) - (#item_durability_total_amount < #result)))",
              "target_property_name": "#result",
              "binding_condition": "always_when_visible"
            },
            {
              "binding_type": "view",
              "source_property_name": "(#start + ((#item_durability_current_amount > #start) - (#item_durability_current_amount < #start)))",
              "target_property_name": "#start",
              "binding_condition": "always_when_visible"
            },
            {
              "binding_type": "view",
              "source_property_name": "((#start * 100) / #result)",
              "target_property_name": "#durability_percent",
              "binding_condition": "always_when_visible"
            },
            {
              "binding_type": "view",
              "source_property_name": "(#hover_text_binding + ('\u00a77\nDurability: ' + #durability_percent + '\u00a7z%') + ('\n\u00a78Aux Id: ' + #aux_id) - '\u00a77\nDurability: 0\u00a7z%')",
              "target_property_name": "#hover_text",
              "binding_condition": "always_when_visible"
            },
            {
              "binding_type": "view",
              "source_property_name": "(not #hover_text_binding = '')",
              "target_property_name": "#visible"
            }
          ]
        }
      }
    ],
    "controls": "$recipe_var"
  }
}